@prefix thinkr: <http://example.org/thinkr#> .
@prefix tgs: <http://example.org/tgs#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#############################################
# ADDED 2026-08-22 — QuadrantNode lookup system. Replaces live cosine-
# similarity computation with precomputed Euclidean-distance lookup, per
# MJSullivan's own design (see backlog.md). 49 nodes = every integer
# (x,y) pair on a 0-6 grid with (0,0) at the LOWER-LEFT corner —
# deliberately NOT centered on origin the way ScenarioFacet's own
# positions once were; MJSullivan's explicit correction 2026-08-22,
# after an earlier draft of this file mistakenly used the old -3..3
# values. thinkr:hasXPosition/hasYPosition reused directly from
# ScenarioFacet (domain restriction removed from both in tgs-core.ttl
# for exactly this reason) — ScenarioFacet's own real positions were
# MIGRATED to this same 0-6 scheme in the same pass (simple +3 shift;
# the 24 disjointness/divergence relationships were verified programmatically
# unchanged by the shift before applying it, since it's a pure relabeling,
# not a structural change).
#############################################

thinkr:QuadrantNode a owl:Class ;
    rdfs:comment "One of the 49 precomputed lookup points on the real 0-6 grid (7x7), origin (0,0) at the lower-left corner. Each carries its own real hasXPosition/hasYPosition plus precomputed Euclidean distance to each of the 4 real corner positions (QuadrantNode.11/.51/.15/.55), which the 16 real ScenarioFacets are linked to via thinkr:hasQuadrantNode. An arbitrary point (e.g. a classified news article) can be compared to any ScenarioFacet via a direct table lookup rather than live computation."@en ;
    skos:prefLabel "Quadrant Node"@en .

thinkr:hasQuadrantNode a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain thinkr:ScenarioFacet ;
    rdfs:range thinkr:QuadrantNode ;
    rdfs:comment "Links a real ScenarioFacet to its corresponding precomputed QuadrantNode (matching hasXPosition/hasYPosition), enabling Euclidean-distance lookup instead of live computation."@en ;
    skos:prefLabel "has quadrant node"@en .

thinkr:hasDistanceToQN11 a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain thinkr:QuadrantNode ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Precomputed Euclidean distance from this QuadrantNode to the real corner at (1,1) (0-6 grid, lower-left origin)."@en ;
    skos:prefLabel "hasDistanceToQN11"@en .

thinkr:hasDistanceToQN15 a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain thinkr:QuadrantNode ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Precomputed Euclidean distance from this QuadrantNode to the real corner at (1,5) (0-6 grid, lower-left origin)."@en ;
    skos:prefLabel "hasDistanceToQN15"@en .

thinkr:hasDistanceToQN51 a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain thinkr:QuadrantNode ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Precomputed Euclidean distance from this QuadrantNode to the real corner at (5,1) (0-6 grid, lower-left origin)."@en ;
    skos:prefLabel "hasDistanceToQN51"@en .

thinkr:hasDistanceToQN55 a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain thinkr:QuadrantNode ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Precomputed Euclidean distance from this QuadrantNode to the real corner at (5,5) (0-6 grid, lower-left origin)."@en ;
    skos:prefLabel "hasDistanceToQN55"@en .

tgs:QuadrantNode.00 a thinkr:QuadrantNode, owl:NamedIndividual ;
    thinkr:hasXPosition 0 ;
    thinkr:hasYPosition 0 ;
    thinkr:hasDistanceToQN11 "1.41"^^xsd:decimal ;
    thinkr:hasDistanceToQN15 "5.10"^^xsd:decimal ;
    thinkr:hasDistanceToQN51 "5.10"^^xsd:decimal ;
    thinkr:hasDistanceToQN55 "7.07"^^xsd:decimal ;
    skos:prefLabel "(0,0)"@en .

