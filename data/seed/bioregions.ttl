tgs:ConceptScheme.OneEarthBioregions2023 a skos:ConceptScheme, owl:NamedIndividual ;
    skos:prefLabel "One Earth Bioregions 2023"@en ;
    skos:definition "One Earth's hierarchy of 8 biogeographic realms, 14 realm divisions, 53 subrealms and 185 bioregions."@en ;
    dcterms:source tgs:Work.OneEarthBioregions2023 ;
    dcterms:creator "Karl Burkart, One Earth" ;
    dcterms:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
    skos:scopeNote "Attribution: One Earth (oneearth.org). Data licensed CC BY-NC 4.0."@en ;
    skos:hasTopConcept
        tgs:BiogeographicRealm.Afrotropic,
        tgs:BiogeographicRealm.Antarctic,
        tgs:BiogeographicRealm.Australasian,
        tgs:BiogeographicRealm.Indomalayan,
        tgs:BiogeographicRealm.Nearctic,
        tgs:BiogeographicRealm.Neotropic,
        tgs:BiogeographicRealm.Oceanian,
        tgs:BiogeographicRealm.Palearctic ;
    .
