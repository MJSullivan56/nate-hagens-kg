tgs:Work.RealityBlind a thinkr:Work, owl:NamedIndividual ;
    skos:prefLabel "Reality Blind: Integrating the Systems Science Underpinning Our Collective Futures, Vol. 1"@en ;
    rdfs:comment "Co-authored by Nate Hagens and DJ White (now a real, built Persona in this graph — resolves a note in an earlier, since-consolidated version of this entry flagging he wasn't yet modeled). Self-published on Amazon (ISBN 9798701116281) specifically so full content could stay free online — was the primary text for Hagens' own 'Reality 101' class. Covers deep time, human brain/behavior, ecology, and energy/money/economy, including a real elaboration of Concept.CarbonPulse (already in this graph) as a central framing device. Confirmed via multiple independent sources: Amazon, Goodreads, a LinkedIn post from Nate himself, MAHB, Stanford."@en ;
    dct:issued "2021"^^xsd:gYear ;
    dct:creator tgs:Human.NateHagens, tgs:Human.DJWhite ;
    dct:source <https://read.realityblind.world/> ;
    dct:isReferencedBy tgs:Interview.TGS_237_ArtBerman, tgs:Monologue.Frankly_161_HumanitysIcarusMoment, tgs:Interview.TGS_202_SamanthaSweetwater, tgs:Monologue.Frankly_104_DucksAndBlueberries, tgs:Monologue.Frankly_103_TheGhostOfDopaminePast, tgs:Monologue.Frankly_102_ThisWeeksLearnings, tgs:Monologue.Frankly_101_WhatIWantToWantForTheFuture, tgs:Monologue.Frankly_160_AStateOfTheWorldAddress, tgs:Monologue.Frankly_129_DesperatelySeekingAgency, tgs:Monologue.Frankly_151_Part6PlanningUnderUncertainty, tgs:Monologue.Frankly_148_Part4CompositeWorlds, tgs:Monologue.Frankly_138_Part1ChangingTheFuture, tgs:Monologue.Frankly_142_GuideToStayingHumanPart2, tgs:Monologue.Frankly_143_GuideToStayingHumanPart3, tgs:Monologue.Frankly_145_Part3UphillFutures, tgs:Interview.TGS_235_RobertPape, tgs:Interview.TGS_236_ZekeHausfather, tgs:Interview.TGS_185_MythsShapingOurEconomies, tgs:Interview.TGS_226_CanMoneyServeLife, tgs:Interview.TGS_220_AWorldOnThePrecipice, tgs:Interview.TGS_221_AndrewHolecek, tgs:Interview.TGS_209_BalazsMatics, tgs:Interview.TGS_238_IndyJohar, tgs:Monologue.Frankly_162_SevenRungsOfARunawaySystem, tgs:Interview.TGS_71_DanielSchmachtenberger, tgs:Interview.TGS_50_CriteriaCategoriesResponse, tgs:Interview.TGS_42_ModelingDriversMetacrisis, tgs:Interview.TGS_31_SensemakingUncertaintyPurpose, tgs:Interview.TGS_20_MaximumPowerHyperAgents, tgs:Interview.TGS_5_BendNotBreakPart1, tgs:Interview.TGS_126_AVisionForBetterment, tgs:Monologue.Frankly_82_PowerVsLife, tgs:Monologue.Frankly_86_WhatIsWealth, tgs:Monologue.Frankly_73_TheSuperorganismAndTheSelf, tgs:Monologue.Frankly_25_LossAversion, tgs:Interview.TGS_93_JorisVanDerSchot, tgs:Monologue.Frankly_76_TheBattlesOfOurTime, tgs:Monologue.Frankly_70_AskMeAnything, tgs:Monologue.Frankly_66_RealityParty ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
        thinkr:hasAlternateTermType tgs:AlternateTermType.ExactMatch ;
        skos:prefLabel "Reality Blind"@en ;
        skos:scopeNote "Short-form title, used in casual reference (e.g. this graph's own dct:references usage) versus the full formal title." ] ;
    dct:identifier "urn:isbn:9798701116281" ;
    .

