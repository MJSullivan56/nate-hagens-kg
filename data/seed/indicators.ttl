    skos:broader tgs:IndicatorCategory.Housing ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.Housing ;
    skos:prefLabel "Housing Burden"@en ;
    skos:definition "Share of renters paying more than 30% of income on housing."@en ;
    thinkr:shortfallPercent "55"^^xsd:decimal ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage shortfall below the social foundation. Earlier paraphrased definition: 'The proportion of households spending more than 30% to 50% of their gross income on rent or mortgage payments.'"@en .

