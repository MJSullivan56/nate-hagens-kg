    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.EcosystemRegeneration ;
    dcterms:description "100 Regenerative Village (100RV) promotes agroforestry and regenerative practices so forests stay intact as water catchments."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.MultiStakeholderForestGovernance a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Multi-Stakeholder Forest Governance"@en ;
