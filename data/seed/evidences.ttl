tgs:Evidence.Disarmer_CommunityReconciliation_BaueTIBC11 a thinkr:Evidence, owl:NamedIndividual ;
    thinkr:confidence thinkr:ConfidenceType.Candidate ;
    thinkr:evidencePolarity thinkr:PolarityType.Supports ;
    thinkr:aboutSource tgs:Source.BaueTIBC11Post ;
    dcterms:description "Bill Baue's account of TIBC11: when a full session turned into what many experienced as public shaming, an Indigenous participant trained in peacemaking by Mohawk Chief Jake Swamp ran a full-community circle the next day that turned shame into regret and separation toward solidarity. A real case of the broader, WWNS #4 sense of the Disarmer (defusing blame before it hardens), carried out through community reconciliation. Drafted by Claude at MJSullivan's request."@en ;
    prov:generatedAtTime "2026-10-21"^^xsd:date .

