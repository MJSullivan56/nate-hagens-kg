@prefix tgs:   <http://example.org/tgs#> .
@prefix thinkr: <http://example.org/thinkr#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/tgs#> a owl:Ontology ;
    owl:imports <http://example.org/thinkr#> ;
    rdfs:comment "Imports tgs-core for Protege compatibility — editing this file alone will resolve thinkr: classes/properties via the catalog file."@en ;
    .

#############################################
# thinkr:Work — promoted out of tgs-core.ttl on 2026-07-11, its first
# real instance (governance principle: classes get their own file once
# they have real content, not before).
#############################################

thinkr:Work a owl:Class ;
    rdfs:comment "A book, essay, or other work in which a concept or idea is developed."@en ;
    rdfs:subClassOf dct:BibliographicResource ;
    skos:scopeNote "Narrower than dct:BibliographicResource: specifically a work in which a TGS-relevant concept is developed, not any bibliographic item in general."@en ;
    skos:prefLabel "Work"@en ;
    .

#############################################
# Instances
#############################################

tgs:Work.CaliforniaDoughnutReport2025 a thinkr:Work, owl:NamedIndividual ;
    skos:prefLabel "The California Doughnut Snapshot and Report"@en ;
    rdfs:comment "Authors: Alaitz Aritza (data manager), Julian Kraus-Polk (editor), California Doughnut Economics Coalition. Published November 6, 2025, v1. Examines 42 social/ecological indicators across 21 categories; finds California overshooting 89% of ecological indicators (average overshoot 286%) while falling short on 100% of social indicators assessed. CC-BY 4.0 licensed — more permissive than most sources in this graph, direct quotation with attribution is explicitly permitted."@en ;
    dct:source <https://zenodo.org/records/17540639> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/legalcode> ;
    .

tgs:Work.TheMasterAndHisEmissary a thinkr:Work, owl:NamedIndividual ;
    skos:prefLabel "The Master and His Emissary: The Divided Brain and the Making of the Western World"@en ;
    rdfs:comment "2009 book by Iain McGilchrist (Yale University Press). Argues the brain's two hemispheres offer fundamentally different kinds of attention to the world, and that Western culture has become dominated by narrow, left-hemisphere thinking at the expense of the right's broader, contextual awareness. Sold over 200,000 copies."@en ;
    dct:creator tgs:Human.IainMcGilchrist ;
    owl:sameAs <http://dbpedia.org/resource/The_Master_and_His_Emissary> ;
    .

tgs:Work.TheMatterWithThings a thinkr:Work, owl:NamedIndividual ;
    skos:prefLabel "The Matter with Things: Our Brains, Our Delusions, and the Unmaking of the World"@en ;
    rdfs:comment "2021 book by Iain McGilchrist (Perspectiva Press), extending The Master and His Emissary's hemisphere hypothesis into epistemology and metaphysics — 1,500 pages across two volumes."@en ;
    dct:creator tgs:Human.IainMcGilchrist ;
    owl:sameAs <http://dbpedia.org/resource/The_Matter_with_Things> ;
    .

tgs:Work.RealityBlind a thinkr:Work, owl:NamedIndividual ;
    skos:prefLabel "Reality Blind: Integrating the Systems Science Underpinning Our Collective Futures, Vol. 1"@en ;
    rdfs:comment "Co-authored with DJ White — DJ White NOT modeled as a Person individual as of 2026-07-11, would need the same verification pass as every other person tonight (Wikipedia/wrong-person checks), not fabricated as a side effect of fleshing out Nate. Self-published on Amazon (ISBN 9798701116281) specifically so full content could stay free online — was the primary text for Nate's Reality 101 course. Confirmed via multiple independent sources: Amazon, Goodreads, a LinkedIn post from Nate himself, MAHB, Stanford."@en ;
    dct:issued "2021"^^xsd:gYear ;
    dct:creator tgs:Human.NateHagens ;
    .

#############################################
# BOOTSTRAPPED 2026-07-15 — Gaya Herrington's 2021 paper, direct
# empirical basis for tgs:LinkNote.LimitsToGrowth_GayaHerrington. See
# humans.ttl for the fuller bootstrap trail.
#############################################

tgs:Work.UpdateToLimitsToGrowth2021 a thinkr:Work, owl:NamedIndividual ;
    skos:prefLabel "Update to limits to growth: Comparing the World3 model with empirical data"@en ;
    rdfs:comment "Peer-reviewed article, Journal of Industrial Ecology (Yale University), 2021. DOI 10.1111/jiec.13084. Re-tests the original 1972 Limits to Growth study's World3 model against real-world 2020-era data; finds current trends track most closely with the study's 'Business as Usual 2' and 'Comprehensive Technology' scenarios, both projecting overshoot-and-decline dynamics within the 21st century. Verified via WebSearch 2026-07-15."@en ;
    dct:issued "2021"^^xsd:gYear ;
    dct:creator tgs:Human.GayaHerrington ;
    dct:source <https://doi.org/10.1111/jiec.13084> ;
    .

tgs:Work.FiveInsightsForAvoidingGlobalCollapse a thinkr:Work, owl:NamedIndividual ;
    skos:prefLabel "Five Insights for Avoiding Global Collapse"@en ;
    rdfs:comment "Book by Gaya Herrington, containing an exclusive research update based on 2022 data extending her original World3 empirical re-test (see tgs:Work.UpdateToLimitsToGrowth2021). Confirmed via WebFetch of her own bio site (gayaherrington.com/about) 2026-07-15 — exact publisher/ISBN/year not yet independently verified, flagged honestly rather than guessed, same discipline as tgs:Work.RealityBlind's DJ White note."@en ;
    dct:creator tgs:Human.GayaHerrington ;
    .

#############################################
# ADDED 2026-08-13 — external citations from Frankly_138's official show
# notes. NOTE: the show notes also cite "Scenario Thinking: A Historical
# Evolution of Strategic Foresight" as the source behind
# tgs:Concept.ScenarioThinking — deliberately NOT minted as a Work here,
# title alone is insufficient to safely verify authorship/publication
# details without real search, same discipline as every other bootstrap
# this project has done. Flagged in Concept.ScenarioThinking's own
# scopeNote instead of guessed at here.
#############################################

tgs:Work.ComplexityAndPostmodernism a thinkr:Work, owl:NamedIndividual ;
    skos:prefLabel "Complexity and Postmodernism: Understanding Complex Systems"@en ;
    rdfs:comment "1998 book by Paul Cilliers (Routledge), cited in Frankly_138's show notes alongside the episode's complex-systems-thinking discussion. Author/title NOT independently re-verified this session — taken directly from the official show notes' own citation, which is itself a stronger source than an unverified transcript mention."@en ;
    .

tgs:Work.GlobalTippingPointsReport2025 a thinkr:Work, owl:NamedIndividual ;
    skos:prefLabel "Global Tipping Points Report 2025"@en ;
    rdfs:comment "Cited in Frankly_138's show notes specifically for its treatment of ice-sheet and soil-system tipping points. Full authorship/publisher NOT independently verified this session — real, citable report per the official show notes' own link, worth a proper WebFetch verification pass before treating this stub as complete."@en ;
    .
