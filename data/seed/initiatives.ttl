    thinkr:carriedOutBy tgs:Organization.ReVillageGreenValley ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CollectiveOwnershipModels ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.LegalStewardship ;
    dcterms:description "The team is forming a community land trust to hold the Green Valley Commons in perpetuity for collective wellbeing."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.GreenValleyCommons a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Green Valley Commons"@en ;
    thinkr:carriedOutBy tgs:Organization.ReVillageGreenValley ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CommonsGovernanceProtocols, tgs:PracticeTerm.CulturalHubOrLearningCenter ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.HubsAndCenters ;
