    thinkr:listedInPracticeCluster tgs:PracticeCluster.HubsAndCenters, tgs:PracticeCluster.ServicesAndInfrastructure ;
    dcterms:description "A planned hub would host respectful cultural tourism—lodging, guided visits, and teaching grounded in Huni Kuin cosmology and restoration work—so outsiders can witness progress, diversify income, and build accountable cross-cultural relationships."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.NativeCropRegenerationAndSupplyChainDevelopment a thinkr:Initiative, owl:NamedIndividual ;
