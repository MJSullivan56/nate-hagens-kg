    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "In Jembrana, KEM supported Sabha Wana Kerthi, a multi-stakeholder forest forum chaired from the regional planning agency and joined by forestry and environment offices, the forest management unit (KPH), farmer groups (KTH), and firms such as Palapa (nutmeg) and Conservana Spices (vanilla, coffee, cacao)."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.PlanningAssistanceToLocalGovernments a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Planning Assistance to Local Governments"@en ;
    thinkr:carriedOutBy tgs:Organization.KoalisiEkonomiMembumi ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ParticipatoryStrategies ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "KEM backs districts in drafting plans that lock in environmental and social commitments—not only pilot projects."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ValueChainCollaborationCanvas a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Value Chain Collaboration Canvas"@en ;
    thinkr:carriedOutBy tgs:Organization.KoalisiEkonomiMembumi ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.NetworkWeaving, tgs:PracticeTerm.ValueChainDevelopment ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "VC3 stitches stakeholders so each chain link reinforces the next. In Tabanan, agroforestry cacao growers work with Agridesa on data-backed farming, digital tools, and finance; Cau Chocolates off-takes organic, agroforestry-grown beans."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.GuidedTours a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Guided Tours"@en ;
    thinkr:carriedOutBy tgs:Organization.KogayonAssociation ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ImmersiveJourneys, tgs:PracticeTerm.TraditionalEcologicalKnowledge, tgs:PracticeTerm.VisitorExperiences ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.ServicesAndInfrastructure ;
    dcterms:description "Tours respond to a simple demand: visitors and locals want to know the story of the land. Guides frame history as orientation—where communities come from shapes where they can go."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.HeritagePreservation a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Heritage Preservation"@en ;
    thinkr:carriedOutBy tgs:Organization.KogayonAssociation ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ArtAndStorytelling, tgs:PracticeTerm.ConstructionAndHousing ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.ServicesAndInfrastructure, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Heritage work prioritises buildings and landscapes that can still speak clearly to history—not every structure can be saved, but exceptional ones can be repaired, reused, and interpreted."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.SilkWeavingWorkshop a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Silk Weaving Workshop"@en ;
    thinkr:carriedOutBy tgs:Organization.KogayonAssociation ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ClothingAndProductManufacturing ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.ServicesAndInfrastructure ;
    dcterms:description "The silk line runs from raising silkworms through reeling thread to weaving on manual looms—methods handed down mother to daughter."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.TraditionalHorseExperiences a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Traditional Horse Experiences"@en ;
    thinkr:carriedOutBy tgs:Organization.KogayonAssociation ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ImmersiveJourneys, tgs:PracticeTerm.MoreThanHumanKnowledge, tgs:PracticeTerm.VisitorExperiences ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.ServicesAndInfrastructure, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Horses are integrated as working partners: feeding, handling, light riding. The pitch is not stunt tourism but invitation into daily mountain life—pastoral rhythms and long cohabitation between people and livestock."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.NatureToursAndExperiences a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Nature Tours and Experiences"@en ;
    thinkr:carriedOutBy tgs:Organization.Landschaftspflegeverein ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CulturalAndSpiritualPractices, tgs:PracticeTerm.LearningPrograms, tgs:PracticeTerm.VisitorExperiences ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.ServicesAndInfrastructure, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Public programmes lean on direct experience: guided day walks and night walks where moths, beetles, bats, and other nocturnal life appear; festival stalls introduce the association’s work in plain sight."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.NetworkNaturregionBuilding a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Network Naturregion Building"@en ;
    thinkr:carriedOutBy tgs:Organization.Landschaftspflegeverein ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CulturalHubOrLearningCenter, tgs:PracticeTerm.HabitatConnectivity, tgs:PracticeTerm.NetworkWeaving ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.EcosystemRegeneration, tgs:PracticeCluster.HubsAndCenters ;
    dcterms:description "Many high-value patches sit isolated—a poor recipe for persistence. “Orphan” greens—verges, corporate lawns, small parks—can still host diversity if managed intentionally."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.SchoolEducationPrograms a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "School Education Programs"@en ;
    thinkr:carriedOutBy tgs:Organization.Landschaftspflegeverein ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.LearningPrograms ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "With Enzesfeld elementary, educators start young: children map what lives nearby, then join maintenance sessions and learn that habitats need ongoing care—nothing stewards itself."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.SustainableGrasslandManagement a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Sustainable Grassland Management"@en ;
    thinkr:carriedOutBy tgs:Organization.Landschaftspflegeverein ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.FarmerSupport, tgs:PracticeTerm.HabitatConnectivity, tgs:PracticeTerm.RegenerativeGrazing ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.EcosystemRegeneration ;
    dcterms:description "Open habitats cannot be sustained with uniform, industrial mowing. Historically, mosaic grazing and scythe work moved slowly across small parcels—patterns that modern large-field management erases along with specialist species."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.DecolonizingHumanWildlifeConflicts a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Decolonizing Human-Wildlife Conflicts"@en ;
    thinkr:carriedOutBy tgs:Organization.MIKIAKenya ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.HabitatConnectivity, tgs:PracticeTerm.TraditionalEcologicalKnowledge ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.EcosystemRegeneration, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Conflict-reduction programmes often lean on technical packages while understating long-standing Maasai practices."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.IndigenousLearningCentersAndMapping a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Indigenous Learning Centers and Mapping"@en ;
    thinkr:carriedOutBy tgs:Organization.MIKIAKenya ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CulturalHubOrLearningCenter, tgs:PracticeTerm.GeographicAndEcologicalMapping ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.HubsAndCenters, tgs:PracticeCluster.MappingAndIndicators ;
    dcterms:description "With two communities, MIKIA supports mapping of degraded habitat, water access, and human–wildlife hotspots—data owned and narrated by residents for advocacy and planning."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.IndigenousTaxonomyAndZoonosis a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Indigenous Taxonomy & Zoonosis"@en ;
    thinkr:carriedOutBy tgs:Organization.MIKIAKenya ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.LearningPrograms, tgs:PracticeTerm.TraditionalEcologicalKnowledge ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "One line of work compiles an Indigenous taxonomy guide—how Maasai classify and relate to plants, animals, celestial bodies, and weather signs as predictive tools."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.CollaborativeKnowledgeProjects a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Collaborative Knowledge Projects"@en ;
    thinkr:carriedOutBy tgs:Organization.MiraRiverGuardians ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ArtAndStorytelling, tgs:PracticeTerm.CitizenOrCommunityScience, tgs:PracticeTerm.LearningPrograms ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Three years of mapping fed collaborative projects aimed at regeneration: - School workshops build youth literacy on the river and responsibility for its care. - Guided ecological tours ground understanding in direct experience of the catchment. - Citizen science deepens monitoring literacy and shared ownership of data."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.RiverGuardians a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "River Guardians"@en ;
    thinkr:carriedOutBy tgs:Organization.MiraRiverGuardians ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GovernanceBodies ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "That differentiated engagement helped turn a loose stakeholder map into a network of River Guardians—people and organisations willing to act as bioregional stewards."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.SocialEcosystemMapping a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Social Ecosystem Mapping"@en ;
    thinkr:carriedOutBy tgs:Organization.MiraRiverGuardians ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.NetworkWeaving, tgs:PracticeTerm.SocialOrNetworkMapping ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.MappingAndIndicators ;
    dcterms:description "Early work mapped the social ecosystem: who holds stake in the basin, where they operate, and how trust might grow through repeated contact on their own ground."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.NilaIndigenousLandTrustStrategy a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Nila Indigenous Land Trust Strategy"@en ;
    thinkr:carriedOutBy tgs:Organization.NilaVenaOrganizingTeam ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.AgreementsAndLegalInstruments, tgs:PracticeTerm.CollectiveOwnershipModels, tgs:PracticeTerm.CommonsGovernanceProtocols ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.LegalStewardship ;
    dcterms:description "The aim is a Native-led land trust that can travel as a model—returning land and authority to tribal stewardship."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.NilaVenaSustainabilityForum a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Nila Vena Sustainability Forum"@en ;
    thinkr:carriedOutBy tgs:Organization.NilaVenaOrganizingTeam ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GovernanceBodies, tgs:PracticeTerm.TraditionalEcologicalKnowledge ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "For roughly three years, representatives of all six tribes have met through the Nila Vena Sustainability Forum, using a council format akin to their regional health board—one appointed delegate per tribe."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.AllianceForTheMysticRiverWatershed a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Alliance for the Mystic River Watershed"@en ;
    thinkr:carriedOutBy tgs:Organization.NortheastBioregioningCollective ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CulturalHubOrLearningCenter, tgs:PracticeTerm.ParticipatoryStrategies ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.HubsAndCenters ;
    dcterms:description "The Alliance models joint municipal–tribal planning for climate, equity, and ecosystem health."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.NortheastBFFAndVentureStudio a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Northeast BFF & Venture Studio"@en ;
    thinkr:carriedOutBy tgs:Organization.NortheastBioregioningCollective ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GrantsPrograms, tgs:PracticeTerm.InvestmentVehicles, tgs:PracticeTerm.VentureCultivation ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "The group is building paired capital: a bioregional financing facility (trust capital aligned with an intertribal table) and a venture studio for bioregionally rooted enterprises unlikely to emerge from conventional markets."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.NortheastBioregionalStrategyAndIntertribalGovernanceFramework a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Northeast Bioregional Strategy & Intertribal Governance Framework"@en ;
    thinkr:carriedOutBy tgs:Organization.NortheastBioregioningCollective ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.NetworkWeaving, tgs:PracticeTerm.ParticipatoryStrategies, tgs:PracticeTerm.RightsOfNature ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.LegalStewardship ;
    dcterms:description "A draft regional regenerative strategy—Indigenous co-governance at the core—bundles restoration with food, fiber, and fuel systems, then links those to efficient buildings, clean energy, and active mobility (trails, multi-use paths)."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ForestRegenerationAndCattleRanching a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Forest Regeneration and Cattle Ranching"@en ;
    thinkr:carriedOutBy tgs:Organization.PanamaRestorationLab ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.RegenerativeAgriculture, tgs:PracticeTerm.RegenerativeGrazing, tgs:PracticeTerm.VegetationPlanting ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.EcosystemRegeneration ;
    dcterms:description "Ranching and clearing have left pastures prone to drying. The program works with stockmen on regenerative grazing and reforestation, uses ForTerra results on carbon, biomass, and grazing management, and trials rapid tree establishment to recover grasslands, canopy, and biodiversity services tied to rain and storage."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.LaArenosaPilotSite a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "La Arenosa Pilot Site"@en ;
    thinkr:carriedOutBy tgs:Organization.PanamaRestorationLab ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.DemonstratorSite, tgs:PracticeTerm.FormalScientificProcess, tgs:PracticeTerm.RegenerativeAgriculture ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.HubsAndCenters, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Work begins on one hectare of pineapple—a stand-in for common practice: bare rows on depleted soil, high erosion, little water holding."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.PanamaVentureStudioRestorationFund a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Panama Venture Studio + Restoration Fund"@en ;
    thinkr:carriedOutBy tgs:Organization.PanamaRestorationLab ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.InvestmentVehicles, tgs:PracticeTerm.PortfolioDevelopment, tgs:PracticeTerm.VentureCultivation ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "A venture studio plus restoration fund are designed as one pipeline: co-design place-based methods and enterprises, then move catalytic capital into landscape portfolios and shared infrastructure under governance that privileges community priorities and ecosystem outcomes."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.HeRipoKauAVisionForTheHokianga a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "He Ripo Kau: A Vision for the Hokianga"@en ;
    thinkr:carriedOutBy tgs:Organization.ReconnectingNorthland ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ParticipatoryStrategies, tgs:PracticeTerm.TrainingAndEmploymentPathways, tgs:PracticeTerm.WatershedRepair ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.EcosystemRegeneration, tgs:PracticeCluster.ServicesAndInfrastructure ;
    dcterms:description "He Ripo Kau applies the Tapere logic in Hokianga—linking taiao renewal with mana tangata. Since 2016, hui have convened hau kāinga around a shared model."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.NatureBasedEnterprise a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Nature-Based Enterprise"@en ;
    thinkr:carriedOutBy tgs:Organization.ReconnectingNorthland ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ValueChainDevelopment, tgs:PracticeTerm.VentureCultivation ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "Nature-based enterprise ties livelihoods to healthy ecosystems inside each Tapere. Deprivation—scarce jobs, housing stress, thin services—slows circular economies even where biodiversity is high."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.TaperePlanningRootedInAncestralBoundaries a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Tapere: Planning Rooted in Ancestral Boundaries"@en ;
    thinkr:carriedOutBy tgs:Organization.ReconnectingNorthland ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GeographicAndEcologicalMapping, tgs:PracticeTerm.HabitatConnectivity, tgs:PracticeTerm.ParticipatoryStrategies ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.EcosystemRegeneration, tgs:PracticeCluster.MappingAndIndicators ;
    dcterms:description "Tapere builds hyper-local plans aligned with Māori tapere land units—not imported grid lines."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.TeKawaWaiora a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Te Kawa Waiora"@en ;
    thinkr:carriedOutBy tgs:Organization.ReconnectingNorthland ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.TraditionalEcologicalKnowledge ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "In 2020–2021, Te Kawa Waiora examined mauri—life force—along the Wairoa River and its margins, centring Indigenous partners and asking what a renewed, place-based ethics of care might look like."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.TeKeteHonongaTheBasketOfConnections a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Te Kete Hononga: The Basket of Connections"@en ;
    thinkr:carriedOutBy tgs:Organization.ReconnectingNorthland ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.NetworkWeaving, tgs:PracticeTerm.TrainingAndEmploymentPathways ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.ServicesAndInfrastructure ;
    dcterms:description "Te Kete Hononga (“basket of connections”) bundles navigation support for community initiatives: funding, training, and agencies threaded through a trusted Kairaranga (weaver)—a local person trained to open doors across the system."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.TheConnectivityPartnership a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "The Connectivity Partnership"@en ;
    thinkr:carriedOutBy tgs:Organization.ReconnectingNorthland ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GrantsPrograms, tgs:PracticeTerm.InvestmentVehicles, tgs:PracticeTerm.NetworkWeaving ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "The Connectivity Partnership formalises cooperation among NGOs (WWF-New Zealand, NZ Landcare Trust), agencies, and iwi—pooling knowledge, co-funding, and coordinating corridors and catchments."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.BioculturalJaguarCreditsProgram a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Biocultural Jaguar Credits Program"@en ;
    thinkr:carriedOutBy tgs:Organization.RegenFoundation ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.EcologicalMonitoring, tgs:PracticeTerm.ResultBasedMechanisms ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.MappingAndIndicators, tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "This pilot conservation program aims to create and demonstrate a fully transparent ecological-economic model that safeguards Earth's biosphere while enhancing human wellbeing."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.DeepEconomicCodeWork a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Deep Economic Code Work"@en ;
    thinkr:carriedOutBy tgs:Organization.RegenSydney ;
