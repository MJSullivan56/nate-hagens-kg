@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tgs: <http://example.org/tgs#> .
@prefix thinkr: <http://example.org/thinkr#> .

<http://example.org/tgs#> a owl:Ontology ;
    owl:imports <http://example.org/thinkr#> ;
    rdfs:comment "Imports tgs-core for Protege compatibility — editing this file alone will resolve thinkr: classes/properties via the catalog file."@en .

#############################################
# ADDED 2026-10-20 — One Earth's solutions taxonomy (tgs:Work.OneEarthSolutions),
# at MJSullivan's request, as a source of solution types for WWNS.
# Same classes as initiatives.ttl: the three pillars plus Levers of Change and
# Intersectional Themes are thinkr:PracticeCluster; sub-pillars and the 76
# solutions are thinkr:PracticeTerm, linked by skos:broader (solution ->
# sub-pillar -> pillar). Six Fronts crosswalk (skos:relatedMatch) is set
# mostly at sub-pillar level; query with skos:broader* to reach solutions.
# Definitions are short paraphrases of One Earth's own descriptions.
# IRIs carry a OneEarth_ prefix to keep them apart from Bioregioning terms.
#############################################

tgs:PracticeCluster.OneEarth_EnergyTransition a thinkr:PracticeCluster, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:topConceptOf tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Energy Transition"@en ;
    skos:definition "Shifting energy systems away from fossil fuels toward clean, renewable power for everyone, using technology that is already available and cheaper than polluting alternatives."@en ;
    skos:scopeNote "TGS reading (MJSullivan's and Nate's view): renewables are important but not enough by themselves; Nate's aggregate-probability test (tgs:Concept.AggregateProbability, Frankly_79) names '100 percent renewables' among single-issue efforts that look good alone. Quote this pillar in WWNS as part of using less, not only cleaner."@en ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_RenewablePower a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Renewable Power"@en ;
    skos:definition "Electricity from clean sources that regenerate faster than they are used."@en ;
    skos:broader tgs:PracticeCluster.OneEarth_EnergyTransition ;
    skos:relatedMatch tgs:InterventionSubdomain.EnergySystems ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_SolarPhotovoltaic a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Solar Photovoltaic"@en ;
    skos:definition "Panels that convert sunlight directly into electric current."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_RenewablePower ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_SolarThermoelectric a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Solar Thermoelectric"@en ;
    skos:definition "Mirrors or lenses concentrate sunlight to heat a fluid that drives a turbine."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_RenewablePower ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_GeothermalPower a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Geothermal Power"@en ;
    skos:definition "Underground heat, usually near volcanic areas, turned into steam for electricity."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_RenewablePower ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_OnshoreWind a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Onshore Wind"@en ;
    skos:definition "Land-based turbines converting wind into electricity."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_RenewablePower ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_OffshoreWind a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Offshore Wind"@en ;
    skos:definition "Seabed-anchored turbines using stronger ocean winds."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_RenewablePower ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_WaveEnergy a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Wave Energy"@en ;
    skos:definition "Ocean wave motion converted into electricity."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_RenewablePower ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_SustainableHydropower a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Sustainable Hydropower"@en ;
    skos:definition "Smaller dams that generate power while protecting aquatic life and fish migration."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_RenewablePower ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_SustainableBiomassPower a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Sustainable Biomass Power"@en ;
    skos:definition "Electricity from waste biomass rather than harvested trees."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_RenewablePower ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_GreenHydrogenPower a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Green Hydrogen Power"@en ;
    skos:definition "Hydrogen made by splitting water with renewable electricity, stored and used in fuel cells."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_RenewablePower ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_RenewableHeat a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Renewable Heat"@en ;
    skos:definition "Heating water, buildings and industry with clean, regenerating sources."@en ;
    skos:broader tgs:PracticeCluster.OneEarth_EnergyTransition ;
    skos:relatedMatch tgs:InterventionSubdomain.EnergySystems ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_SolarHeat a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Solar Heat"@en ;
    skos:definition "The sun's heat captured for space or water heating."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_RenewableHeat ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_SustainableBiomassHeat a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Sustainable Biomass Heat"@en ;
    skos:definition "Controlled burning of waste biomass for heat without depleting forests or farmland."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_RenewableHeat ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_GeothermalHeat a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Geothermal Heat"@en ;
    skos:definition "Underground heat drawn for homes and industry."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_RenewableHeat ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_GreenHydrogenHeat a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Green Hydrogen Heat"@en ;
    skos:definition "Clean hydrogen burned for high-temperature heat or used in fuel cells."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_RenewableHeat ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_DistrictHeat a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "District Heat"@en ;
    skos:definition "Insulated pipe networks distributing renewable heat to homes and industry."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_RenewableHeat ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_ElectricHeat a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Electric Heat"@en ;
    skos:definition "Heat pumps, heaters and induction powered by renewable electricity."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_RenewableHeat ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_RenewableTransport a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Renewable Transport"@en ;
    skos:definition "Vehicles powered by renewable electricity or portable carbon-neutral fuels."@en ;
    skos:broader tgs:PracticeCluster.OneEarth_EnergyTransition ;
    skos:relatedMatch tgs:InterventionSubdomain.TransportationAndLogistics, tgs:InterventionSubdomain.EnergySystems ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_GreenHydrogenFuel a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Green Hydrogen Fuel"@en ;
    skos:definition "Renewably produced hydrogen used on demand in fuel cells."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_RenewableTransport ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_SustainableEFuel a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Sustainable E-fuel"@en ;
    skos:definition "Synthetic fuels made with renewable power for existing aircraft and ships."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_RenewableTransport ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_SustainableBiofuel a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Sustainable Biofuel"@en ;
    skos:definition "Liquid fuels from non-food sources such as algae and waste."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_RenewableTransport ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_ElectricTransport a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Electric Transport"@en ;
    skos:definition "Trains, buses, cars and bikes on renewable electricity."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_RenewableTransport ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_EnergyEfficiency a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Energy Efficiency"@en ;
    skos:definition "Reducing total energy demand through behavior and technology without lowering living standards."@en ;
    skos:broader tgs:PracticeCluster.OneEarth_EnergyTransition ;
    skos:relatedMatch tgs:InterventionSubdomain.EnergySystems, tgs:InterventionSubdomain.HousingAndBuiltEnvironment, tgs:Concept.JevonsParadox ;
    skos:scopeNote "Efficiency without a binding limit tends to raise total use (tgs:Concept.JevonsParadox, tgs:Concept.GeneralizedJevonsParadox); the pillar's 'without lowering living standards' assumes the rebound can be avoided."@en ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_BuiltEnvironment a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Built Environment"@en ;
    skos:definition "Buildings, cities and infrastructure designed to need less energy and materials."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_EnergyEfficiency ;
    skos:relatedMatch tgs:InterventionSubdomain.HousingAndBuiltEnvironment ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_TransportationEfficiency a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Transportation Efficiency"@en ;
    skos:definition "Shifting travel toward rail, buses, bikes and remote work."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_EnergyEfficiency ;
    skos:relatedMatch tgs:InterventionSubdomain.TransportationAndLogistics, tgs:Concept.JevonsParadox ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_TransmissionAndStorage a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Transmission and Storage"@en ;
    skos:definition "Smart grids, meters, demand response and batteries to cut losses."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_EnergyEfficiency ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_IndustriesAndServices a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Industries and Services"@en ;
    skos:definition "Upgrades that cut energy use and emissions in manufacturing."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_EnergyEfficiency ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeCluster.OneEarth_NatureConservation a thinkr:PracticeCluster, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:topConceptOf tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Nature Conservation"@en ;
    skos:definition "Protecting natural environments to reverse biodiversity loss and stabilize the climate, aiming to protect, restore and connect 50% of Earth's lands and oceans."@en ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_LandConservation a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Land Conservation"@en ;
    skos:definition "Long-term protection and Indigenous governance of land ecosystems across all biomes."@en ;
    skos:broader tgs:PracticeCluster.OneEarth_NatureConservation ;
    skos:relatedMatch tgs:InterventionSubdomain.ProtectingEcologicalGains, tgs:InterventionSubdomain.BiodiversityDefense ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_ProtectedLands a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Protected Lands"@en ;
    skos:definition "Areas already protected by governments, including IUCN categories and OECMs."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_LandConservation ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_RaritySites a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Rarity Sites"@en ;
    skos:definition "Unprotected areas with rare, threatened or range-restricted species needing immediate protection."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_LandConservation ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_LandHabitats a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Land Habitats"@en ;
    skos:definition "Unprotected land with plant and animal communities vital to healthy ecosystems."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_LandConservation ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_MammalAssemblages a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Mammal Assemblages"@en ;
    skos:definition "Unprotected landscapes where large mammals gather seasonally."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_LandConservation ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_IntactWilderness a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Intact Wilderness"@en ;
    skos:definition "Large, undisturbed, unprotected forests, shrublands and grasslands."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_LandConservation ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_ClimateRefugia a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Climate Refugia"@en ;
    skos:definition "Unprotected areas that store large amounts of carbon."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_LandConservation ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_IndigenousTenure a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Indigenous Tenure"@en ;
    skos:definition "Lands used by Indigenous Peoples or local communities and legally recognized."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_LandConservation ;
    skos:relatedMatch tgs:InterventionSubdomain.LandAndHousingReform ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_UrbanBiodiversity a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Urban Biodiversity"@en ;
    skos:definition "Restoring nature in cities: trees, microforests, pollinator meadows, river restoration."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_LandConservation ;
    skos:relatedMatch tgs:InterventionSubdomain.ReconnectionToPlace ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_OceanConservation a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Ocean Conservation"@en ;
    skos:definition "Long-term protection and sustainable management of marine areas and species."@en ;
    skos:broader tgs:PracticeCluster.OneEarth_NatureConservation ;
    skos:relatedMatch tgs:InterventionSubdomain.NonClimatePlanetaryBoundaries, tgs:InterventionSubdomain.ProtectingEcologicalGains ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_ProtectedSeas a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Protected Seas"@en ;
    skos:definition "Marine protected areas with official limits on human activity."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_OceanConservation ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_MarineHabitats a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Marine Habitats"@en ;
    skos:definition "Unprotected ocean areas with life vital to marine ecosystems."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_OceanConservation ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_SustainableFisheries a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Sustainable Fisheries"@en ;
    skos:definition "Fishing at rates that let stocks replenish naturally."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_OceanConservation ;
    skos:relatedMatch tgs:Concept.OstromDesignPrinciples ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_MarineCarbonSinks a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Marine Carbon Sinks"@en ;
    skos:definition "Ocean systems that absorb and store carbon dioxide."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_OceanConservation ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_EcosystemRestoration a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Ecosystem Restoration"@en ;
    skos:definition "Helping degraded ecosystems and their natural processes recover."@en ;
    skos:broader tgs:PracticeCluster.OneEarth_NatureConservation ;
    skos:relatedMatch tgs:InterventionSubdomain.SoilAndWaterRegeneration, tgs:InterventionSubdomain.BiodiversityDefense ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_Reforestation a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Reforestation"@en ;
    skos:definition "Planting native trees on damaged land."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_EcosystemRestoration ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_ForestRecovery a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Forest Recovery"@en ;
    skos:definition "Restoring logged or degraded forests by natural or assisted regeneration."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_EcosystemRestoration ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_SustainableForestry a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Sustainable Forestry"@en ;
    skos:definition "Selective logging instead of clear-cutting."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_EcosystemRestoration ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_GrasslandRestoration a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Grassland Restoration"@en ;
    skos:definition "Managing and planting native species to restore grasslands."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_EcosystemRestoration ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_WetlandRestoration a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Wetland Restoration"@en ;
    skos:definition "Restoring marshes, bogs, seagrass and kelp forests."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_EcosystemRestoration ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_MangroveRestoration a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Mangrove Restoration"@en ;
    skos:definition "Reviving coastal mangroves to store carbon and protect shorelines."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_EcosystemRestoration ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_CoastalRestoration a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Coastal Restoration"@en ;
    skos:definition "Rehabilitating coastal ecosystems, including bleached corals."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_EcosystemRestoration ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_SpeciesRewilding a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Species Rewilding"@en ;
    skos:definition "Reintroducing animals to habitats they were removed from."@en ;
    skos:broader tgs:PracticeTerm.OneEarth_EcosystemRestoration ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    .

tgs:PracticeTerm.OneEarth_WildlifeConnectivity a thinkr:PracticeTerm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthSolutions ;
    skos:prefLabel "Wildlife Connectivity"@en ;
    skos:definition "Ecological corridors that let species move between habitats."@en ;
    skos:broader tgs:PracticeCluster.OneEarth_NatureConservation ;
