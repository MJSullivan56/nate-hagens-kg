@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tgs: <http://example.org/tgs#> .
@prefix thinkr: <http://example.org/thinkr#> .

tgs: a owl:Ontology ;
    rdfs:comment "Imports tgs-core for Protege compatibility — editing this file alone will resolve thinkr: classes/properties via the catalog file."@en ;
    owl:imports thinkr: .

tgs:LinkNote.CircleOfTrustLocalism_ElinorOstrom a thinkr:LinkNote,
        owl:NamedIndividual ;
    thinkr:aboutObject tgs:Persona.ElinorOstrom ;
    thinkr:aboutSubject tgs:Concept.CircleOfTrustLocalism ;
    thinkr:calculatedConfidence thinkr:ConfidenceType.Curated ;
    thinkr:hasEvidence tgs:Evidence.CircleOfTrustLocalism_ElinorOstrom .

