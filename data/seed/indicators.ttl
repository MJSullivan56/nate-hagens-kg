#############################################

tgs:Indicator.InternetAccess a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.ConnectivityAndTransportation ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025, tgs:Work.CaliforniaDoughnutIndicators2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.ConnectivityAndTransportation ;
    skos:prefLabel "Internet Access"@en ;
    skos:definition "Share of households with no internet subscription, or a cellphone plan only."@en ;
    thinkr:shortfallPercent "16.9"^^xsd:decimal ;
    thinkr:observedValue "16.9%" ;
    thinkr:thresholdValue "0%" ;
    thinkr:valueUnit "%" ;
    thinkr:thresholdBasis "Ambitious target of 0%."@en ;
    thinkr:measurementYear "2023" ;
    thinkr:dataPublicationYear "2024" ;
    thinkr:hasDataSource <https://data.census.gov/table?q=california%20without%20internet> ;
    thinkr:dataSourceCitation "1) U.S. Census Bureau. (n.d.). California households without internet access [Data table]." ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage shortfall below the social foundation. Earlier paraphrased definition: 'The percentage of households with reliable, high-speed broadband connections.' Value, threshold, years and sources from CalDEC's companion indicator sheet (tgs:Work.CaliforniaDoughnutIndicators2025), added 2026-10-23; the gap now uses the sheet's unrounded figure."@en .

tgs:Indicator.TransitReportCard a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.ConnectivityAndTransportation ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025, tgs:Work.CaliforniaDoughnutIndicators2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.ConnectivityAndTransportation ;
    skos:prefLabel "Transit Report Card"@en ;
    skos:definition "Report-card scores for vehicle miles traveled and transit access."@en ;
    thinkr:shortfallPercent "40.0"^^xsd:decimal ;
    thinkr:observedValue "6" ;
    thinkr:thresholdValue "10" ;
    thinkr:valueUnit "score out of 10" ;
    thinkr:thresholdBasis "A full score (10) on Transportation for America's Transit Report Card, using only its vehicle-miles-traveled and transit-access metrics; shortfall = 1 - score/10."@en ;
    thinkr:measurementYear "2021" ;
    thinkr:dataPublicationYear "2021" ;
    thinkr:hasDataSource <https://t4america.org/transit-report-card/> ;
    thinkr:dataSourceCitation "1) Transportation for America. (n.d.). Transit report card." ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage shortfall below the social foundation. Earlier paraphrased definition: 'A qualitative and structural evaluation of public transportation efficiency, coverage, and scheduling.' Value, threshold, years and sources from CalDEC's companion indicator sheet (tgs:Work.CaliforniaDoughnutIndicators2025), added 2026-10-23; the gap now uses the sheet's unrounded figure."@en .

#############################################
# Housing
#############################################

tgs:Indicator.Homelessness a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.Housing ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025, tgs:Work.CaliforniaDoughnutIndicators2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.Housing ;
    skos:prefLabel "Homelessness"@en ;
    skos:definition "Point-in-time count of unhoused people, scaled to a shortfall."@en ;
    thinkr:shortfallPercent "35.9"^^xsd:decimal ;
    thinkr:observedValue "187,084 of 39,431,263 = 0.47%" ;
    thinkr:thresholdValue "0%" ;
    thinkr:valueUnit "people (share of population)" ;
    thinkr:thresholdBasis "0% of the population unhoused, on a scale where 100% shortfall is the highest credible OECD rate, Northern Ireland's 1.32% of population (OECD Family Database, HC3.1)."@en ;
    thinkr:measurementYear "2024" ;
    thinkr:dataPublicationYear "2024" ;
    thinkr:hasDataSource <https://files.hudexchange.info/reports/published/CoC_PopSub_State_CA_2024.pdf> ;
    thinkr:hasThresholdSource <https://www.oecd.org/els/family/HC3-1-Population-experiencing-homelessness.pdf> ;
    thinkr:dataSourceCitation "1) U.S. Department of Housing and Urban Development. (2024). Continuum of care homeless populations and subpopulations report: California 2024. 2) Target: OECD. (n.d.). HC3.1: Population experiencing homelessness. OECD Family Database." ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage shortfall below the social foundation. Earlier paraphrased definition: 'The per-capita rate of individuals experiencing unhoused or transient living situations.' Value, threshold, years and sources from CalDEC's companion indicator sheet (tgs:Work.CaliforniaDoughnutIndicators2025), added 2026-10-23; the gap now uses the sheet's unrounded figure. CalDEC's README cites 0.87% and 0.46% in its worked example (giving about 34.85%); the indicator sheet uses 0.47% (187,084 of 39,431,263 in 2024), giving 35.9%, used here; the report rounds to 36%."@en .

tgs:Indicator.HousingBurden a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.Housing ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025, tgs:Work.CaliforniaDoughnutIndicators2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.Housing ;
    skos:prefLabel "Housing Burden"@en ;
    skos:definition "Share of renters paying more than 30% of income on housing."@en ;
    thinkr:shortfallPercent "55.0"^^xsd:decimal ;
    thinkr:observedValue "55%" ;
    thinkr:thresholdValue "0%" ;
    thinkr:valueUnit "%" ;
    thinkr:thresholdBasis "Ambitious target of 0%."@en ;
    thinkr:measurementYear "2018" ;
    thinkr:dataPublicationYear "2020?" ;
    thinkr:hasDataSource <https://www.ppic.org/interactive/californians-and-the-housing-crisis/> ;
    thinkr:dataSourceCitation "1) Public Policy Institute of California. (n.d.). Californians and the housing crisis [Interactive data]." ;
    skos:altLabel "Housing Cost Burden"@en ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage shortfall below the social foundation. Earlier paraphrased definition: 'The proportion of households spending more than 30% to 50% of their gross income on rent or mortgage payments.' Value, threshold, years and sources from CalDEC's companion indicator sheet (tgs:Work.CaliforniaDoughnutIndicators2025), added 2026-10-23; the gap now uses the sheet's unrounded figure."@en .

#############################################
# Equity
#############################################

tgs:Indicator.GenderPayGap a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.Equity ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025, tgs:Work.CaliforniaDoughnutIndicators2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.Equity ;
    skos:prefLabel "Gender Pay Gap"@en ;
    skos:definition "Percentage difference in median full-time wages between women and men."@en ;
    thinkr:shortfallPercent "12.9"^^xsd:decimal ;
    thinkr:observedValue "87.1%" ;
    thinkr:thresholdValue "100%" ;
    thinkr:valueUnit "%" ;
    thinkr:thresholdBasis "Pay parity: women earn 100% of men's median wage for full-time, year-round work."@en ;
    thinkr:measurementYear "2023" ;
    thinkr:dataPublicationYear "2023" ;
    thinkr:hasDataSource <https://www.census.gov/library/stories/2022/03/what-is-the-gender-wage-gap-in-your-state.html> ;
    thinkr:dataSourceCitation "1) U.S. Census Bureau. (2023). What is the gender wage gap in your state?" ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage shortfall below the social foundation. Earlier paraphrased definition: 'The statistical difference in median earnings between men and women performing comparable work.' Value, threshold, years and sources from CalDEC's companion indicator sheet (tgs:Work.CaliforniaDoughnutIndicators2025), added 2026-10-23; the gap now uses the sheet's unrounded figure."@en .

tgs:Indicator.RacialEquityIndex a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.Equity ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025, tgs:Work.CaliforniaDoughnutIndicators2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.Equity ;
    skos:prefLabel "Racial Equity Index"@en ;
    skos:definition "Inclusion score on racial gaps in economic vitality, readiness and connectedness."@en ;
    thinkr:shortfallPercent "40.0"^^xsd:decimal ;
    thinkr:observedValue "60" ;
    thinkr:thresholdValue "100" ;
    thinkr:valueUnit "inclusion score out of 100" ;
    thinkr:thresholdBasis "A perfect inclusion score (100) on PolicyLink and the USC Equity Research Institute's Racial Equity Index; only the inclusion score is used, since the doughnut's other indicators cover absolute performance."@en ;
    thinkr:measurementYear "2023" ;
    thinkr:dataPublicationYear "2024" ;
    thinkr:hasDataSource <https://nationalequityatlas.org/research/racial_equity_index/index> ;
    thinkr:dataSourceCitation "1) PolicyLink & USC Equity Research Institute. (2024). Racial Equity Index: Summary. National Equity Atlas." ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage shortfall below the social foundation. Earlier paraphrased definition: 'A multi-factor metric tracking institutional disparities in wealth, justice, and health across racial groups.' Value, threshold, years and sources from CalDEC's companion indicator sheet (tgs:Work.CaliforniaDoughnutIndicators2025), added 2026-10-23; the gap now uses the sheet's unrounded figure."@en .

#############################################
# Social Cohesion
#############################################

tgs:Indicator.IncomeInequality a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.SocialCohesion ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025, tgs:Work.CaliforniaDoughnutIndicators2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.SocialCohesion ;
    skos:prefLabel "Income Inequality"@en ;
    skos:definition "Share of people living in counties with a Gini index above 0.30."@en ;
    thinkr:shortfallPercent "100.0"^^xsd:decimal ;
    thinkr:observedValue "0%" ;
    thinkr:thresholdValue "100%" ;
    thinkr:valueUnit "%" ;
    thinkr:thresholdBasis "Everyone lives in a county with a Gini index below 0.30, the threshold used by Fanning et al. (2022), The social shortfall and ecological overshoot of nations."@en ;
    thinkr:measurementYear "2023" ;
    thinkr:dataPublicationYear "2023" ;
    thinkr:hasDataSource <https://data.census.gov/table/ACSDT5Y2023.B19083?q=gini+in+california+counties> ;
    thinkr:hasThresholdSource <https://static-content.springer.com/esm/art%3A10.1038%2Fs41893-021-00799-z/MediaObjects/41893_2021_799_MOESM1_ESM.pdf> ;
    thinkr:dataSourceCitation "1) U.S. Census Bureau, U.S. Department of Commerce. (n.d.). Gini Index of Income Inequality, American Community Survey, ACS 5-Year Estimates Detailed Tables, Table B19083. 2) Target: Fanning, A., et al. (2022). The social shortfall and ecological overshoot of nations. Nat Sustain 5, 26–36 (2022). https://doi.org/10.1038/s41893-021-00799-z - Supplementary information 2.10." ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage shortfall below the social foundation. Earlier paraphrased definition: 'The structural gap in distribution between the highest and lowest economic earning brackets (e.g. Gini Coefficient).' Value, threshold, years and sources from CalDEC's companion indicator sheet (tgs:Work.CaliforniaDoughnutIndicators2025), added 2026-10-23; the gap now uses the sheet's unrounded figure."@en .

tgs:Indicator.ReportNotHappy a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.SocialCohesion ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025, tgs:Work.CaliforniaDoughnutIndicators2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.SocialCohesion ;
    skos:prefLabel "Report Not Happy"@en ;
    skos:definition "Share of people reporting they are 'not too happy'."@en ;
    thinkr:shortfallPercent "26.0"^^xsd:decimal ;
    thinkr:observedValue "26%" ;
    thinkr:thresholdValue "0%" ;
    thinkr:valueUnit "%" ;
    thinkr:thresholdBasis "Ambitious target of 0%."@en ;
    thinkr:measurementYear "2023" ;
    thinkr:dataPublicationYear "2024" ;
    thinkr:hasDataSource <https://www.ppic.org/publication/ppic-statewide-survey-californians-and-their-government-september-2023/> ;
    thinkr:dataSourceCitation "1) Baldassare, M., et al. (2023). PPIC Statewide Survey: Californians and Their Government. Public Policy Institute of California." ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage shortfall below the social foundation. Earlier paraphrased definition: 'The percentage of surveyed residents reporting low baseline life satisfaction or chronic emotional distress.' Value, threshold, years and sources from CalDEC's companion indicator sheet (tgs:Work.CaliforniaDoughnutIndicators2025), added 2026-10-23; the gap now uses the sheet's unrounded figure."@en .

#############################################
# Food
#############################################

tgs:Indicator.FoodInsecurity a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.Food ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025, tgs:Work.CaliforniaDoughnutIndicators2025 ;
