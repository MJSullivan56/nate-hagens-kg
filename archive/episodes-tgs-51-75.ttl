tgs:Interview.TGS_64_AndrewMillison a thinkr:Episode, owl:NamedIndividual ;
    thinkr:createdDate "2026-09-04"^^xsd:date ;
    thinkr:updatedDate "2026-09-04"^^xsd:date ;
    thinkr:hasEpisodeType thinkr:EpisodeType.Interview ;
    thinkr:hasEpisodeSegment tgs:EpisodeSegment.MainShow ;
    skos:prefLabel "Andrew Millison: \"Geomorphology, Permaculture, and The Good Work\""@en ;
    skos:definition "Nate's real, direct first conversation with Andrew Millison, Oregon State University's permaculture education director, framed explicitly as a deliberate shift toward covering real, practical responses rather than only the constraints driving toward a Great Simplification. Millison directly explains permaculture as a design system working with existing land and water flows rather than against them, offering real, visible, near-term improvements in food, water, and social capital."@en ;
    dct:created "2023-03-13"^^xsd:date ;
    dct:issued "2023-03-29"^^xsd:date ;
    dct:subject tgs:Subject.HumanBehavior, tgs:Subject.EconomicsAndMonetary ;
    thinkr:hasHost tgs:Persona.NateHagens ;
