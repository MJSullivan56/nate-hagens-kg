thinkr:ConfidenceType.Corroborated a thinkr:ConfidenceType,
        owl:NamedIndividual ;
    skos:definition "LinkNote-only (calculatedConfidence): two or more INDEPENDENT (different thinkr:Source individuals) Curated+Supports evidence from Reputable-or-better sources. Unverified-tier support cannot contribute toward this tier no matter how many pieces accumulate."@en ;
    skos:prefLabel "Corroborated"@en .

thinkr:ConfidenceType.Disputed a thinkr:ConfidenceType,
        owl:NamedIndividual ;
    skos:definition "LinkNote-only (calculatedConfidence): at least one Curated+Contests evidence from a Reputable-or-better source exists. This OVERRIDES Corroborated regardless of how much supporting evidence also exists — a serious rebuttal should surface for human attention, not get mathematically outvoted."@en ;
    skos:prefLabel "Disputed"@en .

thinkr:EarthSystemComponent a owl:Class ;
    rdfs:comment "A real, macro-scale, physical component of Earth's climate/ecological system (e.g. the AMOC, an ice sheet, a major biome), discussed within Hagens' TGS framework — he cites it as evidence, typically via expert guests who study it directly, rather than originating or reframing the idea himself. FOLDED under thinkr:Concept 2026-08-13 (was initially built as a fully separate sibling class the same day) — per MJSullivan's explicit direction, once thinkr:Concept itself was revised into an explicit umbrella (see thinkr:Concept's own rdfs:comment and the new thinkr:HagensConcept subclass). Deliberately NOT a thinkr:HagensConcept — AMOC and its siblings are exactly the kind of externally-originated, adopted-not-authored content that subclass exists to exclude."@en ;
    rdfs:subClassOf thinkr:Concept ;
    skos:prefLabel "Earth System Component"@en .

thinkr:NamedEntityType a owl:Class ;
    rdfs:comment "ABSTRACT top-level category class — restructured 2026-07-11 per MJSullivan: each thinkr:NamedEntity subclass gets its OWN more specific categorization as a subclass of this one (e.g. thinkr:PersonEntityType for thinkr:Human), rather than one flat enumeration shared across every subclass. Mirrors the class hierarchy: thinkr:NamedEntity -> thinkr:Human is paralleled by thinkr:NamedEntityType -> thinkr:PersonEntityType. A future Organization subclass would get its own thinkr:OrganizationEntityType sibling, not reuse Person's categories."@en ;
    skos:prefLabel "Named Entity Type"@en .

thinkr:PolarityType.Contests a thinkr:PolarityType,
        owl:NamedIndividual ;
    skos:prefLabel "Contests"@en .

thinkr:PolarityType.Mentions a thinkr:PolarityType,
        owl:NamedIndividual ;
    skos:definition "Cites/discusses the claim without clearly arguing a position either way. Stored for context, never affects calculatedConfidence."@en ;
    skos:prefLabel "Mentions"@en .

