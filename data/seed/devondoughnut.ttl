@prefix thinkr: <http://example.org/thinkr#> .
@prefix tgs: <http://example.org/tgs#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

#############################################
# ADDED 2026-10-21 -- the Devon Doughnut (tgs:ConceptScheme.DevonDoughnut), at
# MJSullivan's request, approved from review sheets 1 and 6b. The 22 domains
# of the Bioregional Learning Centre's Devon Doughnut (2021), a doughnut
# drawn for a bioregion rather than a nation or city: 10 ecological-ceiling
# domains (5 'human action', 5 'condition') and 12 social-foundation domains.
# LICENSING: the source compilation is CC BY-NC-SA 4.0 and marked not for
# reuse elsewhere, so this file carries only domain names, Devon's one-word
# framing for each, and Claude's own paraphrased definitions, with a link
# back to devondoughnut.org. No indicator, measure or pathway text is copied.
# Each domain links to the intervention subdomain(s) it belongs to by
# skos:relatedMatch, which is how it reaches a front in the WWNS matrix.
#############################################

thinkr:DevonDoughnutDomain a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:comment "One of the domains of the Devon Doughnut, a bioregional doughnut for South Devon, UK, or one of its grouping nodes (the two halves and the two ecological-ceiling subgroups). Kept separate from thinkr:IndicatorCategory, which models the California Doughnut's 21 categories."@en ;
    skos:prefLabel "Devon Doughnut Domain"@en .

tgs:ConceptScheme.DevonDoughnut a skos:ConceptScheme, owl:NamedIndividual ;
    skos:prefLabel "Devon Doughnut"@en ;
    skos:definition "The Devon Doughnut's 22 domains: Doughnut Economics drawn for a bioregion (South Devon, UK) by the Bioregional Learning Centre, with measures for both citizens and policy makers and example pathways for action in every domain."@en ;
    dcterms:source tgs:Work.DevonDoughnutIndicatorCompilation ;
    dcterms:creator tgs:Organization.BioregionalLearningCentreSouthDevon ;
    dcterms:relation tgs:Initiative.DevonDoughnutProject, tgs:Work.BioregionalCarryingCapacitySessions ;
    rdfs:seeAlso <https://www.devondoughnut.org> ;
    skos:hasTopConcept tgs:DevonDoughnutDomain.EcologicalCeiling, tgs:DevonDoughnutDomain.SocialFoundation ;
    skos:scopeNote "Bill Baue (r3.0) frames a bioregional doughnut as bioregional carrying capacity: the outer ring sets ecological thresholds, the inner ring social ones, and the bioregion is the reference community for allocating fair shares of each (tgs:Concept.ContextBasedSustainability, tgs:Concept.CarryingCapacity). The Devon Doughnut was presented in r3.0's Bioregional Carrying Capacity series, Session 5 (14 April 2025)."@en ;
    .

tgs:DevonDoughnutDomain.EcologicalCeiling a thinkr:DevonDoughnutDomain, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.DevonDoughnut ;
    skos:topConceptOf tgs:ConceptScheme.DevonDoughnut ;
    skos:prefLabel "Ecological Ceiling (Devon)"@en ;
    skos:definition "The Devon Doughnut's outer ring, split into domains of human action (pressures people can change) and domains of condition (the state of Devon's land, water and life)."@en ;
    skos:closeMatch tgs:DoughnutHalf.EcologicalCeiling ;
    dcterms:source tgs:Work.DevonDoughnutIndicatorCompilation ;
    .

tgs:DevonDoughnutDomain.EcologicalCeiling_HumanAction a thinkr:DevonDoughnutDomain, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.DevonDoughnut ;
    skos:broader tgs:DevonDoughnutDomain.EcologicalCeiling ;
    skos:prefLabel "Human Action (Devon ecological ceiling)"@en ;
    skos:definition "Grouping node: the five ceiling domains measured by commitments and behaviour that put pressure on the living world."@en ;
    dcterms:source tgs:Work.DevonDoughnutIndicatorCompilation ;
    .

tgs:DevonDoughnutDomain.EcologicalCeiling_Condition a thinkr:DevonDoughnutDomain, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.DevonDoughnut ;
    skos:broader tgs:DevonDoughnutDomain.EcologicalCeiling ;
    skos:prefLabel "Condition (Devon ecological ceiling)"@en ;
    skos:definition "Grouping node: the five ceiling domains measured by the health of Devon's coast, rivers, habitats, soil and wildlife."@en ;
    dcterms:source tgs:Work.DevonDoughnutIndicatorCompilation ;
    .

tgs:DevonDoughnutDomain.SocialFoundation a thinkr:DevonDoughnutDomain, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.DevonDoughnut ;
    skos:topConceptOf tgs:ConceptScheme.DevonDoughnut ;
    skos:prefLabel "Social Foundation (Devon)"@en ;
    skos:definition "The Devon Doughnut's inner ring: twelve domains of human wellbeing."@en ;
    skos:closeMatch tgs:DoughnutHalf.SocialFoundation ;
    dcterms:source tgs:Work.DevonDoughnutIndicatorCompilation ;
    .

tgs:DevonDoughnutDomain.GreenhouseGasEmissions a thinkr:DevonDoughnutDomain, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.DevonDoughnut ;
    skos:broader tgs:DevonDoughnutDomain.EcologicalCeiling_HumanAction ;
    skos:prefLabel "Greenhouse Gas Emissions"@en ;
    skos:definition "How widely Devon sectors, groups and individuals have committed to reaching net-zero emissions; tracked through low-carbon travel choices and published net-zero plans."@en ;
    skos:note "Devon's one-word framing for this domain: 'Shifting the culture'."@en ;
    skos:relatedMatch tgs:InterventionSubdomain.EnergySystems, tgs:InterventionSubdomain.TransportationAndLogistics, tgs:InterventionSubdomain.FinanceAndCreditRedesign, tgs:IndicatorCategory.OzoneDepletion, tgs:PracticeTerm.PoliticalAdvocacy, tgs:PracticeTerm.RenewableEnergy ;
    dcterms:source tgs:Work.DevonDoughnutIndicatorCompilation ;
    skos:scopeNote "Subdomain links approved from review sheet 6b, with review strength: Energy Systems (firm); Transportation and Logistics (probable); Finance and Credit Redesign (possible). California Doughnut categories (sheet 2): Climate Change (closeMatch, firm); Ozone Depletion (relatedMatch, possible). Bioregioning Earth and One Earth practices (sheet 3): Renewable Energy (possible); Political Advocacy (probable)."@en ;
    skos:closeMatch tgs:IndicatorCategory.ClimateChange ;
    .

tgs:DevonDoughnutDomain.PlasticPollution a thinkr:DevonDoughnutDomain, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.DevonDoughnut ;
    skos:broader tgs:DevonDoughnutDomain.EcologicalCeiling_HumanAction ;
    skos:prefLabel "Plastic Pollution"@en ;
    skos:definition "Commitment across Devon to cutting plastic pollution, from teaching the 5 Rs in schools to shops dropping single-use plastics."@en ;
    skos:note "Devon's one-word framing for this domain: 'Rejecting'."@en ;
    skos:relatedMatch tgs:InterventionSubdomain.PlasticAndChemicalHazards, tgs:IndicatorCategory.ChemicalPollution, tgs:PracticeTerm.LearningPrograms ;
    dcterms:source tgs:Work.DevonDoughnutIndicatorCompilation ;
    skos:scopeNote "Subdomain links approved from review sheet 6b, with review strength: Plastic and Chemical Hazards (firm). California Doughnut categories (sheet 2): Chemical Pollution (relatedMatch, probable). Bioregioning Earth and One Earth practices (sheet 3): Learning Programs (possible)."@en ;
    .

tgs:DevonDoughnutDomain.LandUse a thinkr:DevonDoughnutDomain, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.DevonDoughnut ;
    skos:broader tgs:DevonDoughnutDomain.EcologicalCeiling_HumanAction ;
    skos:prefLabel "Land Use"@en ;
    skos:definition "Commitment to managing land for nature: keeping ground permeable, limiting farmland loss to development, and clustering woodland for connected ecosystems."@en ;
    skos:note "Devon's one-word framing for this domain: 'Diversifying'."@en ;
    skos:relatedMatch tgs:InterventionSubdomain.LandAndHousingReform, tgs:InterventionSubdomain.BiodiversityDefense, tgs:InterventionSubdomain.SubsidiarityAndLocalGovernance, tgs:PracticeTerm.HabitatConnectivity, tgs:PracticeTerm.RegenerativeAgriculture, tgs:PracticeTerm.TerritorialZoning ;
    dcterms:source tgs:Work.DevonDoughnutIndicatorCompilation ;
    skos:scopeNote "Subdomain links approved from review sheet 6b, with review strength: Land and Housing Reform (probable); Biodiversity Defense and Corridor Creation (probable); Subsidiarity and Local Governance Capacity (possible). California Doughnut categories (sheet 2): Land-Use Change (closeMatch, firm). Bioregioning Earth and One Earth practices (sheet 3): Territorial Zoning (probable); Habitat Connectivity (probable); Regenerative Agriculture (possible)."@en ;
    skos:closeMatch tgs:IndicatorCategory.LandUseChange ;
    .

tgs:DevonDoughnutDomain.Waste a thinkr:DevonDoughnutDomain, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.DevonDoughnut ;
    skos:broader tgs:DevonDoughnutDomain.EcologicalCeiling_HumanAction ;
    skos:prefLabel "Waste"@en ;
    skos:definition "Commitment to tackling waste, especially composting organics back to the land and reducing household waste sent to landfill or incineration."@en ;
    skos:note "Devon's one-word framing for this domain: 'Interrupting the cycle of harm'."@en ;
    skos:relatedMatch tgs:InterventionSubdomain.SoilAndWaterRegeneration, tgs:InterventionSubdomain.PlasticAndChemicalHazards, tgs:IndicatorCategory.ChemicalPollution, tgs:PracticeTerm.OneEarth_Composting, tgs:PracticeTerm.OneEarth_FoodWasteReduction ;
    dcterms:source tgs:Work.DevonDoughnutIndicatorCompilation ;
    skos:scopeNote "Subdomain links approved from review sheet 6b, with review strength: Soil, Land, and Water Regeneration (probable); Plastic and Chemical Hazards (possible). California Doughnut categories (sheet 2): Chemical Pollution (relatedMatch, probable). Bioregioning Earth and One Earth practices (sheet 3): Composting (firm); Food Waste Reduction (probable)."@en ;
    .

tgs:DevonDoughnutDomain.AirQuality a thinkr:DevonDoughnutDomain, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.DevonDoughnut ;
    skos:broader tgs:DevonDoughnutDomain.EcologicalCeiling_HumanAction ;
    skos:prefLabel "Air Quality"@en ;
    skos:definition "Commitment to cleaner air, chiefly by shifting car journeys to public transport and making pollution readings publicly visible."@en ;
    skos:note "Devon's one-word framing for this domain: 'Making it visible'."@en ;
    skos:relatedMatch tgs:InterventionSubdomain.TransportationAndLogistics, tgs:InterventionSubdomain.NonClimatePlanetaryBoundaries, tgs:IndicatorCategory.ConnectivityAndTransportation, tgs:PracticeTerm.EcologicalMonitoring, tgs:PracticeTerm.OneEarth_ElectricTransport, tgs:PracticeTerm.TransportationTransitions ;
    dcterms:source tgs:Work.DevonDoughnutIndicatorCompilation ;
    skos:scopeNote "Subdomain links approved from review sheet 6b, with review strength: Transportation and Logistics (firm); Non-Climate Planetary Boundaries (probable). California Doughnut categories (sheet 2): Air Pollution (closeMatch, firm); Connectivity & Transportation (relatedMatch, possible). Bioregioning Earth and One Earth practices (sheet 3): Transportation Transitions (firm); Electric Transport (probable); Ecological Monitoring (probable)."@en ;
    skos:closeMatch tgs:IndicatorCategory.AirPollution ;
    .

tgs:DevonDoughnutDomain.CoastAndMarineHealth a thinkr:DevonDoughnutDomain, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.DevonDoughnut ;
    skos:broader tgs:DevonDoughnutDomain.EcologicalCeiling_Condition ;
    skos:prefLabel "Coast & Marine Health"@en ;
    skos:definition "Share of Devon seabed managed for ecosystem health, biodiversity and local fishing livelihoods, including protected no-fishing areas and community-supported fisheries."@en ;
    skos:note "Devon's one-word framing for this domain: 'Protecting'."@en ;
    skos:relatedMatch tgs:InterventionSubdomain.BiodiversityDefense, tgs:InterventionSubdomain.FoodAndWaterSystems, tgs:IndicatorCategory.BiodiversityLoss, tgs:IndicatorCategory.OceanAcidification, tgs:PracticeTerm.CitizenOrCommunityScience, tgs:PracticeTerm.OneEarth_MarineHabitats, tgs:PracticeTerm.OneEarth_OceanConservation, tgs:PracticeTerm.OneEarth_SustainableFisheries ;
    dcterms:source tgs:Work.DevonDoughnutIndicatorCompilation ;
    skos:scopeNote "Subdomain links approved from review sheet 6b, with review strength: Biodiversity Defense and Corridor Creation (firm); Food and Water Systems (probable). California Doughnut categories (sheet 2): Ocean Acidification (relatedMatch, probable); Biodiversity Loss (relatedMatch, possible). Bioregioning Earth and One Earth practices (sheet 3): Sustainable Fisheries (firm); Marine Habitats (firm); Ocean Conservation (probable); Citizen or Community Science (probable)."@en ;
    .

tgs:DevonDoughnutDomain.WaterbodyHealth a thinkr:DevonDoughnutDomain, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.DevonDoughnut ;
    skos:broader tgs:DevonDoughnutDomain.EcologicalCeiling_Condition ;
    skos:prefLabel "Waterbody Health"@en ;
    skos:definition "Share of Devon freshwater managed for health and biodiversity, with citizens monitoring rivers and polluters reporting incidents."@en ;
    skos:note "Devon's one-word framing for this domain: 'Reporting'."@en ;
    skos:relatedMatch tgs:InterventionSubdomain.SoilAndWaterRegeneration, tgs:InterventionSubdomain.NonClimatePlanetaryBoundaries, tgs:IndicatorCategory.FreshwaterUse, tgs:IndicatorCategory.NitrogenAndPhosphorus, tgs:PracticeTerm.CitizenOrCommunityScience, tgs:PracticeTerm.EcologicalMonitoring, tgs:PracticeTerm.WatershedRepair ;
    dcterms:source tgs:Work.DevonDoughnutIndicatorCompilation ;
    skos:scopeNote "Subdomain links approved from review sheet 6b, with review strength: Soil, Land, and Water Regeneration (firm); Non-Climate Planetary Boundaries (probable). California Doughnut categories (sheet 2): Freshwater Use (relatedMatch, probable); Nitrogen & Phosphorus (relatedMatch, probable). Bioregioning Earth and One Earth practices (sheet 3): Citizen or Community Science (firm); Watershed Repair (probable); Ecological Monitoring (probable)."@en ;
    .

tgs:DevonDoughnutDomain.HabitatHealth a thinkr:DevonDoughnutDomain, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.DevonDoughnut ;
    skos:broader tgs:DevonDoughnutDomain.EcologicalCeiling_Condition ;
    skos:prefLabel "Habitat Health"@en ;
    skos:definition "Share of land managed for habitat health, with hedgerows and verges managed as wildlife corridors joined into a recovery network."@en ;
    skos:note "Devon's one-word framing for this domain: 'Connecting up'."@en ;
    skos:relatedMatch tgs:InterventionSubdomain.BiodiversityDefense, tgs:IndicatorCategory.BiodiversityLoss, tgs:IndicatorCategory.LandUseChange, tgs:PracticeTerm.GeographicAndEcologicalMapping, tgs:PracticeTerm.HabitatConnectivity, tgs:PracticeTerm.VegetationPlanting ;
    dcterms:source tgs:Work.DevonDoughnutIndicatorCompilation ;
    skos:scopeNote "Subdomain links approved from review sheet 6b, with review strength: Biodiversity Defense and Corridor Creation (firm). California Doughnut categories (sheet 2): Biodiversity Loss (relatedMatch, probable); Land-Use Change (relatedMatch, possible). Bioregioning Earth and One Earth practices (sheet 3): Habitat Connectivity (firm); Geographic and Ecological Mapping (probable); Vegetation Planting (possible)."@en ;
    .

tgs:DevonDoughnutDomain.SoilHealth a thinkr:DevonDoughnutDomain, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.DevonDoughnut ;
    skos:broader tgs:DevonDoughnutDomain.EcologicalCeiling_Condition ;
    skos:prefLabel "Soil Health"@en ;
    skos:definition "Share of land managed for soil health; regenerative farming and school citizen-science measures of soil microorganisms."@en ;
    skos:note "Devon's one-word framing for this domain: 'Micro-organisms'."@en ;
    skos:relatedMatch tgs:InterventionSubdomain.SoilAndWaterRegeneration, tgs:InterventionSubdomain.PlasticAndChemicalHazards, tgs:IndicatorCategory.ChemicalPollution, tgs:IndicatorCategory.NitrogenAndPhosphorus, tgs:PracticeTerm.CitizenOrCommunityScience, tgs:PracticeTerm.OneEarth_SoilManagement, tgs:PracticeTerm.RegenerativeAgriculture ;
    dcterms:source tgs:Work.DevonDoughnutIndicatorCompilation ;
    skos:scopeNote "Subdomain links approved from review sheet 6b, with review strength: Soil, Land, and Water Regeneration (firm); Plastic and Chemical Hazards (probable). California Doughnut categories (sheet 2): Chemical Pollution (relatedMatch, possible); Nitrogen & Phosphorus (relatedMatch, possible). Bioregioning Earth and One Earth practices (sheet 3): Regenerative Agriculture (firm); Soil Management (firm); Citizen or Community Science (probable)."@en ;
    .

tgs:DevonDoughnutDomain.Biodiversity a thinkr:DevonDoughnutDomain, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.DevonDoughnut ;
    skos:broader tgs:DevonDoughnutDomain.EcologicalCeiling_Condition ;
    skos:prefLabel "Biodiversity"@en ;
    skos:definition "Share of land managed for biodiversity gain; chemical-free gardens, rewilded verges and field edges, and farmland managed for wildlife."@en ;
    skos:relatedMatch tgs:InterventionSubdomain.BiodiversityDefense, tgs:InterventionSubdomain.NonClimatePlanetaryBoundaries, tgs:PracticeTerm.CulturalAndSpiritualPractices, tgs:PracticeTerm.HabitatConnectivity, tgs:PracticeTerm.RegenerativeAgriculture ;
    dcterms:source tgs:Work.DevonDoughnutIndicatorCompilation ;
    skos:scopeNote "Subdomain links approved from review sheet 6b, with review strength: Biodiversity Defense and Corridor Creation (firm); Non-Climate Planetary Boundaries (probable). California Doughnut categories (sheet 2): Biodiversity Loss (closeMatch, firm). Bioregioning Earth and One Earth practices (sheet 3): Habitat Connectivity (probable); Regenerative Agriculture (probable); Cultural and Spiritual Practices (possible)."@en ;
    skos:closeMatch tgs:IndicatorCategory.BiodiversityLoss ;
    .

tgs:DevonDoughnutDomain.Water a thinkr:DevonDoughnutDomain, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.DevonDoughnut ;
    skos:broader tgs:DevonDoughnutDomain.SocialFoundation ;
    skos:prefLabel "Water"@en ;
    skos:definition "How easily residents can get information on Devon water quality and quantity; household metering and community water monitoring."@en ;
    skos:note "Devon's one-word framing for this domain: 'Understanding'."@en ;
    skos:relatedMatch tgs:InterventionSubdomain.FoodAndWaterSystems, tgs:InterventionSubdomain.TrustAndInformationCommons, tgs:PracticeTerm.CitizenOrCommunityScience, tgs:PracticeTerm.WaterManagement ;
    dcterms:source tgs:Work.DevonDoughnutIndicatorCompilation ;
    skos:scopeNote "Subdomain links approved from review sheet 6b, with review strength: Food and Water Systems (firm); Trust Rebuilding and the Information Commons (possible). California Doughnut categories (sheet 2): Water & Sanitation (closeMatch, probable). Bioregioning Earth and One Earth practices (sheet 3): Citizen or Community Science (firm); Water Management (probable)."@en ;
    skos:closeMatch tgs:IndicatorCategory.WaterAndSanitation ;
    .

tgs:DevonDoughnutDomain.Food a thinkr:DevonDoughnutDomain, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.DevonDoughnut ;
    skos:broader tgs:DevonDoughnutDomain.SocialFoundation ;
    skos:prefLabel "Food"@en ;
    skos:definition "How often producers and consumers in the region are directly connected; local sourcing by households, shops, schools and anchor institutions."@en ;
    skos:note "Devon's one-word framing for this domain: 'Re-connecting'."@en ;
    skos:relatedMatch tgs:InterventionSubdomain.FoodAndWaterSystems, tgs:InterventionSubdomain.LocalExchangeSystems, tgs:PracticeTerm.CommunityFoodAccess, tgs:PracticeTerm.RegionalSourcing, tgs:PracticeTerm.ValueChainDevelopment ;
    dcterms:source tgs:Work.DevonDoughnutIndicatorCompilation ;
    skos:scopeNote "Subdomain links approved from review sheet 6b, with review strength: Food and Water Systems (firm); Local and Regional Exchange Systems (probable). California Doughnut categories (sheet 2): Food (closeMatch, firm). Bioregioning Earth and One Earth practices (sheet 3): Regional Sourcing (firm); Community Food Access (probable); Value Chain Development (probable)."@en ;
    skos:closeMatch tgs:IndicatorCategory.Food ;
    .

tgs:DevonDoughnutDomain.AccessToNature a thinkr:DevonDoughnutDomain, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.DevonDoughnut ;
    skos:broader tgs:DevonDoughnutDomain.SocialFoundation ;
    skos:prefLabel "Access to Nature"@en ;
    skos:definition "How often people, especially young people, get guided time in nature, including nature prescribed for health."@en ;
    skos:note "Devon's one-word framing for this domain: 'Opening doors'."@en ;
    skos:relatedMatch tgs:InterventionSubdomain.ReconnectionToPlace, tgs:PracticeTerm.ImmersiveJourneys, tgs:PracticeTerm.LearningPrograms ;
    dcterms:source tgs:Work.DevonDoughnutIndicatorCompilation ;
    skos:scopeNote "Subdomain links approved from review sheet 6b, with review strength: Reconnection to Place and Ecology (firm). Bioregioning Earth and One Earth practices (sheet 3): Immersive Journeys (probable); Learning Programs (probable)."@en ;
    .

tgs:DevonDoughnutDomain.HealthAndWellbeing a thinkr:DevonDoughnutDomain, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.DevonDoughnut ;
    skos:broader tgs:DevonDoughnutDomain.SocialFoundation ;
    skos:prefLabel "Health & Wellbeing"@en ;
    skos:definition "Availability of open-ended, low-cost mental health support, including social prescribing (arts, sport, gardening)."@en ;
    skos:note "Devon's one-word framing for this domain: 'Responding'."@en ;
    skos:relatedMatch tgs:InterventionSubdomain.CareEconomy, tgs:InterventionSubdomain.MedicalSupplyChains, tgs:PracticeTerm.HealthAndSocialCare, tgs:PracticeTerm.StoryingPlace ;
    dcterms:source tgs:Work.DevonDoughnutIndicatorCompilation ;
    skos:scopeNote "Subdomain links approved from review sheet 6b, with review strength: The Care Economy (probable); Medical and Pharmaceutical Supply Chains (possible). California Doughnut categories (sheet 2): Health (closeMatch, firm). Bioregioning Earth and One Earth practices (sheet 3): Health and Social Care (firm); Storying Place (possible)."@en ;
    skos:closeMatch tgs:IndicatorCategory.Health ;
    .

tgs:DevonDoughnutDomain.Education a thinkr:DevonDoughnutDomain, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.DevonDoughnut ;
    skos:broader tgs:DevonDoughnutDomain.SocialFoundation ;
    skos:prefLabel "Education"@en ;
    skos:definition "Whether people feel equipped to tackle current problems; a more relevant, problem-solving curriculum."@en ;
    skos:note "Devon's one-word framing for this domain: 'Making it practical'."@en ;
    skos:relatedMatch tgs:InterventionSubdomain.EducationRedesign, tgs:PracticeTerm.LearningPrograms ;
    dcterms:source tgs:Work.DevonDoughnutIndicatorCompilation ;
    skos:scopeNote "Subdomain links approved from review sheet 6b, with review strength: Education Redesign (firm). California Doughnut categories (sheet 2): Education (closeMatch, firm). Bioregioning Earth and One Earth practices (sheet 3): Learning Programs (firm)."@en ;
    skos:closeMatch tgs:IndicatorCategory.Education ;
    .

tgs:DevonDoughnutDomain.IncomeAndWork a thinkr:DevonDoughnutDomain, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.DevonDoughnut ;
    skos:broader tgs:DevonDoughnutDomain.SocialFoundation ;
