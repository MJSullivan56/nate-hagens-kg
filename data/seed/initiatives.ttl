    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Wild cacao and wild pepper anchor the model—food and medicine—restoring degraded forest while standing up processing and trade."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.NativeTreeReforestationCampaign a thinkr:Initiative, owl:NamedIndividual ;
