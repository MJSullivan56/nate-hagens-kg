# Which earlier episode do later episodes point back to most often?
PREFIX thinkr: <http://example.org/thinkr#>
PREFIX tgs:    <http://example.org/tgs#>
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?ep ?title (COUNT(DISTINCT ?later) AS ?citedBy) WHERE {
  ?later a thinkr:Episode ; dct:references ?ep .
  ?ep a thinkr:Episode ; skos:prefLabel ?title .
  FILTER(?later != ?ep)
} GROUP BY ?ep ?title ORDER BY DESC(?citedBy) LIMIT 3
