    rdfs:subClassOf thinkr:Concept ;
    skos:prefLabel "Doughnut Category"@en .

thinkr:Evidence a owl:Class ;
    rdfs:comment "One individual piece of evidence for/against a thinkr:LinkNote's claim. Multiple Evidence individuals can attach to one LinkNote. Never deleted even when superseded (prov:wasRevisionOf) — the historical record of what was believed and why is preserved; superseded evidence is simply excluded from calculatedConfidence."@en ;
    skos:prefLabel "Evidence"@en .

tgs:EpisodeSegment.MainShow a thinkr:EpisodeSegment,
        owl:NamedIndividual ;
    skos:definition "The numbered interview/discussion feed — confirmed via the site's own /episode/ URL path, a separate numbering sequence from Frankly."@en ;
    skos:prefLabel "Main Show"@en .

tgs:EpisodeSegment.RealityRoundtable a thinkr:EpisodeSegment,
        owl:NamedIndividual ;
    skos:definition "The multi-guest panel-discussion segment — confirmed via the site's own /episode/reality-roundtable-N URL slug, an independently-numbered sequence from both the main show and Frankly."@en ;
    skos:prefLabel "Reality Roundtable"@en ;
    skos:scopeNote "ADDED 2026-08-13. IMPORTANT CORRECTION to this class's own original design assumption: Frankly vs. MainShow were cleanly distinguishable by URL PATH ALONE (/frankly-original/ vs /episode/). Reality Roundtable does NOT extend that pattern cleanly — it shares the SAME /episode/ path as MainShow, distinguished only by the URL SLUG containing 'reality-roundtable-N' rather than a guest name. Confirmed real, independently-numbered sequence (RR-2, RR-10, RR-14, RR-19, RR-20, RR-25, RR-26 all confirmed to exist via web search). This means the original 18 MainShow-tagged episodes from the earlier hasEpisodeSegment audit were NOT re-checked against this refined rule — they were all confirmed single-guest interviews by their own titles, making a hidden Reality Roundtable among them unlikely, but this was not exhaustively re-verified. Worth a real spot-check later, not assumed clean."@en .

tgs:Concept.Superorganism a thinkr:Concept,
        owl:NamedIndividual ;
    thinkr:echoesIdeaOf tgs:Persona.JoshFarley ;
    thinkr:influencedBy tgs:Persona.EOWilson ;
    dct:source <https://www.thegreatsimplification.com> ;
    dct:subject tgs:Subject.SystemsFrameworks ;
    skos:definition "Framing human civilization as a single self-organizing, energy-and-resource-consuming entity whose collective behavior is not simply the sum of individual human intentions — echoing biological superorganism concepts (ant colonies, etc.) applied to techno-industrial society."@en ;
    skos:prefLabel "The Superorganism"@en .

thinkr:EpisodeType.PanelDiscussion a thinkr:EpisodeType,
