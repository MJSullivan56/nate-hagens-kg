    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.LocalGovernanceInnovation a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Local Governance Innovation"@en ;
    thinkr:carriedOutBy tgs:Organization.ReVillageGreenValley ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GovernanceDesign, tgs:PracticeTerm.PoliticalAdvocacy ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.LegalStewardship ;
    dcterms:description "They partnered with the Graton Community Services District (sewer) to broaden its mandate toward parks, recreation, and eventually ecosystem services and recommoning."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ReVillageCoOpEnterprises a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "ReVillage Co-Op Enterprises"@en ;
    thinkr:carriedOutBy tgs:Organization.ReVillageGreenValley ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ValueChainDevelopment, tgs:PracticeTerm.VentureCultivation ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "They are breaking ground on a community-owned enterprise—a public house, marketplace, café, food hub, and small-business incubator—in a long-vacant historic firehouse (once a train station) facing the new town square."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ReVillagingToolkitAndLearningExchange a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "ReVillaging Toolkit and Learning Exchange"@en ;
    thinkr:carriedOutBy tgs:Organization.ReVillageGreenValley ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.LearningPrograms ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "ReVillage wants to help other places adapt this model. They are co-developing a “ReVillaging Toolkit”—legal templates, governance patterns, land strategies, and narrative resources."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.RiverDetectives a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "River Detectives"@en ;
    thinkr:carriedOutBy tgs:Organization.RiverErichtCatchmentRestorationInitiative ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CitizenOrCommunityScience, tgs:PracticeTerm.WatershedRepair ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.EcosystemRegeneration, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "River Detectives extends the community-science approach toward catchment care. From August 2023 to August 2024, residents researched historic management of rivers, bogs, and lochans—asking what past practices might teach present stewardship."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.EdgePrize a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Edge Prize"@en ;
    thinkr:carriedOutBy tgs:Organization.SalmonNation ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GrantsPrograms, tgs:PracticeTerm.VentureCultivation ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "An early experiment in funding the work of Ravens, the Edge Prize launched in 2023 as a distributed bioregional accelerator—a novel methodology for growing community through an online accelerator and prize challenge."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.MagicCanoe a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Magic Canoe"@en ;
    thinkr:carriedOutBy tgs:Organization.SalmonNation ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ArtAndStorytelling ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "From the Storytelling of Ravens gatherings emerged Magic Canoe, a nonprofit media and storytelling organization dedicated to amplifying the people, projects, and possibilities helping Salmon Nation thrive."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.SalmonBioculturalCreditProgram a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Salmon Biocultural Credit Program"@en ;
    thinkr:carriedOutBy tgs:Organization.SalmonNation ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ResultBasedMechanisms, tgs:PracticeTerm.TraditionalEcologicalKnowledge ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.SystemicFinance, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Salmon Returns is developing a Salmon Biocultural Credit program—a verified unit of ecological and cultural regeneration representing the restoration of salmon lifeways, habitats, and the relationships that sustain them."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.SalmonReturns a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Salmon Returns"@en ;
    thinkr:carriedOutBy tgs:Organization.SalmonNation ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.InvestmentVehicles, tgs:PracticeTerm.PortfolioDevelopment ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "Salmon Returns is a cross-border bioregional fund grounded in the migratory pathways of wild Pacific salmon, representing what founder Cheryl Chen calls a biocultural finance collaborative for regenerating place, culture, and economy."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.StorytellingOfRavens a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Storytelling of Ravens"@en ;
    thinkr:carriedOutBy tgs:Organization.SalmonNation ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CongressingAndEvents, tgs:PracticeTerm.NetworkWeaving ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "The Trust's first major initiative was Storytelling of Ravens, an in-person convening format that began in Sitka, Alaska in 2019."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.BioculturalHub a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Biocultural Hub"@en ;
    thinkr:carriedOutBy tgs:Organization.SinalDoVale ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CulturalHubOrLearningCenter, tgs:PracticeTerm.DemonstratorSite, tgs:PracticeTerm.VisitorExperiences ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.HubsAndCenters, tgs:PracticeCluster.ServicesAndInfrastructure ;
    dcterms:description "The site functions as a bioregional hub: a place where visitors, partners, and local actors meet, learn, and test ideas."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.CaminoDoGuarauEcoTourismTrail a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Camino do Guaraú Eco-Tourism Trail"@en ;
    thinkr:carriedOutBy tgs:Organization.SinalDoVale ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.HabitatConnectivity, tgs:PracticeTerm.ImmersiveJourneys, tgs:PracticeTerm.VisitorExperiences ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.EcosystemRegeneration, tgs:PracticeCluster.ServicesAndInfrastructure, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "The 110-kilometer trail starts not by coincidence at Sinal do Vale. By curating this officially recognized Camino do Guaraú, Sinal do Vale galvanized entrepreneurs, activists, change makers, and farmers to join the regeneration movement."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.MadreFrutasSocialEnterprise a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Madre Frutas Social Enterprise"@en ;
    thinkr:carriedOutBy tgs:Organization.SinalDoVale ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ValueChainDevelopment ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy ;
    dcterms:description "Madre Frutas is a women-led enterprise that turns abundant local jackfruit into marketable products."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.SINALFlowFund a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "SINAL Flow Fund"@en ;
    thinkr:carriedOutBy tgs:Organization.SinalDoVale ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GrantsPrograms, tgs:PracticeTerm.StructuringAndCapitalization ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "The SINAL Flow Fund is a locally managed funding mechanism designed to channel diverse capital streams— including public grants, donations, supply chain finance, and investment capital—toward regenerative initiatives in the region."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.TerraUmidaAgroforestryCorridor a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Terra Umida Agroforestry Corridor"@en ;
    thinkr:carriedOutBy tgs:Organization.SinalDoVale ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.RegenerativeAgriculture, tgs:PracticeTerm.ValueChainDevelopment ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy ;
    dcterms:description "Another 30 kilometers along the trail, hikers pass wide degraded farmlands called Terra Umida."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ValEstrelaHistoricAndCulturalEcotourismSite a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Val Estrela Historic and Cultural Ecotourism Site"@en ;
    thinkr:carriedOutBy tgs:Organization.SinalDoVale ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CulturalAndSpiritualPractices, tgs:PracticeTerm.VisitorExperiences, tgs:PracticeTerm.WatershedRepair ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.EcosystemRegeneration, tgs:PracticeCluster.ServicesAndInfrastructure, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "After about 20 kilometers through great landscapes, the trail arrives at Val Estrela—the port where one-third of the slaves arrived in Brazil."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.BioregionalMappingOfIndia a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Bioregional Mapping of India"@en ;
    thinkr:carriedOutBy tgs:Organization.SouthAsiaBioregionalismWorkingGroup ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GeographicAndEcologicalMapping ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.MappingAndIndicators ;
    dcterms:description "A major project set out to map bioregional boundaries across India. The team worked back from district lines imposed under British rule, layering other evidence."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.LearningFromPracticalExperiments a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Learning from Practical Experiments"@en ;
    thinkr:carriedOutBy tgs:Organization.SouthAsiaBioregionalismWorkingGroup ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.NetworkWeaving, tgs:PracticeTerm.PeerLearning ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Before leaning on abstract theory, they looked at what was already happening. One touchstone was a river parliament catalyzed by [[Tarun Bharat Sangh]], where roughly 60 to 70 villages in one river basin in Western India built institutions to govern the basin together."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.VisionFor2100 a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Vision for 2100"@en ;
    thinkr:carriedOutBy tgs:Organization.SouthAsiaBioregionalismWorkingGroup ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GovernanceDesign, tgs:PracticeTerm.NetworkWeaving, tgs:PracticeTerm.ParticipatoryStrategies ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "The working group is drafting a long-range biocultural vision: what South Asia might become by 2100."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.BusinessCoachingAndPrograms a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Business Coaching & Programs"@en ;
    thinkr:carriedOutBy tgs:Organization.SpruceRoot ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.LearningPrograms ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Lending is just one piece of a much larger vision. Spruce Root offers business coaching to stakeholders beyond their loan portfolio."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.PathToProsperity a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Path to Prosperity"@en ;
    thinkr:carriedOutBy tgs:Organization.SpruceRoot ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.LearningPrograms ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "One of Spruce Root's signature programs is Path to Prosperity, a business development competition that supports local businesses with positive social, economic, and ecological impact."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ResilienceCircles a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Resilience Circles"@en ;
    thinkr:carriedOutBy tgs:Organization.SpruceRoot ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.LearningPrograms, tgs:PracticeTerm.PeerLearning, tgs:PracticeTerm.TraditionalEcologicalKnowledge ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "With Jump/Scale, Spruce Root runs Alaska Native Resilience Circles—a year-long cohort for Indigenous entrepreneurs that treats business viability and personal and cultural well-being as one fabric."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.SeacoastTrust a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Seacoast Trust"@en ;
    thinkr:carriedOutBy tgs:Organization.SpruceRoot ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GrantsPrograms, tgs:PracticeTerm.InvestmentVehicles ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "Recognizing that the work of regeneration requires long-term, patient capital, Spruce Root became the fiscal sponsor of the Seacoast Trust—a permanent funding mechanism created to provide access to capital for Indigenous-led conservation projects that place local communities at the center of efforts to achieve a…"@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.SmallBusinessLending a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Small Business Lending"@en ;
    thinkr:carriedOutBy tgs:Organization.SpruceRoot ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.InvestmentVehicles, tgs:PracticeTerm.VentureCultivation ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "Spruce Root's approach to economic development starts with recognition: many entrepreneurs in Southeast Alaska don't have access to affordable capital through traditional financing channels."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.StrategicPlanning a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Strategic Planning"@en ;
    thinkr:carriedOutBy tgs:Organization.SpruceRoot ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ParticipatoryStrategies ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "In 2022, they finalized and took part in implementing a five-year strategic plan for the Sitka Tribe of Alaska and began facilitating an update of the comprehensive community plan for Yakutat in partnership with the local government."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.SustainableSoutheastPartnership a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Sustainable Southeast Partnership"@en ;
    thinkr:carriedOutBy tgs:Organization.SpruceRoot ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GovernanceBodies, tgs:PracticeTerm.NetworkWeaving ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "The Sustainable Southeast Partnership (SSP)—a Spruce Root and Sealaska program—works as a regional collective-impact network."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.CommunityLedGovernance a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Community-Led Governance"@en ;
    thinkr:carriedOutBy tgs:Organization.TarunBharatSangh ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CommonsGovernanceProtocols, tgs:PracticeTerm.GovernanceBodies ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "To counter government contracts for commercial fishing that risked overuse, habitat harm, and displacement, TBS helped communities create the River Arvari Sansad (River Arvari Parliament) in 1998."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.CulturalRevivalForEcologicalKinship a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Cultural Revival for Ecological Kinship"@en ;
    thinkr:carriedOutBy tgs:Organization.TarunBharatSangh ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CulturalAndSpiritualPractices ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "TBS wove ritual and symbol into daily responsibility for ecosystems. Drawing on Raksha Bandhan, where sisters tie threads on brothers’ wrists, villagers tied threads around trees to pledge protection."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.NationalAndInternationalAdvocacy a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "National and International Advocacy"@en ;
    thinkr:carriedOutBy tgs:Organization.TarunBharatSangh ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.NetworkWeaving, tgs:PracticeTerm.PoliticalAdvocacy ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.LegalStewardship ;
    dcterms:description "In 1989, TBS and village partners discussed how mining in the Aravallis—near Sariska—was undermining johads."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.WaterLiteracyAndEducation a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Water Literacy and Education"@en ;
    thinkr:carriedOutBy tgs:Organization.TarunBharatSangh ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.LearningPrograms, tgs:PracticeTerm.TraditionalEcologicalKnowledge ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "TBS ran trainings and workshops for farmers, youth, schoolchildren, and local officials—often through village heads—so communities could see how conservation linked to their own well-being and to the land’s productivity."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.WaterWarriors a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Water Warriors"@en ;
    thinkr:carriedOutBy tgs:Organization.TarunBharatSangh ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.LearningPrograms ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "TBS trained more than 10,000 Jal Yodhas (“Water Warriors”)—grassroots leaders, including women and youth— with technical and ecological skills to advance restoration locally."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.WatershedRestorationAndRiverRevival a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Watershed Restoration and River Revival"@en ;
    thinkr:carriedOutBy tgs:Organization.TarunBharatSangh ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.WaterManagement, tgs:PracticeTerm.WatershedRepair ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.EcosystemRegeneration ;
    dcterms:description "TBS works with communities to bring back water abundance, revive river watersheds, and support sustainable development."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:ConceptScheme.BioregioningEarth a skos:ConceptScheme, owl:NamedIndividual ;
    skos:prefLabel "Bioregioning Earth Ontology"@en ;
    skos:definition "Activity taxonomy of Bioregioning Earth: ten practice clusters and their 69 practice terms, used to tag on-the-ground initiatives. Mapped to the Six Fronts by skos:relatedMatch."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    dcterms:creator "Bioregioning Earth" ;
    skos:hasTopConcept
        tgs:PracticeCluster.AgroBioeconomy,
        tgs:PracticeCluster.AlternativeFinance,
        tgs:PracticeCluster.CommunityGovernance,
        tgs:PracticeCluster.EcosystemRegeneration,
        tgs:PracticeCluster.HubsAndCenters,
        tgs:PracticeCluster.LegalStewardship,
        tgs:PracticeCluster.MappingAndIndicators,
        tgs:PracticeCluster.ServicesAndInfrastructure,
        tgs:PracticeCluster.SystemicFinance,
        tgs:PracticeCluster.WaysOfKnowing ;
    .

# Cross-scheme mappings, Bioregioning Earth -> One Earth Solutions (added 2026-10-20; Claude's first-pass draft,
# accepted by MJSullivan for later enrichment). broadMatch: the One Earth term is broader; narrowMatch: narrower.
# Deliberately unmatched: Species Control, Interspecies Mutualism, Disaster Relief, Coaches and Leaders.
tgs:PracticeTerm.RenewableEnergy skos:closeMatch tgs:PracticeCluster.OneEarth_EnergyTransition .
tgs:PracticeTerm.TransportationTransitions skos:closeMatch tgs:PracticeTerm.OneEarth_RenewableTransport .
tgs:PracticeTerm.ConstructionAndHousing skos:closeMatch tgs:PracticeTerm.OneEarth_BuiltEnvironment .
tgs:PracticeTerm.RegenerativeAgriculture skos:closeMatch tgs:PracticeCluster.OneEarth_RegenerativeAgriculture .
tgs:PracticeTerm.RegenerativeGrazing skos:closeMatch tgs:PracticeTerm.OneEarth_SustainableGrazing .
tgs:PracticeTerm.RegionalSourcing skos:closeMatch tgs:PracticeTerm.OneEarth_BioregionalSourcing .
tgs:PracticeTerm.HabitatConnectivity skos:closeMatch tgs:PracticeTerm.OneEarth_WildlifeConnectivity .
tgs:PracticeTerm.ClothingAndProductManufacturing skos:narrowMatch tgs:PracticeTerm.OneEarth_CircularFibersheds .
tgs:PracticeTerm.WatershedRepair skos:narrowMatch tgs:PracticeTerm.OneEarth_WetlandRestoration .
tgs:PracticeTerm.WatershedRepair skos:narrowMatch tgs:PracticeTerm.OneEarth_RiversAndStreams .
tgs:PracticeTerm.VegetationPlanting skos:narrowMatch tgs:PracticeTerm.OneEarth_Reforestation .
tgs:PracticeTerm.SeedsAndNurseries skos:relatedMatch tgs:PracticeTerm.OneEarth_SeedDiversity .
tgs:PracticeTerm.MaterialsTransformation skos:relatedMatch tgs:PracticeTerm.OneEarth_RecycleAndReuse .
tgs:PracticeTerm.MaterialsTransformation skos:relatedMatch tgs:PracticeTerm.OneEarth_FoodUpcycling .
tgs:PracticeTerm.FarmerSupport skos:relatedMatch tgs:PracticeTerm.OneEarth_SmallholderFarming .
tgs:PracticeTerm.WaterManagement skos:relatedMatch tgs:PracticeTerm.OneEarth_WaterStewardship .
tgs:PracticeTerm.WaterManagement skos:relatedMatch tgs:PracticeTerm.OneEarth_DrylandIrrigation .
tgs:PracticeTerm.CollectiveOwnershipModels skos:relatedMatch tgs:PracticeTerm.OneEarth_IndigenousTenure .
tgs:PracticeTerm.TraditionalEcologicalKnowledge skos:relatedMatch tgs:PracticeTerm.OneEarth_IndigenousTenure .
tgs:PracticeTerm.HealthAndSocialCare skos:relatedMatch tgs:PracticeTerm.OneEarth_PublicHealth .
tgs:PracticeTerm.TrainingAndEmploymentPathways skos:relatedMatch tgs:PracticeTerm.OneEarth_SustainableLivelihoods .
tgs:PracticeTerm.GrantsPrograms skos:broadMatch tgs:PracticeTerm.OneEarth_FinanceAndIncentives .
tgs:PracticeTerm.InvestmentVehicles skos:broadMatch tgs:PracticeTerm.OneEarth_FinanceAndIncentives .
tgs:PracticeTerm.ResultBasedMechanisms skos:broadMatch tgs:PracticeTerm.OneEarth_FinanceAndIncentives .
tgs:PracticeTerm.StructuringAndCapitalization skos:broadMatch tgs:PracticeTerm.OneEarth_FinanceAndIncentives .
tgs:PracticeTerm.PortfolioDevelopment skos:broadMatch tgs:PracticeTerm.OneEarth_FinanceAndIncentives .
tgs:PracticeTerm.FinanceAssessments skos:broadMatch tgs:PracticeTerm.OneEarth_FinanceAndIncentives .
tgs:PracticeTerm.VentureCultivation skos:broadMatch tgs:PracticeTerm.OneEarth_FinanceAndIncentives .
tgs:PracticeTerm.RightsOfNature skos:broadMatch tgs:PracticeTerm.OneEarth_LegalEmpowerment .
tgs:PracticeTerm.AgreementsAndLegalInstruments skos:broadMatch tgs:PracticeTerm.OneEarth_LegalEmpowerment .
tgs:PracticeTerm.PoliticalAdvocacy skos:broadMatch tgs:PracticeTerm.OneEarth_PolicyAndGovernance .
tgs:PracticeTerm.CitizenOrCommunityScience skos:broadMatch tgs:PracticeTerm.OneEarth_ScienceAndIntelligence .
tgs:PracticeTerm.EcologicalMonitoring skos:broadMatch tgs:PracticeTerm.OneEarth_ScienceAndIntelligence .
tgs:PracticeTerm.FormalScientificProcess skos:broadMatch tgs:PracticeTerm.OneEarth_ScienceAndIntelligence .
tgs:PracticeTerm.LearningPrograms skos:broadMatch tgs:PracticeTerm.OneEarth_EducationAndCulture .
tgs:PracticeTerm.PeerLearning skos:broadMatch tgs:PracticeTerm.OneEarth_EducationAndCulture .
tgs:PracticeTerm.ArtAndStorytelling skos:broadMatch tgs:PracticeTerm.OneEarth_EducationAndCulture .
tgs:PracticeTerm.NetworkWeaving skos:broadMatch tgs:PracticeTerm.OneEarth_CommunityAction .
