tgs:Organization.ExxonMobil a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "ExxonMobil"@en ;
    skos:definition "American multinational oil and gas company. Included as the best-documented case of organized climate doubt: its own scientists' accurate warming projections against its public messaging (tgs:Work.AssessingExxonMobilsGlobalWarmingProjections)."@en ;
    thinkr:challenges tgs:Concept.ClimateSensitivity ;
    owl:sameAs <http://dbpedia.org/resource/ExxonMobil> ;
