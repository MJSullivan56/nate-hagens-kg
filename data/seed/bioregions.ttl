@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tgs: <http://example.org/tgs#> .
@prefix thinkr: <http://example.org/thinkr#> .

<http://example.org/tgs#> a owl:Ontology ;
    owl:imports <http://example.org/thinkr#> ;
    rdfs:comment "Imports tgs-core for Protege compatibility — editing this file alone will resolve thinkr: classes/properties via the catalog file."@en .

#############################################
# ADDED 2026-10-20 — One Earth's Bioregions 2023 framework (tgs:Work.OneEarthBioregions2023),
# by Karl Burkart and One Earth, licensed CC BY-NC 4.0; attribution: One Earth.
# Hierarchy (skos:broader): Bioregion (185, skos:notation = One Earth code, e.g. NA24)
#   -> BioregionalSubrealm (53) -> BioregionalRealm (One Earth's 14 realm divisions)
#   -> BiogeographicRealm (the 8 classic realms).
# Codes and names: One Earth's bioregion list page. Bioregion-to-subrealm membership:
# the datahub.io 'bioregions-2023' CSV. Subrealm names and subrealm-to-realm grouping:
# One Earth's 2023 framework page, which differs from the CSV's realm column for the
# Persian, Tibetan, Mongolian and East Asian desert subrealms (the page's grouping is
# used; it reproduces the page's per-realm bioregion counts exactly). The 844
# component ecoregions (Dinerstein et al. 2017) are not imported.
#############################################

tgs:BiogeographicRealm.Nearctic a thinkr:BiogeographicRealm, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.OneEarthBioregions2023 ;
    skos:topConceptOf tgs:ConceptScheme.OneEarthBioregions2023 ;
    skos:prefLabel "Nearctic"@en ;
    dcterms:source tgs:Work.OneEarthBioregions2023 ;
    .

