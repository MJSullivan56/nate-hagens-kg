    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.HuniKuinInterculturalExchangeHub a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Huni Kuin Intercultural Exchange Hub"@en ;
    thinkr:carriedOutBy tgs:Organization.HuwaKaruInterculturalReserve ;
