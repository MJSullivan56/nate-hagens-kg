@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tgs: <http://example.org/tgs#> .
@prefix thinkr: <http://example.org/thinkr#> .

<http://example.org/tgs#> a owl:Ontology ;
    owl:imports <http://example.org/thinkr#> ;
    rdfs:comment "Imports tgs-core for Protege compatibility — editing this file alone will resolve thinkr: classes/properties via the catalog file."@en ;
    .

#############################################
# thinkr:Organization — split out of the old, overloaded thinkr:School on
# 2026-07-11. A real legal entity with actual staff/roles — the kind of
# thing someone is literally employed by or a board member of. Distinct
# from thinkr:SchoolOfThought (an idea, no legal existence) and
# thinkr:AcademicInstitution (a university — different possible
# relationship verbs; an Organization can sponsor someone, a university
# generally wouldn't).
#############################################

thinkr:Organization a owl:Class ;
    rdfs:subClassOf thinkr:NamedEntity ;
    rdfs:comment "A real legal entity — nonprofit, company, community with actual staff/editorial roles — distinct from thinkr:SchoolOfThought (an idea) and thinkr:AcademicInstitution (a university, different relationship verbs apply)."@en ;
    skos:prefLabel "Organization"@en ;
    .

#############################################
# Instances
#############################################

tgs:Organization.TheOilDrum a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "The Oil Drum"@en ;
    skos:definition "A collaborative blog/community devoted to analysis and discussion of energy, peak oil, and sustainability, founded March 2005 by Kyle Saunders ('Prof. Goose') and Dave Summers ('Heading Out'). Active until 2013. Distinct from the broader tgs:SchoolOfThought.PeakOilMovement it was part of — a specific, independently-notable institution within that wider community, same relationship as Doughnut Economics sits within broader ecological economics. Nate Hagens was Managing/Lead Editor here before founding TGS — see tgs:Human.NateHagens."@en ;
    owl:sameAs <http://dbpedia.org/resource/The_Oil_Drum>  ;
    dcterms:isReferencedBy tgs:Monologue.Frankly_138_Part1ChangingTheFuture ;
    .

tgs:Organization.PostCarbonInstitute a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Post Carbon Institute"@en ;
    skos:definition "A 501(c)(3) nonprofit (DBA of Metafoundation) founded 2003 by Julian Darley, based in Oregon, focused on the transition away from fossil fuels via systems thinking, energy literacy, and community resilience. Nate Hagens currently sits on its Board — see tgs:Human.NateHagens."@en ;
    owl:sameAs 
        <http://dbpedia.org/resource/Post_Carbon_Institute>,
        <http://www.wikidata.org/entity/Q7233628> ;
    .

tgs:Organization.MaEarth a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Ma Earth"@en ;
    skos:definition "Collective/quadratic-funding crowdfunding platform for regenerative land and ecological projects, pairing philanthropic matching funds with community fundraising (e.g. mangrove restoration in the Pacific, a war-amputee farming cooperative in the Congo). Co-founded 2023 by tgs:Human.MatthewMonahan. NO owl:sameAs: verified 2026-07-11, no genuine Wikipedia page found — a small organization (~2 employees per one source), plausibly below Wikipedia's notability bar."@en ;
    dcterms:isReferencedBy tgs:Interview.TGS_226_CanMoneyServeLife ;
    .

tgs:Organization.BiomeTrust a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Biome Trust"@en ;
    skos:definition "A philanthropic foundation, co-founded/co-stewarded 2022-present by tgs:Human.MatthewMonahan, which he describes in TGS_226 as his family's grant-making fund run with some collaborators. By his account it has granted roughly $10 million over its lifetime, and its repeated difficulty getting funds onto the ground efficiently led to the founding of tgs:Organization.MaEarth. Listed among the selection partners for Ma Earth's third funding round."@en ;
    dcterms:isReferencedBy tgs:Interview.TGS_226_CanMoneyServeLife ;
    .

tgs:Organization.ConsilienceProject a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "The Consilience Project"@en ;
    dcterms:isPartOf tgs:Organization.CivilizationResearchInstitute ;
    skos:definition "Non-profit media organization (founded 2021, a publication of the Civilization Research Institute) publishing research on public sensemaking, governance design, and global risk mitigation — addressing the erosion of shared epistemics and 'information commons.' Founding member: tgs:Human.DanielSchmachtenberger. NOT separately verified for DBpedia/Wikidata as of 2026-07-11 — flagged honestly rather than guessed; revisit if this becomes independently relevant."@en ;
    .

#############################################
# ENRICHED 2026-07-14 — surfaced by actually reading Nate's own bio
# intro for Matthew Monahan (TGS_226 transcript), not general web
# search. New extraction pattern being piloted: episode intros are a
# different, richer kind of source than generic NER — Nate's own
# framing, not inferred entity mentions. See
# docs/sidecar-cleanup-handoff.md for the fuller discussion.
#############################################

tgs:Organization.MangaroaFarms a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Mangaroa Farms"@en ;
    skos:definition "A community food hub, regenerative agriculture project, and resilience education centre in the Hutt Valley, Upper Hutt, New Zealand (near the Mangaroa River). Founded 2018 by brothers Matthew and Brian Monahan (with Catlin Powers) as a living laboratory for transitioning former dairy and pine plantation land into regenerative agriculture and native forest. Structurally part of/owned by tgs:Organization.BiomeTrust, per Mangaroa Farms' own 'About Us' page and multiple independent sources. Originally surfaced via Nate Hagens' own guest introduction for Matthew Monahan (TGS_226 transcript) — a new extraction pattern piloted 2026-07-14, reading episode intros as a distinct primary source rather than relying on generic NER or web search alone (see docs/sidecar-cleanup-handoff.md). Independently verified 2026-07-14 via multiple sources (mangaroa.org, NZBusiness Magazine, Good Magazine, Quorum Sense, Waterford Press) — real, active, well-documented. NO owl:sameAs asserted: no Wikipedia/DBpedia/Wikidata entry found, plausibly below the notability bar for a small regional farm."@en ;
    dcterms:isReferencedBy tgs:Interview.TGS_226_CanMoneyServeLife ;
    .

#############################################
# BOOTSTRAPPED 2026-07-15 — Gaya Herrington's current professional
# affiliations, surfaced via real WebSearch/WebFetch verification (not
# the podcast intro alone, which never mentions either — see
# docs/sidecar-cleanup-handoff.md for the fuller bootstrap trail).
# KPMG and De Nederlandsche Bank (both past employers) deliberately kept
# as prose only in tgs:Human.GayaHerrington's own comment, not modeled
# as separate Organization individuals — same "current/most-relevant
# affiliation gets structured, degree/employment history stays prose"
# precedent as tgs:Human.JoshFarley (Columbia/Cornell/Grinnell stayed
# prose; only University of Vermont got a structured Relationship).
#############################################

tgs:Organization.SchneiderElectric a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Schneider Electric"@en ;
    skos:definition "French multinational energy management and industrial automation company. Gaya Herrington served as Vice-President of Sustainability Research there (12 years advising multinationals per her own bio) — CORRECTED 2026-07-15: initially recorded as her current role via general WebSearch, but a direct WebFetch of her own site (gayaherrington.com/about) confirms this is now a PAST role ('Former ... Vice President Sustainability Research at Schneider Electric'); she has been an independent advisor since 2026. Real, on-the-record fact worth knowing for future sessions: a general WebSearch summary and a primary-source fetch of the subject's own site can disagree, and the primary source wins."@en ;
    .

tgs:Organization.ClubOfRome a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Club of Rome"@en ;
    skos:definition "International think tank/NGO founded 1968, best known for commissioning the original 1972 'Limits to Growth' study (see tgs:Concept.LimitsToGrowth) that this Persona family's LinkNote/Work provenance chain already traces back to. Gaya Herrington is a confirmed member per her own bio (gayaherrington.com/about) — verified via WebFetch 2026-07-15. Thematically the single most on-point affiliation surfaced in her bootstrap: the organization that commissioned the study she later empirically re-tested."@en ;
    .

tgs:Organization.StopStraatintimidatie a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Stop Straatintimidatie"@en ;
    skos:definition "Dutch anti-street-harassment advocacy organization, founded 2014 by Gaya Herrington (then publicly known as Gaya Branderhorst) as a citizen's initiative targeting 40,000 signatures (reached approximately 19,000 by 2016); became a formal nonprofit foundation in May 2016. Deliberately kept roughly 50/50 gender-balanced team. Real, documented policy impact: street harassment began being formally fined in Amsterdam and Rotterdam starting 2018. Verified via WebSearch 2026-07-15 (not mentioned in the TGS_57 podcast intro itself — surfaced entirely through independent verification, not the transcript)."@en ;
    .

#############################################
# ADDED 2026-08-13 — RR-26 bootstrap.
#############################################

tgs:Organization.InternationalBatesonInstitute a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "International Bateson Institute"@en ;
    skos:definition "A nonprofit foundation for transcontextual research in ecology, economy, social change, health, education, and art — founded and led by Nora Bateson (president), registered in Sweden (sources vary on whether also US-registered). Institutional home for Bateson's 'Warm Data' methodology and Warm Data Lab certification program; Jonathan Goldsmith and Lucas Jackson are both affiliated as core team member and certified host, respectively."@en ;
    dcterms:source <https://www.warmdata.life/international-bateson-institute> ;
    skos:scopeNote "CORRECTED 2026-08-13, caught before this pass was finished: first draft mistakenly used owl:sameAs for this org's own homepage — this project's established convention reserves owl:sameAs specifically for DBpedia/Wikidata equivalence (confirmed via the Organization.MaEarth precedent: 'NO owl:sameAs... no genuine Wikipedia page found'), not general external links. No Wikipedia/DBpedia page found for this org — dcterms:source used instead for its own homepage."@en ;
    .

# added 2026-08-29
tgs:Organization.ILSR a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Institute for Local Self-Reliance"@en ;
    skos:definition "Nonprofit organization and advocacy group founded 1974, providing research, advocacy, and technical assistance for local solutions to community development — banking, broadband, energy, independent business, waste. Three offices: Washington D.C., Portland Maine, Minneapolis MN. Co-directed by tgs:Human.StacyMitchell and John Farrell as of 2025."@en ;
    owl:sameAs <https://en.wikipedia.org/wiki/Institute_for_Local_Self-Reliance> ;
    .

tgs:Organization.InstituteForSymbolicSelection a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Institute for Symbolic Selection"@en ;
    skos:definition "Interdisciplinary research program founded by Greg Elliott, investigating how human-created symbolic systems (institutions, game-theoretic incentive structures) shape behavior and the long-term evolution of civilization. Grew directly out of his own Psychopathic Selection Hypothesis research. No owl:sameAs found — not independently verified as having a dedicated Wikipedia/DBpedia page."@en ;
    .

tgs:Organization.CenterForHumaneTechnology a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Center for Humane Technology"@en ;
    skos:definition "Nonprofit co-founded by Tristan Harris and Aza Raskin, originally focused on social media's psychological engineering of user behavior, pivoted toward AI safety and governance beginning January 2023 after receiving direct warnings from AI-lab insiders about an imminent capability step-change (pre-GPT-4). Co-produces the podcast 'Your Undivided Attention.'"@en ;
    owl:sameAs <https://en.wikipedia.org/wiki/Center_for_Humane_Technology> ;
    .

tgs:Organization.BioticPumpGreeningGroup a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Biotic Pump Greening Group"@en ;
    skos:definition "Real, direct research and advocacy organization focused on the biotic pump theory (tgs:Concept.BioticPump) and its practical application to reforestation and water-cycle restoration. Antonio Nobre (already built, tgs:Human.AntonioNobre) serves as its real Scientific Director."@en ;
    .

tgs:Organization.EarthSpeciesProject a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Earth Species Project"@en ;
    skos:definition "Real, open-source collaborative nonprofit dedicated to decoding non-human animal communication, using AI as a tool to translate the languages of other species. Co-founded by Aza Raskin (already built)."@en ;
    .

tgs:Organization.KnodelFoundation a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Knodel Foundation"@en ;
    skos:definition "Real, Germany-based impact investing firm focused on projects that increase sustainability and autonomy for the Global South. Founded and led by Patrick Knodel (already built)."@en ;
    owl:sameAs <https://knodelfoundation.org/en/> ;
    .

tgs:Organization.EkskaretFoundation a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Ekskäret Foundation"@en ;
    skos:definition "Real, Stockholm-based foundation running youth camps, adult retreats, and conferences focused on inner development. Founded by Tomas Björkman (already built)."@en ;
    owl:sameAs <http://ekskaret.se/> ;
    .

tgs:Organization.OrphanWisdomSchool a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Orphan Wisdom School"@en ;
    skos:definition "Real school co-founded by Stephen Jenkinson and his wife, Natalie Roy, teaching the skills of deep living, culture-making, and how to grieve and die well."@en ;
    .

tgs:Organization.RecycleLebanon a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Recycle Lebanon"@en ;
    skos:definition "Real, Lebanon-based organization founded 2015, working toward circular-economy system change — reducing plastic usage and pollution while building nature-based consumption and production alternatives. Founded and directed by Joslin Faith Kehdy (already built)."@en ;
    owl:sameAs <https://www.sustainlebanon.com/> ;
    .

tgs:Organization.AmazonEnvironmentalResearchInstitute a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Amazon Environmental Research Institute (IPAM)"@en ;
    skos:definition "Real, Brazilian think tank focused on Amazonian challenges for reaching zero deforestation and sustainable development. André Guimarães (already built) serves as Executive Director."@en ;
    owl:sameAs <https://ipam.org.br/en/> ;
    .

tgs:Organization.Restor a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Restor"@en ;
    skos:definition "Real, open-data online platform for the global ecological restoration movement, connecting restoration projects, funders, and scientific data. Founded by Thomas Crowther (already built)."@en ;
    owl:sameAs <https://restor.eco/> ;
    .

tgs:Organization.TransitionNetwork a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Transition Network"@en ;
    skos:definition "Real, international movement of community-led responses to climate change and economic instability, active in roughly 50 countries, organized around local economy projects, community energy companies, and community food projects. Co-founded by Rob Hopkins (already built) alongside Transition Town Totnes, its first and namesake initiative."@en ;
    owl:sameAs <https://transitionnetwork.org/> ;
    .

tgs:Organization.CommodityContext a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Commodity Context"@en ;
    skos:definition "Real, direct oil-market research and analysis business founded by Rory Johnston (already built), publishing a real Substack newsletter and advising institutional investors, policymakers, and corporate decision-makers on commodity markets."@en ;
    owl:sameAs <https://www.commoditycontext.com/> ;
    .

tgs:Organization.ReEarthInitiative a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Re-Earth Initiative"@en ;
    skos:definition "Real, global youth-led organization co-founded by Xiye Bastida (already built), raising and allocating funding to small-scale, effective climate and ecological projects across frontline communities in the Global South, including a real, direct participatory-grantmaking model where grantees themselves help guide funding decisions."@en ;
    owl:sameAs <https://reearthin.org/> ;
    .

tgs:Organization.PlanetaryGuardians a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Planetary Guardians"@en ;
    skos:definition "Real, independent collective working to elevate the Planetary Boundaries framework (already a formal Concept in this graph) as a public measurement standard, inviting broad participation in guardianship of the biosphere. Real, direct members include Xiye Bastida, the late Jane Goodall, and several already-built TGS guests including Johan Rockström and Carlos Nobre."@en ;
    owl:sameAs <https://www.planetaryguardians.org/> ;
    .

tgs:Organization.ThreeFiftyOrg a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "350.org"@en ;
    skos:definition "Real, first global grassroots climate campaign, co-founded by Bill McKibben (already built), organizing protests and demonstrations on every continent including Antarctica. Real, direct role in launching opposition to the Keystone XL pipeline and the fossil-fuel divestment campaign, which became the largest anti-corporate campaign in history."@en ;
    owl:sameAs <https://350.org/> ;
    .

tgs:Organization.ThirdAct a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Third Act"@en ;
    skos:definition "Real, direct organization founded by Bill McKibben (already built), organizing people over the age of 60 for action on climate and social justice — built on the real, direct premise that older generations hold real, significant structural and financial power, and real, available time."@en ;
    owl:sameAs <https://thirdact.org/> ;
    .

tgs:Organization.BeyondPlastics a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Beyond Plastics"@en ;
    skos:definition "Real, direct nationwide project working to end plastic pollution, directly cited in TGS_102 (already built)."@en ;
    owl:sameAs <https://www.beyondplastics.org/> ;
    .

tgs:Organization.SkepticalScience a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Skeptical Science"@en ;
    skos:definition "Real, direct educational website founded by John Cook (already built) in 2007, real, widely regarded as one of the most reputable sources explaining the actual science behind global heating. Winner, 2011 Australian Museum Eureka Prize for the Advancement of Climate Change Knowledge; 2016 Friend of the Planet Award, National Center for Science Education."@en ;
    owl:sameAs <https://skepticalscience.com/> ;
    .

tgs:Organization.CrankyUncle a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Cranky Uncle"@en ;
    skos:definition "Real, direct misinformation-inoculation game created by John Cook (already built), combining critical thinking, cartoons, and gamification to build genuine resilience against misleading arguments across any subject, not only climate. Real, direct partner organizations include UNICEF, applied specifically to vaccine misinformation."@en ;
    owl:sameAs <https://crankyuncle.com/> ;
    .

tgs:Organization.ElectricPowerResearchInstitute a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Electric Power Research Institute"@en ;
    skos:definition "Real, direct US electric-power research organization where Meredith Angwin (already built) served as one of the first women to hold a project manager role, leading real, direct projects in renewable and nuclear energy."@en ;
    owl:sameAs <https://www.epri.com/> ;
    .

tgs:Organization.SchumacherCenterForNewEconomics a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Schumacher Center for a New Economics"@en ;
    skos:definition "Real, direct successor to the original E.F. Schumacher Society, based in Great Barrington, Massachusetts, and real, direct home of Schumacher's own personal library and archives. Continues his work through research, lectures, and technical assistance aimed at building strong, diverse local economies."@en ;
    owl:sameAs <https://centerforneweconomics.org/> ;
    .

tgs:Organization.SchumacherInstitute a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "The Schumacher Institute"@en ;
    skos:definition "Real, independent research organization based in Bristol, England, part of the real, direct 'Schumacher Circle' of organizations founded in E.F. Schumacher's memory or inspired by his work — alongside Schumacher College, the Soil Association, and Practical Action (the former Intermediate Technology Development Group, which Schumacher himself founded in 1966)."@en ;
    owl:sameAs <https://schumacherinstitute.org.uk/> ;
    .

tgs:Organization.CyberSecurityLabLouisville a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Cyber Security Lab, University of Louisville"@en ;
    skos:definition "Real, direct research lab within the Department of Computer Engineering and Computer Science at the University of Louisville's Speed School of Engineering, founded and directed by Roman Yampolskiy (already built) since 2012."@en ;
    owl:sameAs <https://engineering.louisville.edu/faculty/roman-v-yampolskiy> ;
    .

tgs:Organization.Conjecture a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Conjecture"@en ;
    skos:definition "Real, direct AI safety research company founded March 2022 by Connor Leahy (already built), Sid Black, and Gabriel Alfour, born directly out of EleutherAI (already built). Real, stated mission to scale applied AI alignment research, pursuing 'Cognitive Emulation' — building interpretable AI from the ground up rather than attempting to align existing large language models after the fact. Leahy led the company as CEO until stepping down in early 2026."@en ;
    owl:sameAs <https://www.conjecture.dev/about> ;
    .

tgs:Organization.EleutherAI a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "EleutherAI"@en ;
    skos:definition "Real, direct open-source large language model research collective, co-founded July 2020 by Connor Leahy (already built) with Sid Black and Leo Gao out of a Discord server, aiming to replicate GPT-3 in the open. Real, direct outputs include The Pile (2020), GPT-Neo (2021), GPT-J-6B (2021, the largest open-source GPT-3-style model at release), and GPT-NeoX-20B (2022). Real, direct early home for discussions on the risks of the same advanced AI systems it helped build."@en ;
    owl:sameAs <https://www.eleuther.ai/> ;
    .

tgs:Organization.ControlAI a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "ControlAI"@en ;
    skos:definition "Real, direct nonprofit AI-risk advocacy organization, running real, direct campaigns including a citizen letter-writing tool and 'The Direct Institutional Plan.' Connor Leahy (already built) joined as US Director in early 2026 after stepping down as Conjecture's CEO, having previously served as an advisor."@en ;
    owl:sameAs <https://controlai.com/> ;
    .

tgs:Organization.GlobalGuerrillasReport a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Global Guerrillas Report"@en ;
    skos:definition "Real, direct newsletter and podcast published by John Robb (already built), covering the intersection of war, politics, and technology — a real, direct continuation of the Global Guerrillas blog he launched in 2004."@en ;
    owl:sameAs <https://johnrobb.substack.com/> ;
    .

tgs:Organization.PlanetLabs a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Planet Labs"@en ;
    skos:definition "Real, direct Earth-imaging and geospatial data company (formally Planet Labs PBC, a Public Benefit Corporation), headquartered in San Francisco, co-founded in 2010 by Will Marshall (already built) with Chris Boshuizen and Robbie Schingler. Operates the world's largest constellation of Earth-observing satellites, imaging the entire planet's landmass daily, with a real, direct stated mission (written into its own PBC charter) to make global change visible, accessible, and actionable in service of a more sustainable and secure world."@en ;
    owl:sameAs <https://www.planet.com/> ;
    .

tgs:Organization.OutlierProjects a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Outlier Projects"@en ;
    skos:definition "A climate philanthropy that funds research on frontier climate risks: better forecasting of catastrophic and tail-end risks, and tools that could help stabilize climate systems at the necessary speed and scale (in TGS_204, glacier forecasting and stabilization, methane, and sunlight reflection research). Kelly Erhart is its Director of Partnerships; she works for Mike Schroepfer, an early donor to Vesta."@en ;
    dcterms:source <https://www.outlierprojects.org/> ;
    dcterms:isReferencedBy tgs:Interview.TGS_204_KellyErhart ;
    .

tgs:Organization.Vesta a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Vesta (Project Vesta)"@en ;
    skos:definition "A nonprofit co-founded by Kelly Erhart that pioneered coastal enhanced weathering, now generally called ocean alkalinity enhancement, spreading olivine on coastlines to draw down carbon dioxide, and that delivered the first field trials of the approach. Erhart led it for five years before joining Outlier Projects, and remains an advisor."@en ;
    dcterms:source <http://vesta.earth> ;
    dcterms:isReferencedBy tgs:Interview.TGS_204_KellyErhart ;
    .

tgs:Organization.AmazonResearchInternacional a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Amazon Research Internacional"@en ;
    skos:definition "Nonprofit founded by Rosa Vásquez Espinoza to conserve Amazonian biodiversity, ecosystems and Indigenous knowledge by joining Indigenous knowledge with modern science, and to build Indigenous-led entrepreneurship from the research. Its projects described in TGS_201 include mapping wild stingless-bee hives, the campaign behind Satipo's recognition of stingless bees' rights, Indigenous-led camera trapping in Asháninka territory, research on toxic frogs and animal self-medication, and early work with Ese Ejja women in Bolivia."@en ;
    dcterms:source <https://www.amazonresearch.org/about> ;
    dcterms:isReferencedBy tgs:Interview.TGS_201_RosaVasquezEspinoza ;
    .

tgs:Organization.EmmettInstitute a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Emmett Institute on Climate Change and the Environment"@en ;
    skos:definition "Climate and environmental law research center at the UCLA School of Law, whose faculty director is Ted Parson (TGS_200); its colleagues have worked with Los Angeles city and county governments on lightening surfaces to reduce the urban heat island effect, and it publishes the Legal Planet blog."@en ;
    dcterms:source <https://law.ucla.edu/academics/centers/emmett-institute-climate-change-environment> ;
    dcterms:isReferencedBy tgs:Interview.TGS_200_TedParson ;
    .

tgs:Organization.SchoolForMoralAmbition a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "The School for Moral Ambition"@en ;
    skos:definition "Nonprofit co-founded in 2024 by Rutger Bregman to build a movement of people who take on the world's most pressing problems. Its Moral Ambition Circles are free, self-organized groups of five to eight that work through what moral ambition could mean for them and end with a pledge; its selective fellowships pay talented professionals to quit their jobs and work on causes chosen by prioritization researchers using the 'sizable, solvable, sorely neglected' test: in TGS_195 (recorded July 2025), fighting big tobacco in Europe, a global billionaires tax, and food-system reform, including lobbying in Brussels for alternative proteins. About 17,000 members in over 100 countries at the time."@en ;
    dcterms:source <https://www.moralambition.org/> ;
    dcterms:isReferencedBy tgs:Interview.TGS_195_RutgerBregman ;
    .

tgs:Organization.GivingWhatWeCan a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Giving What We Can"@en ;
    skos:definition "Organization that promotes a pledge to give at least 10% of one's income to highly effective charities, with an online record of donations; Rutger Bregman (TGS_195) took the pledge and describes tracking his giving as a 'moral portfolio'."@en ;
    dcterms:source <https://www.givingwhatwecan.org/about-us> ;
    dcterms:isReferencedBy tgs:Interview.TGS_195_RutgerBregman ;
    .

tgs:Organization.TheGuardian a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "The Guardian"@en ;
    skos:definition "British daily newspaper, for which Oliver Milman (TGS_189) is environment correspondent."@en ;
    dcterms:source <https://www.theguardian.com/profile/oliver-milman> ;
    dcterms:isReferencedBy tgs:Interview.TGS_189_OliverMilman ;
    .

tgs:Organization.AtlanticPackaging a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Atlantic Packaging"@en ;
    skos:definition "Family-owned packaging company, about 80 years old, described as the largest privately held and most technical packaging company in North America, serving consumer-products brands, retailers, e-commerce and industrial customers. Led by its third generation, president Wes Carter (TGS_186), it shifted from a value proposition of packaging efficiency to a sustainability program built on nature-based materials, recycling partnerships with customers, and health as an organizing principle, including an extensive employee wellness program."@en ;
    dcterms:source <https://www.atlanticpkg.com/> ;
    dcterms:isReferencedBy tgs:Interview.TGS_186_WesCarter, tgs:Interview.TGS_170_KristineTompkins ;
    .

tgs:Organization.ANewEarthProject a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "A New Earth Project"@en ;
    skos:definition "Initiative launched by Wes Carter in January 2020, a collaboration between outdoor enthusiasts and global packaging suppliers with the mission of ridding the world's oceans, lakes and rivers of plastic pollution, working with athletes and musicians to build demand for sustainable packaging (TGS_186)."@en ;
    dcterms:source <https://anewearthproject.com/> ;
    dcterms:isReferencedBy tgs:Interview.TGS_186_WesCarter ;
    .

tgs:Organization.NewEarthVentures a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "New Earth Ventures"@en ;
    skos:definition "Venture firm launched by Atlantic Packaging around 2024 to help startups scale nature-based packaging materials, such as seaweed-based plastics and a compostable shrimp-shell cooler foam (TGS_186)."@en ;
    dcterms:source <https://newearthventures.vc/> ;
    dcterms:isReferencedBy tgs:Interview.TGS_186_WesCarter ;
    .

tgs:Organization.EcologicalFuturesGroup a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Ecological Futures Group"@en ;
    skos:definition "Organization founded and led by Rod Schoonover that examines the national security and societal dimensions of global ecological change (TGS_183)."@en ;
    dcterms:source <https://ecologicalfutures.com/> ;
    dcterms:isReferencedBy tgs:Interview.TGS_183_RodSchoonover ;
    .

tgs:Organization.DarkMatterLabs a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Dark Matter Labs"@en ;
    skos:definition "Field laboratory co-founded by Indy Johar, focused on building the institutional infrastructure for radical civic societies, cities, regions and towns. Its initiative Expanding Civilizational Optionality (xCO), discussed in TGS_238, combines a capital platform, an option foundry and learning and organizing infrastructure; other initiatives linked in the show notes include Madrid 2050 degrees, Extraction Zero, bioregioning and the Planetary Civics Inquiry."@en ;
    dcterms:source <https://darkmatterlabs.org/> ;
    dcterms:isReferencedBy tgs:Interview.TGS_238_IndyJohar, tgs:Interview.TGS_147_IndyJohar ;
    .

tgs:Organization.Project00 a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Project 00"@en ;
    skos:definition "Architecture and design practice co-founded by Indy Johar (TGS_147, TGS_238)."@en ;
    dcterms:source <https://www.project00.cc/> ;
    .

tgs:Organization.CivilizationResearchInstitute a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Civilization Research Institute"@en ;
    skos:definition "Non-profit research organization with which Daniel Schmachtenberger works; The Consilience Project is its public-facing publication (tgs:Organization.ConsilienceProject). TGS_132's show description directs listeners to a document of AI resources and research compiled by the Institute."@en ;
    dcterms:source <https://civilizationresearchinstitute.org/> ;
    skos:scopeNote "Minted 2026-10-18 for TGS_132, under the scope rule for ecosystem organizations: an organization enters the graph only when a TGS source mentions it or it is a guest's institutional home. Its founders, staff and programs are not modeled; the website was not consulted for this entry."@en ;
    .

tgs:Organization.EarthkindCollective a thinkr:Organization, owl:NamedIndividual ;
    skos:prefLabel "Earthkind Collective"@en ;
    skos:definition "Collaborative community of funders and practitioners responding to interconnected global challenges. It runs a venture studio for aligned ventures, a member community and a strategic coordination hub, and describes itself as discreet by design. Author of tgs:Work.WorldInTransition2026."@en ;
    dcterms:source <https://www.earthkindcollective.org> ;
    .

