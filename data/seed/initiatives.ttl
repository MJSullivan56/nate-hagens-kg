    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "Work is organized around seven broad themes—Circles of Activity—treated as interconnected parts of one system."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.PortfolioOfLegacyProjects a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Portfolio of Legacy Projects"@en ;
    thinkr:carriedOutBy tgs:Organization.7GenerationGTB ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.PortfolioDevelopment ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "The Portfolio of Projects gathers fragmented, decontextualized activity in the bioregion into Legacy Projects— shared units of practice that can spread."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.SchoolCommunityNetwork a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "School Community Network"@en ;
    thinkr:carriedOutBy tgs:Organization.7GenerationGTB ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.LearningPrograms, tgs:PracticeTerm.TraditionalEcologicalKnowledge ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Through schools, the initiative supports an intergenerational zone where people learn with and from each other in real community settings and take collective action on regenerative Legacy Projects, using a land-based learning model."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.CommunityReconciliationAndForgiveness a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Community Reconciliation and Forgiveness"@en ;
    thinkr:carriedOutBy tgs:Organization.AbundanceProject ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CommunityReconciliation, tgs:PracticeTerm.NetworkWeaving ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "In 2023, church leaders across the valley met together for the first time—no small feat, since many congregations would not previously share a building."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.LandStewardshipTokenization a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Land Stewardship Tokenization"@en ;
    thinkr:carriedOutBy tgs:Organization.AbundanceProject ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CollectiveOwnershipModels ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.LegalStewardship ;
    dcterms:description "The valley’s original Khoisan inhabitants are described as sustaining one of the world’s longest-lived valuesbased societies, contrasted with class-based society elsewhere: ownership anchors class relations, while stewardship anchors a values-based orientation."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.WatershedRestorationPlanning a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Watershed Restoration Planning"@en ;
    thinkr:carriedOutBy tgs:Organization.AbundanceProject ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.SystemsAndResourceMapping, tgs:PracticeTerm.WatershedRepair ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.EcosystemRegeneration, tgs:PracticeCluster.MappingAndIndicators ;
    dcterms:description "The team mapped “blue” and “green” zones along the river. Blue zones slow runoff from the mountains so water seeps into soil instead of stripping topsoil into the channel."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.AcademiaBiosferica a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Academia Biosférica"@en ;
    thinkr:carriedOutBy tgs:Organization.AccionSerrana ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.TrainingAndEmploymentPathways ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.ServicesAndInfrastructure ;
    dcterms:description "The Academia Biosférica program represents an intergenerational training initiative developed in partnership with institutions across Latin America."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.CapitalAllocationAndFinancialStrategy a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Capital Allocation and Financial Strategy"@en ;
    thinkr:carriedOutBy tgs:Organization.AccionSerrana ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GrantsPrograms ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "Currently, approximately 70% of funding comes through Acción Andina's international network, with 30% from matching grants and public-private partnerships."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.CultureAndEmployment a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Culture and Employment"@en ;
    thinkr:carriedOutBy tgs:Organization.AccionSerrana ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.TrainingAndEmploymentPathways ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.ServicesAndInfrastructure ;
    dcterms:description "Beyond ecological goals, the restoration work focuses on promoting visibility of local gaucho and indigenous communities, creating green employment opportunities for youth in restoration, mountain guiding, and forest ranger positions."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.GovernanceAndValues a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Governance and Values"@en ;
    thinkr:carriedOutBy tgs:Organization.AccionSerrana ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GovernanceBodies ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "Acción Serrana operates through a four-tiered governance model that reflects the bioregion's nested social and ecological systems: 1."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.MonitoringEvaluationAndLearning a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Monitoring, Evaluation, and Learning"@en ;
    thinkr:carriedOutBy tgs:Organization.AccionSerrana ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.EcologicalMonitoring ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.MappingAndIndicators ;
    dcterms:description "A robust monitoring system ensures transparency and scientific rigor across all restoration work."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ParticipatoryForestRestoration a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Participatory Forest Restoration"@en ;
    thinkr:carriedOutBy tgs:Organization.AccionSerrana ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.SeedsAndNurseries, tgs:PracticeTerm.VegetationPlanting ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.EcosystemRegeneration ;
    dcterms:description "Acción Serrana has developed a sophisticated restoration infrastructure which includes maintenance of protective fencing, seed collection, nursery construction and operation, seedling germination and transplantation, and strategic underplanting during the rainy season."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.RegenerativeProductsAndServicesPortfolio a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Regenerative Products & Services Portfolio"@en ;
    thinkr:carriedOutBy tgs:Organization.AccionSerrana ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ValueChainDevelopment ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy ;
    dcterms:description "A developing line of bioregionally-rooted products including herbal tea blends from native species, guided ecotourism experiences to restoration sites, and local food products."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.EducationalWorkWithSchools a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Educational Work with Schools"@en ;
    thinkr:carriedOutBy tgs:Organization.AliancaMarITerraDiMallorca ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.LearningPrograms ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "The work is less a single education program than a series of intentional conversations across communities."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.FoodshedAndEnergyshedMapping a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Foodshed and Energyshed Mapping"@en ;
    thinkr:carriedOutBy tgs:Organization.AliancaMarITerraDiMallorca ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GeographicAndEcologicalMapping, tgs:PracticeTerm.RegionalSourcing, tgs:PracticeTerm.SystemsAndResourceMapping ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.MappingAndIndicators ;
    dcterms:description "On Mallorca, the alliance has used foodshed and energyshed mapping to trace how food and energy move through landscapes and settlements—mapping relational “footprints” rather than only administrative boundaries."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.SacredPathwaysRevitalizationProject a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Sacred Pathways Revitalization Project"@en ;
    thinkr:carriedOutBy tgs:Organization.AliancaMarITerraDiMallorca ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ArtAndStorytelling, tgs:PracticeTerm.CulturalAndSpiritualPractices ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "The project uses ancient infrastructure as a tool for contemporary environmental awareness and cultural reconnection, honoring both pre-Christian and Catholic heritage."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.TourismIndustryTransformationInitiative a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Tourism Industry Transformation Initiative"@en ;
    thinkr:carriedOutBy tgs:Organization.AliancaMarITerraDiMallorca ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ArtAndStorytelling, tgs:PracticeTerm.VisitorExperiences ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.ServicesAndInfrastructure, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Mallorca's economy is dominated by tourism, which comprises approximately 80% of economic activity."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.LandscapeScaleRestorationProjects a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Landscape-Scale Restoration Projects"@en ;
    thinkr:carriedOutBy tgs:Organization.AllianceForScotlandsRainforest ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.HabitatConnectivity, tgs:PracticeTerm.SpeciesControl, tgs:PracticeTerm.VegetationPlanting ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.EcosystemRegeneration ;
    dcterms:description "The Alliance has adopted 11 community-focused projects that cover more than 15% of Scotland's rainforest zone, with more coming soon."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.NatureFinanceForScotlandsRainforest a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Nature Finance for Scotland's Rainforest"@en ;
    thinkr:carriedOutBy tgs:Organization.AllianceForScotlandsRainforest ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ResultBasedMechanisms, tgs:PracticeTerm.StructuringAndCapitalization ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "The Alliance estimates that £500 million in long-term investment is needed to truly restore and expand Scotland's rainforest."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.OurRainforestFutures a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Our Rainforest Futures"@en ;
    thinkr:carriedOutBy tgs:Organization.AllianceForScotlandsRainforest ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.TrainingAndEmploymentPathways ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.ServicesAndInfrastructure ;
    dcterms:description "The challenge of restoring Scotland's rainforest is also about building the local capacity to do the work."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.TheCommonGroundForum a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "The Common Ground Forum"@en ;
    thinkr:carriedOutBy tgs:Organization.AllianceForScotlandsRainforest ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CommonsGovernanceProtocols, tgs:PracticeTerm.GovernanceBodies ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "When the Association of Deer Management Groups first approached the Alliance for Scotland's Rainforest a few years ago, they saw potential for collaboration—something they called \"the common ground.\" But decades of conflict between environmental groups and deer management interests had created a deep-seated lack of…"@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.AltiplanoRegenerationManifesto a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Altiplano Regeneration Manifesto"@en ;
    thinkr:carriedOutBy tgs:Organization.AlVelAl ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ParticipatoryStrategies ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "The common challenges facing the territory—environmental degradation, social loss, and economic uncertainty —inspired entities from across the region to unite and create a common manifesto."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.EcoregenerativeCertification a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Ecoregenerative Certification"@en ;
    thinkr:carriedOutBy tgs:Organization.AlVelAl ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.EcologicalMonitoring, tgs:PracticeTerm.ResultBasedMechanisms ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.MappingAndIndicators, tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "Ecoregenerative Certification is a voluntary standard for farms that are already organic and want to show they go further: they manage land in ways that improve soil, water, and biodiversity, not only meet organic rules."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.EcotourismDevelopment a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Ecotourism Development"@en ;
    thinkr:carriedOutBy tgs:Organization.AlVelAl ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.VisitorExperiences ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.ServicesAndInfrastructure ;
    dcterms:description "Tourism is developed as a way to connect visitors to landscape regeneration and local culture—not as undifferentiated growth."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.EducationAlliance a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Education Alliance"@en ;
    thinkr:carriedOutBy tgs:Organization.AlVelAl ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ArtAndStorytelling, tgs:PracticeTerm.LearningPrograms ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "They hold that regenerating the landscape requires a shift in how people feel and think about land."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.LandscapeFinanceStrategy a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Landscape Finance Strategy"@en ;
    thinkr:carriedOutBy tgs:Organization.AlVelAl ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.FinanceAssessments, tgs:PracticeTerm.StructuringAndCapitalization ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "The landscape partnership first ran a 4 Returns finance assessment with AlVelAl, allied foundations and enterprises, and Commonland—mapping real interventions and their costs."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.NaturalEcosystemsRestoration a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Natural Ecosystems Restoration"@en ;
    thinkr:carriedOutBy tgs:Organization.AlVelAl ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.HabitatConnectivity, tgs:PracticeTerm.VegetationPlanting, tgs:PracticeTerm.WatershedRepair ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.EcosystemRegeneration ;
    dcterms:description "Restoration focuses on natural areas and how they connect to working farmland. On priority sites such as La Muela, partners work to recover vegetation, soils, and water retention."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.RegenerativeAgricultureMachineryBank a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Regenerative Agriculture Machinery Bank"@en ;
    thinkr:carriedOutBy tgs:Organization.AlVelAl ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.FarmerSupport, tgs:PracticeTerm.PeerLearning, tgs:PracticeTerm.ResourceHub ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.HubsAndCenters, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "To practice regenerative agriculture, specific machinery is needed, and not all farmers can afford the full range of machines required."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.RegenerativeAgricultureTransition a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Regenerative Agriculture Transition"@en ;
    thinkr:carriedOutBy tgs:Organization.AlVelAl ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.DemonstratorSite, tgs:PracticeTerm.FarmerSupport, tgs:PracticeTerm.RegenerativeAgriculture ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.HubsAndCenters ;
    dcterms:description "One of the initial goals has been to help align stakeholders and shift from the development of almond monocultures and intensive agricultural and livestock farming practices to mainstreaming regenerative practices and developing the regional market for them."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.RegenerativeValueChainDevelopment a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Regenerative Value Chain Development"@en ;
    thinkr:carriedOutBy tgs:Organization.AlVelAl ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ValueChainDevelopment ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy ;
    dcterms:description "The work has developed three regenerative businesses now in operation: an almond-focused company (Almendrehesa), an olive oil cooperative (Habitat), and a food platform (AlVelAl Foods) to sell regenerative products from across the territory."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ASHAInternationalAdvocacy a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "ASHA International Advocacy"@en ;
    thinkr:carriedOutBy tgs:Organization.AmazonSacredHeadwatersAlliance ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.PoliticalAdvocacy ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.LegalStewardship ;
    dcterms:description "The Alliance engages in significant advocacy with national governments in the region as well as international organizations."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.AmazonHeadwatersTerritorialMonitoring a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Amazon Headwaters Territorial Monitoring"@en ;
    thinkr:carriedOutBy tgs:Organization.AmazonSacredHeadwatersAlliance ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.TerritorialMonitoring ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.MappingAndIndicators ;
    dcterms:description "Communities are establishing autonomous monitoring systems that combine traditional knowledge with modern technology—from satellite imagery to smartphone-based documentation—to track both ecological health and territorial incursions."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.CrossBorderIndigenousAllianceBuilding a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Cross-Border Indigenous Alliance Building"@en ;
    thinkr:carriedOutBy tgs:Organization.AmazonSacredHeadwatersAlliance ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GovernanceBodies, tgs:PracticeTerm.NetworkWeaving ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "The alliance is a long-horizon effort to weave together Indigenous nations on both sides of the Ecuador–Peru border—more than 30 peoples and nationalities in a region where colonial borders have often split communities and territories."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ReforestingEdibleForests a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Reforesting Edible Forests"@en ;
    thinkr:carriedOutBy tgs:Organization.AmazonSacredHeadwatersAlliance ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.RegenerativeAgriculture, tgs:PracticeTerm.VegetationPlanting ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.EcosystemRegeneration ;
    dcterms:description "A regenerative food forest project that increases biodiversity while providing economic benefits to 47 communities."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ABIFNetworkDevelopmentProgram a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "ABIF Network Development Program"@en ;
    thinkr:carriedOutBy tgs:Organization.ASPROCIG ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.NetworkWeaving, tgs:PracticeTerm.PeerLearning ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "ABIFs are family-based ecological units where each household commits to creating a beautiful, biodiverse living space that integrates cultural and ecological practices."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ProductiveEcologicalLandscapes a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Productive Ecological Landscapes"@en ;
    thinkr:carriedOutBy tgs:Organization.ASPROCIG ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.RegenerativeAgriculture ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy ;
    dcterms:description "With mentorship from established members and the broader community, each new family designs a productive landscape that meets their food and income needs while regenerating local ecosystems."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.UrbanRuralConnectionInitiative a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Urban-Rural Connection Initiative"@en ;
    thinkr:carriedOutBy tgs:Organization.ASPROCIG ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CommunityFoodAccess, tgs:PracticeTerm.LearningPrograms, tgs:PracticeTerm.ValueChainDevelopment ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "The Urban-Rural Connection Initiative creates bridges between urban and rural areas by establishing agroecological stores in urban neighborhoods, particularly in economically disadvantaged areas."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.BiofabricPlacesNetwork a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Biofabric Places Network"@en ;
    thinkr:carriedOutBy tgs:Organization.AtelierLUMA ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ConstructionAndHousing, tgs:PracticeTerm.NetworkWeaving, tgs:PracticeTerm.PeerLearning ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.ServicesAndInfrastructure, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "The Biofabric Places Network is a collaborative system of material production hubs. The network enables different bioregions to learn from each other—materials \"cooked\" in similar ways but adapted to local contexts, from Middle Eastern deserts to European cities."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ResourceTransformationAndMaterialDevelopment a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Resource Transformation and Material Development"@en ;
    thinkr:carriedOutBy tgs:Organization.AtelierLUMA ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ClothingAndProductManufacturing, tgs:PracticeTerm.MaterialsTransformation, tgs:PracticeTerm.ValueChainDevelopment ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.ServicesAndInfrastructure ;
    dcterms:description "A central focus involves identifying and transforming undervalued resources into valuable products and materials."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.SustainableBuildingDemonstration a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Sustainable Building Demonstration"@en ;
    thinkr:carriedOutBy tgs:Organization.AtelierLUMA ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ConstructionAndHousing, tgs:PracticeTerm.DemonstratorSite ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.HubsAndCenters, tgs:PracticeCluster.ServicesAndInfrastructure ;
    dcterms:description "One of their most significant projects is the comprehensive renovation of a 2,000-square-meter industrial building on the Luma Arles site."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.BayDeltaAssetMapping a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Bay Delta Asset Mapping"@en ;
    thinkr:carriedOutBy tgs:Organization.BayDeltaTrust ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.SystemsAndResourceMapping ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.MappingAndIndicators ;
    dcterms:description "The Trust leads an asset-mapping process that asks: What strengths already exist in this system—institutions, people, projects, built and natural assets—and how can they be named, mapped, and made easier for others to find and build on?"@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.BayDeltaCommunityLearningEcosystem a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Bay Delta Community Learning Ecosystem"@en ;
    thinkr:carriedOutBy tgs:Organization.BayDeltaTrust ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ImmersiveJourneys, tgs:PracticeTerm.LearningPrograms, tgs:PracticeTerm.NetworkWeaving ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "A strategic network-building initiative that combines monthly community calls highlighting local projects with Bioregional Explorers Club field trips to build direct experience of the watershed."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.BayDeltaGovernanceInnovation a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Bay Delta Governance Innovation"@en ;
    thinkr:carriedOutBy tgs:Organization.BayDeltaTrust ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.PoliticalAdvocacy ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.LegalStewardship ;
    dcterms:description "Governance innovation proceeds along four connected lines: partnering with aligned institutions; targeted education for agencies (including taking water-district officials on watershed tours); engaging private landowners in restoration; and experimenting with “partner state”–style arrangements that widen who…"@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ClimateAdaptationLearningJourney a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Climate Adaptation Learning Journey"@en ;
    thinkr:carriedOutBy tgs:Organization.BioregionalLearningCentreSouthDevon ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ImmersiveJourneys, tgs:PracticeTerm.WatershedRepair ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.EcosystemRegeneration, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Over five days, participants move through the bioregion—farms, coasts hit by flooding, river communities facing high water, sites where people are repairing roads themselves—linking water quantity and quality to everyday decisions."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.DancingInSaltMarshes a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Dancing in Salt Marshes"@en ;
    thinkr:carriedOutBy tgs:Organization.BioregionalLearningCentreSouthDevon ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ArtAndStorytelling, tgs:PracticeTerm.WatershedRepair ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.EcosystemRegeneration, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "The program pairs salt-marsh restoration and water conservation with cultural engagement—including work toward river rights charters—so ecology and culture move together rather than as separate “environmental” and “arts” tracks."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.DartingtonCharterAndDance a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Dartington Charter & Dance"@en ;
    thinkr:carriedOutBy tgs:Organization.BioregionalLearningCentreSouthDevon ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.AgreementsAndLegalInstruments, tgs:PracticeTerm.RightsOfNature ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.LegalStewardship ;
    dcterms:description "The UK's first River Charter was established at Dartington in 2019, which recognizes the river's intrinsic rights alongside its role in supporting biodiversity and community wellbeing."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.DevonDoughnutProject a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Devon Doughnut Project"@en ;
    thinkr:carriedOutBy tgs:Organization.BioregionalLearningCentreSouthDevon ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.DoughnutAssessment ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.MappingAndIndicators ;
    dcterms:description "In 2020, as the world grappled with the global pandemic, the BLC recognized an opportunity to reimagine their bioregion's future through Kate Raworth's Doughnut Economics model."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    dcterms:relation tgs:ConceptScheme.DevonDoughnut, tgs:Work.DevonDoughnutIndicatorCompilation ;
    .

tgs:Initiative.StoryOfPlace a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Story of Place"@en ;
    thinkr:carriedOutBy tgs:Organization.BioregionalLearningCentreSouthDevon ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.StoryingPlace ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.MappingAndIndicators ;
    dcterms:description "To understand the boundaries and character of their bioregion, the BLC undertook a Story of Place process, creating a layered analysis starting from geology, examining landscape and land use, rainfall patterns and soil types, but also human social history and political history."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.DunhillEcoparkDevelopmentInitiative a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Dunhill Ecopark Development Initiative"@en ;
    thinkr:carriedOutBy tgs:Organization.BioregionalWeavingAllianceIreland ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CulturalHubOrLearningCenter, tgs:PracticeTerm.DemonstratorSite, tgs:PracticeTerm.ValueChainDevelopment ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.HubsAndCenters ;
    dcterms:description "Dunhill Ecopark is a community-scale hub meant to combine living, working, learning, and enterprise: roughly 38 businesses already operate on-site, with education spaces anchoring how people encounter regenerative agriculture and reflect on environmental, social, and economic impacts together."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.FamilyLandBiodiversityIndex a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Family Land Biodiversity Index"@en ;
    thinkr:carriedOutBy tgs:Organization.BioregionalWeavingAllianceIreland ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.EcologicalMonitoring, tgs:PracticeTerm.RegenerativeAgriculture, tgs:PracticeTerm.ResultBasedMechanisms ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.MappingAndIndicators, tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "A project involving 43 farmers with the goal of ensuring at least 10% of farmland is dedicated to biodiversity while maintaining farm viability."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.RegenerativeAgricultureDemonstrationNetwork a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Regenerative Agriculture Demonstration Network"@en ;
    thinkr:carriedOutBy tgs:Organization.BioregionalWeavingAllianceIreland ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.DemonstratorSite, tgs:PracticeTerm.PeerLearning, tgs:PracticeTerm.RegenerativeAgriculture ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.HubsAndCenters, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Demonstration farms knit neighboring holdings into a learning network—sharing practices and materials in place."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.SustainableDairyIndex a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Sustainable Dairy Index"@en ;
    thinkr:carriedOutBy tgs:Organization.BioregionalWeavingAllianceIreland ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.RegenerativeAgriculture, tgs:PracticeTerm.SocioeconomicIndicators ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.MappingAndIndicators ;
    dcterms:description "Building on the FBI system, the team developed the Sustainable Dairy Index, a systematic effort to redefine success metrics in dairy farming by integrating environmental and social returns alongside financial ones."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.WaterfordBioregionalMapping a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Waterford Bioregional Mapping"@en ;
    thinkr:carriedOutBy tgs:Organization.BioregionalWeavingAllianceIreland ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CitizenOrCommunityScience, tgs:PracticeTerm.GeographicAndEcologicalMapping, tgs:PracticeTerm.SocialOrNetworkMapping ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.MappingAndIndicators, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Mapping work combines science and lived attachment. Participatory workshops ask residents where they feel emotionally tied to the territory; those insights layer onto geological base maps of river basins and land use."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.RiverErichtCatchmentRestoration a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "River Ericht Catchment Restoration"@en ;
    thinkr:carriedOutBy tgs:Organization.BioregioningTayside ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.HabitatConnectivity, tgs:PracticeTerm.VegetationPlanting, tgs:PracticeTerm.WatershedRepair ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.EcosystemRegeneration ;
    dcterms:description "The Ericht is among Europe’s most important Atlantic salmon spawning systems. Restoration finance nationally falls short of need; new policy instruments are appearing, and this project is testing how to operate in that shifting policy and funding terrain."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.StocktakeAndGapAnalysis a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Stocktake and Gap Analysis"@en ;
    thinkr:carriedOutBy tgs:Organization.BioregioningTayside ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.FinanceAssessments, tgs:PracticeTerm.SocialOrNetworkMapping ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.MappingAndIndicators, tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "Between autumn 2024 and early 2025, two directors held ten conversations with [[Dark Matter Labs]], working through fifteen dimensions of how the Tay might one day host bioregional financing facilities without being pulled into finance-as-usual.The stocktake and gap analysis summary names what followed: most effort…"@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.TaysideCommunityScienceInitiative a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Tayside Community Science Initiative"@en ;
    thinkr:carriedOutBy tgs:Organization.BioregioningTayside ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CitizenOrCommunityScience ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "As one of five NatureScot pilots, the initiative asks how community-led monitoring can strengthen resilience and regeneration—grounded in place-based knowledge, shared learning, and collective agency."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.BlueRidgeCommunityLandAgreements a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Blue Ridge Community Land Agreements"@en ;
    thinkr:carriedOutBy tgs:Organization.BlueRidgeFoodshedFund ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CollectiveOwnershipModels ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.LegalStewardship ;
    dcterms:description "Recognizing that land access is a major barrier for small-scale and BIPOC farmers in the region, the Trust is developing a land strategy based on long-term stewardship rather than speculative ownership."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.BlueRidgeFoodshedCapitalInfrastructure a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Blue Ridge Foodshed Capital Infrastructure"@en ;
    thinkr:carriedOutBy tgs:Organization.BlueRidgeFoodshedFund ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GrantsPrograms, tgs:PracticeTerm.InvestmentVehicles ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "The Trust is partnering with Abundance Capital to administer the Blue Ridge Foodshed Fund—a catalytic donor-advised fund (DAF)."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.FarmFoodAccessProgram a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Farm Food Access Program"@en ;
    thinkr:carriedOutBy tgs:Organization.BlueRidgeFoodshedFund ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CommunityFoodAccess, tgs:PracticeTerm.ValueChainDevelopment ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy ;
    dcterms:description "The Farm Food Access Program is the Trust’s lead intervention: it pays farmers for food that is then prepared or boxed for community resource centers across six counties—getting dollars onto farms while feeding neighbors through trusted front-line organizations."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.InstitutionalAndCommercialPurchasing a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Institutional and Commercial Purchasing"@en ;
    thinkr:carriedOutBy tgs:Organization.BlueRidgeFoodshedFund ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CommunityFoodAccess, tgs:PracticeTerm.RegionalSourcing, tgs:PracticeTerm.ValueChainDevelopment ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy ;
    dcterms:description "Schools, universities, and hospitals could anchor steady demand for regional farms, but procurement rules, food-safety expectations, and thin coordination often block uptake."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ProducerCenteredGovernanceDesign a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Producer-Centered Governance Design"@en ;
    thinkr:carriedOutBy tgs:Organization.BlueRidgeFoodshedFund ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GovernanceDesign ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "A core tenet of the Foodshed Trust model is that producers must play a central role in funding decisions, infrastructure design, and enterprise development."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.WNCFoodHubCollaborative a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "WNC Food Hub Collaborative"@en ;
    thinkr:carriedOutBy tgs:Organization.BlueRidgeFoodshedFund ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.RegionalSourcing, tgs:PracticeTerm.ValueChainDevelopment ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy ;
    dcterms:description "The WNC Food Hub Collaborative is a newly formed group of 10 participating food hubs across the region that collectively purchase from hundreds of local farms."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.AppalachiaCommunityCapitalDesign a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Appalachia Community Capital Design"@en ;
    thinkr:carriedOutBy tgs:Organization.BlueprintForImpact ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GrantsPrograms, tgs:PracticeTerm.InvestmentVehicles ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "Blueprint is developing community capital strategies that embed regenerative values and local decisionmaking."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.AppalachianCulturalInfrastructure a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Appalachian Cultural Infrastructure"@en ;
    thinkr:carriedOutBy tgs:Organization.BlueprintForImpact ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ArtAndStorytelling ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "The initiative supports place-based cultural work by developing a bioregional cultural infrastructure that includes arts funding, participatory storytelling projects, and partnerships with cultural institutions across the Southern Appalachians."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.CrossSectorCollaborativeInfrastructure a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Cross-Sector Collaborative Infrastructure"@en ;
    thinkr:carriedOutBy tgs:Organization.BlueprintForImpact ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.NetworkWeaving ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "Over the past two years, Blueprint has facilitated regular convenings of over 50 individuals and organizations, building shared language, governance structures, and aligned funding strategies."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.DevelopmentPortfolio a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Development Portfolio"@en ;
    thinkr:carriedOutBy tgs:Organization.BlueprintForImpact ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.PortfolioDevelopment, tgs:PracticeTerm.VentureCultivation ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "Blueprint is assembling a portfolio of investable initiatives—forests, farms and soil, health, food access, microeconomies, and arts—so funders encounter a systemic regional program rather than isolated projects."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.PostDisasterRegenerativeRecoveryModel a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Post-Disaster Regenerative Recovery Model"@en ;
    thinkr:carriedOutBy tgs:Organization.BlueprintForImpact ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.DisasterRelief, tgs:PracticeTerm.HealthAndSocialCare ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.ServicesAndInfrastructure ;
    dcterms:description "In the aftermath of devastating floods, Blueprint for Impact developed a community-rooted model of regenerative recovery."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.BosqueFractalGovernanceAndFinance a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Bosque Fractal Governance and Finance"@en ;
    thinkr:carriedOutBy tgs:Organization.BosqueFractal ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CollectiveOwnershipModels, tgs:PracticeTerm.StructuringAndCapitalization ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.LegalStewardship, tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "To protect the land and its vision beyond individual ownership, Bosque Fractal is developing a collective governance and financing model rooted in the principles of the commons."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.EcologicalRestorationOfValleDeZaquencipa a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Ecological Restoration of Valle de Zaquencipá"@en ;
    thinkr:carriedOutBy tgs:Organization.BosqueFractal ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.VegetationPlanting, tgs:PracticeTerm.WaterManagement, tgs:PracticeTerm.WatershedRepair ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.EcosystemRegeneration ;
    dcterms:description "The land at Bosque Fractal is part of a critical watershed feeding Bogotá and surrounding areas, and includes degraded zones requiring urgent care."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.RegenerativeSanctuary a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Regenerative Sanctuary"@en ;
    thinkr:carriedOutBy tgs:Organization.BosqueFractal ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CulturalAndSpiritualPractices, tgs:PracticeTerm.CulturalHubOrLearningCenter, tgs:PracticeTerm.VisitorExperiences ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.HubsAndCenters, tgs:PracticeCluster.ServicesAndInfrastructure, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "At the center of this project is a ceremonial dome built by the collective, where rituals, women's gatherings, intergenerational healing work, and arts-based events are held throughout the year."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.TheLivingAtlas a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "The Living Atlas"@en ;
    thinkr:carriedOutBy tgs:Organization.BosqueFractal ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GeographicAndEcologicalMapping, tgs:PracticeTerm.KnowledgeArtefacts, tgs:PracticeTerm.StoryingPlace ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.MappingAndIndicators ;
    dcterms:description "Bosque Fractal is developing a \"Living Atlas\"—a dynamic, participatory tool that maps the ecological, cultural, Bosque Fractal is developing a \"Living Atlas\"—a dynamic, participatory tool that maps the ecological, cultural, and spiritual dimensions of the territory."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.BurrenPeerToPeerLearningNetwork a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Burren Peer-to-Peer Learning Network"@en ;
    thinkr:carriedOutBy tgs:Organization.BurrenbeoTrust ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.NetworkWeaving, tgs:PracticeTerm.PeerLearning ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "The programme brokers farmer-to-farmer learning: who already farms for nature pairs with neighbours who want to transition."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.BurrenPublicEngagementProgram a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Burren Public Engagement Program"@en ;
    thinkr:carriedOutBy tgs:Organization.BurrenbeoTrust ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CongressingAndEvents, tgs:PracticeTerm.LearningPrograms ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Each year the winterage—moving cattle onto the mountain—draws a public ritual around transhumance."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.FarmInfrastructureSupportInitiative a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Farm Infrastructure Support Initiative"@en ;
    thinkr:carriedOutBy tgs:Organization.BurrenbeoTrust ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.FarmerSupport, tgs:PracticeTerm.GrantsPrograms ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "Targeted grants fund practical upgrades—stone walls, feeding systems, water management—that lift environmental scores and make day-to-day farming easier."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.FarmingHub a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Farming Hub"@en ;
    thinkr:carriedOutBy tgs:Organization.BurrenbeoTrust ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CulturalHubOrLearningCenter ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.HubsAndCenters ;
    dcterms:description "A local office matters: it is where farmers get plain-language guidance, paperwork help, and small “plans for nature” when they want to act but fear doing the wrong thing."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.NewRevenueDevelopment a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "New Revenue Development"@en ;
    thinkr:carriedOutBy tgs:Organization.BurrenbeoTrust ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ResultBasedMechanisms, tgs:PracticeTerm.ValueChainDevelopment, tgs:PracticeTerm.VisitorExperiences ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.ServicesAndInfrastructure, tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "Farmers now earn from work the landscape needs: restoring drystone walls (sometimes through local enterprises built around that craft), hosting visitors who want the story from the people who farm the land, and —in Wild Atlantic Nature—paid crews (for example) controlling invasive rhododendron several days a week."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ResultsBasedFarmingProgram a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Results-Based Farming Program"@en ;
    thinkr:carriedOutBy tgs:Organization.BurrenbeoTrust ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.EcologicalMonitoring, tgs:PracticeTerm.RegenerativeAgriculture, tgs:PracticeTerm.ResultBasedMechanisms ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.MappingAndIndicators, tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "The programme puts a price on good management through results-based payments. A rapid field assessment scores each parcel out of 10 for overall condition—biodiversity, water, soil, invasive pressure, and related indicators."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.DeshkanZiibiConservationImpactBond a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Deshkan Ziibi Conservation Impact Bond"@en ;
    thinkr:carriedOutBy tgs:Organization.CarolinianCanada ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ResultBasedMechanisms, tgs:PracticeTerm.TraditionalEcologicalKnowledge, tgs:PracticeTerm.VegetationPlanting ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.EcosystemRegeneration, tgs:PracticeCluster.SystemicFinance, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "The Deshkan Ziibi Conservation Impact Bond (DZCIB) links investor repayment to five holistic outcome streams —habitat, knowledge/circling, economy, relational connection, and ecocentric wellbeing—rather than treating ecology as the only ledger."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.HealthyLandscapeStrategy a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Healthy Landscape Strategy"@en ;
    thinkr:carriedOutBy tgs:Organization.CarolinianCanada ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.HabitatConnectivity, tgs:PracticeTerm.TraditionalEcologicalKnowledge, tgs:PracticeTerm.VegetationPlanting ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.EcosystemRegeneration, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Carolinian Canada's Healthy Landscape Strategy aims to grow Canada's Biggest Wildlife Garden connecting Toronto to Windsor with healthy habitat."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.InTheZoneHabitatTracker a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "In the Zone Habitat Tracker"@en ;
    thinkr:carriedOutBy tgs:Organization.CarolinianCanada ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CitizenOrCommunityScience ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Since most of the land in the region is privately owned, landowners in the Carolinian Zone play an instrumental role in habitat sustainability."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.BioregionalFinancingFacilityDevelopment a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Bioregional Financing Facility Development"@en ;
    thinkr:carriedOutBy tgs:Organization.CEDPO ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GrantsPrograms, tgs:PracticeTerm.InvestmentVehicles ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "A bioregional funding mechanism currently in development, the CEDPO Financing Facility is designed to receive donations and investments from Costa Rican donors, the Costa Rican government, and international sources."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.MultiStakeholderGovernance a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Multi-Stakeholder Governance"@en ;
    thinkr:carriedOutBy tgs:Organization.CEDPO ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GovernanceBodies ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "CEDPO’s governance is nested and statutory: a national rural-development mandate, university research capacity, an NGO fiscal backbone, and a territorial council (SETO) that mixes elected municipal and community seats—including Indigenous representation—so decisions stay accountable to place."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ParticipatorySystemsMapping a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Participatory Systems Mapping"@en ;
    thinkr:carriedOutBy tgs:Organization.CEDPO ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.SystemsAndResourceMapping ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.MappingAndIndicators ;
    dcterms:description "The foundation for CEDPO was laid through a participatory systems mapping process initiated in 2015, led by Regenerative Earth in collaboration with local communities and Indigenous groups."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ProjectPortfolioDevelopment a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Project Portfolio Development"@en ;
    thinkr:carriedOutBy tgs:Organization.CEDPO ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.PortfolioDevelopment, tgs:PracticeTerm.TraditionalEcologicalKnowledge, tgs:PracticeTerm.VentureCultivation ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.SystemicFinance, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "CEDPO has backed about 15 initiatives chosen through its systems map—spanning environment, society, and economy."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.BioregionalizationCourseDevelopment a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Bioregionalization Course Development"@en ;
    thinkr:carriedOutBy tgs:Organization.ColombiaRegenerativa ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.LearningPrograms ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Recognizing the need for broader learning, Colombia Regenerativa is developing a course in bioregionalization where conversations serve as a fundamental design element."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.NetworkBuildingAndLearningExchange a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Network Building and Learning Exchange"@en ;
    thinkr:carriedOutBy tgs:Organization.ColombiaRegenerativa ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.NetworkWeaving, tgs:PracticeTerm.PeerLearning ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "A network structure has formed organically: the team connects organizations and actors running regenerative initiatives—in any dimension—to bioregional networks inside Colombia and to the Global Network of Regenerative Communities, so lessons travel horizontally rather than staying project-bound."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ThreeRingsEvaluationProcess a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Three Rings Evaluation Process"@en ;
    thinkr:carriedOutBy tgs:Organization.ColombiaRegenerativa ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.SystemsAndResourceMapping ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.MappingAndIndicators ;
    dcterms:description "In 2021, Colombia Regenerativa undertook a systematic evaluation process with seven bioregions across Colombia."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.VirtualGaiaDigitalMappingPlatform a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Virtual Gaia Digital Mapping Platform"@en ;
    thinkr:carriedOutBy tgs:Organization.ColombiaRegenerativa ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GeographicAndEcologicalMapping, tgs:PracticeTerm.KnowledgeArtefacts ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.MappingAndIndicators ;
    dcterms:description "Colombia Regenerativa is developing Virtual Gaia, a collaborative project with Costa Rica to create a digital mapping platform where all bioregions in a country—or anywhere on the globe—can be localized."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.CommunityEngagementAndEducation a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Community Engagement and Education"@en ;
    thinkr:carriedOutBy tgs:Organization.ComunidadIndigenaJoseLuisCaniulef ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CitizenOrCommunityScience, tgs:PracticeTerm.LearningPrograms ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "At Colegio Virgen de la Candelaria, workshops linked students to their environmental heritage."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.EcologicalAssessmentAndMonitoring a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Ecological Assessment and Monitoring"@en ;
    thinkr:carriedOutBy tgs:Organization.ComunidadIndigenaJoseLuisCaniulef ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CitizenOrCommunityScience, tgs:PracticeTerm.EcologicalMonitoring, tgs:PracticeTerm.GeographicAndEcologicalMapping ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.MappingAndIndicators, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "In 2022, researchers and community members sampled macroinvertebrates in three Cruces tributaries—Colico, Afunalhue, and Petrohue."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.OralHistoryCollectionAndMemoryMapping a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Oral History Collection and Memory Mapping"@en ;
    thinkr:carriedOutBy tgs:Organization.ComunidadIndigenaJoseLuisCaniulef ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.StoryingPlace, tgs:PracticeTerm.TraditionalEcologicalKnowledge ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.MappingAndIndicators, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "In trawün (community meetings), elders remembered when *pitrales* and *gualves*, *canelos* and *lumas* dominated the land—recorded in this account—along with stories of change, place, and legends such as the Girl of the Radales, who appears to those who walk the radal groves."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ParticipatoryStrategyDevelopment a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Participatory Strategy Development"@en ;
    thinkr:carriedOutBy tgs:Organization.ComunidadIndigenaJoseLuisCaniulef ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GovernanceBodies, tgs:PracticeTerm.ParticipatoryStrategies ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "To move past only fighting emergencies, the community began a participatory strategy in 2021—spanning community, commune, region, and beyond, with an eye on water that reaches the sea: regeneration imagined from community to ocean."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.CommunityFoodSecurityProject a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Community Food Security Project"@en ;
    thinkr:carriedOutBy tgs:Organization.CostaRicaRegenerativa ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CommunityFoodAccess, tgs:PracticeTerm.RegenerativeAgriculture ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy ;
    dcterms:description "When COVID-19 stopped tourism in Guanacaste, Costa Rica Regenerativa mobilized 500 farming families in a belt skeptics had called unsuitable for vegetables."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.EducationalHive a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Educational Hive"@en ;
    thinkr:carriedOutBy tgs:Organization.CostaRicaRegenerativa ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.LearningPrograms ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Muñoz sees formal education as misaligned with present needs; the Hive, built with Ugal, links experts, learners, and bioregions for applied projects, with achievements logged in a passport-style record."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.MRVCollectiveDevelopment a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "MRV Collective Development"@en ;
    thinkr:carriedOutBy tgs:Organization.CostaRicaRegenerativa ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.EcologicalMonitoring ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.MappingAndIndicators ;
    dcterms:description "The MRV Collective (measurement, reporting, verification) seeks transparency for regenerative outcomes."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.RegenerativeAgricultureProgram a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Regenerative Agriculture Program"@en ;
    thinkr:carriedOutBy tgs:Organization.CostaRicaRegenerativa ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.RegenerativeAgriculture, tgs:PracticeTerm.VegetationPlanting ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.EcosystemRegeneration ;
    dcterms:description "The program works through technical schools, pairing demonstration sites, student training, and carbon finance for fences and water."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.SavoryHubInitiative a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Savory Hub Initiative"@en ;
    thinkr:carriedOutBy tgs:Organization.CostaRicaRegenerativa ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.HabitatConnectivity, tgs:PracticeTerm.RegenerativeGrazing ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.EcosystemRegeneration ;
    dcterms:description "The Savory Hub work targets 380,000 regional cattle hectares. Farmers who dedicate 15–30% as corridors can sharply raise returns while giving land back to wild connectivity."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ArchetypeBasedPlanning a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Archetype-Based Planning"@en ;
    thinkr:carriedOutBy tgs:Organization.CurridabatSweetCity ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ParticipatoryStrategies ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "Curridabat used archetypes—stand-in beings whose needs and experiences shape the story of a place—to surface gaps between today and a desired future and to support backcasting and sequencing of change."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.GovernancePlatformMethodology a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Governance Platform Methodology"@en ;
    thinkr:carriedOutBy tgs:Organization.CurridabatSweetCity ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GovernanceDesign ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "Strong pilots often stall because they lack governance that can carry them. Curridabat’s answer was a methodological bet on platforms—shared systems many projects can join."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.PollinatorCitizenshipProgram a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Pollinator Citizenship Program"@en ;
    thinkr:carriedOutBy tgs:Organization.CurridabatSweetCity ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GovernanceDesign, tgs:PracticeTerm.InterspeciesMutualism, tgs:PracticeTerm.RightsOfNature ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.EcosystemRegeneration, tgs:PracticeCluster.LegalStewardship ;
    dcterms:description "The city treated the pollination system as an active partner—an alliance that fed information back into governance."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.DiamanteBioregionalTrustDevelopment a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Diamante Bioregional Trust Development"@en ;
    thinkr:carriedOutBy tgs:Organization.DiamanteBaruBioregionalConsortium ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GrantsPrograms, tgs:PracticeTerm.InvestmentVehicles ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "The Diamante Bioregional Trust is a community-aligned capital channel aimed at grassroots regenerative action."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.DiamanteLuz a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Diamante Luz"@en ;
    thinkr:carriedOutBy tgs:Organization.DiamanteBaruBioregionalConsortium ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CulturalHubOrLearningCenter, tgs:PracticeTerm.DemonstratorSite, tgs:PracticeTerm.RegenerativeAgriculture ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.HubsAndCenters ;
    dcterms:description "The collective describes Diamante Luz as its first on-the-ground node: shared land for permaculture and common resources, where residents, neighbors, and visitors co-create ways of living and working with nonhuman relations."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ParticipatoryGovernanceDevelopment a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Participatory Governance Development"@en ;
    thinkr:carriedOutBy tgs:Organization.DiamanteBaruBioregionalConsortium ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CommonsGovernanceProtocols, tgs:PracticeTerm.GovernanceBodies ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "Governance is described as a living braid of sociocratic practice and Indigenous decision-making—listening from many directions, elders and local communities in the weave, sociocratic circles with shared representation, and decentralized, transparent mechanisms for deciding and acting."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.RECenterTheResourceRecyclingCenterSanSalvador a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "RECenter the Resource Recycling Center San Salvador"@en ;
    thinkr:carriedOutBy tgs:Organization.DiamanteBaruBioregionalConsortium ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.LearningPrograms, tgs:PracticeTerm.MaterialsTransformation ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "RECenter gathers recyclable and repurposable material for the local community and runs education on how everyday choices shape impacts."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.SacredShieldInitiative a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Sacred Shield Initiative"@en ;
    thinkr:carriedOutBy tgs:Organization.DiamanteBaruBioregionalConsortium ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.TerritorialMonitoring ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.MappingAndIndicators ;
    dcterms:description "Sacred Shield puts Indigenous-led protection teams on the ground: regenerative education, long-term biocultural sovereignty, and capital that can move with frontline priorities."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.HalaTraditionalAgricultureMapping a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Hala Traditional Agriculture Mapping"@en ;
    thinkr:carriedOutBy tgs:Organization.EnlivenedCooperative ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.GeographicAndEcologicalMapping, tgs:PracticeTerm.TerritorialZoning, tgs:PracticeTerm.TraditionalEcologicalKnowledge ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.LegalStewardship, tgs:PracticeCluster.MappingAndIndicators, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Traditional Hawaiian land management is a layered bioregional system. At broad scale, moku were political regions aligned with environmental gradients (temperature, sun, rain), shaping how entire landscapes were used."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.TraditionalKnowledgeInGovernance a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Traditional Knowledge in Governance"@en ;
    thinkr:carriedOutBy tgs:Organization.EnlivenedCooperative ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.AgreementsAndLegalInstruments, tgs:PracticeTerm.GrantsPrograms, tgs:PracticeTerm.PoliticalAdvocacy ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.LegalStewardship, tgs:PracticeCluster.SystemicFinance ;
    dcterms:description "The cooperative is entering a cooperative service agreement with the Natural Resource Conservation Service (NRCS) so these bioregional models can guide program funding—for example, funding agroforestry only where traditional practice indicates agroforestry fits, avoiding projects that mismatch place."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.StrategyGames a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Strategy Games"@en ;
    thinkr:carriedOutBy tgs:Organization.ETHZurich ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ParticipatoryStrategies ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "From 2023-2025, a strategy game was implemented in the Ericht catchment bioregion. The process began with listening to diverse stakeholders—farmers, anglers, land managers, estate owners, and community leaders —to understand their roles and perceptions."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.FindhornWatershedDeerForum a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Findhorn Watershed Deer Forum"@en ;
    thinkr:carriedOutBy tgs:Organization.FindhornWatershedInitiative ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.ParticipatoryStrategies, tgs:PracticeTerm.PoliticalAdvocacy, tgs:PracticeTerm.SpeciesControl ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.EcosystemRegeneration, tgs:PracticeCluster.LegalStewardship ;
    dcterms:description "The Catchment Deer Forum aligns stalkers, gamekeepers, and other land managers so deer densities support both woodland regeneration and viable stalking."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.GaelicCulturalHeritage a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Gaelic Cultural Heritage"@en ;
    thinkr:carriedOutBy tgs:Organization.FindhornWatershedInitiative ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CulturalAndSpiritualPractices ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "A flagship Nature Connection strand is the human ecology residency with Ranish Sandland and Mary Macfadden—Gaelic-speaking researchers in the upper catchment who recovered songs, stories, and place names, including archival material not performed for centuries, returned to local use."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.MonitoringStrategy a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Monitoring Strategy"@en ;
    thinkr:carriedOutBy tgs:Organization.FindhornWatershedInitiative ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CitizenOrCommunityScience, tgs:PracticeTerm.EcologicalMonitoring, tgs:PracticeTerm.SocioeconomicIndicators ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.MappingAndIndicators, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Monitoring pairs formal science with in-context participation: “cold” metrics and “warm” observation together describe watershed condition."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.RiparianWatershedRecovery a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Riparian Watershed Recovery"@en ;
    thinkr:carriedOutBy tgs:Organization.FindhornWatershedInitiative ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.HabitatConnectivity, tgs:PracticeTerm.VegetationPlanting, tgs:PracticeTerm.WatershedRepair ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.EcosystemRegeneration ;
    dcterms:description "Salmon offered a practical entry: a ready stakeholder base and steep declines—a pattern across Scotland, not only the Findhorn."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.TrainingAndGreenJobs a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Training & Green Jobs"@en ;
    thinkr:carriedOutBy tgs:Organization.FindhornWatershedInitiative ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.TrainingAndEmploymentPathways ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.ServicesAndInfrastructure ;
    dcterms:description "Workstreams test how skills training, environmental credits, and rural job pathways can align—linking restoration and land work to livelihoods and, where relevant, to housing stability in scattered communities."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.HumanElephantHarmony a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Human-Elephant Harmony"@en ;
    thinkr:carriedOutBy tgs:Organization.ForeverSabah ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CitizenOrCommunityScience, tgs:PracticeTerm.MoreThanHumanKnowledge, tgs:PracticeTerm.ParticipatoryStrategies ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Since 2016, Human-Elephant Harmony has worked with Dusun communities, agencies, and partners to treat conflict as a coexistence problem."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.LearningAndCapacityBuilding a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Learning and Capacity Building"@en ;
    thinkr:carriedOutBy tgs:Organization.ForeverSabah ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CulturalHubOrLearningCenter, tgs:PracticeTerm.LearningPrograms ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.HubsAndCenters, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "Forever Sabah Institute prototypes ways to strengthen people in the network as changemakers—blurring lines between theory and practice, student and teacher, local and global, classroom and field."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.LegalInnovationAndPolicyDevelopment a thinkr:Initiative, owl:NamedIndividual ;
