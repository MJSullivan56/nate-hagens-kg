tgs:Monologue.Frankly_85_TheLightTriad a thinkr:Episode, owl:NamedIndividual ;
    thinkr:createdDate "2026-08-13"^^xsd:date ;
    thinkr:updatedDate "2026-08-13"^^xsd:date ;
    thinkr:hasEpisodeType thinkr:EpisodeType.Monologue ;
    thinkr:hasEpisodeSegment tgs:EpisodeSegment.Frankly ;
    skos:prefLabel "The Light Triad"@en ;
    skos:definition "Nate's own solo exploration of Scott Barry Kaufman's 'Light Triad' (faith in humanity, humanism, Kantianism) as a real but structurally weaker counterweight to the Dark Triad — arguing traits generally outcompete values, so a lone Light Triad individual will be exploited by a Dark Triad one, and only real, mutually-supporting groups (not just individual goodness) stand a chance. Closes with open questions he doesn't resolve: how many people does a Light Triad individual need around them for real protection, whether Dark Triad prevalence rises or falls as the Carbon Pulse declines, and whether a Dark Triad personality can genuinely change."@en ;
    dct:created "2025-02-12"^^xsd:date ;
    dct:issued "2025-02-14"^^xsd:date ;
