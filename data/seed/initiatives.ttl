    thinkr:listedInPracticeCluster tgs:PracticeCluster.EcosystemRegeneration, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "A long-horizon campaign targets 749,000+ native trees on degraded ancestral land—guided by Indigenous ecological knowledge, aimed at biodiversity, food sovereignty, and climate resilience."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.SustainableEthnobotanicalsResearchProgram a thinkr:Initiative, owl:NamedIndividual ;
