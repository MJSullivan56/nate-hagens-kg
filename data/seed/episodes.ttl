tgs:Interview.TGS_165_WisdomOverPower dct:references tgs:Interview.TGS_85_WisdomNatureAndTheBrain .

#############################################
# thinkr:Series stub example — "How to Think About the Future", real
# confirmed Frankly numbers (138, 139, 145 — non-sequential, other Frankly
# episodes fall between them, which is genuine real numbering, not an
# error) from the exact Frankly-number matching work earlier tonight.
# STUBS, not fully fleshed out: no dct:created/issued, no
# hasCanonicalSource/hasReplay/hasTranscript yet — only what's needed to
# demonstrate the Series/seriesPosition relationship itself. Flesh out
# properly (same depth as Episodes 226/85/165/217) before treating these
# as complete.
#############################################

tgs:Series.HowToThinkAboutTheFuture a thinkr:Series, dcmitype:Collection, owl:NamedIndividual ;
    dct:hasPart 
        tgs:Monologue.Frankly_138_Part1ChangingTheFuture, 
        tgs:Monologue.Frankly_139_Part2FourVariables, 
        tgs:Monologue.Frankly_145_Part3UphillFutures, 
        tgs:Monologue.Frankly_148_Part4CompositeWorlds, 
        tgs:Monologue.Frankly_150_Part5PersonalLandscapes, 
        tgs:Monologue.Frankly_151_Part6PlanningUnderUncertainty ;
    skos:prefLabel "How to Think About the Future"@en ;
    rdfs:comment "6-part Frankly series (Frankly #138/139/145/148/150/151), confirmed complete 2026-07-15/16 via all 6 real transcripts. Grew organically, same pattern as Bend Not Break below — Part 4's own opening notes the series kept getting longer than planned, and Part 5 was originally meant to be the finale before Hagens split it into a personal-application aside (Part 5) plus a separate planning-methodology closer (Part 6). Part 4 is the framework-defining episode (the 4-Dimension/16-Facet/256-combination scenario matrix, modeled in scenariodimensions.ttl/scenariofacets.ttl/scenarios.ttl) — Parts 1-3 build the conceptual groundwork (holding the future as a landscape of possibilities; the 4 grids themselves; a valleys/ridges/switchbacks/erosion landscape metaphor), Parts 5-6 apply it (to individual lives; to real-world planning/action under uncertainty)."@en ;
    .
# ^ explicit inverse of each member's dct:isPartOf below — same reasoner
# caveat as convergesWith earlier tonight: dct:hasPart/dct:isPartOf are
# genuine DCTERMS inverses, but without a reasoner, only asserting one
# direction means the Collection itself has no queryable list of its own
# members. Both directions asserted here for exactly that reason.

tgs:Series.BendNotBreak a thinkr:Series, dcmitype:Collection, owl:NamedIndividual ;
    dct:hasPart 
        tgs:Interview.TGS_5_BendNotBreakPart1, 
        tgs:Interview.TGS_20_MaximumPowerHyperAgents, 
        tgs:Interview.TGS_31_SensemakingUncertaintyPurpose, 
        tgs:Interview.TGS_42_ModelingDriversMetacrisis, 
        tgs:Interview.TGS_50_CriteriaCategoriesResponse ;
    skos:prefLabel "Bend Not Break"@en ;
    rdfs:comment "Discovered 2026-07-13 while verifying 3 previously-unrelated Schmachtenberger episode entries — turned out to be a real, distinct 5-part series never before modeled. Confirmed via Nate's own words (a Substack post about Part 3) that the series wasn't originally planned as 5 parts — it grew organically from conversation, first to 4 planned parts, then 5 once Part 3 diverged from its intended topic."@en ;
    .

tgs:Monologue.Frankly_138_Part1ChangingTheFuture a thinkr:Episode, owl:NamedIndividual ;
    thinkr:hasEpisodeType thinkr:EpisodeType.Monologue ;
    thinkr:hasEpisodeSegment tgs:EpisodeSegment.Frankly ;
    skos:prefLabel "How to Think About the Future (Part 1): Changing the Future Starts with How You Think"@en ;
    skos:definition "Opens the series by naming a pattern Hagens says he hears repeatedly from the audience: people who have already settled on one storyline about the future and filter everything else through it. Introduces Scenario Thinking as the alternative, names 3 reasons holding multiple futures at once is hard in practice (the nervous system wants resolution, careers/identities attach to particular futures, cultural incentives reward confident stories over honest uncertainty), and closes by introducing Shortfall Risk, which the episode's own description states will act as connective tissue across the rest of the series."@en ;
    dct:created "2026-04-11"^^xsd:date ;
    dct:issued "2026-04-17"^^xsd:date ;
    dct:subject tgs:Subject.HumanBehavior, tgs:Subject.SystemsScience ;
    thinkr:hasHost tgs:Persona.NateHagens ;
    dct:isPartOf tgs:Series.HowToThinkAboutTheFuture ;
    thinkr:seriesPosition 1 ;
    thinkr:hasCanonicalSource <https://www.thegreatsimplification.com/frankly-original/138-how-to-think-about-the-future-part-1> ;
    thinkr:hasReplay <https://youtu.be/vgq_6GIHmCA> ;
    thinkr:hasTranscript <https://www.thegreatsimplification.com/wp-content/uploads/2026/04/Frankly-138-Transcript-How-to-Think-About-the-Future-Part-1.pdf> ;
    dct:source <https://natehagens.substack.com/p/essay-how-to-think-about-the-future> ;
    thinkr:discusses
        tgs:Concept.GreatSimplification,
        tgs:Concept.Wetware,
        tgs:Concept.TerrorManagementTheory,
        tgs:Concept.ShortfallRisk,
        tgs:Concept.ScenarioThinking,
        tgs:Concept.MoreThanHumanPredicament,
        tgs:Concept.NarrativeAsActiveInference,
        tgs:Concept.Rebuildables,
        tgs:Concept.ComplexSystemsThinking ;
    dct:references
        tgs:Organization.TheOilDrum,
        tgs:Monologue.Frankly_129_DesperatelySeekingAgency,
        tgs:Monologue.Frankly_132_FrameworkForAction,
        tgs:Interview.TGS_85_WisdomNatureAndTheBrain,
        tgs:Interview.TGS_165_WisdomOverPower,
        tgs:Work.ComplexityAndPostmodernism,
        tgs:Work.GlobalTippingPointsReport2025 ;
    skos:scopeNote "REBUILT 2026-08-13 from Frankly_138's own official show-notes page (thegreatsimplification.com/frankly-original/138-...) — a real, structured, WordPress-generated per-episode topic index Hagens' team maintains, discovered this session as a much stronger extraction source than transcript-reading or generic NER. Every thinkr:discusses/dct:references link above traces to a specific labeled entry in that page, not inferred. Fixed 2 real bugs from this stub's first draft: thinkr:hasCanonicalSource was used twice (its own scopeNote documents cardinality-one; the essay link now correctly uses the general dct:source instead) and was typed as an xsd:anyURI string literal rather than a proper linked resource (thinkr:hasCanonicalSource is declared owl:ObjectProperty, not a datatype property — every other use of it in this graph uses a bare IRI)."@en .

tgs:Monologue.Frankly_139_Part2FourVariables a thinkr:Episode, owl:NamedIndividual ;
    thinkr:hasEpisodeType thinkr:EpisodeType.Monologue ;
    thinkr:hasEpisodeSegment tgs:EpisodeSegment.Frankly ;
    skos:prefLabel "How to Think About the Future (Part 2): Four Variables Shaping the Coming Decades"@en ;
    skos:definition "2ND PASS 2026-08-13, using the full real transcript (previously built from show notes only). This is the episode that formally introduces the complete 4-Dimension/16-Facet scenario framework this graph's own ScenarioDimension/ScenarioFacet structure is built from — Nate treats his long-standing 4-scenario Economic grid (Green Growth, Mordor, The Great Simplification, Mad Max) as the foundation, then layers three more grids on top: Power and Distribution (concentration of decision-making authority vs. where material gains flow), Geopolitical (cooperation vs. adversarial relations, crossed with interdependence vs. self-sufficiency), and Earth Systems (climate stress vs. biosphere integrity, explicitly from an already-compromised 2026 baseline, not a neutral one). Technology and demographics are both explicitly considered and deliberately NOT given their own grids — Nate argues both act as modifiers/amplifiers of whatever direction the underlying system is already moving, rather than independent dimensions."@en ;
    thinkr:hasHost tgs:Persona.NateHagens ;
    dct:isPartOf tgs:Series.HowToThinkAboutTheFuture ;
    thinkr:seriesPosition 2 ;
    dct:created "2026-04-20"^^xsd:date ;
    dct:issued "2026-04-24"^^xsd:date ;
    dct:subject tgs:Subject.HumanBehavior, tgs:Subject.SystemsScience ;
    thinkr:hasCanonicalSource <https://www.thegreatsimplification.com/frankly-original/139-how-to-think-about-the-future-part-2> ;
    thinkr:hasTranscript <https://www.thegreatsimplification.com/wp-content/uploads/2026/04/Frankly-139-Transcript-How-to-Think-About-the-Future-Part-2.pdf> ;
    thinkr:hasReplay <https://youtu.be/5R0oUGPf9C4> ;
    dct:source <https://natehagens.substack.com/p/essay-how-to-think-about-the-future-92e> ;
    thinkr:discusses tgs:SchoolOfThought.PlanetaryBoundaries, tgs:Concept.CarbonPulse, tgs:Concept.Superorganism,
        tgs:ScenarioFacet.GreenGrowth, tgs:ScenarioFacet.Mordor, tgs:ScenarioFacet.TheGreatSimplification, tgs:ScenarioFacet.MadMax,
        tgs:ScenarioFacet.CivicIdeal, tgs:ScenarioFacet.TheStewardshipDeal, tgs:ScenarioFacet.ACapturedDemocracy, tgs:ScenarioFacet.ForcedFeudalism,
        tgs:ScenarioFacet.TheGlobalizationIdeal, tgs:ScenarioFacet.FriendlyNeighborsWithGoodFences, tgs:ScenarioFacet.TheGeopoliticalDangerZone, tgs:ScenarioFacet.TheColdWarScenario,
        tgs:ScenarioFacet.StrainedButWorkable, tgs:ScenarioFacet.QuietUnraveling, tgs:ScenarioFacet.HothouseTriage, tgs:ScenarioFacet.CascadingBreakdown ;
    dct:references tgs:Persona.DanielSchmachtenberger, tgs:Series.BendNotBreak, tgs:Interview.TGS_12_DennisMeadows, tgs:Work.ScenarioThinkingHistoricalEvolution ;
    skos:scopeNote "2ND PASS 2026-08-13 — MJSullivan flagged this as 'the key episode that describes these quadrants' given the axis-correction work done this session (see ScenarioDimension.Economic and ScenarioDimension.Geopolitical's own scopeNotes), and supplied the full transcript for a proper enrichment pass rather than relying on show notes alone. discusses list corrected from the original single tgs:Concept.GreatSimplification (now split into Concept + ScenarioFacet — see that split's own history) to the specific tgs:ScenarioFacet.TheGreatSimplification, and substantially expanded: this episode is the real primary source for all 16 ScenarioFacets across all 4 Dimensions, not just the original 4 Economic ones it had been scoped to before this pass. tgs:Concept.Superorganism added as a real, direct reference — Hagens' own words describing the Cold War Facet as 'the fission of the Superorganism.' Real, further citable material found but NOT built in this pass: 'Fire apes' (a real recurring Reality Blind term, cited directly to a specific page); the real statistic that 26 people hold the same financial claims on biophysical reality as the bottom 4 billion humans (sourced to a real Oxfam report); Concept.DarkTriad already built elsewhere in this graph is referenced again here but not formally dct:referenced in this pass, to avoid overloading a single episode's reference list without a clear stopping point. hasCanonicalSource fixed 2026-08-13 (original 1st-pass note, still accurate) — same xsd:anyURI-literal-instead-of-proper-resource bug originally found and fixed on Frankly_138, never applied to the rest of this series until now."@en ;
    thinkr:hasDiscussionSummary "A genuinely foundational episode for this graph's own scenario-matrix structure, not just another Frankly. Nate opens by directly naming a cognitive trap — settling on one preferred future and then judging everything else against it — and argues for holding a real distribution of possible futures instead. The four-grid structure is built up methodically and explicitly incompletely: Nate states outright that technology and demographics were both considered for their own separate grids and deliberately excluded, arguing both function as amplifiers of whatever direction the underlying system is already moving rather than independent axes — AI specifically is framed as already inside the Earth Systems grid, since data-center electricity demand is itself a direct new draw on the energy/biophysical system the whole framework is built around. A real, distinctive moment of self-aware epistemic humility: Nate explicitly invites the audience to propose grids he hasn't considered, naming mental/physical health and freedom of information/communication as real candidates he chose not to include. The Geopolitical grid's own real-time grounding is notable — recorded during the actual 2026 Iran war and Strait of Hormuz closure, Nate uses that live, unfolding event as a direct real-world example of the 'adversarial and interdependent' quadrant, citing the Philippines' energy emergency, Bangladesh's school closures, and Japan's emergency oil-reserve release as concurrent real evidence. Nate draws a real, pointed distinction between what a contraction-vs-growth headline means for the 'fairness' question (during growth) versus the 'is there enough' question (during contraction) — the same quadrant axes, he argues, describe a fundamentally different lived experience depending on which economic direction they're paired with. The episode closes by explicitly refusing to let any single quadrant stand as a full future on its own — Nate states directly that nobody will 'live in The Great Simplification in general,' only in a Great Simplification combined with a specific power structure, geopolitical backdrop, and ecological condition, previewing Part 3's work building concrete scenario composites from these four layers."@en ;
    .

tgs:Monologue.Frankly_145_Part3UphillFutures a thinkr:Episode, owl:NamedIndividual ;
    thinkr:hasEpisodeType thinkr:EpisodeType.Monologue ;
    thinkr:hasEpisodeSegment tgs:EpisodeSegment.Frankly ;
    skos:prefLabel "How to Think About the Future (Part 3): Uphill Futures in a Downhill World"@en ;
    skos:definition "Introduces a landscape metaphor (borrowed from developmental biology's Waddington landscape and lake-ecology succession) for thinking about civilizational futures: valleys (stable states systems settle into), ridges (the barriers/cost of transitioning between them), switchbacks (deliberate human effort — trust-building, institution-building — that makes an otherwise-too-steep transition possible), and erosion (neglect or active harm that makes a transition permanently harder). Central claim: the easiest-to-reach futures are not the same as the most desirable ones — desirable futures generally require sustained uphill effort to both reach and remain in, while undesirable ones tend to be the default downhill path requiring no coordinated effort at all."@en ;
    thinkr:hasHost tgs:Persona.NateHagens ;
    dct:isPartOf tgs:Series.HowToThinkAboutTheFuture ;
    thinkr:seriesPosition 3 ;
    dct:created "2026-05-22"^^xsd:date ;
    dct:issued "2026-06-05"^^xsd:date ;
    dct:subject tgs:Subject.HumanBehavior ;
    thinkr:hasCanonicalSource <https://www.thegreatsimplification.com/frankly-original/145-how-to-think-about-the-future-part-3> ;
    thinkr:hasTranscript <https://www.thegreatsimplification.com/wp-content/uploads/2026/06/Frankly-145-Transcript-HTTATF-Pt-3.docx.pdf> ;
    thinkr:hasReplay <https://youtu.be/vTBQ1AS-KVw> ;
    dct:source <https://natehagens.substack.com/p/essay-uphill-futures-in-a-downhill> ;
    thinkr:discusses tgs:Concept.TheSenecaEffect, tgs:Concept.LandscapeOfPossibleFutures, tgs:Concept.Metacrisis, tgs:Concept.ShortfallRisk ;
    skos:scopeNote "2026-08-13: real dates/subject/replay/essay added, transcript URL corrected (real URL uses a different month folder AND retains a .docx.pdf double-extension — the pattern-matched guess used across this whole series turned out inconsistent with the real site for parts 3/5/6, confirmed only via direct page fetches, not assumed)."@en ;
    .

tgs:Monologue.Frankly_148_Part4CompositeWorlds a thinkr:Episode, owl:NamedIndividual ;
    thinkr:hasEpisodeType thinkr:EpisodeType.Monologue ;
    thinkr:hasEpisodeSegment tgs:EpisodeSegment.Frankly ;
    skos:prefLabel "How to Think About the Future (Part 4): Mordor to the Long Repair - How Might Daily Life Feel in the Next Decades?"@en ;
    skos:definition "The framework-defining episode of this series: proposes 4 Dimensions (grids) - Economic, Power & Distribution, Geopolitical, Earth Systems - each with 4 Facet options, for 256 mathematically possible composite futures, and builds out 4 representative named examples in detail (The Long Repair, Mordor Persists, Fortress World, The Unraveling - modeled as thinkr:Scenario individuals in scenarios.ttl). Explicit that these 4 are chosen to stretch thinking, not presented as an exhaustive or equally-likely set, and that the real future will likely be some regional patchwork of all of them rather than any single one holding globally."@en ;
    thinkr:hasHost tgs:Persona.NateHagens ;
    dct:isPartOf tgs:Series.HowToThinkAboutTheFuture ;
    thinkr:seriesPosition 4 ;
    dct:created "2026-06-09"^^xsd:date ;
    dct:issued "2026-06-25"^^xsd:date ;
    dct:subject tgs:Subject.HumanBehavior ;
    thinkr:hasCanonicalSource <https://www.thegreatsimplification.com/frankly-original/148-how-to-think-about-the-future-part-4> ;
    thinkr:hasTranscript <https://www.thegreatsimplification.com/wp-content/uploads/2026/06/Frankly-148-Transcript-How-to-Think-About-the-Future-Part-4.pdf> ;
    thinkr:hasReplay <https://youtu.be/KlkAeQ5xdeQ> ;
    dct:source <https://natehagens.substack.com/p/mordor-to-the-long-repair-how-might> ;
    thinkr:discusses tgs:Concept.ShortfallRisk, tgs:Concept.ScenarioThinking, tgs:Concept.GreatSimplification, tgs:Concept.Superorganism, tgs:Concept.MoreThanHumanPredicament, tgs:Scenario.GS-CI-FN-SW, tgs:Scenario.MO-CD-GD-QU, tgs:Scenario.GS-FF-CW-HT, tgs:Scenario.MM-FF-CW-CB ;
    dct:references tgs:Interview.TGS_27_JoeTainter, tgs:Monologue.Frankly_140_APerspectiveFromLebanon, tgs:Interview.TGS_222_BrettKencairn, tgs:Interview.TGS_178_AndrewMillison ;
    skos:scopeNote "2026-08-13: real dates/subject/replay/essay added, transcript URL corrected (real is 2026/06, not the 2026/04 pattern-matched guess), dct:references added (Tainter -> real guest episode #27, closing a gap flagged weeks ago in the original backlog; #222/#178 resolved to real guest names via the show notes own URL slugs, not left as bare numbers)."@en ;
    .

