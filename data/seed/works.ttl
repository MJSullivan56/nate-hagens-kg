tgs:Work.FutureCouncilFilm a thinkr:Work, owl:NamedIndividual ;
    skos:prefLabel "Future Council"@en ;
    rdfs:comment "2024 documentary film directed by Damon Gameau, following eight children (ages 11-14) across Europe by biodiesel-fueled bus, confronting corporate leaders (Nestlé, Decathlon, ING, among others) about climate accountability. Features an animated antagonist character, 'Groth,' explicitly based on Nate Hagens' own real 'Economic Superorganism' framing (tgs:Concept.Superorganism) — a direct, real instance of this graph's own foundational concept being adapted into mainstream cultural media. Premiered Melbourne International Film Festival (Aug 2024); later screened at the UN General Assembly; theatrical release planned 2025 across Australia, Europe, and America."@en ;
    dct:creator tgs:Human.DamonGameau ;
    dct:issued "2024"^^xsd:gYear ;
    dct:isReferencedBy tgs:Monologue.Frankly_73_TheSuperorganismAndTheSelf ;
    .

