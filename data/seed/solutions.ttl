tgs:ConceptScheme.OneEarthSolutions a skos:ConceptScheme, owl:NamedIndividual ;
    skos:prefLabel "One Earth Solutions"@en ;
    skos:definition "One Earth's taxonomy of 76 climate and biodiversity solutions in three pillars and twelve sub-pillars, with seven levers of change and seven intersectional themes. Mapped to the Six Fronts by skos:relatedMatch."@en ;
    dcterms:source tgs:Work.OneEarthSolutions ;
    dcterms:creator "One Earth" ;
    skos:hasTopConcept
        tgs:PracticeCluster.OneEarth_EnergyTransition,
        tgs:PracticeCluster.OneEarth_IntersectionalThemes,
        tgs:PracticeCluster.OneEarth_LeversOfChange,
        tgs:PracticeCluster.OneEarth_NatureConservation,
        tgs:PracticeCluster.OneEarth_RegenerativeAgriculture ;
    .
