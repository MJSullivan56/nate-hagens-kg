    thinkr:hasIndicatorCategory tgs:IndicatorCategory.Equity ;
    skos:prefLabel "Racial Equity Index"@en ;
    skos:definition "Inclusion score on racial gaps in economic vitality, readiness and connectedness."@en ;
    thinkr:shortfallPercent "40"^^xsd:decimal ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage shortfall below the social foundation. Earlier paraphrased definition: 'A multi-factor metric tracking institutional disparities in wealth, justice, and health across racial groups.'"@en .

