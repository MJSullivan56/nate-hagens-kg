tgs:Interview.Frankly_20_KeepingWarmData a thinkr:Episode, owl:NamedIndividual ;
    thinkr:createdDate "2026-08-13"^^xsd:date ;
    thinkr:updatedDate "2026-08-13"^^xsd:date ;
    thinkr:hasEpisodeType thinkr:EpisodeType.Interview ;
    thinkr:hasEpisodeSegment tgs:EpisodeSegment.Frankly ;
    skos:prefLabel "Staying Warm Data with Nora Bateson"@en ;
    skos:definition "Real, direct role correction (2026-09-12): Nora Bateson interviews Nate, not the reverse — a genuine reversal of the show's usual format, not a naming slip. Nate discusses, as the one being interviewed, the real, acute electricity-price spike in Sweden (roughly 35-40x normal) as a live 'dress rehearsal' for The Great Simplification — what people are actually doing in their own homes to adapt, whether there's a single villain or a broad systemic root cause, and how quickly lived behavior changes once a comfortable baseline (cheap, reliable heat) is suddenly removed."@en ;
    dct:created "2022-12-16"^^xsd:date ;
    dct:issued "2022-12-16"^^xsd:date ;
    dct:subject tgs:Subject.EnergySystems, tgs:Subject.HumanBehavior, tgs:Subject.EconomicsAndMonetary ;
    thinkr:hasHost tgs:Persona.NoraBateson ;
    thinkr:hasGuest tgs:Persona.NateHagens ;
    thinkr:hasCanonicalSource <https://www.thegreatsimplification.com/frankly-original/20-keeping-warm-data> ;
    thinkr:discusses tgs:Concept.GreatSimplification ;
    dct:references tgs:Interview.TGS_10_NoraBateson, tgs:SchoolOfThought.WarmData, tgs:Work.RealityBlind ;
    skos:scopeNote "MJSullivan's own real finding this session: this episode's show notes (unlike others processed so far) preserve real, per-item citation links to primary sources (news articles, government data, Wikipedia, and — notably — a direct page-level citation into Work.RealityBlind for the 'Loss Aversion' discussion). Real further citable material NOT built into this graph, deliberately deferred (mostly narrow, single-episode-specific news citations rather than recurring entities): Swedish electricity-price/production-mix news coverage (thelocal.se, energimyndigheten.se), a nuclear-fusion Nature article, and passing mentions of Angela Merkel and Margaret Thatcher (real people, not bootstrapped here — too tangential to this episode's own core content to justify it)."@en ;
    .


