    skos:inScheme tgs:ConceptScheme.OneEarthBioregions2023 ;
    skos:prefLabel "Greenland Subrealm"@en ;
    skos:scopeNote "One Earth names this subrealm 'Greenland', the same as its single bioregion; 'Subrealm' is appended here so each preferred label is unique within the scheme, as SKOS recommends."@en ;
