@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix thinkr: <http://example.org/thinkr#> .
@prefix tgs:   <http://example.org/tgs#> .

<http://example.org/thinkr/> a owl:Ontology .

#################################################################
#    Datatypes
#################################################################

###  internal:anonymous-constants
<internal:anonymous-constants> a rdfs:Datatype .

#################################################################
#    Object Properties
#################################################################

<http://example.org/thinkr#aboutEntity> a owl:ObjectProperty .

<http://example.org/thinkr#aboutExternalURI> a owl:ObjectProperty .

<http://example.org/thinkr#aboutObject> a owl:ObjectProperty .

<http://example.org/thinkr#aboutSource> a owl:ObjectProperty .

<http://example.org/thinkr#aboutSubject> a owl:ObjectProperty .

<http://example.org/thinkr#activeInPhase> a owl:ObjectProperty .

<http://example.org/thinkr#actsThrough> a owl:ObjectProperty .

<http://example.org/thinkr#appliesTo> a owl:ObjectProperty .

<http://example.org/thinkr#calculatedConfidence> a owl:ObjectProperty .

<http://example.org/thinkr#confidence> a owl:ObjectProperty .

<http://example.org/thinkr#contrastsWith> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://example.org/thinkr#relatesTo> .

<http://example.org/thinkr#convergesWith> a owl:ObjectProperty .

<http://example.org/thinkr#crosswalkSource> a owl:ObjectProperty .

<http://example.org/thinkr#diagonallyDisjointWith> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://example.org/thinkr#logicallyDisjointWith> ,
    [ owl:inverseOf <http://example.org/thinkr#logicallyDisjointWith>
    ] .

<http://example.org/thinkr#discusses> a owl:ObjectProperty .

<http://example.org/thinkr#echoesIdeaOf> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://example.org/thinkr#relatesTo> .

<http://example.org/thinkr#evidencePolarity> a owl:ObjectProperty .

<http://example.org/thinkr#favorsFacet> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://example.org/thinkr#relatesTo> .

<http://example.org/thinkr#hasAcademicRelationship> a owl:ObjectProperty .

<http://example.org/thinkr#hasCanonicalSource> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://purl.org/dc/terms/source> .

<http://example.org/thinkr#hasDoughnutHalf> a owl:ObjectProperty .

<http://example.org/thinkr#hasEpisodeSegment> a owl:ObjectProperty .

<http://example.org/thinkr#hasEpisodeType> a owl:ObjectProperty .

<http://example.org/thinkr#hasEvidence> a owl:ObjectProperty .

<http://example.org/thinkr#hasFacet> a owl:ObjectProperty .

<http://example.org/thinkr#hasFront> a owl:ObjectProperty .

<http://example.org/thinkr#hasGuest> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://purl.org/dc/terms/contributor> .

<http://example.org/thinkr#hasHost> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://purl.org/dc/terms/creator> .

<http://example.org/thinkr#hasIndicatorCategory> a owl:ObjectProperty .

<http://example.org/thinkr#hasIntellectualRelationship> a owl:ObjectProperty .

<http://example.org/thinkr#hasNamedEntityType> a owl:ObjectProperty .

<http://example.org/thinkr#hasObject> a owl:ObjectProperty .

<http://example.org/thinkr#hasPersonEntityType> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://example.org/thinkr#hasNamedEntityType> .

<http://example.org/thinkr#hasPersonalRelationship> a owl:ObjectProperty .

<http://example.org/thinkr#hasPhase> a owl:ObjectProperty .

<http://example.org/thinkr#hasProfessionalRelationship> a owl:ObjectProperty .

<http://example.org/thinkr#hasProfessionalRole> a owl:ObjectProperty .

<http://example.org/thinkr#hasRelationshipType> a owl:ObjectProperty .

<http://example.org/thinkr#hasReplay> a owl:ObjectProperty .

<http://example.org/thinkr#hasSubdomain> a owl:ObjectProperty .

<http://example.org/thinkr#hasSubject> a owl:ObjectProperty .

<http://example.org/thinkr#hasTGSRole> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://example.org/thinkr#hasProfessionalRole> .

<http://example.org/thinkr#hasTranscript> a owl:ObjectProperty .

<http://example.org/thinkr#influencedBy> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://example.org/thinkr#relatesTo> .

<http://example.org/thinkr#logicallyDisjointWith> a owl:ObjectProperty .

<http://example.org/thinkr#memberOf> a owl:ObjectProperty .

<http://example.org/thinkr#morphsInto> a owl:ObjectProperty .

<http://example.org/thinkr#relatesTo> a owl:ObjectProperty .

<http://example.org/thinkr#reliabilityTier> a owl:ObjectProperty .

<http://example.org/thinkr#xAxisDivergentFrom> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://example.org/thinkr#relatesTo> ,
    [ owl:inverseOf <http://example.org/thinkr#relatesTo>
    ] .

<http://example.org/thinkr#yAxisDivergentFrom> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://example.org/thinkr#relatesTo> ,
    [ owl:inverseOf <http://example.org/thinkr#relatesTo>
    ] .

<http://purl.org/dc/terms/contributor> a owl:ObjectProperty .

<http://purl.org/dc/terms/creator> a owl:ObjectProperty .

<http://purl.org/dc/terms/source> a owl:ObjectProperty .

