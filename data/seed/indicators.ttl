@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tgs: <http://example.org/tgs#> .
@prefix thinkr: <http://example.org/thinkr#> .

<http://example.org/tgs#> a owl:Ontology ;
    owl:imports <http://example.org/thinkr#> ;
    rdfs:comment "Imports tgs-core for Protege compatibility — editing this file alone will resolve thinkr: classes/properties via the catalog file."@en .

#############################################
# ADDED 2026-08-13 — the 42 individual Doughnut indicators (2 per each
# of the 21 categories in doughnutcategories.ttl), sourced from
# MJSullivan's own manual transcription of
# tgs:Work.CaliforniaDoughnutReport2025. Names kept EXACTLY as given in
# that transcription, including informal/internal-sounding labels (e.g.
# "Report Not Happy") — deliberately not renamed to sound more formal,
# since the whole point of this taxonomy is matching CalDEC's own
# framing exactly, per MJSullivan's own stated motivation. rdfs:subClassOf
# thinkr:Concept (NOT thinkr:HagensConcept) — see tgs-core.ttl's own
# comment block.
#############################################

thinkr:Indicator a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:comment "One of the 42 specific, named metrics within the Doughnut Economics model (e.g. Water Quality, Greenhouse Gas Emissions), each belonging to one thinkr:IndicatorCategory."@en ;
    skos:prefLabel "Doughnut Indicator"@en .

thinkr:shortfallPercent a owl:DatatypeProperty ;
    rdfs:domain thinkr:Indicator ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "shortfall percent"@en ;
    skos:definition "How far a social-foundation indicator falls short of its threshold, as a percentage, as reported in the indicator's source (dcterms:source)."@en .

thinkr:observedValue a owl:DatatypeProperty ;
    rdfs:domain thinkr:Indicator ;
    skos:prefLabel "observed value"@en ;
    skos:definition "The indicator's measured value as published by its source, kept as text because some values are compound (land / sea), categorical (Yes) or counts with shares; read with thinkr:valueUnit."@en .

thinkr:thresholdValue a owl:DatatypeProperty ;
    rdfs:domain thinkr:Indicator ;
    skos:prefLabel "threshold value"@en ;
    skos:definition "The desirable level -- the social threshold or ecological ceiling -- the indicator is measured against, as published by its source (e.g. 0%, 0.985, <0.11, >276); read with thinkr:valueUnit and thinkr:thresholdBasis."@en .

thinkr:valueUnit a owl:DatatypeProperty ;
    rdfs:domain thinkr:Indicator ;
    skos:prefLabel "value unit"@en ;
    skos:definition "The unit in which thinkr:observedValue and thinkr:thresholdValue are expressed."@en .

thinkr:thresholdBasis a owl:DatatypeProperty ;
    rdfs:domain thinkr:Indicator ;
    skos:prefLabel "threshold basis"@en ;
    skos:definition "Where the threshold comes from and how the gap is calculated, in plain words."@en .

thinkr:measurementYear a owl:DatatypeProperty ;
    rdfs:domain thinkr:Indicator ;
    skos:prefLabel "measurement year"@en ;
    skos:definition "The year (or span) the observed value was measured, as given by the source."@en .

thinkr:dataPublicationYear a owl:DatatypeProperty ;
    rdfs:domain thinkr:Indicator ;
    skos:prefLabel "data publication year"@en ;
    skos:definition "The year the underlying data was published, as given by the source; may differ from thinkr:measurementYear."@en .

thinkr:hasDataSource a owl:ObjectProperty ;
    rdfs:domain thinkr:Indicator ;
    skos:prefLabel "has data source"@en ;
    skos:definition "Web address of the primary data the observed value was taken from."@en .

thinkr:hasThresholdSource a owl:ObjectProperty ;
    rdfs:domain thinkr:Indicator ;
    skos:prefLabel "has threshold source"@en ;
    skos:definition "Web address of the study or dataset the threshold value was taken from, where it differs from the data source."@en .

thinkr:dataSourceCitation a owl:DatatypeProperty ;
    rdfs:domain thinkr:Indicator ;
    skos:prefLabel "data source citation"@en ;
    skos:definition "The source's own citation for the indicator's data and threshold, as written by the indicator's publisher."@en .

thinkr:averageShortfallPercent a owl:DatatypeProperty ;
    rdfs:domain thinkr:IndicatorCategory ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "average shortfall percent"@en ;
    skos:definition "The average shortfall of a social-foundation category's indicators, as published by the source."@en .

thinkr:averageOvershootPercent a owl:DatatypeProperty ;
    rdfs:domain thinkr:IndicatorCategory ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "average overshoot percent"@en ;
    skos:definition "The average overshoot of an ecological-ceiling category's indicators, as published by the source; 0 means within the ceiling."@en .

thinkr:overshootPercent a owl:DatatypeProperty ;
    rdfs:domain thinkr:Indicator ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "overshoot percent"@en ;
    skos:definition "How far an ecological-ceiling indicator exceeds its boundary, as a percentage, as reported in the indicator's source (dcterms:source); 0 means within the boundary."@en .

#############################################
# Water & Sanitation
#############################################

tgs:Indicator.WaterQuality a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.WaterAndSanitation ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025, tgs:Work.CaliforniaDoughnutIndicators2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.WaterAndSanitation ;
    skos:prefLabel "Water Quality"@en ;
    skos:definition "Share of people served by water systems that do not meet quality standards."@en ;
    thinkr:shortfallPercent "2.2"^^xsd:decimal ;
    thinkr:observedValue "883,169 = 2.2%" ;
    thinkr:thresholdValue "0%" ;
    thinkr:valueUnit "people (share of population)" ;
    thinkr:thresholdBasis "Ambitious target of 0%."@en ;
    thinkr:measurementYear "2025" ;
    thinkr:dataPublicationYear "2025" ;
    thinkr:hasDataSource <https://www.waterboards.ca.gov/drinking_water/certlic/drinkingwater/saferdashboard.html> ;
    thinkr:dataSourceCitation "1) California State Water Resources Control Board. (n.d.). SAFER dashboard." ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage shortfall below the social foundation. Earlier paraphrased definition: 'The safety and cleanliness of public drinking water supplies, screening for toxic contaminants or pollutants.' Value, threshold, years and sources from CalDEC's companion indicator sheet (tgs:Work.CaliforniaDoughnutIndicators2025), added 2026-10-23; the gap now uses the sheet's unrounded figure."@en .

tgs:Indicator.SanitationAccess a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.WaterAndSanitation ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025, tgs:Work.CaliforniaDoughnutIndicators2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.WaterAndSanitation ;
    skos:prefLabel "Sanitation Access"@en ;
    skos:definition "Share of people lacking basic sanitation."@en ;
    thinkr:shortfallPercent "0.57"^^xsd:decimal ;
    thinkr:observedValue "214,930 = 0.57%" ;
    thinkr:thresholdValue "0%" ;
    thinkr:valueUnit "share of population (%)" ;
    thinkr:thresholdBasis "Ambitious target of 0%."@en ;
    thinkr:measurementYear "2019" ;
    thinkr:dataPublicationYear "2020" ;
    thinkr:hasDataSource <https://ajph.aphapublications.org/doi/full/10.2105/AJPH.2020.305833> ;
    thinkr:dataSourceCitation "1) Capone, D., Cumming, O., Nichols, D., & Brown, J. (2020). Water and sanitation in urban America, 2017–2019. American journal of public health, 110(10), 1567-1572)" ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage shortfall below the social foundation. Earlier paraphrased definition: 'The availability of clean, functional sewage and wastewater infrastructure across communities.' Value, threshold, years and sources from CalDEC's companion indicator sheet (tgs:Work.CaliforniaDoughnutIndicators2025), added 2026-10-23; the gap now uses the sheet's unrounded figure. Sources disagree slightly: the indicator sheet gives 0.57% (214,930 people), its calculations tab and the report 0.6%, and caldec.org 0.5%; the graph uses 0.57."@en .

#############################################
# Energy
#############################################

tgs:Indicator.EnergyBurden a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.Energy ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025, tgs:Work.CaliforniaDoughnutIndicators2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.Energy ;
    skos:prefLabel "Energy Burden"@en ;
    skos:definition "Share of households whose energy bill is 10% or more of income."@en ;
    thinkr:shortfallPercent "19.6"^^xsd:decimal ;
    thinkr:observedValue "19.6%" ;
    thinkr:thresholdValue "0%" ;
    thinkr:valueUnit "%" ;
    thinkr:thresholdBasis "Ambitious target of 0%."@en ;
    thinkr:measurementYear "2022" ;
    thinkr:dataPublicationYear "2023" ;
    thinkr:hasDataSource <http://www.homeenergyaffordabilitygap.com/03a_affordabilityData.html> ;
    thinkr:dataSourceCitation "1) Fisher, Sheehan & Colton. (2023). Home Energy Affordability Gap: Current year data." ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage shortfall below the social foundation. Earlier paraphrased definition: 'The percentage of household income spent strictly on electric, gas, and heating utility bills.' Value, threshold, years and sources from CalDEC's companion indicator sheet (tgs:Work.CaliforniaDoughnutIndicators2025), added 2026-10-23; the gap now uses the sheet's unrounded figure."@en .

tgs:Indicator.EnergyReliability a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.Energy ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025, tgs:Work.CaliforniaDoughnutIndicators2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.Energy ;
    skos:prefLabel "Energy Reliability"@en ;
    skos:definition "Share of the population in counties averaging six or more hours of power outage a year."@en ;
    thinkr:shortfallPercent "7.0"^^xsd:decimal ;
    thinkr:observedValue "7%" ;
    thinkr:thresholdValue "0%" ;
    thinkr:valueUnit "%" ;
    thinkr:thresholdBasis "Ambitious target of 0%."@en ;
    thinkr:measurementYear "2023" ;
    thinkr:dataPublicationYear "2025" ;
    thinkr:hasDataSource <https://doi.org/10.6084/m9.figshare.24237376.v2> ;
    thinkr:dataSourceCitation "1) Murphy, P. & Kwoka, B. (in preparation). Equity-adjusted value of lost load. Report for the Alfred P. Sloan Foundation. Uses data from: Brelsford, C., et al. (2023). The Environment for Analysis of Geo-Located Energy Information’s recorded electricity outages 2014-2023 (Version 2)." ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage shortfall below the social foundation. Earlier paraphrased definition: 'The frequency and duration of power outages or grid blackouts impacting residents.' Value, threshold, years and sources from CalDEC's companion indicator sheet (tgs:Work.CaliforniaDoughnutIndicators2025), added 2026-10-23; the gap now uses the sheet's unrounded figure."@en .

#############################################
