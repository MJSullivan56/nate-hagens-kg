tgs:Indicator.ParticulateMatter a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.AirPollution ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025, tgs:Work.CaliforniaDoughnutIndicators2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.AirPollution ;
    skos:prefLabel "Particulate Matter"@en ;
    skos:definition "Share of air basins above 9 micrograms per cubic metre of PM2.5."@en ;
    thinkr:overshootPercent "60"^^xsd:decimal ;
    thinkr:observedValue "60%" ;
    thinkr:thresholdValue "0%" ;
    thinkr:valueUnit "%" ;
    thinkr:thresholdBasis "No air basin above the federal annual PM2.5 standard of 9 micrograms per cubic metre, which is stricter than California's state standard."@en ;
    thinkr:measurementYear "2023" ;
    thinkr:dataPublicationYear "2025" ;
    thinkr:hasDataSource <https://www.arb.ca.gov/adam/select8/sc8start.php> ;
    thinkr:dataSourceCitation "1) California Air Resources Board. (n.d.). Air quality and emissions data. PM2.5: Annual Averages, National Design Value → select 2023, all California regions → select all air basins → calculate percent of air basins exceeding 9 ug/cubic meter." ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage overshoot beyond the ecological ceiling. Earlier paraphrased definition: 'Fine inhalable solids or droplets suspended in air (PM2.5 and PM10), originating from wildfire smoke, dust, and combustion.' Value, threshold, years and sources from CalDEC's companion indicator sheet (tgs:Work.CaliforniaDoughnutIndicators2025), added 2026-10-23; the gap now uses the sheet's unrounded figure."@en .
