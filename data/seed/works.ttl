tgs:Work.DesigningRegenerativeCultures a thinkr:Work, owl:NamedIndividual ;
    skos:prefLabel "Designing Regenerative Cultures"@en ;
    rdfs:comment "2016 book by Daniel Christian Wahl (Triarchy Press, UK), translated into 7+ languages — a wide-ranging analysis of ecological design, whole-systems thinking, and regenerative culture, described by reviewers as 'a Whole Earth Catalog for the 21st century.'"@en ;
