#############################################

tgs:Indicator.UnprotectedArea a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.BiodiversityLoss ;
