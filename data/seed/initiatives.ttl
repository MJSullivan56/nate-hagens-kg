    thinkr:listedInPracticeCluster tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "A training arc aims to reach more than 500 Indigenous youth in agroforestry, ecology, and cultural practice— passing knowledge between generations and preparing leaders who can govern territory regeneratively while identity stays central."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ActionPlanImplementation a thinkr:Initiative, owl:NamedIndividual ;
