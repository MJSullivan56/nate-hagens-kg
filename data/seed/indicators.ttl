    thinkr:hasIndicatorCategory tgs:IndicatorCategory.ConnectivityAndTransportation ;
    skos:prefLabel "Transit Report Card"@en ;
    skos:definition "Report-card scores for vehicle miles traveled and transit access."@en ;
    thinkr:shortfallPercent "40"^^xsd:decimal ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage shortfall below the social foundation. Earlier paraphrased definition: 'A qualitative and structural evaluation of public transportation efficiency, coverage, and scheduling.'"@en .

