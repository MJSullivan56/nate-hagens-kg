    thinkr:aboutSource tgs:Source.BaueTIBC11Post ;
    dcterms:description "Bill Baue's account of TIBC11: the peacemaking circle bridged Indigenous and non-Indigenous participants and rival readings of the same event (misappropriation versus misperception), with each person speaking only for themselves. Drafted by Claude at MJSullivan's request."@en ;
    prov:generatedAtTime "2026-10-21"^^xsd:date .

tgs:Evidence.Governess_DecisionMakingProcesses_BaueTIBC11 a thinkr:Evidence, owl:NamedIndividual ;
    thinkr:confidence thinkr:ConfidenceType.Candidate ;
