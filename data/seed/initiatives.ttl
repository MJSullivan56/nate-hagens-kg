    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.SydneyDoughnutEconomy a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Sydney Doughnut Economy"@en ;
    thinkr:carriedOutBy tgs:Organization.RegenSydney ;
