# For the newest episode: the older episode it does NOT cite that shares the most concepts with it.
PREFIX thinkr: <http://example.org/thinkr#>
PREFIX tgs:    <http://example.org/tgs#>
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?latest ?older ?olderTitle (COUNT(DISTINCT ?c) AS ?shared) WHERE {
  { SELECT ?latest WHERE { ?latest a thinkr:Episode ; dct:issued ?d } ORDER BY DESC(?d) LIMIT 1 }
  ?latest thinkr:discusses ?c . ?older thinkr:discusses ?c ; skos:prefLabel ?olderTitle .
  FILTER(?older != ?latest)
  FILTER NOT EXISTS { ?latest dct:references ?older }
} GROUP BY ?latest ?older ?olderTitle ORDER BY DESC(?shared) LIMIT 3
