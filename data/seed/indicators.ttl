    thinkr:overshootPercent "59"^^xsd:decimal ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage overshoot beyond the ecological ceiling. Earlier paraphrased definition: 'The percentage of ecologically critical habitats lacking legal conservation safeguards against development.'"@en .

tgs:Indicator.AtRiskSpecies a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.BiodiversityLoss ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.BiodiversityLoss ;
    skos:prefLabel "At-Risk Species"@en ;
    skos:definition "Share of animal and plant species at risk of extinction."@en ;
    thinkr:overshootPercent "947"^^xsd:decimal ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage overshoot beyond the ecological ceiling. Earlier paraphrased definition: 'The count or proportion of native plant and animal species classified as threatened, endangered, or vulnerable.'"@en .

#############################################
# Land-Use Change
#############################################

tgs:Indicator.ForestCover a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.LandUseChange ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.LandUseChange ;
    skos:prefLabel "Forest Cover"@en ;
    skos:definition "Share of land without forest cover, against a boundary of 75% of preindustrial cover."@en ;
    thinkr:overshootPercent "28"^^xsd:decimal ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage overshoot beyond the ecological ceiling. Earlier paraphrased definition: 'The total land area blanketed by natural, undisturbed tree canopies.'"@en .

tgs:Indicator.EcologicalFootprint a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.LandUseChange ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.LandUseChange ;
    skos:prefLabel "Ecological Footprint"@en ;
    skos:definition "Consumption-based ecological footprint in global hectares per capita."@en ;
    thinkr:overshootPercent "351"^^xsd:decimal ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage overshoot beyond the ecological ceiling. Earlier paraphrased definition: 'A measure of how much biologically productive land and water an economy requires to produce its consumed resources.'"@en .

#############################################
# Freshwater Use
#############################################

tgs:Indicator.Groundwater a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.FreshwaterUse ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.FreshwaterUse ;
    skos:prefLabel "Groundwater"@en ;
    skos:altLabel "Ground Water"@en ;
    skos:definition "Share of groundwater pumped from critically overdrafted basins."@en ;
    thinkr:overshootPercent "63"^^xsd:decimal ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage overshoot beyond the ecological ceiling. Earlier paraphrased definition: 'The extraction rate versus the recharge rate of underground aquifers.' Formerly tgs:Indicator.GroundWater."@en .

tgs:Indicator.WaterFootprint a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.FreshwaterUse ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.FreshwaterUse ;
    skos:prefLabel "Water Footprint"@en ;
    skos:definition "Blue water footprint per capita."@en ;
    thinkr:overshootPercent "76"^^xsd:decimal ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage overshoot beyond the ecological ceiling. Earlier paraphrased definition: 'The total volume of freshwater consumed directly and indirectly to manufacture goods and sustain consumer lifestyles.'"@en .

#############################################
# Climate Change
#############################################

tgs:Indicator.GreenhouseGasEmissions a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.ClimateChange ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.ClimateChange ;
    skos:prefLabel "Greenhouse Gas Emissions"@en ;
    skos:definition "Consumption-based greenhouse gas footprint per capita."@en ;
    thinkr:overshootPercent "1890"^^xsd:decimal ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage overshoot beyond the ecological ceiling. Earlier paraphrased definition: 'The net volume of carbon dioxide, methane, and related gases released by human activity.'"@en .

tgs:Indicator.NonRenewableElectricity a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.ClimateChange ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.ClimateChange ;
    skos:prefLabel "Non-Renewable Electricity"@en ;
    skos:definition "Share of electricity not generated from solar, wind or geothermal."@en ;
    thinkr:overshootPercent "62"^^xsd:decimal ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage overshoot beyond the ecological ceiling. Earlier paraphrased definition: 'The share of power generated using fossil fuels (coal, natural gas) relative to clean alternatives.'"@en .

#############################################
# Ocean Acidification
#############################################

tgs:Indicator.OceanPH a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.OceanAcidification ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.OceanAcidification ;
    skos:prefLabel "Ocean pH"@en ;
    skos:definition "Change in ocean pH compared with preindustrial levels."@en ;
    thinkr:overshootPercent "91"^^xsd:decimal ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage overshoot beyond the ecological ceiling. Earlier paraphrased definition: 'The declining scale of marine water alkalinity, which threatens shell-building organisms and coral reefs.'"@en .

tgs:Indicator.AcidificationPotential a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.OceanAcidification ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.OceanAcidification ;
    skos:prefLabel "Acidification Potential"@en ;
    skos:altLabel "SO2-Eq Footprint"@en ;
    skos:definition "Acidification potential: SO2-equivalent footprint per capita."@en ;
    thinkr:overshootPercent "520"^^xsd:decimal ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage overshoot beyond the ecological ceiling. Earlier paraphrased definition: 'A measure of sulfur dioxide equivalents released, tracking regional acidification risks in aquatic systems.' Formerly tgs:Indicator.SO2EqFootprint."@en .

#############################################
# Chemical Pollution
#############################################

tgs:Indicator.ToxicPesticidesApplied a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.ChemicalPollution ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.ChemicalPollution ;
    skos:prefLabel "Toxic Pesticides Applied"@en ;
    skos:definition "Share of high-risk toxins among the pesticides applied each year."@en ;
    thinkr:overshootPercent "65"^^xsd:decimal ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage overshoot beyond the ecological ceiling. Earlier paraphrased definition: 'The physical volume of solid municipal and industrial waste dumped into land disposal sites.' The report's page 11 lists this category's indicators as Landfill and Toxic Releases, but page 12 charts Toxic Pesticides Applied and Toxic Chemicals Released and carries their values; the graph follows page 12. This node was formerly tgs:Indicator.Landfill, minted from the page-11 list; Landfill is a different measure and is not kept as a label."@en .

tgs:Indicator.ToxicChemicalsReleased a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.ChemicalPollution ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.ChemicalPollution ;
    skos:prefLabel "Toxic Chemicals Released"@en ;
    skos:altLabel "Toxic Releases"@en ;
    skos:definition "Share of toxic chemicals released out of those produced each year."@en ;
    thinkr:overshootPercent "13"^^xsd:decimal ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage overshoot beyond the ecological ceiling. Earlier paraphrased definition: 'The mass of hazardous chemical compounds leaked into local soil, air, and waterways by industrial facilities.' Page 11 of the report calls it Toxic Releases; page 12, which carries the value, calls it Toxic Chemicals Released. Formerly tgs:Indicator.ToxicReleases."@en .

#############################################
# Air Pollution
#############################################

tgs:Indicator.O3Pollution a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.AirPollution ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.AirPollution ;
    skos:prefLabel "O3 Pollution"@en ;
    skos:altLabel "O3 (Ozone) Pollution"@en ;
    skos:definition "Share of air basins violating the 0.070 ppm ozone standard."@en ;
    thinkr:overshootPercent "60"^^xsd:decimal ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage overshoot beyond the ecological ceiling. Earlier paraphrased definition: 'Ground-level smog concentration, which acts as a respiratory irritant formed by vehicular and industrial emissions.'"@en .

tgs:Indicator.ParticulateMatter a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.AirPollution ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.AirPollution ;
    skos:prefLabel "Particulate Matter"@en ;
    skos:definition "Share of air basins above 9 micrograms per cubic metre of PM2.5."@en ;
    thinkr:overshootPercent "60"^^xsd:decimal ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage overshoot beyond the ecological ceiling. Earlier paraphrased definition: 'Fine inhalable solids or droplets suspended in air (PM2.5 and PM10), originating from wildfire smoke, dust, and combustion.'"@en .
