    thinkr:hasIndicatorCategory tgs:IndicatorCategory.Housing ;
    skos:prefLabel "Homelessness"@en ;
    skos:definition "Point-in-time count of unhoused people, scaled to a shortfall."@en ;
    thinkr:shortfallPercent "36"^^xsd:decimal ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage shortfall below the social foundation. Earlier paraphrased definition: 'The per-capita rate of individuals experiencing unhoused or transient living situations.'"@en .

tgs:Indicator.HousingBurden a thinkr:Indicator, owl:NamedIndividual ;
