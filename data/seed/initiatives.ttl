    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "This is a structured capacity system—nested support from local landscapes to the full bioregion."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.RegionalActivationTour a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Regional Activation Tour"@en ;
    thinkr:carriedOutBy tgs:Organization.RegenerateCascadia ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CongressingAndEvents, tgs:PracticeTerm.NetworkWeaving ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance ;
    dcterms:description "To learn what regeneration would take, Brandon and Claire ran a month-long Regional Activation Tour in October 2023, soon after they met."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.FoodSovereigntyAndSeedSavingNetworks a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Food Sovereignty and Seed Saving Networks"@en ;
    thinkr:carriedOutBy tgs:Organization.ReGenerOsaCollective ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.CommunityFoodAccess, tgs:PracticeTerm.RegenerativeAgriculture, tgs:PracticeTerm.ValueChainDevelopment ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy ;
    dcterms:description "After Manos Cambiadas, a gap stood out: many farmers could not sell what they grew. They started “Caja Verde,” a community-supported agriculture box; a year later that evolved into Mercado Verde."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.ManosCambiadas a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Manos Cambiadas"@en ;
    thinkr:carriedOutBy tgs:Organization.ReGenerOsaCollective ;
    thinkr:hasPracticeTerm tgs:PracticeTerm.FarmerSupport, tgs:PracticeTerm.PeerLearning ;
    thinkr:listedInPracticeCluster tgs:PracticeCluster.AgroBioeconomy, tgs:PracticeCluster.WaysOfKnowing ;
    dcterms:description "They launched “Manos Cambiadas,” rooted in an old pattern of neighbors helping neighbors. They worked alongside neighbors on farms and with what people needed day to day."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.OsaBioculturalFund a thinkr:Initiative, owl:NamedIndividual ;
    skos:prefLabel "Osa Biocultural Fund"@en ;
