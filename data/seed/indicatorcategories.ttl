@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tgs: <http://example.org/tgs#> .
@prefix thinkr: <http://example.org/thinkr#> .

<http://example.org/tgs#> a owl:Ontology ;
    owl:imports <http://example.org/thinkr#> ;
    rdfs:comment "Imports tgs-core for Protege compatibility — editing this file alone will resolve thinkr: classes/properties via the catalog file."@en .

#############################################
# ADDED 2026-08-13 — the 21 Doughnut categories (12 Social Foundation,
# 9 Ecological Ceiling), sourced from MJSullivan's own manual transcription
# of tgs:Work.CaliforniaDoughnutReport2025's structure. Count independently
# confirmed against that Work's own existing rdfs:comment ("42 social/
# ecological indicators across 21 categories") before minting anything —
# exact match, giving real confidence the transcription is complete and
# accurate, not something taken on faith. rdfs:subClassOf thinkr:Concept
# (NOT thinkr:HagensConcept) — see tgs-core.ttl's own comment block.
#############################################

thinkr:IndicatorCategory a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:comment "One of the 21 named categories within the Doughnut Economics model (e.g. Water & Sanitation, Climate Change), each belonging to one thinkr:DoughnutHalf and containing 2 thinkr:Indicator members."@en ;
    skos:scopeNote "Labels follow the California Doughnut Report (tgs:Work.CaliforniaDoughnutReport2025), a regional downscaling. The global Doughnut 3.0 (tgs:Work.DoughnutOfSocialAndPlanetaryBoundaries2025) has the same 12 + 9 dimensions; where its names differ, the 3.0 name is attached as a CloseMatch alternate term. The 42 thinkr:Indicator individuals are California's, not the global 22 social and 13 ecological indicators."@en ;
    skos:prefLabel "Doughnut Category"@en .

#############################################
# Social Foundation (12)
#############################################

tgs:IndicatorCategory.WaterAndSanitation a thinkr:IndicatorCategory, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:DoughnutHalf.SocialFoundation ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasDoughnutHalf tgs:DoughnutHalf.SocialFoundation ;
    skos:prefLabel "Water & Sanitation"@en ;
    thinkr:averageShortfallPercent "1"^^xsd:decimal ;
    skos:definition "Measures access to clean, affordable, and safe infrastructure for hydration and hygiene."@en .

tgs:IndicatorCategory.Energy a thinkr:IndicatorCategory, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:DoughnutHalf.SocialFoundation ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasDoughnutHalf tgs:DoughnutHalf.SocialFoundation ;
    skos:prefLabel "Energy"@en ;
    thinkr:averageShortfallPercent "13"^^xsd:decimal ;
    skos:definition "Assesses the accessibility, cost, and reliability of the electrical grid and power resources."@en .

tgs:IndicatorCategory.ConnectivityAndTransportation a thinkr:IndicatorCategory, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:DoughnutHalf.SocialFoundation ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasDoughnutHalf tgs:DoughnutHalf.SocialFoundation ;
    skos:prefLabel "Connectivity & Transportation"@en ;
    thinkr:averageShortfallPercent "28"^^xsd:decimal ;
    skos:definition "Tracks the physical and digital mobility required to participate in modern society."@en ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
        thinkr:hasAlternateTermType tgs:AlternateTermType.CloseMatch ;
        skos:prefLabel "Connectivity"@en ;
        skos:scopeNote "Doughnut 3.0 name for this dimension, from tgs:Work.TheEvolvingDoughnut2025 and tgs:Work.DoughnutOfSocialAndPlanetaryBoundaries2025. A close match rather than an exact one: the global Doughnut and the California report measure the dimension with different indicators. Added 2026-10-19."@en ] .

tgs:IndicatorCategory.Housing a thinkr:IndicatorCategory, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:DoughnutHalf.SocialFoundation ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasDoughnutHalf tgs:DoughnutHalf.SocialFoundation ;
    skos:prefLabel "Housing"@en ;
    thinkr:averageShortfallPercent "45"^^xsd:decimal ;
    skos:definition "Evaluates residential security, stability, and affordability."@en .

tgs:IndicatorCategory.Equity a thinkr:IndicatorCategory, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:DoughnutHalf.SocialFoundation ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasDoughnutHalf tgs:DoughnutHalf.SocialFoundation ;
    skos:prefLabel "Equity"@en ;
    thinkr:averageShortfallPercent "26"^^xsd:decimal ;
    skos:definition "Measures systemic fairness and gaps in wealth or opportunity across demographics."@en ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
        thinkr:hasAlternateTermType tgs:AlternateTermType.CloseMatch ;
        skos:prefLabel "Equality"@en ;
        skos:scopeNote "Doughnut 3.0 name for this dimension, from tgs:Work.TheEvolvingDoughnut2025 and tgs:Work.DoughnutOfSocialAndPlanetaryBoundaries2025. A close match rather than an exact one: the global Doughnut and the California report measure the dimension with different indicators. Added 2026-10-19."@en ] .

tgs:IndicatorCategory.SocialCohesion a thinkr:IndicatorCategory, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:DoughnutHalf.SocialFoundation ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasDoughnutHalf tgs:DoughnutHalf.SocialFoundation ;
    skos:prefLabel "Social Cohesion"@en ;
    thinkr:averageShortfallPercent "63"^^xsd:decimal ;
    skos:definition "Assesses community relationships, financial divides, and collective psychological wellbeing."@en .

tgs:IndicatorCategory.Food a thinkr:IndicatorCategory, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:DoughnutHalf.SocialFoundation ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasDoughnutHalf tgs:DoughnutHalf.SocialFoundation ;
    skos:prefLabel "Food"@en ;
    thinkr:averageShortfallPercent "26"^^xsd:decimal ;
    skos:definition "Tracks nutritional health and physical access to sustaining diets."@en .

tgs:IndicatorCategory.Health a thinkr:IndicatorCategory, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:DoughnutHalf.SocialFoundation ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasDoughnutHalf tgs:DoughnutHalf.SocialFoundation ;
    skos:prefLabel "Health"@en ;
    thinkr:averageShortfallPercent "43"^^xsd:decimal ;
    skos:definition "Monitors physical longevity and medical system entry barriers."@en .

tgs:IndicatorCategory.Education a thinkr:IndicatorCategory, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:DoughnutHalf.SocialFoundation ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasDoughnutHalf tgs:DoughnutHalf.SocialFoundation ;
    skos:prefLabel "Education"@en ;
    thinkr:averageShortfallPercent "37"^^xsd:decimal ;
    skos:definition "Measures academic achievement and the financial consequences of seeking it."@en .

tgs:IndicatorCategory.IncomeAndWork a thinkr:IndicatorCategory, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:DoughnutHalf.SocialFoundation ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasDoughnutHalf tgs:DoughnutHalf.SocialFoundation ;
    skos:prefLabel "Income & Work"@en ;
    thinkr:averageShortfallPercent "12"^^xsd:decimal ;
    skos:definition "Evaluates baseline financial security and formal employment opportunities."@en .

tgs:IndicatorCategory.PeaceAndJustice a thinkr:IndicatorCategory, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:DoughnutHalf.SocialFoundation ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasDoughnutHalf tgs:DoughnutHalf.SocialFoundation ;
    skos:prefLabel "Peace & Justice"@en ;
    thinkr:averageShortfallPercent "82"^^xsd:decimal ;
    skos:definition "Assesses community safety, systemic violence, and institutional accountability."@en .

tgs:IndicatorCategory.PoliticalVoice a thinkr:IndicatorCategory, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:DoughnutHalf.SocialFoundation ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasDoughnutHalf tgs:DoughnutHalf.SocialFoundation ;
    skos:prefLabel "Political Voice"@en ;
    thinkr:averageShortfallPercent "28"^^xsd:decimal ;
    skos:definition "Tracks civic engagement and democratic representation."@en .

#############################################
# Ecological Ceiling (9)
#############################################

tgs:IndicatorCategory.NitrogenAndPhosphorus a thinkr:IndicatorCategory, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:DoughnutHalf.EcologicalCeiling ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasDoughnutHalf tgs:DoughnutHalf.EcologicalCeiling ;
    skos:prefLabel "Nitrogen & Phosphorus"@en ;
    thinkr:averageOvershootPercent "433"^^xsd:decimal ;
    skos:definition "Tracks the chemical overloading of biosphere networks due to industrial agricultural run-off."@en ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
        thinkr:hasAlternateTermType tgs:AlternateTermType.CloseMatch ;
        skos:prefLabel "Nutrient pollution"@en ;
        skos:scopeNote "Doughnut 3.0 name for this dimension, from tgs:Work.TheEvolvingDoughnut2025 and tgs:Work.DoughnutOfSocialAndPlanetaryBoundaries2025. A close match rather than an exact one: the global Doughnut and the California report measure the dimension with different indicators. Added 2026-10-19."@en ] .

tgs:IndicatorCategory.OzoneDepletion a thinkr:IndicatorCategory, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:DoughnutHalf.EcologicalCeiling ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasDoughnutHalf tgs:DoughnutHalf.EcologicalCeiling ;
    skos:prefLabel "Ozone Depletion"@en ;
    thinkr:averageOvershootPercent "0"^^xsd:decimal ;
    skos:definition "Monitors the degradation of the atmospheric layer that shields Earth from harmful solar radiation."@en ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
        thinkr:hasAlternateTermType tgs:AlternateTermType.CloseMatch ;
        skos:prefLabel "Ozone layer depletion"@en ;
        skos:scopeNote "Doughnut 3.0 name for this dimension, from tgs:Work.TheEvolvingDoughnut2025 and tgs:Work.DoughnutOfSocialAndPlanetaryBoundaries2025. A close match rather than an exact one: the global Doughnut and the California report measure the dimension with different indicators. Added 2026-10-19."@en ] .

tgs:IndicatorCategory.BiodiversityLoss a thinkr:IndicatorCategory, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:DoughnutHalf.EcologicalCeiling ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasDoughnutHalf tgs:DoughnutHalf.EcologicalCeiling ;
    skos:prefLabel "Biodiversity Loss"@en ;
    thinkr:averageOvershootPercent "503"^^xsd:decimal ;
    skos:definition "Measures the degradation of wildlife ecosystems and the extinction rate of organisms."@en ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
        thinkr:hasAlternateTermType tgs:AlternateTermType.CloseMatch ;
        skos:prefLabel "Biodiversity breakdown"@en ;
        skos:scopeNote "Doughnut 3.0 name for this dimension, from tgs:Work.TheEvolvingDoughnut2025 and tgs:Work.DoughnutOfSocialAndPlanetaryBoundaries2025. A close match rather than an exact one: the global Doughnut and the California report measure the dimension with different indicators. Added 2026-10-19."@en ] .

tgs:IndicatorCategory.LandUseChange a thinkr:IndicatorCategory, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:DoughnutHalf.EcologicalCeiling ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasDoughnutHalf tgs:DoughnutHalf.EcologicalCeiling ;
    skos:prefLabel "Land-Use Change"@en ;
    thinkr:averageOvershootPercent "190"^^xsd:decimal ;
    skos:definition "Tracks the conversion of natural wilderness into urban or agricultural zones."@en ;
    skos:scopeNote "Given a single top-level '#' heading (rather than '##') in MJSullivan's original markdown, alongside Ocean Acidification below — confirmed via cross-check against the 21-category count already established in tgs:Work.CaliforniaDoughnutReport2025's own rdfs:comment that this was a formatting slip, not an intentional 3rd-tier distinction; modeled here as a normal Ecological Ceiling category like its 8 siblings."@en ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
        thinkr:hasAlternateTermType tgs:AlternateTermType.CloseMatch ;
        skos:prefLabel "Land conversion"@en ;
        skos:scopeNote "Doughnut 3.0 name for this dimension, from tgs:Work.TheEvolvingDoughnut2025 and tgs:Work.DoughnutOfSocialAndPlanetaryBoundaries2025. A close match rather than an exact one: the global Doughnut and the California report measure the dimension with different indicators. Added 2026-10-19."@en ] .

tgs:IndicatorCategory.FreshwaterUse a thinkr:IndicatorCategory, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:DoughnutHalf.EcologicalCeiling ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasDoughnutHalf tgs:DoughnutHalf.EcologicalCeiling ;
    skos:prefLabel "Freshwater Use"@en ;
    thinkr:averageOvershootPercent "70"^^xsd:decimal ;
    skos:definition "Monitors the consumption and depletion of finite freshwater sources."@en ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
        thinkr:hasAlternateTermType tgs:AlternateTermType.CloseMatch ;
        skos:prefLabel "Freshwater disruption"@en ;
        skos:scopeNote "Doughnut 3.0 name for this dimension, from tgs:Work.TheEvolvingDoughnut2025 and tgs:Work.DoughnutOfSocialAndPlanetaryBoundaries2025. A close match rather than an exact one: the global Doughnut and the California report measure the dimension with different indicators. Added 2026-10-19."@en ] .

tgs:IndicatorCategory.ClimateChange a thinkr:IndicatorCategory, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:DoughnutHalf.EcologicalCeiling ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasDoughnutHalf tgs:DoughnutHalf.EcologicalCeiling ;
    skos:prefLabel "Climate Change"@en ;
    thinkr:averageOvershootPercent "976"^^xsd:decimal ;
    skos:definition "Tracks the heating of Earth's atmosphere via greenhouse gas accumulation."@en .

tgs:IndicatorCategory.OceanAcidification a thinkr:IndicatorCategory, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:DoughnutHalf.EcologicalCeiling ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasDoughnutHalf tgs:DoughnutHalf.EcologicalCeiling ;
    skos:prefLabel "Ocean Acidification"@en ;
    thinkr:averageOvershootPercent "305"^^xsd:decimal ;
    skos:definition "Measures chemical shifts in marine environments caused by absorbing human carbon output."@en ;
    skos:scopeNote "Same markdown-heading-level note as Land-Use Change above — modeled as a normal Ecological Ceiling category, not a 3rd tier."@en .

tgs:IndicatorCategory.ChemicalPollution a thinkr:IndicatorCategory, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:DoughnutHalf.EcologicalCeiling ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasDoughnutHalf tgs:DoughnutHalf.EcologicalCeiling ;
    skos:prefLabel "Chemical Pollution"@en ;
    thinkr:averageOvershootPercent "39"^^xsd:decimal ;
    skos:definition "Monitors the accumulation of synthetic, toxic, and non-biodegradable waste in the environment."@en .

tgs:IndicatorCategory.AirPollution a thinkr:IndicatorCategory, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:DoughnutHalf.EcologicalCeiling ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasDoughnutHalf tgs:DoughnutHalf.EcologicalCeiling ;
    skos:prefLabel "Air Pollution"@en ;
    thinkr:averageOvershootPercent "60"^^xsd:decimal ;
    skos:definition "Tracks airborne concentrations of gases and microscopic solids dangerous to human lungs."@en .

# ===== BEGIN DERIVED INVERSES (scripts/derive/compute_inverses.py; do not edit by hand) =====

# Each triple below mirrors a hand-authored one elsewhere in data/seed/.

tgs:IndicatorCategory.AirPollution
    skos:closeMatch tgs:DevonDoughnutDomain.AirQuality ;
    skos:narrower tgs:Indicator.O3Pollution, tgs:Indicator.ParticulateMatter .

tgs:IndicatorCategory.BiodiversityLoss
    skos:closeMatch tgs:DevonDoughnutDomain.Biodiversity ;
    skos:narrower tgs:Indicator.AtRiskSpecies, tgs:Indicator.UnprotectedArea ;
    skos:relatedMatch tgs:DevonDoughnutDomain.CoastAndMarineHealth, tgs:DevonDoughnutDomain.HabitatHealth .

tgs:IndicatorCategory.ChemicalPollution
    skos:narrower tgs:Indicator.ToxicChemicalsReleased, tgs:Indicator.ToxicPesticidesApplied ;
    skos:relatedMatch tgs:DevonDoughnutDomain.PlasticPollution, tgs:DevonDoughnutDomain.SoilHealth, tgs:DevonDoughnutDomain.Waste .

tgs:IndicatorCategory.ClimateChange
    skos:closeMatch tgs:DevonDoughnutDomain.GreenhouseGasEmissions ;
    skos:narrower tgs:Indicator.GreenhouseGasEmissions, tgs:Indicator.NonRenewableElectricity .

tgs:IndicatorCategory.ConnectivityAndTransportation
    skos:narrower tgs:Indicator.InternetAccess, tgs:Indicator.TransitReportCard ;
    skos:relatedMatch tgs:DevonDoughnutDomain.AirQuality, tgs:DevonDoughnutDomain.CommunityConnectivity .

tgs:IndicatorCategory.Education
    skos:closeMatch tgs:DevonDoughnutDomain.Education ;
    skos:narrower tgs:Indicator.LiteracyRate, tgs:Indicator.StudentLoanDebt .

tgs:IndicatorCategory.Energy
    skos:closeMatch tgs:DevonDoughnutDomain.Energy ;
    skos:narrower tgs:Indicator.EnergyBurden, tgs:Indicator.EnergyReliability .

tgs:IndicatorCategory.Equity
    skos:closeMatch tgs:DevonDoughnutDomain.EquityAndEquality ;
    skos:narrower tgs:Indicator.GenderPayGap, tgs:Indicator.RacialEquityIndex .

tgs:IndicatorCategory.Food
    skos:closeMatch tgs:DevonDoughnutDomain.Food ;
    skos:narrower tgs:Indicator.FoodInsecurity, tgs:Indicator.VegetablesPerDay .

tgs:IndicatorCategory.FreshwaterUse
    skos:narrower tgs:Indicator.Groundwater, tgs:Indicator.WaterFootprint ;
    skos:relatedMatch tgs:DevonDoughnutDomain.WaterbodyHealth .

tgs:IndicatorCategory.Health
    skos:closeMatch tgs:DevonDoughnutDomain.HealthAndWellbeing ;
    skos:narrower tgs:Indicator.HealthcareAffordability, tgs:Indicator.LifeExpectancy .

tgs:IndicatorCategory.Housing
    skos:closeMatch tgs:DevonDoughnutDomain.Housing ;
    skos:narrower tgs:Indicator.Homelessness, tgs:Indicator.HousingBurden .

tgs:IndicatorCategory.IncomeAndWork
    skos:closeMatch tgs:DevonDoughnutDomain.IncomeAndWork ;
    skos:narrower tgs:Indicator.Poverty, tgs:Indicator.Unemployment .

tgs:IndicatorCategory.LandUseChange
    skos:closeMatch tgs:DevonDoughnutDomain.LandUse ;
    skos:narrower tgs:Indicator.EcologicalFootprint, tgs:Indicator.ForestCover ;
    skos:relatedMatch tgs:DevonDoughnutDomain.HabitatHealth .

tgs:IndicatorCategory.NitrogenAndPhosphorus
    skos:narrower tgs:Indicator.EutrophicationPotential, tgs:Indicator.NitrogenLeached ;
    skos:relatedMatch tgs:DevonDoughnutDomain.SoilHealth, tgs:DevonDoughnutDomain.WaterbodyHealth .

tgs:IndicatorCategory.OceanAcidification
    skos:narrower tgs:Indicator.AcidificationPotential, tgs:Indicator.OceanPH ;
    skos:relatedMatch tgs:DevonDoughnutDomain.CoastAndMarineHealth .

tgs:IndicatorCategory.OzoneDepletion
    skos:narrower tgs:Indicator.OzoneDepletingSubstances, tgs:Indicator.OzoneLayer ;
    skos:relatedMatch tgs:DevonDoughnutDomain.GreenhouseGasEmissions .

tgs:IndicatorCategory.PeaceAndJustice
    skos:narrower tgs:Indicator.PoliceScorecard, tgs:Indicator.ViolentCrime ;
    skos:relatedMatch tgs:DevonDoughnutDomain.Safety .

tgs:IndicatorCategory.PoliticalVoice
    skos:closeMatch tgs:DevonDoughnutDomain.PoliticalVoice ;
    skos:narrower tgs:Indicator.RegisteredVoters, tgs:Indicator.VoterTurnout .

tgs:IndicatorCategory.SocialCohesion
    skos:closeMatch tgs:DevonDoughnutDomain.CommunityConnectivity ;
    skos:narrower tgs:Indicator.IncomeInequality, tgs:Indicator.ReportNotHappy .

tgs:IndicatorCategory.WaterAndSanitation
    skos:closeMatch tgs:DevonDoughnutDomain.Water ;
    skos:narrower tgs:Indicator.SanitationAccess, tgs:Indicator.WaterQuality .
# ===== END DERIVED INVERSES =====
