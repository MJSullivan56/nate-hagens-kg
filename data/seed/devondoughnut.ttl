    skos:relatedMatch tgs:InterventionSubdomain.ViolencePreventionAndSocialCohesion, tgs:IndicatorCategory.PeaceAndJustice, tgs:PracticeTerm.HealthAndSocialCare ;
    dcterms:source tgs:Work.DevonDoughnutIndicatorCompilation ;
    skos:scopeNote "Subdomain links approved from review sheet 6b, with review strength: Violence Prevention and Social Cohesion (firm). California Doughnut categories (sheet 2): Peace & Justice (relatedMatch, probable). Bioregioning Earth and One Earth practices (sheet 3): Health and Social Care (possible)."@en ;
    .

tgs:DevonDoughnutDomain.EquityAndEquality a thinkr:DevonDoughnutDomain, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.DevonDoughnut ;
