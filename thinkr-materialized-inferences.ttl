    <http://example.org/thinkr#hasHost> <http://example.org/tgs#Persona.NateHagens> ;
    <http://example.org/thinkr#hasReplay> <https://open.spotify.com/episode/2Vdchibvh0vABOd0eicQrA> ,
    <https://youtu.be/F838KOrQrRg> ;
    <http://example.org/thinkr#hasTranscript> <https://www.thegreatsimplification.com/wp-content/uploads/2025/02/TGS165IainMcGilchristTranscript.pdf> ;
    <http://purl.org/dc/terms/contributor> <http://example.org/tgs#Persona.IainMcGilchrist> ;
