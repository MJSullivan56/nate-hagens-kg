@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tgs: <http://example.org/tgs#> .
@prefix thinkr: <http://example.org/thinkr#> .

<http://example.org/tgs#> a owl:Ontology ;
    owl:imports <http://example.org/thinkr#> ;
    rdfs:comment "Imports tgs-core for Protege compatibility — editing this file alone will resolve thinkr: classes/properties via the catalog file."@en .


tgs:Concept.CarbonPulse a thinkr:Concept, thinkr:HagensConcept,
        owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.TGSConcepts ;
    skos:topConceptOf tgs:ConceptScheme.TGSConcepts ;
    dcterms:source <https://natehagens.substack.com/i/159009316/the-carbon-pulse> ;
    dcterms:subject tgs:Subject.EROIAndEnergyQuality ;
    skos:definition "The one-time burst of fossil energy that humanity is spending in a geological instant -- a brief spike in history, not a permanent baseline."@en ;
    skos:prefLabel "The Carbon Pulse"@en ;
    thinkr:hasAnalyticalLens thinkr:AnalyticalLensType.Biophysical .

tgs:Concept.CircleOfTrustLocalism a thinkr:Concept,
        owl:NamedIndividual ;
    skos:altLabel "Circle of Trust"@en ;
    skos:inScheme tgs:ConceptScheme.TGSConcepts ;
    skos:topConceptOf tgs:ConceptScheme.TGSConcepts ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.CommunityAndResponse ;
    skos:definition "Hagens' emphasis on rebuilding smaller-scale, face-to-face community and local resource resilience as an adaptive response to declining energy surplus and institutional fragility."@en ;
    skos:prefLabel "Local Resilience"@en ;
    thinkr:echoesIdeaOf tgs:Persona.ElinorOstrom ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
        thinkr:hasAlternateTermType tgs:AlternateTermType.ExactMatch ;
        skos:prefLabel "Circle of Trust"@en ;
        skos:scopeNote "THIRD pilot case for the alternate-term mechanism, 2026-08-13 — split out of this Concept's own former compound prefLabel (\"Local Resilience / 'Circle of Trust'\"). Kept as an anonymous blank node (Tier 2)." ] .

tgs:Concept.ComplexityCollapse a thinkr:Concept,
        owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.TGSConcepts ;
    skos:topConceptOf tgs:ConceptScheme.TGSConcepts ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.OvershootAndLimits ;
    skos:definition "Societies solve problems by adding complexity, but complexity costs energy and yields diminishing returns, until collapse -- a rapid loss of complexity -- becomes a rational simplification."@en ;
    skos:prefLabel "Complexity and Collapse"@en ;
    thinkr:influencedBy tgs:Persona.JosephTainter ;
    thinkr:definedIn tgs:Work.TheCollapseOfComplexSocieties ;
    thinkr:hasAnalyticalLens thinkr:AnalyticalLensType.Biophysical, thinkr:AnalyticalLensType.Institutional .

tgs:Concept.DiscountRatesAndPresentBias a thinkr:Concept,
        owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.TGSConcepts ;
    skos:topConceptOf tgs:ConceptScheme.TGSConcepts ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.BehavioralEconomicsAndCognition ;
    skos:definition "Valuing the future far less than the present, in finance and in our own heads, which systematically underprices long-term ecological risk."@en ;
    skos:prefLabel "Discount Rates"@en ;
    thinkr:echoesIdeaOf tgs:Persona.MarcusAurelius ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
        thinkr:hasAlternateTermType tgs:AlternateTermType.Related ;
        skos:prefLabel "Present Bias"@en ;
        skos:scopeNote "FOURTH pilot case, 2026-08-13 — split out of this Concept's own former compound prefLabel (\"Discount Rates / Present Bias\"). Deliberately typed Related, NOT ExactMatch: 'discount rate' is the formal economic parameter, 'present bias' is the specific psychological tendency that produces excessive discounting — related, not strictly synonymous. Kept as an anonymous blank node (Tier 2)." ] .

tgs:Concept.EnergyReturnOnInvestment a thinkr:Concept,
        owl:NamedIndividual ;
    skos:altLabel "EROI"@en ;
    skos:inScheme tgs:ConceptScheme.TGSConcepts ;
    skos:topConceptOf tgs:ConceptScheme.TGSConcepts ;
    dcterms:source <https://en.wikipedia.org/wiki/Energy_return_on_investment>,
        <https://www.sciencedirect.com/topics/engineering/energy-return-on-investment>,
        <https://world-nuclear.org/information-library/energy-and-the-environment/energy-return-on-investment>,
        <https://pmc.ncbi.nlm.nih.gov/articles/PMC7320919/>,
        <https://www.gov.uk/research-for-development-outputs/eroi-of-different-fuels-and-the-implications-for-society> ;
    dcterms:subject tgs:Subject.EROIAndEnergyQuality ;
    skos:definition "The energy a source delivers divided by the energy spent to get it; the higher it is, the more surplus is left over to run the rest of society."@en ;
    thinkr:extendedDefinition "The ratio of energy delivered by an energy source to the energy required to extract/produce it; central to Hagens' argument that the quality, not just quantity, of energy sources matters for what a society can sustain."@en ;
    skos:prefLabel "Energy Return on Investment"@en ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
        thinkr:hasAlternateTermType tgs:AlternateTermType.ExactMatch, tgs:AlternateTermType.Abbreviation ;
        skos:prefLabel "EROI"@en ;
        skos:scopeNote "SECOND pilot case for the alternate-term mechanism, 2026-08-13 — split out of this Concept's own former compound prefLabel ('EROI (Energy Return on Investment)'), same anti-pattern as Wetware's original compound label. BOTH types asserted deliberately: ExactMatch because this is genuinely the same meaning, Abbreviation because it's specifically a lexical-form relationship, not just a loose synonym. REVISED same day, per MJSullivan's explicit standing convention: when a term IS an Abbreviation of another, the FULL EXPANDED FORM is canonical (prefLabel + IRI local name), the abbreviation itself goes into the AlternateTerm — reversed from this pilot's own first draft, which had it backwards (IRI/prefLabel = 'EROI', full form as the AlternateTerm). See thinkr:AlternateTermType.Abbreviation's own scopeNote for the general rule." ] ;
    thinkr:hasAnalyticalLens thinkr:AnalyticalLensType.Biophysical .

tgs:Concept.EnergyBlindness a thinkr:Concept,
        owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.TGSConcepts ;
    skos:topConceptOf tgs:ConceptScheme.TGSConcepts ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.EROIAndEnergyQuality ;
    skos:definition "Our culture's failure to see how completely modern life depends on cheap, dense, finite energy, because economics treats energy as just another priced input."@en ;
    skos:prefLabel "Energy Blindness"@en ;
    thinkr:contrastsWith tgs:Persona.Buddha ;
    thinkr:influencedBy tgs:Persona.ArtBerman, tgs:Persona.SteveKeen ;
    skos:scopeNote "MJSullivan's own observation, added 2026-08-30: Energy Blindness has a fairly direct relationship to the standard economics concept of externalities — not equivalent, but externalities (costs or benefits of an economic activity borne by parties outside the transaction, left out of market prices) are a key component of how energy blindness actually operates in practice. Real, direct textual confirmation found the same day in TGS_154 (Jane Muncke): Nate's own words, asking whether short-term convenience-seeking happens 'despite the externalities,' using the term directly and unprompted in exactly this context. No dedicated Concept.Externalities individual exists in this graph — a generic economics term, not itself something any specific episode discusses as its own topic — so this relationship is captured here as prose rather than a formal link to an individual that doesn't yet exist. Real, direct origin confirmed 2026-09-16: this real, direct term originates in tgs:Monologue.Frankly_3_EnergyBlindness (June 2022, one of the show's earliest episodes), now built from its own real, complete transcript. Steve Keen is directly credited there by name for a real, foundational formulation Nate builds on: 'labor without energy is a corpse, and technology without energy is a sculpture' -- Nate's own real, direct addition to that same line: 'a city without energy is a museum.'"@en ;
    thinkr:hasAnalyticalLens thinkr:AnalyticalLensType.Biophysical, thinkr:AnalyticalLensType.PsychologicalInner ;
    .

tgs:Concept.EnergySlaves a thinkr:Concept,
        owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.TGSConcepts ;
    skos:topConceptOf tgs:ConceptScheme.TGSConcepts ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.EROIAndEnergyQuality ;
    skos:definition "Fossil energy expressed as human labor equivalents -- a barrel of oil does years of human work -- to make the size of our energy subsidy tangible."@en ;
    skos:prefLabel "Energy Slaves"@en ;
    thinkr:hasAnalyticalLens thinkr:AnalyticalLensType.Biophysical ;
    skos:altLabel "Human labour equivalents"@en .

tgs:Concept.GreatSimplification a thinkr:Concept, thinkr:HagensConcept,
        owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.TGSConcepts ;
    skos:topConceptOf tgs:ConceptScheme.TGSConcepts ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.SystemsFrameworks ;
    skos:definition "The coming, likely non-linear decline in energy use, material throughput and complexity as fossil surplus energy falls short of what the economy has grown to expect."@en ;
    skos:prefLabel "The Great Simplification"@en ;
    thinkr:contrastsWith tgs:SchoolOfThought.TechnoOptimism ;
    thinkr:relatesTo tgs:ScenarioFacet.TheGreatSimplification ;
    dcterms:references tgs:Interview.TGS_100_NateHagens ;
    skos:scopeNote "CANONICAL REFERENCE ADDED 2026-08-30: tgs:Interview.TGS_100_NateHagens designated by MJSullivan as the primary episode to link whenever a reference to this Concept as a whole is needed — the show's 100th episode, a real, comprehensive synthesis of the framework covering nearly every major concept in this graph in one sitting, made unusually direct by a genuine role reversal (Kate Raworth interviewing Nate rather than the reverse). OPEN DESIGN QUESTION, raised by MJSullivan same day, deliberately NOT resolved yet — no changes made pending further thought: this Concept may really function as an umbrella term for the whole show/framework rather than a specific, citable idea individual episodes 'discuss' the way Concept.DarkTriad or Concept.Superorganism do. If that's right, a real category mismatch may be sitting underneath the dct:references link just added — an umbrella label for an entire body of work isn't naturally 'referenced by' one episode among hundreds the way a specific concept is, even a comprehensive one. The umbrella-term reading has real value on its own (a durable, top-level label for the whole project), independent of whether episode-linkage is the right mechanism for it. Left as-is for now; revisit if this tension recurs elsewhere or a clearer resolution presents itself. contrastsWith added 2026-08-13. Real, direct evidence, not inferred from tone alone: RR-24's own official episode description centers its entire premise on critiquing techno-optimists' space-colonization ambitions as a way of 'bypassing the problems we now face on Earth' — this graph's own already-built Concept.EnergyBlindness makes the same underlying critique in general form. MJSullivan's own framing, worth preserving: this graph's discipline is about verifying real sources, not about false neutrality — Hagens' own real material already takes a clear, evidenced side here. SPLIT 2026-08-13: this individual was dual-typed as both Concept and ScenarioFacet (added, then reverted from an even earlier split attempt, then re-split here) — now holds the Concept role only, with the grid-specific ScenarioFacet role split out to its own individual, tgs:ScenarioFacet.TheGreatSimplification, linked via thinkr:relatesTo. See that individual's own scopeNote for the full reasoning and migration record."@en ;
    thinkr:hasAnalyticalLens thinkr:AnalyticalLensType.Biophysical .

tgs:Concept.GrowthImperative a thinkr:Concept,
        owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.TGSConcepts ;
    skos:topConceptOf tgs:ConceptScheme.TGSConcepts ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.MonetarySystemAndGrowth ;
    skos:definition "Debt-based money and compound interest require continual growth, which locks in ever-rising energy and material use regardless of limits."@en ;
    skos:prefLabel "The Growth Imperative"@en ;
    thinkr:hasAnalyticalLens thinkr:AnalyticalLensType.Institutional, thinkr:AnalyticalLensType.Biophysical .

tgs:Concept.HumanPredicament a thinkr:Concept, thinkr:HagensConcept,
        owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.TGSConcepts ;
    skos:topConceptOf tgs:ConceptScheme.TGSConcepts ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.SystemsFrameworks ;
    skos:definition "Hagens' preferred framing over 'the climate problem' or 'the energy problem' — the interlocking set of ecological overshoot, energy decline, economic dependence on growth, and human behavioral wiring, treated as a single systemic predicament rather than a checklist of separate problems with separate solutions."@en ;
    skos:prefLabel "The Human Predicament"@en .

tgs:Concept.JevonsParadox a thinkr:Concept,
        owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.TGSConcepts ;
    skos:topConceptOf tgs:ConceptScheme.TGSConcepts ;
    dcterms:source <https://en.wikipedia.org/wiki/Jevons_paradox>,
        <https://www.sciencedirect.com/science/article/abs/pii/S0921800905001084>,
        <https://www.researchgate.net/publication/344271331_The_problem_of_energy_efficiency_known_as_the_Jevons_paradox> ;
    dcterms:subject tgs:Subject.EROIAndEnergyQuality ;
    skos:definition "Making a resource more efficient to use tends to increase total use, because it gets cheaper and finds new uses -- why efficiency alone does not cure overshoot."@en ;
    skos:prefLabel "Jevons Paradox"@en ;
    thinkr:influencedBy tgs:Persona.WilliamStanleyJevons ;
    thinkr:hasAnalyticalLens thinkr:AnalyticalLensType.Biophysical, thinkr:AnalyticalLensType.GameTheoretic .

tgs:Concept.LimitsToGrowth a thinkr:Concept,
        owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.TGSConcepts ;
    skos:topConceptOf tgs:ConceptScheme.TGSConcepts ;
    dcterms:source <https://www.clubofrome.org/publication/the-limits-to-growth/> ;
    dcterms:subject tgs:Subject.OvershootAndLimits ;
    skos:definition "The Club of Rome study whose World3 model projected that growth in population, industry and resource use on a finite planet leads to overshoot and decline in the 21st century."@en ;
    skos:prefLabel "Limits to Growth"@en ;
    thinkr:influencedBy tgs:Persona.DennisMeadows, tgs:Persona.DonellaMeadows ;
    thinkr:relatesTo tgs:Persona.GayaHerrington ;
    thinkr:definedIn tgs:Work.LimitsToGrowth1972 ;
    thinkr:hasAnalyticalLens thinkr:AnalyticalLensType.Biophysical .

tgs:Concept.Metacrisis a thinkr:Concept,
        owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.TGSConcepts ;
    skos:topConceptOf tgs:ConceptScheme.TGSConcepts ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.SystemsFrameworks ;
    skos:definition "The view that climate, biodiversity loss, inequality, polarization and other crises share common root causes and must be understood together rather than as separate problems."@en ;
    skos:prefLabel "Metacrisis"@en ;
    thinkr:influencedBy tgs:Persona.GregoryBateson ;
    thinkr:hasAnalyticalLens thinkr:AnalyticalLensType.GameTheoretic, thinkr:AnalyticalLensType.Biophysical .

tgs:Concept.MoneyAsClaimOnEnergy a thinkr:Concept, thinkr:HagensConcept,
        owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.TGSConcepts ;
    skos:topConceptOf tgs:ConceptScheme.TGSConcepts ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.MonetarySystemAndGrowth ;
    skos:definition "Money is not wealth but a claim on future energy and resources, so a debt-fuelled monetary system assumes ever-growing energy throughput."@en ;
    skos:prefLabel "Money as a Claim on Future Energy"@en ;
    thinkr:echoesIdeaOf tgs:Persona.Aristotle ;
    skos:altLabel "Financial claims on biophysical reality"@en .

tgs:Concept.Overshoot a thinkr:Concept,
        owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.TGSConcepts ;
    skos:topConceptOf tgs:ConceptScheme.TGSConcepts ;
    dcterms:source <https://en.wikipedia.org/wiki/Overshoot_(book)> ;
    dcterms:subject tgs:Subject.OvershootAndLimits ;
    skos:definition "Using resources and sinks faster than nature can regenerate or absorb them, which temporarily lifts a population above its long-term carrying capacity while drawing that capacity down."@en ;
    thinkr:extendedDefinition "The condition of a population/economy consuming renewable and non-renewable resources faster than natural systems can regenerate or absorb waste from them, borrowed from systems ecology (Catton, Meadows) and applied to the global economy."@en ;
    skos:prefLabel "Ecological Overshoot"@en ;
    thinkr:convergesWith tgs:SchoolOfThought.DoughnutEconomics ;
    thinkr:influencedBy tgs:Persona.WilliamCatton ;
    skos:altLabel "Ecological overshoot"@en .

tgs:Concept.PeakOil a thinkr:Concept,
        owl:NamedIndividual ;
    skos:altLabel "Hubbert Peak Theory"@en ;
    skos:inScheme tgs:ConceptScheme.TGSConcepts ;
    skos:topConceptOf tgs:ConceptScheme.TGSConcepts ;
    dcterms:source <https://en.wikipedia.org/wiki/Peak_oil> ;
    dcterms:subject tgs:Subject.EROIAndEnergyQuality ;
    skos:definition "The point of maximum oil extraction, after which production declines; the starting point of Nate's work on energy and the economy."@en ;
    thinkr:extendedDefinition "The point at which the maximum rate of petroleum extraction is reached, after which production enters terminal decline — a formative concept in Hagens' background (he worked as a peak oil analyst before founding The Great Simplification) and foundational to his energy-decline framing."@en ;
    skos:prefLabel "Peak Oil"@en ;
    thinkr:influencedBy tgs:Persona.MKingHubbert ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
        thinkr:hasAlternateTermType tgs:AlternateTermType.ExactMatch ;
        skos:prefLabel "Hubbert Peak Theory"@en ;
        skos:scopeNote "The formal academic name for this same observation, per Hubbert's own 1956 paper 'Nuclear Energy and the Fossil Fuels' (presented to the American Petroleum Institute) — real citation confirmed via https://en.wikipedia.org/wiki/Hubbert_peak_theory. ExactMatch, not just Related: same core referent as Peak Oil, just formal/academic naming versus the popularized term this graph's source material actually uses." ] .

tgs:Concept.Superorganism a thinkr:Concept,
        owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.TGSConcepts ;
    skos:topConceptOf tgs:ConceptScheme.TGSConcepts ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.SystemsFrameworks ;
    skos:definition "Global civilization as a single energy-consuming entity whose behavior emerges from the system, not from anyone's intentions -- and which no one is steering."@en ;
    skos:prefLabel "The Superorganism"@en ;
    thinkr:echoesIdeaOf tgs:Persona.JoshFarley ;
    thinkr:influencedBy tgs:Persona.EOWilson ;
    thinkr:hasAnalyticalLens thinkr:AnalyticalLensType.Biophysical, thinkr:AnalyticalLensType.GameTheoretic .

tgs:Concept.TheoryOfChange a thinkr:Concept,
        owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.TGSConcepts ;
    skos:topConceptOf tgs:ConceptScheme.TGSConcepts ;
    dcterms:source <https://www.thegreatsimplification.com/wp-content/uploads/2025/12/TGS-205-Nate-Hagens-Transcript.pdf> ;
    dcterms:subject tgs:Subject.CommunityAndResponse ;
    skos:definition "Rather than converting millions, inform and connect a smaller 'scout team' that changes the initial conditions from which larger change can emerge."@en ;
    skos:prefLabel "Theory of Change"@en ;
    thinkr:hasAlternateTerm
        [ a thinkr:AlternateTerm ;
            thinkr:hasAlternateTermType tgs:AlternateTermType.Related ;
            skos:prefLabel "Emergence"@en ;
            skos:scopeNote "FIFTH pilot case, 2026-08-13, and the first with 3 terms tangled in one label rather than 2 — split out of this Concept's own former compound prefLabel (\"Theory of Change (Emergence / Initial Conditions)\") into a base concept plus TWO separate AlternateTerms rather than one. Typed Related: 'emergence' is the broader systems-science phenomenon this Theory of Change relies on, not a direct synonym for it." ],
        [ a thinkr:AlternateTerm ;
            thinkr:hasAlternateTermType tgs:AlternateTermType.Related ;
            skos:prefLabel "Initial Conditions"@en ;
            skos:scopeNote "See the sibling 'Emergence' AlternateTerm's scopeNote on this same Concept for the full split rationale. Typed Related for the same reason: the specific mechanism this Theory of Change acts through ('shift the initial conditions'), not a synonym for the Theory of Change itself." ] ;
    thinkr:hasAnalyticalLens thinkr:AnalyticalLensType.PracticalPersonal .

tgs:Concept.Wetware a thinkr:Concept,
        owl:NamedIndividual ;
    skos:altLabel "Evolutionary Mismatch"@en ;
    skos:inScheme tgs:ConceptScheme.TGSConcepts ;
    skos:topConceptOf tgs:ConceptScheme.TGSConcepts ;
    dcterms:source <https://en.wikipedia.org/wiki/Wetware_(brain)> ;
    dcterms:subject tgs:Subject.BehavioralEconomicsAndCognition ;
    skos:definition "Human brains and emotions evolved for small Pleistocene bands and scarcity, and are poorly matched to abundance, abstraction and global-scale decisions."@en ;
    skos:prefLabel "Human 'Wetware'"@en ;
    thinkr:echoesIdeaOf tgs:Persona.SigmundFreud ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
        thinkr:hasAlternateTermType tgs:AlternateTermType.ExactMatch ;
        skos:prefLabel "Evolutionary Mismatch"@en ;
        skos:scopeNote "PILOT CASE for the alternate-term mechanism, 2026-08-13 — split out of this Concept's own former compound prefLabel (\"Human 'Wetware' / Evolutionary Mismatch\"), which had jammed two real terms into one string. Kept as an anonymous blank node (Tier 2, per MJSullivan's own hasAlternateTerm pattern) rather than promoted to a named thinkr:AlternateTerm individual — not yet reused across any other Concept, no independent citable history captured yet. Promote to a named individual if/when either changes." ] .

thinkr:Concept a owl:Class ;
    rdfs:comment "A term or idea discussed within Nate Hagens' Great Simplification framework — the UMBRELLA level, deliberately broad: includes ideas he originated/reframed himself (see the narrower thinkr:HagensConcept subclass) AND real ideas/theories he adopts, synthesizes, or substantively engages with from elsewhere (e.g. Terror Management Theory, Peak Oil, the Superorganism) without having originated them. REVISED 2026-08-13, per MJSullivan's explicit direction, after auditing all 26 existing Concept individuals found the majority (19 of 26) already had documented external origination (15 via explicit thinkr:influencedBy/echoesIdeaOf/contrastsWith links to a real Persona, plus 4 more confirmed external by their own prose) — external adoption/synthesis is the NORM here, not the exception, which is why a narrower subclass for his own originated ideas specifically was worth adding rather than assumed."@en ;
    rdfs:subClassOf skos:Concept ;
    skos:scopeNote "Narrower than skos:Concept: specifically an idea discussed within Hagens' TGS framework, not a general classification term — do not confuse with thinkr:Subject, which is also a skos:Concept subclass but for topic classification, a different purpose entirely."@en ;
    skos:prefLabel "Concept"@en .

thinkr:HagensConcept a owl:Class ;
    rdfs:subClassOf thinkr:Concept ;
    rdfs:comment "The narrower subclass of thinkr:Concept specifically for ideas Nate Hagens originated, coined, or gave a genuinely distinctive reframing to himself — as opposed to the broader umbrella, which also covers real ideas/theories he substantively engages with but adopted from elsewhere. ADDED 2026-08-13, raised by MJSullivan specifically to be able to isolate Nate's own unique contributions from the broader set of ideas his show discusses. Classification requires real per-Concept judgment, not a mechanical rule — 'has no documented external lineage yet' is NOT sufficient evidence on its own (several genuinely external ideas, like Terror Management Theory and EROI, had no formal thinkr:influencedBy triple asserted despite being clearly not his own) — each of the 7 initial members was individually checked against its own existing definition/scopeNote before being classified here."@en ;
    skos:prefLabel "Hagens Concept"@en .


