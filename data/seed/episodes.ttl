# premiered via YouTube Premiere May 19, 2022 (confirmed directly via
# Nate's own real Substack announcement, 'announcing the great
# simplification') — a separate, distinct 'full movie' upload exists
# at https://www.youtube.com/watch?v=-xr9rIQxwj4, alongside the 4
# individual part videos modeled here. Nate's own real Substack post
# uses "Act N" terminology for the 4 parts; both that and the videos'
# own "Part N of 04" titling are preserved.
#############################################

tgs:Series.GreatSimplificationAnimatedSeries a thinkr:Series, dcmitype:Collection, owl:NamedIndividual ;
    dct:hasPart
        tgs:AnimatedVideo.Part1EnergyBlind, tgs:AnimatedVideo.Part2TheHumanSuperorganism,
        tgs:AnimatedVideo.Part3TheHumanBeing, tgs:AnimatedVideo.Part4TheGreatSimplification ;
    skos:prefLabel "The Great Simplification Animated Series"@en ;
    rdfs:comment "4-part animated explanatory series (EnergyandOurFuture.org/ISEOF, animated by Jumbo), combined into a single 32-minute film premiered via YouTube Premiere May 19, 2022. Real, consistent-across-all-4-parts production credits: Nate Hagens (Executive Producer), Leslie Batt-Lutz (Creative Director), Elizabeth Sirianni (Editor & Creative Consultant), Justin Ritchie (Producer, Jumbo), Elliot Wilks (Lead Animator & Art Director, Jumbo). Part-specific credits (illustrator, voice coaches) are on each individual AnimatedVideo. Real 'thanks to' contributors credited across all 4 parts for script/sound/suggestions: tgs:Human.DJWhite, tgs:Human.ChuckWatson (Chuck Watson's identification here is plausible given his own extensive, real, established TGS collaboration, but not independently confirmed as the same individual beyond name match), and tgs:Human.JoanDiamond — all three already real, built Personas in this graph. Joan Diamond's status was upgraded 2026-08-13 (same day) from an unbuilt acknowledgment-level credit to a full Persona, after Frankly_80's own transcript independently confirmed her as a real prior TGS guest (#28) and an unusually close relationship ('longtime friend, colleague, board member, and muse'). Rex Weyler, Kyle Saunders, Travis Hall, and Todd Hagens remain real but not built as individuals — peripheral acknowledgment-level credits."@en ;
    dct:creator tgs:Human.NateHagens ;
    thinkr:hasCanonicalSource <https://www.thegreatsimplification.com/resources> ;
    .

tgs:AnimatedVideo.Part1EnergyBlind a thinkr:Episode, owl:NamedIndividual ;
    thinkr:hasEpisodeType thinkr:EpisodeType.AnimatedVideo ;
    skos:prefLabel "Energy Blind (Part 1 of 4)"@en ;
    skos:definition "Real, direct narrative of deep-time human history — from Earth's formation through the Neolithic agricultural revolution to the 19th-century discovery of fossil-energy extraction — arguing the last 200 years of growth rest on a one-time geological windfall of stored solar energy, and that modern culture and institutions systematically fail to appreciate this ('energy blind'). Closes on the real, direct claim that early access to fossil energy would have appeared 'indistinguishable from magic' to prior generations, and that instead of recognizing the windfall, modern culture built stories crediting the resulting wealth to human ingenuity alone."@en ;
    dct:isPartOf tgs:Series.GreatSimplificationAnimatedSeries ;
    thinkr:seriesPosition 1 ;
    thinkr:hasCanonicalSource <https://www.youtube.com/watch?v=T19tHn_LA80> ;
    thinkr:hasTranscript <https://www.youtube.com/watch?v=T19tHn_LA80> ;
    thinkr:discusses tgs:Concept.EnergyBlindness, tgs:Concept.CarbonPulse ;
    dct:contributor "Caleb Bond (Illustrator)"@en ;
    .

