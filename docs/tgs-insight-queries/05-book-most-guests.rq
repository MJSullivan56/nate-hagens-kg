# The book or paper cited across the most different guests' episodes.
PREFIX thinkr: <http://example.org/thinkr#>
PREFIX tgs:    <http://example.org/tgs#>
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?w ?title (COUNT(DISTINCT ?g) AS ?guests) (GROUP_CONCAT(DISTINCT ?gl; separator=", ") AS ?who) WHERE {
  ?e dct:references ?w ; thinkr:hasGuest ?g . ?w a thinkr:Work ; skos:prefLabel ?title .
  ?g rdfs:label ?gl0 . BIND(REPLACE(?gl0," \\(persona\\)","") AS ?gl)
} GROUP BY ?w ?title ORDER BY DESC(?guests) LIMIT 3
