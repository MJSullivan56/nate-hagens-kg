@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tgs: <http://example.org/tgs#> .
@prefix thinkr: <http://example.org/thinkr#> .

<http://example.org/tgs#> a owl:Ontology ;
    owl:imports <http://example.org/thinkr#> ;
    rdfs:comment "Imports tgs-core for Protege compatibility — editing this file alone will resolve thinkr: classes/properties via the catalog file."@en .

#############################################
# ADDED 2026-08-13 — the 42 individual Doughnut indicators (2 per each
# of the 21 categories in doughnutcategories.ttl), sourced from
# MJSullivan's own manual transcription of
# tgs:Work.CaliforniaDoughnutReport2025. Names kept EXACTLY as given in
# that transcription, including informal/internal-sounding labels (e.g.
# "Report Not Happy") — deliberately not renamed to sound more formal,
# since the whole point of this taxonomy is matching CalDEC's own
# framing exactly, per MJSullivan's own stated motivation. rdfs:subClassOf
# thinkr:Concept (NOT thinkr:HagensConcept) — see tgs-core.ttl's own
# comment block.
#############################################

thinkr:Indicator a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:comment "One of the 42 specific, named metrics within the Doughnut Economics model (e.g. Water Quality, Greenhouse Gas Emissions), each belonging to one thinkr:IndicatorCategory."@en ;
    skos:prefLabel "Doughnut Indicator"@en .

thinkr:shortfallPercent a owl:DatatypeProperty ;
    rdfs:domain thinkr:Indicator ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "shortfall percent"@en ;
    skos:definition "How far a social-foundation indicator falls short of its threshold, as a percentage, as reported in the indicator's source (dcterms:source)."@en .

thinkr:overshootPercent a owl:DatatypeProperty ;
    rdfs:domain thinkr:Indicator ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "overshoot percent"@en ;
    skos:definition "How far an ecological-ceiling indicator exceeds its boundary, as a percentage, as reported in the indicator's source (dcterms:source); 0 means within the boundary."@en .

#############################################
# Water & Sanitation
#############################################

tgs:Indicator.WaterQuality a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.WaterAndSanitation ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.WaterAndSanitation ;
    skos:prefLabel "Water Quality"@en ;
    skos:definition "Share of people served by water systems that do not meet quality standards."@en ;
    thinkr:shortfallPercent "2.2"^^xsd:decimal ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage shortfall below the social foundation. Earlier paraphrased definition: 'The safety and cleanliness of public drinking water supplies, screening for toxic contaminants or pollutants.'"@en .

tgs:Indicator.SanitationAccess a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.WaterAndSanitation ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.WaterAndSanitation ;
    skos:prefLabel "Sanitation Access"@en ;
    skos:definition "Share of people lacking basic sanitation."@en ;
    thinkr:shortfallPercent "0.6"^^xsd:decimal ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage shortfall below the social foundation. Earlier paraphrased definition: 'The availability of clean, functional sewage and wastewater infrastructure across communities.'"@en .

#############################################
# Energy
#############################################

tgs:Indicator.EnergyBurden a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.Energy ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.Energy ;
    skos:prefLabel "Energy Burden"@en ;
    skos:definition "Share of households whose energy bill is 10% or more of income."@en ;
    thinkr:shortfallPercent "20"^^xsd:decimal ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage shortfall below the social foundation. Earlier paraphrased definition: 'The percentage of household income spent strictly on electric, gas, and heating utility bills.'"@en .

tgs:Indicator.EnergyReliability a thinkr:Indicator, owl:NamedIndividual ;
    skos:inScheme tgs:ConceptScheme.CaliforniaDoughnutIndicators ;
    skos:broader tgs:IndicatorCategory.Energy ;
    dcterms:source tgs:Work.CaliforniaDoughnutReport2025 ;
    thinkr:hasIndicatorCategory tgs:IndicatorCategory.Energy ;
    skos:prefLabel "Energy Reliability"@en ;
    skos:definition "Share of the population in counties averaging six or more hours of power outage a year."@en ;
    thinkr:shortfallPercent "7"^^xsd:decimal ;
    skos:scopeNote "Definition and value from the California Doughnut Snapshot (pp. 9-12), updated 2026-10-23; the value is the report's percentage shortfall below the social foundation. Earlier paraphrased definition: 'The frequency and duration of power outages or grid blackouts impacting residents.'"@en .

