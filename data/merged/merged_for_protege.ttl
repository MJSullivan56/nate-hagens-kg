tgs:Work.BioregionalFinancingFacilities a thinkr:Work,
        owl:NamedIndividual ;
    dct:creator tgs:Human.SamanthaPower ;
    dct:issued "2024"^^xsd:gYear ;
    dct:source <https://drive.google.com/file/d/1yznJ324biVX_RyVcTKNB96vNMqFbYUI3/view> ;
    rdfs:comment "2024 book, co-authored by Samantha Power and Leon Seefeld — a collaboration between Finance for Gaia, Dark Matter Labs Capital Systems, and the Buckminster Fuller Institute Design Lab. Proposes a new layer in the global financial architecture (Bioregional Financing Facilities/BFFs) to decentralize financial decision-making toward place-based regenerators; includes 12 real case studies. Real advisors listed include tgs:Persona.MatthewMonahan, already a real, built Persona in this graph."@en ;
    skos:prefLabel "Bioregional Financing Facilities: Reimagining Finance to Regenerate Our Planet"@en .

tgs:Work.DesigningRegenerativeCultures a thinkr:Work,
        owl:NamedIndividual ;
    dct:creator tgs:Human.DanielChristianWahl ;
    dct:issued "2016"^^xsd:gYear ;
    rdfs:comment "2016 book by Daniel Christian Wahl (Triarchy Press, UK), translated into 7+ languages — a wide-ranging analysis of ecological design, whole-systems thinking, and regenerative culture, described by reviewers as 'a Whole Earth Catalog for the 21st century.'"@en ;
    owl:sameAs <https://www.amazon.com/Designing-Regenerative-Cultures-Daniel-Christian/dp/1909470775> ;
    skos:prefLabel "Designing Regenerative Cultures"@en .

tgs:Work.FiveInsightsForAvoidingGlobalCollapse a thinkr:Work,
        owl:NamedIndividual ;
    dct:creator tgs:Human.GayaHerrington ;
    rdfs:comment "Book by Gaya Herrington, containing an exclusive research update based on 2022 data extending her original World3 empirical re-test (see tgs:Work.UpdateToLimitsToGrowth2021). Confirmed via WebFetch of her own bio site (gayaherrington.com/about) 2026-07-15 — exact publisher/ISBN/year not yet independently verified, flagged honestly rather than guessed, same discipline as tgs:Work.RealityBlind's DJ White note."@en ;
    skos:prefLabel "Five Insights for Avoiding Global Collapse"@en .

tgs:Work.OutgrowingModernity a thinkr:Work,
        owl:NamedIndividual ;
    dct:creator tgs:Human.VanessaAndreotti ;
    dct:issued "2025"^^xsd:gYear ;
    rdfs:comment "2025 book by Vanessa Machado de Oliveira (Andreotti), published August 12, 2025 — the real sequel to her 2021 'Hospicing Modernity,' with contributions from Keri Facer and Awo Fatokun Faniyii. Explores 'neurocolonization' — modernity's effects on how people think, act, imagine, and adapt — and includes real documented material on the author's own collaborative work with AI systems (a recurring character, 'Aiden'). Co-founder credit: Gesturing Towards Decolonial Futures (GTDF) Arts/Research Collective."@en ;
    owl:sameAs <https://www.amazon.com/Outgrowing-Modernity-Navigating-Complexity-Accountability/dp/B0DMVDJ4VG> ;
    skos:prefLabel "Outgrowing Modernity: Navigating Complexity, Complicity, and Collapse with Accountability and Compassion"@en .

tgs:Work.TheArrogantApe a thinkr:Work,
        owl:NamedIndividual ;
    dct:creator tgs:Human.ChristineWebb ;
    dct:issued "2025"^^xsd:gYear ;
    rdfs:comment "2025 book by Christine Webb (Penguin Random House) — a real New York Times Notable Book of 2025, longlisted for the Nayef Al-Rodhan Book Prize. Argues human exceptionalism is an ideology relying more on human culture than biology, more on delusion and faith than evidence, drawing on Webb's own primatology research."@en ;
    owl:sameAs <https://www.penguinrandomhouse.com/books/717436/the-arrogant-ape-by-christine-webb/> ;
    skos:prefLabel "The Arrogant Ape: The Myth of Human Exceptionalism and Why It Matters"@en .

tgs:Work.UpdateToLimitsToGrowth2021 a thinkr:Work,
        owl:NamedIndividual ;
    dct:creator tgs:Human.GayaHerrington ;
    dct:issued "2021"^^xsd:gYear ;
    dct:source <https://doi.org/10.1111/jiec.13084> ;
    rdfs:comment "Peer-reviewed article, Journal of Industrial Ecology (Yale University), 2021. DOI 10.1111/jiec.13084. Re-tests the original 1972 Limits to Growth study's World3 model against real-world 2020-era data; finds current trends track most closely with the study's 'Business as Usual 2' and 'Comprehensive Technology' scenarios, both projecting overshoot-and-decline dynamics within the 21st century. Verified via WebSearch 2026-07-15."@en ;
    skos:prefLabel "Update to limits to growth: Comparing the World3 model with empirical data"@en .

thinkr:PersonEntityType.CoAuthor a thinkr:PersonEntityType,
        owl:NamedIndividual ;
    skos:prefLabel "Co-Author"@en .

thinkr:PersonEntityType.Collaborator a thinkr:PersonEntityType,
        owl:NamedIndividual ;
    skos:prefLabel "Collaborator"@en .

thinkr:PersonEntityType.Critic a thinkr:PersonEntityType,
        owl:NamedIndividual ;
    rdfs:comment "Motivated by Elon Musk (2026-07-11) — someone whose relationship to TGS is oppositional, distinct from the Contributor/Mention question (which is about publication alignment, not stance). Schema-only for now, per MJSullivan: 'add critic for now and enrich things later' — no Person individual tagged with this yet."@en ;
    skos:prefLabel "Critic"@en .

thinkr:aboutEntity a owl:ObjectProperty ;
    rdfs:comment "The Person/School/Work etc. this crosswalk note documents an external mapping for."@en ;
    rdfs:domain thinkr:CrosswalkNote ;
    rdfs:range thinkr:NamedEntity ;
    skos:prefLabel "about entity"@en .

thinkr:aboutExternalURI a owl:ObjectProperty ;
    rdfs:comment "The external URI (DBpedia/Wikidata resource) this crosswalk note documents — mirrors the actual owl:sameAs triple's object, kept direct and reasoner-compatible rather than reified."@en ;
    rdfs:domain thinkr:CrosswalkNote ;
    skos:prefLabel "about external URI"@en .

thinkr:aboutObject a owl:ObjectProperty ;
    rdfs:domain thinkr:LinkNote ;
    skos:prefLabel "about object"@en .

thinkr:aboutSource a owl:ObjectProperty ;
    rdfs:comment "OPTIONAL. Absent when the Evidence is direct curator/maintainer reasoning rather than a citation to an external publication — such Evidence defaults to thinkr:ReliabilityType.Reputable for aggregation purposes (see that individual's definition)."@en ;
    rdfs:domain thinkr:Evidence ;
    rdfs:range thinkr:Source ;
    skos:prefLabel "about source"@en .

thinkr:aboutSubject a owl:ObjectProperty ;
    rdfs:domain thinkr:LinkNote ;
    skos:prefLabel "about subject"@en .

thinkr:activeInPhase a owl:ObjectProperty ;
    rdfs:comment "Connects an Archetype to the ResponsePhase its timeline most closely corresponds to. Real, direct textual basis, not a loose analogy: Hagens' own words for the business-as-usual archetypes ('what our culture has aspired to... in the past 50, 70 years') match Phase A's stability; his own words for the Fellowship archetypes ('the next decade or so... the bend or break moment') match Phase B by name; his own words for the future archetypes ('20, 30, 40 years from now after we've navigated the bringing the ring to Mordor situation') match Phase C's framing of a destination reached only after building through A and B. One real caveat preserved honestly: Hagens states the future archetypes are 'not only' needed later — 'we need those people today as well' — so this link marks where each Archetype is MOST associated, not an exclusive membership."@en ;
    rdfs:domain thinkr:Archetype ;
    rdfs:range thinkr:ResponsePhase ;
    skos:prefLabel "active in phase"@en .

thinkr:actsThrough a owl:ObjectProperty ;
    rdfs:comment "Links a Persona back to the Human(s) behind it — the ONLY property in this graph that connects a Persona to a Human. Naming/directionality borrowed from DOLCE+DnS Ultralite's actsThrough/actsFor pair (examined directly 2026-07-12; this was the one piece of DOLCE flagged as worth keeping)."@en ;
    rdfs:domain thinkr:Persona ;
    rdfs:range thinkr:Human ;
    skos:prefLabel "acts through"@en .

thinkr:appliesTo a owl:ObjectProperty ;
    rdfs:comment "For activists/practitioners rather than philosophers: this person's work is a concrete instance of the concept (e.g. MLK's organizing as an example of collective-action dynamics discussed under a TGS concept)."@en ;
    rdfs:domain thinkr:Persona ;
    rdfs:range thinkr:Concept ;
    skos:prefLabel "provides real-world example of"@en ;
    skos:scopeNote "DOMAIN CHANGED 2026-07-14 (Batch 5 of the Persona-centered refactor): was thinkr:Human, moved to thinkr:Persona, per MJSullivan's explicit approval — same reasoning as every other Concept-facing property migrated in this batch. The single existing instance (MLK->GrowthImperative, linknotes.ttl) was already pointing at tgs:Persona.MartinLutherKingJr by the time this domain was fixed — caught as a side effect of an earlier blanket Human->Persona text replacement in that file, not a separate deliberate step; this declaration just brings the schema in line with what the data already said."@en .

thinkr:calculatedConfidence a owl:ObjectProperty ;
    rdfs:comment "DERIVED — computed from a LinkNote's Evidence set by scripts/compute_confidence.py. Never hand-write this value into a TTL file; it will drift out of sync with its own evidence. Re-run the compute script after adding/editing any Evidence."@en ;
    rdfs:domain thinkr:LinkNote ;
    rdfs:range thinkr:ConfidenceType ;
    skos:prefLabel "calculated confidence"@en .

thinkr:confidence a owl:ObjectProperty ;
    rdfs:comment "Has THIS piece of evidence been human-reviewed? Points to thinkr:ConfidenceType.Curated or .Candidate only (the other two values, Corroborated/Disputed, are LinkNote-only via thinkr:calculatedConfidence). Domain history: originally xsd:string on thinkr:Concept (wrong), then an enumerated object property on thinkr:LinkNote directly (better, but conflated the assertion with its evidence), now correctly on thinkr:Evidence as part of the Evidence/Source provenance model."@en ;
    rdfs:domain thinkr:Evidence ;
    rdfs:range thinkr:ConfidenceType .

thinkr:contrastsWith a owl:ObjectProperty ;
    rdfs:comment "Useful tension or disagreement worth surfacing to a learner, not just agreement."@en ;
    rdfs:subPropertyOf thinkr:relatesTo ;
    skos:prefLabel "contrasts with"@en ;
    skos:scopeNote "Narrower than thinkr:relatesTo: specifically a useful tension or disagreement, not any relation — does not imply influence in either direction."@en .

thinkr:convergesWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "Independently-developed ideas/frameworks converging on similar conclusions, with NO claimed causal lineage or direct influence — distinct from influencedBy/echoesIdeaOf, which both imply direction. Formally symmetric per OWL semantics, BUT this project's query tooling doesn't run a reasoner (same reason owl:NamedIndividual is asserted explicitly everywhere rather than relied on via subclass inference) — so BOTH directions must be explicitly asserted as real triples, or querying from the 'other' side returns nothing. Verified empirically 2026-07-11: querying tgs:SchoolOfThought.DoughnutEconomics thinkr:convergesWith ?x returned zero results until the reverse triple was added by hand, despite the forward direction being asserted and the property being formally symmetric. First used for tgs:Concept.Overshoot <-> tgs:SchoolOfThought.DoughnutEconomics."@en ;
    skos:prefLabel "converges with"@en .

thinkr:crosswalkSource a owl:ObjectProperty ;
    rdfs:domain thinkr:CrosswalkNote ;
    rdfs:range thinkr:CrosswalkSource ;
    skos:prefLabel "crosswalk source"@en .

thinkr:definedIn a owl:ObjectProperty ;
    rdfs:domain thinkr:Concept ;
    rdfs:range thinkr:Work ;
    skos:prefLabel "primarily defined in"@en .

thinkr:diagonallyDisjointWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "Two ScenarioFacets within the same ScenarioDimension differing on BOTH X and Y — the diagonal-opposite pair in a 2x2 grid (e.g. Mad Max vs. Green Growth on the Economic Dimension), sharing nothing on either axis. This is the ONLY grid relationship that represents genuine disjointness, per MJSullivan's own correction 2026-08-13 — a pair sharing one whole axis of agreement (see thinkr:xAxisDivergentFrom/thinkr:yAxisDivergentFrom) is not truly disjoint, no matter how much they differ on the other axis; only full, no-shared-ground opposition earns that word. Computed directly from each Facet's own thinkr:hasXPosition/thinkr:hasYPosition/thinkr:hasScenarioDimension, not hand-asserted independently of that data."@en ;
    rdfs:domain thinkr:ScenarioFacet ;
    rdfs:range thinkr:ScenarioFacet ;
    rdfs:subPropertyOf thinkr:logicallyDisjointWith ;
    skos:prefLabel "diagonally disjoint with"@en .

thinkr:discusses a owl:ObjectProperty ;
    rdfs:domain thinkr:Episode ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( thinkr:Concept thinkr:EarthSystemComponent thinkr:SchoolOfThought thinkr:Scenario thinkr:ScenarioFacet ) ] ;
    skos:comment "Which Concept(s)/EarthSystemComponent(s)/SchoolOfThought(s)/Scenario(s)/ScenarioFacet(s) an Episode actually discusses — closes the gap identified 2026-07-13 (zero Episode->Concept links existed before this). Named 'discusses' with Episode as subject, matching every other Episode property's directionality (hasHost/hasGuest/hasCanonicalSource/dct:subject/dct:created all have Episode as subject) — deliberately NOT 'thinkr:discussedIn' as originally sketched in extraction/README.md, which would have had Concept as subject, facing the opposite direction from its siblings. thinkr:discussedIn itself REMOVED 2026-08-13 — confirmed via grep across the full data/seed/ directory to have zero real usage (only ever appeared in this comment and its own now-deleted declaration), same for thinkr:hostedBy (confirmed dead in relationships.ttl's own scopeNote explaining its deprecation) — both were leftover schema that outlived the decisions that superseded them. RANGE WIDENED 2026-08-13 to include thinkr:EarthSystemComponent, then WIDENED AGAIN same day to include thinkr:SchoolOfThought, then WIDENED A THIRD TIME same day to include thinkr:Scenario and thinkr:ScenarioFacet — closing the one genuinely missing edge between the Scenario-matrix work and the episode-linking work, per MJSullivan's explicit correction that Concept/Scenario/Series/Episode form a real graph with multiple direct edges, not a chain requiring traversal through intermediate nodes (Episode already links directly to Concept without routing through Scenario, and this closes the analogous Episode<->Scenario/ScenarioFacet gap the same direct way). Reusing this exact property each time rather than inventing a parallel one, matching this project's standing 'don't build new relationship machinery when an existing generic one already fits' discipline."@en ;
    skos:prefLabel "discusses"@en .

thinkr:echoesIdeaOf a owl:ObjectProperty ;
    rdfs:comment "The TGS concept independently converges on / restates an idea this person is known for. No claim of direct influence."@en ;
    rdfs:domain thinkr:Concept ;
    rdfs:range thinkr:Persona ;
    rdfs:subPropertyOf thinkr:relatesTo ;
    skos:prefLabel "echoes idea of"@en ;
    skos:scopeNote "Narrower than thinkr:relatesTo: specifically independent convergence on a similar idea — explicitly NOT a claim of direct influence, see thinkr:influencedBy for that distinct, stronger case. RANGE CHANGED 2026-07-14 (Batch 5 of the Persona-centered refactor, docs/sidecar-cleanup-handoff.md) from thinkr:Human to thinkr:Persona: this is the graph's actual core mechanism — every Concept->thinker connection is fundamentally about that person's PUBLIC INTELLECTUAL ROLE, never a private biographical fact. All existing echoesIdeaOf triples (linknotes.ttl) migrated Human->Persona in the same pass."@en .

thinkr:episode a owl:ObjectProperty ;
    rdfs:domain thinkr:PodcastAppearance ;
    rdfs:range thinkr:Episode ;
    skos:comment "Used when the appearance is a real, already-modeled Episode individual. For appearances on OTHER shows not modeled in this graph, use showName/hostedBy instead (see the reciprocal Matthew Monahan case)."@en ;
    skos:prefLabel "episode"@en .

thinkr:evidencePolarity a owl:ObjectProperty ;
    rdfs:domain thinkr:Evidence ;
    rdfs:range thinkr:PolarityType ;
    skos:prefLabel "evidence polarity"@en .

thinkr:favorsFacet a owl:ObjectProperty ;
    rdfs:comment "Which ScenarioFacet a SchoolOfThought's own core beliefs effectively argue for or predict as achievable — a meaning-level structural match (this belief system's vision of the future IS this facet's own definition), not an empirical claim that the facet is realistic or likely to occur. Does not imply this graph endorses the SchoolOfThought's belief; ScenarioFacet.GreenGrowth's own scopeNote already records Hagens' own contrary assessment (his 'least realistic option on this Dimension') independently of this property."@en ;
    rdfs:domain thinkr:SchoolOfThought ;
    rdfs:range thinkr:ScenarioFacet ;
    rdfs:subPropertyOf thinkr:relatesTo ;
    skos:prefLabel "favors facet"@en ;
    skos:scopeNote "Deliberately narrower than thinkr:discusses (which just says an Episode mentions something) — this is a structural claim about what a SchoolOfThought's OWN internal logic points toward, asserted once at the SchoolOfThought level rather than needing to be re-derived from every Episode that happens to discuss it."@en .

thinkr:hasAcademicRelationship a owl:ObjectProperty ;
    rdfs:domain thinkr:NamedEntity ;
    rdfs:range thinkr:Relationship ;
    skos:comment "Sibling of thinkr:hasPersonalRelationship, minted 2026-07-15 in the same retrofit — links a Persona to Relationship individuals whose thinkr:hasRelationshipType includes RelationshipType.Academic. See hasPersonalRelationship's own comment for the full family design."@en ;
    skos:prefLabel "has academic relationship"@en .

thinkr:hasAlternateTerm a owl:ObjectProperty ;
    rdfs:domain thinkr:Concept ;
    rdfs:range thinkr:AlternateTerm ;
    skos:prefLabel "has alternate term"@en ;
    skos:scopeNote "Domain deliberately Concept-only for now — Persona (real people going by different names) or Organization may need this too eventually, but not built ahead of real demonstrated need, same discipline as the has*Relationship family's original Persona-only scoping."@en .

thinkr:hasAlternateTermType a owl:ObjectProperty ;
    rdfs:domain thinkr:AlternateTerm ;
    rdfs:range thinkr:AlternateTermType ;
    skos:prefLabel "has alternate term type"@en .

thinkr:hasCanonicalSource a owl:ObjectProperty ;
    rdfs:domain thinkr:Episode ;
    rdfs:subPropertyOf dct:source ;
    skos:scopeNote "The canonical page for this Episode — expected cardinality of exactly one, unlike the general dct:source (still used elsewhere in this graph, e.g. Work.CaliforniaDoughnutReport2025, with no such cardinality expectation). subPropertyOf lets this stay a genuine dct:source for anything that reads it generically, while carrying a narrower, Episode-specific meaning here — a scopeNote directly on dct:source itself would incorrectly apply globally to every other use of that property in this graph."@en .

thinkr:hasDiscussionSummary a owl:DatatypeProperty ;
    rdfs:comment "A prose summary of how the episode's participants actually related to each other's positions — genuine agreement, productive clarification, or real disagreement — as distinct from what topics came up (thinkr:discusses) or what the episode is generally about (skos:definition). Most valuable for thinkr:EpisodeType.PanelDiscussion episodes with multiple guests, where a reader can't tell from the topic list alone whether the guests actually converged, talked past each other, or genuinely disagreed — but not restricted to PanelDiscussion only, since a solo Interview can also feature real host/guest tension worth the same treatment. Written from the actual transcript, not inferred from the show notes or description alone."@en ;
    rdfs:domain thinkr:Episode ;
    rdfs:range rdf:langString ;
    skos:prefLabel "has discussion summary"@en .

thinkr:hasDistanceToQN11 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Precomputed Euclidean distance from this QuadrantNode to the real corner at (1,1) (0-6 grid, lower-left origin)."@en ;
    rdfs:domain thinkr:QuadrantNode ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "hasDistanceToQN11"@en .

thinkr:hasDistanceToQN15 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Precomputed Euclidean distance from this QuadrantNode to the real corner at (1,5) (0-6 grid, lower-left origin)."@en ;
    rdfs:domain thinkr:QuadrantNode ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "hasDistanceToQN15"@en .

thinkr:hasDistanceToQN51 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Precomputed Euclidean distance from this QuadrantNode to the real corner at (5,1) (0-6 grid, lower-left origin)."@en ;
    rdfs:domain thinkr:QuadrantNode ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "hasDistanceToQN51"@en .

thinkr:hasDistanceToQN55 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Precomputed Euclidean distance from this QuadrantNode to the real corner at (5,5) (0-6 grid, lower-left origin)."@en ;
    rdfs:domain thinkr:QuadrantNode ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "hasDistanceToQN55"@en .

thinkr:hasDoughnutHalf a owl:ObjectProperty ;
    rdfs:comment "Which of the 2 Doughnut halves (Social Foundation / Ecological Ceiling) this Category belongs to."@en ;
    rdfs:domain thinkr:IndicatorCategory ;
    rdfs:range thinkr:DoughnutHalf ;
    skos:prefLabel "has doughnut half"@en .

thinkr:hasEarthSystemsXPosition a owl:DatatypeProperty ;
    rdfs:comment "This Scenario's Earth Systems-dimension X position — must match its chosen Facet's own thinkr:hasXPosition."@en ;
    rdfs:domain thinkr:Scenario ;
    rdfs:range xsd:integer ;
    skos:prefLabel "has Earth Systems X position"@en .

thinkr:hasEarthSystemsYPosition a owl:DatatypeProperty ;
    rdfs:comment "This Scenario's Earth Systems-dimension Y position — must match its chosen Facet's own thinkr:hasYPosition."@en ;
    rdfs:domain thinkr:Scenario ;
    rdfs:range xsd:integer ;
    skos:prefLabel "has Earth Systems Y position"@en .

thinkr:hasEconomicXPosition a owl:DatatypeProperty ;
    rdfs:comment "This Scenario's Economic-dimension X position (1-5 continuum) — must match its chosen Economic ScenarioFacet's own thinkr:hasXPosition."@en ;
    rdfs:domain thinkr:Scenario ;
    rdfs:range xsd:integer ;
    skos:prefLabel "has Economic X position"@en .

thinkr:hasEconomicYPosition a owl:DatatypeProperty ;
    rdfs:comment "This Scenario's Economic-dimension Y position — must match its chosen Economic ScenarioFacet's own thinkr:hasYPosition."@en ;
    rdfs:domain thinkr:Scenario ;
    rdfs:range xsd:integer ;
    skos:prefLabel "has Economic Y position"@en .

thinkr:hasEpisodeSegment a owl:ObjectProperty ;
    rdfs:comment "Which EpisodeSegment (Frankly/MainShow) this Episode belongs to."@en ;
    rdfs:domain thinkr:Episode ;
    rdfs:range thinkr:EpisodeSegment ;
    skos:prefLabel "has episode segment"@en .

thinkr:hasEpisodeType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain thinkr:Episode ;
    rdfs:range thinkr:EpisodeType ;
    skos:prefLabel "has episode type"@en .

thinkr:hasEvidence a owl:ObjectProperty ;
    rdfs:domain thinkr:LinkNote ;
    rdfs:range thinkr:Evidence ;
    skos:prefLabel "has evidence"@en .

thinkr:hasFacet a owl:ObjectProperty ;
    rdfs:domain thinkr:Scenario ;
    rdfs:range thinkr:ScenarioFacet ;
    skos:prefLabel "has facet"@en ;
    skos:scopeNote "Multi-valued — exactly 4 per Scenario, one per ScenarioDimension, by convention (not enforced as an OWL cardinality restriction, consistent with this project's lighter-weight documented-rule style elsewhere over strict axioms)."@en .

thinkr:hasFacetCode a owl:DatatypeProperty ;
    rdfs:comment "A 2-letter mnemonic code for this Facet, used to construct composite Scenario IRIs (e.g. tgs:Scenario.GS-CI-FN-SW). REVISED 2026-08-13 from single flat letters A-P (dimension-major order) — per MJSullivan's explicit request for something more mnemonic than an arbitrary letter position. Deterministic derivation rule, confirmed 2026-08-13: first letter of the first 2 significant words in the Facet's own local name, dropping articles (The/A/But) as insignificant; single-word Facet names (e.g. Mordor) fall back to their own first 2 letters. Checked by hand for collisions across all 16 current Facets before adopting — none found — but this is NOT guaranteed collision-free by construction for any future Facet added under this same rule; re-check before minting a 17th."@en ;
    rdfs:domain thinkr:ScenarioFacet ;
    rdfs:range xsd:string ;
    skos:prefLabel "has facet code"@en .

thinkr:hasFront a owl:ObjectProperty ;
    rdfs:comment "Connects the overall action-framework Concept to one of its 6 InterventionFronts."@en ;
    rdfs:range thinkr:InterventionFront ;
    skos:prefLabel "has front"@en .

thinkr:hasGeopoliticalXPosition a owl:DatatypeProperty ;
    rdfs:comment "This Scenario's Geopolitical-dimension X position — must match its chosen Facet's own thinkr:hasXPosition."@en ;
    rdfs:domain thinkr:Scenario ;
    rdfs:range xsd:integer ;
    skos:prefLabel "has Geopolitical X position"@en .

thinkr:hasGeopoliticalYPosition a owl:DatatypeProperty ;
    rdfs:comment "This Scenario's Geopolitical-dimension Y position — must match its chosen Facet's own thinkr:hasYPosition."@en ;
    rdfs:domain thinkr:Scenario ;
    rdfs:range xsd:integer ;
    skos:prefLabel "has Geopolitical Y position"@en .

thinkr:hasGuest a owl:ObjectProperty ;
    rdfs:domain thinkr:Work ;
    rdfs:range thinkr:Persona ;
    rdfs:subPropertyOf dct:contributor ;
    skos:scopeNote "A person being interviewed/featured — distinct from dct:contributor's broader sense (editor, co-author, etc. for other Work subtypes). RANGE ADDED 2026-07-14 (Batch 2 of the Persona-centered refactor): even a MINIMAL Persona (identical name, zero distinguishing content, existing solely because the appearance happened) is sufficient — tested concretely in the 2026-07-13 escalation. All 11 existing hasGuest triples migrated Human->Persona in the same pass (episodes.ttl)."@en .

thinkr:hasHost a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain thinkr:Work ;
    rdfs:range thinkr:Persona ;
    rdfs:subPropertyOf dct:creator ;
    skos:scopeNote "The person who hosts/leads this Work — distinct from dct:creator's broader sense, which for other Work subtypes might mean author, director, etc. instead. Same reasoner caveat as thinkr:hasPersonEntityType: doesn't make the fact queryable via bare dct:creator without a reasoner. RANGE ADDED 2026-07-14 (Batch 2 of the Persona-centered refactor, docs/sidecar-cleanup-handoff.md): being a host is a public-facing fact conferred by the appearance itself, which belongs to Persona, not Human directly — same reasoning as hasGuest below. All 14 existing hasHost triples migrated Human->Persona in the same pass (episodes.ttl)."@en .

thinkr:hasIndicatorCategory a owl:ObjectProperty ;
    rdfs:comment "Which of the 21 Doughnut categories this specific Indicator belongs to."@en ;
    rdfs:domain thinkr:Indicator ;
    rdfs:range thinkr:IndicatorCategory ;
    skos:prefLabel "has doughnut category"@en .

thinkr:hasIntellectualRelationship a owl:ObjectProperty ;
    rdfs:domain thinkr:NamedEntity ;
    rdfs:range thinkr:Relationship ;
    skos:comment "Sibling of thinkr:hasPersonalRelationship, minted 2026-07-15 alongside the new thinkr:RelationshipType.Intellectual — links a Persona to Relationship individuals whose thinkr:hasRelationshipType includes RelationshipType.Intellectual (subscribes to / aligns with a school of thought's ideas, distinct from formal employment or academic credentialing). Surfaced by MJSullivan's own review: Relationship.NateHagens_PeakOilMovement (Persona->SchoolOfThought) had been mistagged Professional purely because it was institutional rather than person-to-person — the real discriminator this whole property family uses is thinkr:hasRelationshipType, not the object's class, and this was the one case where the wrong RelationshipType had been picked in the first place, not just filed under the wrong property."@en ;
    skos:prefLabel "has intellectual relationship"@en .

thinkr:hasInteraction a owl:ObjectProperty ;
    rdfs:domain thinkr:Relationship ;
    rdfs:range thinkr:PodcastAppearance ;
    skos:comment "Multi-valued — one triple per interaction instance, each a separate blank node."@en ;
    skos:prefLabel "has interaction"@en .

thinkr:hasLegalRelationship a owl:ObjectProperty ;
    rdfs:domain thinkr:NamedEntity ;
    rdfs:range thinkr:Relationship ;
    skos:comment "Sibling of thinkr:hasPersonalRelationship, minted 2026-07-15 in the same retrofit for RelationshipType completeness — links a Persona to Relationship individuals whose thinkr:hasRelationshipType includes RelationshipType.Legal. No instances yet as of this writing (no Legal-type Relationship exists in the graph), built alongside its 3 siblings anyway since the full family was the explicit request rather than a wait-for-real-need case like most other classes in this project."@en ;
    skos:prefLabel "has legal relationship"@en .

thinkr:hasObject a owl:ObjectProperty ;
    rdfs:domain thinkr:Relationship ;
    skos:comment "The other party in the Relationship — paired with hasSubject for full self-containment."@en ;
    skos:prefLabel "has object"@en .

thinkr:hasPersonEntityType a owl:ObjectProperty ;
    rdfs:comment "The property to actually USE for Persona individuals — subPropertyOf the general thinkr:hasNamedEntityType. Same explicit-typing caveat as elsewhere in this project: rdfs:subPropertyOf won't make a hasPersonEntityType triple automatically queryable via hasNamedEntityType without a reasoner (this project's tooling doesn't run one) — assert both explicitly if a query needs to work at the general level. DOMAIN CHANGED 2026-07-14 (Batch 3 of the Persona-centered refactor, docs/sidecar-cleanup-handoff.md): was thinkr:Human, moved to thinkr:Persona — being tagged Guest/Contributor is a fact about someone's public relationship to TGS, the same category of fact as hasHost/hasGuest (migrated in Batch 2), not a private biographical fact. Flagged as an open question in personas.ttl's Batch 1 comment ('revisit once Batch 3 clarifies') and resolved here."@en ;
    rdfs:domain thinkr:Persona ;
    rdfs:range thinkr:PersonEntityType ;
    rdfs:subPropertyOf thinkr:hasNamedEntityType ;
    skos:prefLabel "has person entity type"@en ;
    skos:scopeNote "Narrower than thinkr:hasNamedEntityType: the property to actually use for thinkr:Persona individuals in practice."@en .

thinkr:hasPersona a owl:ObjectProperty ;
    rdfs:domain thinkr:Human ;
    rdfs:range thinkr:Persona ;
    skos:comment "Explicit inverse of thinkr:actsThrough, asserted directly rather than via owl:inverseOf — consistent with this project's standing practice of asserting both directions explicitly since the toolchain never runs a reasoner (same precedent as dct:hasPart/dct:isPartOf on Series). Multi-valued: Human->Persona is 1..n — one Human may have more than one genuinely distinct public identity, though most individuals in this graph have exactly one."@en ;
    skos:prefLabel "has persona"@en .

thinkr:hasPersonalRelationship a owl:ObjectProperty ;
    rdfs:domain thinkr:NamedEntity ;
    rdfs:range thinkr:Relationship ;
    skos:comment "Links a Persona to Relationship individuals that are genuinely PERSONAL in nature (thinkr:hasRelationshipType includes RelationshipType.Personal on the Relationship itself). RETROFITTED 2026-07-15: until this date every Relationship a Persona was party to was asserted here regardless of its actual hasRelationshipType, discovered as a real modeling bug when Gaya Herrington's host-guest Relationship (Professional-only, no Personal language found) and her two purely institutional Relationships were caught being mis-filed under this property. Now one of a 4-member sibling family mirroring thinkr:RelationshipType exactly (hasPersonalRelationship/hasProfessionalRelationship/hasAcademicRelationship/hasLegalRelationship) — matching the editorial sketch's original hasPersonalRelationship/hasOrganizationRelationship/hasSchoolRelationship family in spirit (index by relationship nature, not by the other party's class), though the actual discriminator ended up being thinkr:hasRelationshipType rather than the object's own class. A single Relationship with multiple hasRelationshipType values (e.g. Josh Farley's, which is Academic+Personal+Professional) is correctly asserted under ALL matching sibling properties — not a data-quality problem, an honest reflection that one Relationship individual can genuinely be more than one kind of relationship. NOT YET DERIVED via script the way calculatedConfidence is (see scripts/compute_confidence.py) even though this is 100% redundant with each Relationship's own hasRelationshipType — flagged as a natural next step, not built in this retrofit pass. DOMAIN WIDENED 2026-08-13 from thinkr:Persona to thinkr:NamedEntity (same for all 4 siblings) after a full audit found 12 real Organization/SchoolOfThought/AcademicInstitution entities that were party to a real Relationship but structurally unable to carry a reverse-index pointer back to it — the exact same class of gap the 2026-07-15 retrofit fixed for Personas, just not extended to non-Persona parties at the time. All 12 backfilled in the same pass (organizations.ttl/academicinstitutions.ttl/schoolsofthought.ttl). DOMAIN CHANGED 2026-07-14 (Batch 3 of the Persona-centered refactor, docs/sidecar-cleanup-handoff.md) from thinkr:Human to thinkr:Persona: every Relationship a Human party to it now runs through their Persona instead, per the final settled principle that Human is a pure leaf node reachable only via thinkr:actsThrough."@en ;
    skos:prefLabel "has personal relationship"@en .

thinkr:hasPhase a owl:ObjectProperty ;
    rdfs:comment "Connects the overall action-framework Concept to one of its 3 ResponsePhases."@en ;
    rdfs:range thinkr:ResponsePhase ;
    skos:prefLabel "has phase"@en .

thinkr:hasPowerAndDistributionXPosition a owl:DatatypeProperty ;
    rdfs:comment "This Scenario's Power & Distribution-dimension X position — must match its chosen Facet's own thinkr:hasXPosition."@en ;
    rdfs:domain thinkr:Scenario ;
    rdfs:range xsd:integer ;
    skos:prefLabel "has Power and Distribution X position"@en .

thinkr:hasPowerAndDistributionYPosition a owl:DatatypeProperty ;
    rdfs:comment "This Scenario's Power & Distribution-dimension Y position — must match its chosen Facet's own thinkr:hasYPosition."@en ;
    rdfs:domain thinkr:Scenario ;
    rdfs:range xsd:integer ;
    skos:prefLabel "has Power and Distribution Y position"@en .

thinkr:hasProfessionalRelationship a owl:ObjectProperty ;
    rdfs:domain thinkr:NamedEntity ;
    rdfs:range thinkr:Relationship ;
    skos:comment "Sibling of thinkr:hasPersonalRelationship, minted 2026-07-15 in the same retrofit — links a Persona to Relationship individuals whose thinkr:hasRelationshipType includes RelationshipType.Professional. See hasPersonalRelationship's own comment for the full family design and the Herrington case that surfaced the need for this split."@en ;
    skos:prefLabel "has professional relationship"@en .

thinkr:hasQuadrantNode a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Links a real ScenarioFacet to its corresponding precomputed QuadrantNode (matching hasXPosition/hasYPosition), enabling Euclidean-distance lookup instead of live computation."@en ;
    rdfs:domain thinkr:ScenarioFacet ;
    rdfs:range thinkr:QuadrantNode ;
    skos:prefLabel "has quadrant node"@en .

thinkr:hasRelationshipType a owl:ObjectProperty ;
    rdfs:domain thinkr:Relationship ;
    rdfs:range thinkr:RelationshipType ;
    skos:prefLabel "has relationship type"@en .

thinkr:hasReplay a owl:ObjectProperty ;
    rdfs:domain thinkr:Work ;
    skos:scopeNote "A link to watch/listen to a replay (YouTube, Spotify, etc.) — multi-valued, one triple per platform. Domain deliberately kept at thinkr:Work, not narrowed to Episode: some future Work subtypes (e.g. an audiobook) could plausibly have a replay too. Many Work subtypes (Book, WhitePaper, PhDThesis) genuinely won't — that's a fact about the specific instance, not something enforced structurally."@en .

thinkr:hasScenarioDimension a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Which of the 4 grids (Economic, Power & Distribution, Geopolitical, Earth Systems) this Facet is one quadrant option of."@en ;
    rdfs:domain thinkr:ScenarioFacet ;
    rdfs:range thinkr:ScenarioDimension ;
    skos:prefLabel "has scenario dimension"@en .

thinkr:hasSubdomain a owl:ObjectProperty ;
    rdfs:comment "Connects an InterventionFront to one of its named Subdomains."@en ;
    rdfs:domain thinkr:InterventionFront ;
    rdfs:range thinkr:InterventionSubdomain ;
    skos:prefLabel "has subdomain"@en .

thinkr:hasSubject a owl:ObjectProperty ;
    rdfs:domain thinkr:Relationship ;
    skos:comment "Explicitly names the relationship's OWN subject, not just its target (hasObject) — makes each Relationship individual a fully self-contained statement, not requiring a reverse lookup through hasPersonalRelationship to know whose relationship this is. Mirrors LinkNote's aboutSubject/aboutObject shape without directly reusing those (domain-restricted to LinkNote specifically)."@en ;
    skos:prefLabel "has subject"@en .

thinkr:hasTGSRole a owl:ObjectProperty ;
    rdfs:range [ a owl:Class ;
            owl:oneOf ( thinkr:ProfessionalRole.Educator thinkr:ProfessionalRole.InstituteExecutive thinkr:ProfessionalRole.Blogger thinkr:ProfessionalRole.Author ) ] ;
    rdfs:subPropertyOf thinkr:hasProfessionalRole ;
    skos:scopeNote "Curated subset of thinkr:ProfessionalRole specifically useful for people in the TGS orbit. The range restriction is DOCUMENTATION ONLY, not enforced — this project currently has exactly two editors (MJSullivan and Claude), so a manually-respected convention is sufficient; would need a real validation script if that ever changes."@en .

thinkr:hasTranscript a owl:ObjectProperty ;
    rdfs:domain thinkr:Work ;
    skos:scopeNote "A link to a text transcript, distinct from thinkr:hasReplay (audio/video) and thinkr:hasCanonicalSource (the page about the content, not the content itself)."@en .

thinkr:hasXPosition a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "0 to 6 — a position along an X sub-axis, with (0,0) at the LOWER-LEFT corner (NOT centered on origin). REVISED 2026-08-22 (second revision this same day): MJSullivan's explicit correction — the earlier same-day recentering to a -3..3 continuum, made specifically to support live cosine-similarity computation from a true center, is now itself superseded: grid comparison moved from cosine to precomputed Euclidean-distance lookup via the new thinkr:QuadrantNode (49 individuals, one per integer grid position), for which a lower-left, all-positive 0-6 scheme is simpler and was the original design intent. thinkr:ScenarioFacet's own 16 real positions were migrated to this same 0-6 scheme via a simple +3 shift (old -2/2 -> new 1/5); the 24 disjointness/divergence relationships were verified programmatically unchanged by the shift before applying it, since a pure shift preserves every relative same/different relationship. rdfs:domain deliberately left absent — this property is shared between thinkr:ScenarioFacet and thinkr:QuadrantNode, and a domain restriction would incorrectly force every QuadrantNode to also be inferred as a ScenarioFacet. See quadrantnodes.ttl and backlog.md for the full design and decision history."@en ;
    rdfs:range xsd:integer ;
    skos:prefLabel "has X position"@en .

thinkr:hasYPosition a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "0 to 6 — a position along a Y sub-axis, with (0,0) at the LOWER-LEFT corner. Same 0-6, domain-shared design as thinkr:hasXPosition — see its own rdfs:comment for the full reasoning and decision history."@en ;
    rdfs:range xsd:integer ;
    skos:prefLabel "has Y position"@en .

thinkr:influencedBy a owl:ObjectProperty ;
    rdfs:comment "Direct, citable influence — either Hagens has referenced this person/school explicitly in developing a Concept, or a SchoolOfThought's own real creator/originator (e.g. Kate Raworth for Doughnut Economics)."@en ;
    rdfs:domain [ owl:unionOf ( thinkr:Concept thinkr:SchoolOfThought ) ] ;
    rdfs:range [ owl:unionOf ( thinkr:Persona thinkr:SchoolOfThought thinkr:Organization thinkr:AcademicInstitution ) ] ;
    rdfs:subPropertyOf thinkr:relatesTo ;
    skos:prefLabel "influenced by"@en ;
    skos:scopeNote "Narrower than thinkr:relatesTo: specifically direct, citable influence (Hagens referenced this source explicitly, for the Concept case) — see thinkr:echoesIdeaOf for the weaker, independent-convergence case. RANGE CHANGED 2026-07-14 (Batch 5 of the Persona-centered refactor): Human replaced with Persona in the union — same reasoning as echoesIdeaOf. All existing influencedBy triples (linknotes.ttl) migrated Human->Persona in the same pass. DOMAIN WIDENED 2026-08-13 from Concept-only to Concept-or-SchoolOfThought — surfaced twice independently (SchoolOfThought.PlanetaryBoundaries's own scopeNote flagged the gap months earlier; SchoolOfThought.DoughnutEconomics hit the identical wall the same session). Deliberately NOT widened to Persona-as-subject (Persona->influencedBy->Persona) in the same pass — that's a real, much bigger door (most guests have their own documented biographical influences, a genuine scope-creep risk for a graph whose subject is Hagens' show, not a general biographical encyclopedia) and a different evidentiary standard (sourced from the person's own biography, not from Hagens citing them on the show) — held as a separate, deliberate decision for later, not bundled in here."@en .

thinkr:memberOf a owl:ObjectProperty ;
    rdfs:domain thinkr:Human ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( thinkr:SchoolOfThought thinkr:Organization thinkr:AcademicInstitution ) ] ;
    skos:comment "Range widened 2026-07-11 when thinkr:School was split into SchoolOfThought/Organization/AcademicInstitution — see the three class declarations below for the reasoning."@en ;
    skos:prefLabel "member of / associated with"@en .

thinkr:morphsInto a owl:ObjectProperty ;
    rdfs:comment "Hagens' own direct, specific real pairing — a business-as-usual Archetype's stated decline-counterpart under continued contraction, not an inferred or computed relationship. Deliberately NOT asserted for every Archetype: Preacher explicitly does not morph into something new per Hagens' own words ('the preacher will always exist... maybe with a lowercase p'), so no target is forced here."@en ;
    rdfs:domain thinkr:Archetype ;
    rdfs:range thinkr:Archetype ;
    skos:prefLabel "morphs into"@en .

thinkr:objectRole a owl:ObjectProperty ;
    rdfs:comment "The role played by the containing Relationship's hasObject in THIS SPECIFIC appearance — explicit, not inferred. Together with subjectRole, SUPERSEDES thinkr:role (retired 2026-07-14, Batch 3 of the Persona-centered refactor) — the old singular property only ever captured one party's role and left the other permanently implicit, which broke the moment an interaction wasn't a clean host/guest binary (co-host, moderator, panelist). Proven concretely on the reciprocal Matthew Monahan case: without this split there was no clean way to distinguish 'Nate hosted him on TGS' from 'he hosted Nate on his own show' except by which property happened to be populated."@en ;
    rdfs:domain thinkr:PodcastAppearance ;
    rdfs:range thinkr:InteractionRole ;
    skos:prefLabel "object role"@en .

thinkr:reliabilityTier a owl:ObjectProperty ;
    rdfs:domain thinkr:Source ;
    rdfs:range thinkr:ReliabilityType ;
    skos:prefLabel "reliability tier"@en .

thinkr:seriesPosition a owl:DatatypeProperty ;
    rdfs:domain thinkr:Work ;
    rdfs:range xsd:integer ;
    skos:scopeNote "Ordinal position within the thinkr:Series pointed to by dct:isPartOf on the same individual — e.g. 2 for Part 2. No Dublin Core term exists for this specifically, minted directly (unlike dct:references/dct:isPartOf, which are used as-is with no subproperty needed — both already carry the right generic meaning)."@en .

thinkr:showName a owl:DatatypeProperty ;
    rdfs:domain thinkr:PodcastAppearance ;
    skos:comment "The name of a show NOT modeled as its own Episode individual in this graph — e.g. Nate's reciprocal guest appearance on Matthew Monahan's own show."@en ;
    skos:prefLabel "show name"@en .

thinkr:subjectRole a owl:ObjectProperty ;
    rdfs:comment "The role played by the containing Relationship's hasSubject in THIS SPECIFIC appearance — explicit, not inferred."@en ;
    rdfs:domain thinkr:PodcastAppearance ;
    rdfs:range thinkr:InteractionRole ;
    skos:prefLabel "subject role"@en .

thinkr:verifiedOn a owl:DatatypeProperty ;
    rdfs:domain thinkr:CrosswalkNote ;
    rdfs:range xsd:date ;
    skos:prefLabel "verified on"@en .

thinkr:xAxisDivergentFrom a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "Two ScenarioFacets within the same ScenarioDimension sharing the same Y position but differing on X. CORRECTED 2026-08-13, raised by MJSullivan: an earlier version of this property was named thinkr:xAxisDisjointWith and asserted as a sub-property of thinkr:logicallyDisjointWith — wrong, because sharing a whole axis of real agreement is the opposite of disjointness, not a weaker version of it. Concrete real case that surfaced the error: tgs:ScenarioFacet.TheGreatSimplification and tgs:ScenarioFacet.GreenGrowth share Y=4 (both 'Within Limits') and differ only on X (Contraction vs. Growth) — and tgs:SchoolOfThought.TechnoOptimism's own real thinkr:favorsFacet link points at GreenGrowth, meaning TechnoOptimism and GreatSimplification share real common ground on ecological limits despite disagreeing on growth direction. Calling that pair 'disjoint' would have erased the very agreement that makes the disagreement interesting. Reserve thinkr:logicallyDisjointWith/thinkr:diagonallyDisjointWith for genuine, no-shared-ground incompatibility only. Computed directly from each Facet's own thinkr:hasXPosition/thinkr:hasYPosition/thinkr:hasScenarioDimension, not hand-asserted independently of that data."@en ;
    rdfs:domain thinkr:ScenarioFacet ;
    rdfs:range thinkr:ScenarioFacet ;
    rdfs:subPropertyOf thinkr:relatesTo ;
    skos:prefLabel "x-axis divergent from"@en .

thinkr:xAxisHighLabel a owl:DatatypeProperty ;
    rdfs:comment "What the HIGH side of this Dimension's X sub-axis means semantically — the direction values 5-6 point in on the 0-6, lower-left-origin continuum. Currently only value 5 is populated; 6 is reserved. Same reasoning as thinkr:xAxisLowLabel — see its own comment for the full context."@en ;
    rdfs:domain thinkr:ScenarioDimension ;
    rdfs:range rdf:langString ;
    skos:prefLabel "X axis high label"@en .

thinkr:xAxisLowLabel a owl:DatatypeProperty ;
    rdfs:comment "What the LOW side of this Dimension's X sub-axis means semantically — the direction values 0-1 point in on the 0-6, lower-left-origin continuum (see thinkr:hasXPosition, migrated 2026-08-22 from the earlier -3..3 centered scheme). Currently only value 1 is populated by a real Facet; 0 is reserved for a more extreme case not yet in any real source material."@en ;
    rdfs:domain thinkr:ScenarioDimension ;
    rdfs:range rdf:langString ;
    skos:prefLabel "X axis low label"@en .

thinkr:yAxisDivergentFrom a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "Two ScenarioFacets within the same ScenarioDimension sharing the same X position but differing on Y. Same correction and same reasoning as thinkr:xAxisDivergentFrom (see its own comment for the full worked example) — deliberately NOT a sub-property of thinkr:logicallyDisjointWith, since sharing a whole axis of agreement is not disjointness. Computed directly from each Facet's own thinkr:hasXPosition/thinkr:hasYPosition/thinkr:hasScenarioDimension, not hand-asserted independently of that data."@en ;
    rdfs:domain thinkr:ScenarioFacet ;
    rdfs:range thinkr:ScenarioFacet ;
    rdfs:subPropertyOf thinkr:relatesTo ;
    skos:prefLabel "y-axis divergent from"@en .

thinkr:yAxisHighLabel a owl:DatatypeProperty ;
    rdfs:comment "What the HIGH side of this Dimension's Y sub-axis means semantically — the direction values 5-6 point in on the 0-6, lower-left-origin continuum. Currently only value 5 is populated; 6 is reserved. Same reasoning as thinkr:xAxisLowLabel — see its own comment for the full context."@en ;
    rdfs:domain thinkr:ScenarioDimension ;
    rdfs:range rdf:langString ;
    skos:prefLabel "Y axis high label"@en .

thinkr:yAxisLowLabel a owl:DatatypeProperty ;
    rdfs:comment "What the LOW side of this Dimension's Y sub-axis means semantically — the direction values 0-1 point in on the 0-6, lower-left-origin continuum. Currently only value 1 is populated; 0 is reserved. Same reasoning as thinkr:xAxisLowLabel — see its own comment for the full context."@en ;
    rdfs:domain thinkr:ScenarioDimension ;
    rdfs:range rdf:langString ;
    skos:prefLabel "Y axis low label"@en .

xsd:gYear a rdfs:Datatype .

xsd:langString a rdfs:Datatype .

tgs:AcademicInstitution.UniversityOfChicago a thinkr:AcademicInstitution,
        owl:NamedIndividual ;
    rdfs:comment "Specifically the Booth School of Business, per tgs:Human.NateHagens's own bio."@en ;
    skos:prefLabel "University of Chicago"@en .

tgs:AlternateTermType.BroadMatch a thinkr:AlternateTermType,
        owl:NamedIndividual ;
    skos:definition "The alternate term is a broader, more general concept than the parent — reusing SKOS's own skos:broadMatch semantics."@en ;
    skos:prefLabel "Broad Match"@en .

tgs:AlternateTermType.CloseMatch a thinkr:AlternateTermType,
        owl:NamedIndividual ;
    skos:definition "Close enough for most purposes, but not strictly identical — reusing SKOS's own skos:closeMatch semantics."@en ;
    skos:prefLabel "Close Match"@en .

tgs:AnimatedVideo.Part1EnergyBlind a thinkr:Episode,
        owl:NamedIndividual ;
    thinkr:discusses tgs:Concept.CarbonPulse,
        tgs:Concept.EnergyBlindness ;
    thinkr:hasCanonicalSource <https://www.youtube.com/watch?v=T19tHn_LA80> ;
    thinkr:hasEpisodeType thinkr:EpisodeType.AnimatedVideo ;
    thinkr:hasTranscript <https://www.youtube.com/watch?v=T19tHn_LA80> ;
    thinkr:seriesPosition 1 ;
    dct:contributor "Caleb Bond (Illustrator)"@en ;
    dct:isPartOf tgs:Series.GreatSimplificationAnimatedSeries ;
    skos:definition "Real, direct narrative of deep-time human history — from Earth's formation through the Neolithic agricultural revolution to the 19th-century discovery of fossil-energy extraction — arguing the last 200 years of growth rest on a one-time geological windfall of stored solar energy, and that modern culture and institutions systematically fail to appreciate this ('energy blind'). Closes on the real, direct claim that early access to fossil energy would have appeared 'indistinguishable from magic' to prior generations, and that instead of recognizing the windfall, modern culture built stories crediting the resulting wealth to human ingenuity alone."@en ;
    skos:prefLabel "Energy Blind (Part 1 of 4)"@en .

tgs:AnimatedVideo.Part3TheHumanBeing a thinkr:Episode,
        owl:NamedIndividual ;
    thinkr:discusses tgs:Concept.Superorganism ;
    thinkr:hasCanonicalSource <https://www.youtube.com/watch?v=OEbSysJt30I> ;
    thinkr:hasEpisodeType thinkr:EpisodeType.AnimatedVideo ;
    thinkr:hasTranscript <https://www.youtube.com/watch?v=OEbSysJt30I> ;
    thinkr:seriesPosition 3 ;
    dct:contributor "Eric Borchardt (Voice Coach)"@en,
        "Joseph Navarra (Illustrator)"@en,
        "Mike Kriefski (Voice Coach)"@en ;
    dct:isPartOf tgs:Series.GreatSimplificationAnimatedSeries ;
    skos:definition "Real, direct examination of evolved human psychology as the actual driver of the Superorganism described in Part 2 — dopamine/reward-prediction dynamics, status-signaling and in-group/out-group tribalism, hyperbolic discounting of the future, and the real claim that 'modern society is only a single brief example out of thousands of successful arrangements in human history,' closing on a real, direct reframe that a global superorganism 'is not our destiny.'"@en ;
    skos:prefLabel "The Human Being (Part 3 of 4)"@en ;
    skos:scopeNote "MJSullivan's own uploaded file for this part carried Part 2's real URL by mistake (a real, direct copy-paste error, confirmed and corrected by MJSullivan directly); the real URL used here was independently verified via web search before being confirmed by MJSullivan."@en .

tgs:AnimatedVideo.Part4TheGreatSimplification a thinkr:Episode,
        owl:NamedIndividual ;
    thinkr:discusses tgs:Concept.CarbonPulse,
        tgs:Concept.GreatSimplification,
        tgs:Concept.Superorganism,
        tgs:SchoolOfThought.TechnoOptimism ;
    thinkr:hasCanonicalSource <https://www.youtube.com/watch?v=n9wDHAJswOg> ;
    thinkr:hasEpisodeType thinkr:EpisodeType.AnimatedVideo ;
    thinkr:hasTranscript <https://www.youtube.com/watch?v=n9wDHAJswOg> ;
    thinkr:seriesPosition 4 ;
    dct:contributor "Eric Borchardt (Voice Coach)"@en,
        "Joseph Navarra (Illustrator)"@en,
        "Mike Kriefski (Voice Coach)"@en ;
    dct:isPartOf tgs:Series.GreatSimplificationAnimatedSeries ;
    dct:references <https://www.artberman.com/blog/addicted-to-electricity-a-preview-of-the-great-simplification/> ;
    skos:definition "Real, direct synthesis of Parts 1-3 into a single argument, structured as 6 real named chapters: The Road Ahead, Flawed Societal Lenses (economist/financial/technology lenses, all real, direct critiques — the technology lens described matches this graph's own real SchoolOfThought.TechnoOptimism closely), The Systems Lens, The Necessity of Energy, The Great Simplification itself, and Navigating the Future. Closes by naming 'the great simplification' directly as the coming era's own real name, arguing available pathways range from genuinely preferable to nearly unthinkable, and that navigating them well will require 'imagination, foresight, empathy, and above all, wisdom.'"@en ;
    skos:prefLabel "The Great Simplification (Part 4 of 4)"@en ;
    skos:scopeNote "Real backlink in this video's own official show notes to Art Berman's own real blog post, 'Addicted to Electricity: A Preview of The Great Simplification' — Art Berman is already a real, built Persona in this graph (RR-1, RR-16), but the blog post itself is a distinct real artifact from either of those; linked here as a direct URL rather than minted as its own Work individual, kept proportionate to its role as a single citation rather than a central source."@en .

tgs:Archetype.Addict a thinkr:Archetype,
        owl:NamedIndividual ;
    skos:definition "Continued access to goods, services, and stability, but with the short-term dopamine hits that defined consumer life no longer available — a real, expected mental withdrawal for the average person."@en ;
    skos:prefLabel "The Addict"@en .

tgs:Archetype.Craftsman a thinkr:Archetype,
        owl:NamedIndividual ;
    thinkr:activeInPhase tgs:ResponsePhase.StableAttractor ;
    skos:definition "Someone able to build things by hand with a variety of materials, without relying on today's global supply chains and big-box retail access."@en ;
    skos:prefLabel "The Craftsman"@en .

tgs:Archetype.Cyborg a thinkr:Archetype,
        owl:NamedIndividual ;
    skos:definition "A transhumanist merging of technology and humanity via AI and big data — Hagens' own real, pointed framing: 'in an effort to save humanity from ecological and material limits, we may lose our actual humanity.'"@en ;
    skos:prefLabel "The Cyborg"@en .

tgs:Archetype.Enforcer a thinkr:Archetype,
        owl:NamedIndividual ;
    skos:definition "Military personnel redirected toward keeping domestic peace among civilians rather than fighting other countries — Hagens directly raises the real possibility of escalating George Floyd-style domestic conflict as the live test case."@en ;
    skos:prefLabel "The Enforcer"@en .

tgs:Archetype.Farmer a thinkr:Archetype,
        owl:NamedIndividual ;
    skos:definition "Real, needed work on the land generating real material surplus — Hagens' own pointed contrast to, in his own words, 'some esoteric PhD that's not really contributing to what the future will need.'"@en ;
    skos:prefLabel "The Farmer"@en .

tgs:Archetype.Grifter a thinkr:Archetype,
        owl:NamedIndividual ;
    skos:definition "Someone who no longer has the ease of a stable sales role and turns to whatever method is available to make ends meet."@en ;
    skos:prefLabel "The Grifter"@en .

tgs:Archetype.Hoarder a thinkr:Archetype,
        owl:NamedIndividual ;
    skos:definition "Where loss-aversion keeps a person from being pro-social and part of their community, clinging instead to accumulated excess claims on reality."@en ;
    skos:prefLabel "The Hoarder"@en .

tgs:Archetype.IndenturedOrSlave a thinkr:Archetype,
        owl:NamedIndividual ;
    skos:definition "As AI displaces labor, energy surplus declines, and wealth inequality increases — Hagens directly cites Patrick Knodel's own real claim (a prior TGS guest) that, by some real definitions, more people are enslaved today than at any prior point in human history."@en ;
    skos:prefLabel "The Indentured / Slave"@en .

tgs:Archetype.WildCard a thinkr:Archetype,
        owl:NamedIndividual ;
    skos:definition "A real, explicit bifurcation, not a single fixed outcome — Hagens states the Elite could go either of two real directions: toward the Hoarder's path (building bunkers, living off historically-stored surplus), or toward playing a real, substantial role in a collective response to the Great Simplification."@en ;
    skos:prefLabel "The Wild Card"@en .

tgs:Concept.Amonging a thinkr:Concept,
        owl:NamedIndividual ;
    thinkr:influencedBy tgs:Persona.NoraBateson ;
    dct:source <https://www.combining.life/> ;
    dct:subject tgs:Subject.SystemsScience ;
    skos:definition "Nora Bateson's own neologism for the edge of the self as genuinely porous and relational rather than fixed — being fundamentally constituted 'among' one's relationships and context, not separately from them. Directly connects to both her book Combining and her newer book Belly (whose own publisher description uses the phrase 'the among-ing of all life') — not confidently attributable to one specific book over the other from the sources checked."@en ;
    skos:prefLabel "Amonging"@en .

tgs:Concept.CircleOfTrustLocalism a thinkr:Concept,
        owl:NamedIndividual ;
    thinkr:echoesIdeaOf tgs:Persona.ElinorOstrom ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
            thinkr:hasAlternateTermType tgs:AlternateTermType.ExactMatch ;
            skos:prefLabel "Circle of Trust"@en ;
            skos:scopeNote "THIRD pilot case for the alternate-term mechanism, 2026-08-13 — split out of this Concept's own former compound prefLabel (\"Local Resilience / 'Circle of Trust'\"). Kept as an anonymous blank node (Tier 2)." ] ;
    dct:source <https://www.thegreatsimplification.com> ;
    dct:subject tgs:Subject.CommunityAndResponse ;
    skos:definition "Hagens' emphasis on rebuilding smaller-scale, face-to-face community and local resource resilience as an adaptive response to declining energy surplus and institutional fragility."@en ;
    skos:prefLabel "Local Resilience"@en .

tgs:Concept.Communing a thinkr:Concept,
        owl:NamedIndividual ;
    thinkr:influencedBy tgs:Persona.NoraBateson ;
    dct:source <https://www.thegreatsimplification.com> ;
    dct:subject tgs:Subject.HumanBehavior ;
    skos:definition "Nora Bateson's framing of 'communing' as the necessary precursor to 'community' — the practice of genuine mutual relating (giving before being owed, radical hospitality, tending to the whole as a way of tending to the self) that most attempts at community-building skip past by going straight to shared values, organizing, and logistics."@en ;
    skos:prefLabel "Communing"@en .

tgs:Concept.ComplexSystemsThinking a thinkr:Concept,
        owl:NamedIndividual ;
    dct:source <https://www.thegreatsimplification.com> ;
    dct:subject tgs:Subject.SystemsScience ;
    skos:definition "The general toolkit of concepts Hagens draws on for reasoning about civilizational dynamics: systems move in fits and starts rather than smoothly; ecological phase shifts exhibit path dependency (once crossed, a threshold is not easily uncrossed); non-linear causality and feedback loops mean small inputs can produce disproportionate effects; and real tipping points (ice sheets, soil systems, per the Global Tipping Points Report 2025) can be crossed well before they become visible in conventional metrics."@en ;
    skos:prefLabel "Complex Systems Thinking"@en ;
    skos:scopeNote "A deliberately GENERAL cluster stub, not split into 4+ separate Concepts for each named sub-idea (fits-and-starts, phase shifts, feedback loops, tipping points) — matches this session's 'don't over-model before a shape reveals itself' approach. Clearly related to the existing tgs:Concept.ComplexityCollapse and tgs:Concept.Metacrisis, but that relation is deliberately NOT formally linked yet (no thinkr:relatesTo asserted) — flagged in prose rather than prematurely formalized, pending more real content to judge the actual relationship by."@en .

tgs:Concept.ComplexityCollapse a thinkr:Concept,
        owl:NamedIndividual ;
    thinkr:influencedBy tgs:Persona.JosephTainter ;
    dct:source <https://www.thegreatsimplification.com> ;
    dct:subject tgs:Subject.OvershootAndLimits ;
    skos:definition "The idea that societies invest in increasing complexity (institutions, specialization, infrastructure) to solve problems, but complexity carries rising energy/resource costs with diminishing returns — eventually making collapse (a rapid loss of complexity) a rational, if painful, adaptive response rather than an aberration."@en ;
    skos:prefLabel "Complexity and Collapse"@en .

tgs:Concept.DiscountRatesAndPresentBias a thinkr:Concept,
        owl:NamedIndividual ;
    thinkr:echoesIdeaOf tgs:Persona.MarcusAurelius ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
            thinkr:hasAlternateTermType tgs:AlternateTermType.Related ;
            skos:prefLabel "Present Bias"@en ;
            skos:scopeNote "FOURTH pilot case, 2026-08-13 — split out of this Concept's own former compound prefLabel (\"Discount Rates / Present Bias\"). Deliberately typed Related, NOT ExactMatch: 'discount rate' is the formal economic parameter, 'present bias' is the specific psychological tendency that produces excessive discounting — related, not strictly synonymous. Kept as an anonymous blank node (Tier 2)." ] ;
    dct:source <https://www.thegreatsimplification.com> ;
    dct:subject tgs:Subject.BehavioralEconomicsAndCognition ;
    skos:definition "The behavioral and financial tendency to heavily undervalue future costs and benefits relative to present ones, which Hagens treats as a key mechanism by which markets and individuals systematically under-price long-term ecological risk."@en ;
    skos:prefLabel "Discount Rates"@en .

tgs:Concept.DunbarsNumber a thinkr:Concept,
        owl:NamedIndividual ;
    thinkr:influencedBy tgs:Persona.RobinDunbar ;
    dct:source <https://en.wikipedia.org/wiki/Dunbar%27s_number> ;
    dct:subject tgs:Subject.HumanBehavior ;
    skos:definition "Robin Dunbar's proposed cognitive limit (roughly 150) on the number of people with whom one can maintain genuinely stable social relationships, derived from a correlation between primate brain/neocortex size and social group size — used in this graph's source material as evidence for prioritizing depth over breadth in relationships."@en ;
    skos:prefLabel "Dunbar's Number"@en .

tgs:Concept.EcologicalFootprint a thinkr:Concept,
        owl:NamedIndividual ;
    thinkr:influencedBy tgs:Persona.MathisWackernagel,
        tgs:Persona.WilliamRees ;
    dct:source <https://en.wikipedia.org/wiki/Ecological_footprint> ;
    dct:subject tgs:Subject.SystemsScience ;
    skos:definition "A quantitative sustainability metric, originated and co-developed by William Rees and his then-PhD-student Mathis Wackernagel (introduced in their 1996 book 'Our Ecological Footprint'), expressing human demand on ecosystems as the amount of biologically productive land and water area required to produce what a population consumes and absorb its waste — the primary tool used to estimate the extent of humanity's ecological overshoot."@en ;
    skos:prefLabel "Ecological Footprint"@en .

tgs:Concept.FrameworkForAction a thinkr:Concept,
        thinkr:HagensConcept,
        owl:NamedIndividual ;
    thinkr:hasFront tgs:InterventionFront.CivicResilienceAndGovernance,
        tgs:InterventionFront.CultureAndMeaning,
        tgs:InterventionFront.EcologicalInterventions,
        tgs:InterventionFront.EconomicTransition,
        tgs:InterventionFront.Infrastructure,
        tgs:InterventionFront.PovertyAndDisplacement ;
    thinkr:hasPhase tgs:ResponsePhase.BendNotBreak,
        tgs:ResponsePhase.StabilityWindow,
        tgs:ResponsePhase.StableAttractor ;
    dct:source <https://www.thegreatsimplification.com/frankly-original/132-what-to-do-as-the-world-falls-apart> ;
    skos:definition "Hagens' own real, explicitly-labeled 'first public draft' framework for what to actually do in response to the more-than-human predicament — introduced in Frankly_132, gestated over roughly a decade and organized under the pressure of real, live world events (the 2026 Iran war/Strait of Hormuz crisis). Structured as 4 levels: a personal foundation of inner work, 'Finding the Others' (trusted networks and shared vocabulary), 6 interdependent thinkr:InterventionFront individuals, and a thinkr:ResponsePhase timeline axis of 3 genuinely overlapping (not strictly sequential) phases that cuts across all 6 Fronts."@en ;
    skos:prefLabel "Framework for Action"@en ;
    skos:scopeNote "Real, direct evidence for the sequencing/parallel-construction stance, worth preserving: Hagens explicitly engages with the anti-capitalist/decolonial critique that structural transformation must precede any other intervention, states real sympathy for it, but argues explicitly for building new structures while the old ones still stand rather than waiting for a precondition that would mean 'waiting forever.'"@en .

tgs:Concept.HumanPredicament a thinkr:Concept,
        thinkr:HagensConcept,
        owl:NamedIndividual ;
    dct:source <https://www.thegreatsimplification.com> ;
    dct:subject tgs:Subject.SystemsFrameworks ;
    skos:definition "Hagens' preferred framing over 'the climate problem' or 'the energy problem' — the interlocking set of ecological overshoot, energy decline, economic dependence on growth, and human behavioral wiring, treated as a single systemic predicament rather than a checklist of separate problems with separate solutions."@en ;
    skos:prefLabel "The Human Predicament"@en .

tgs:Concept.JevonsParadox a thinkr:Concept,
        owl:NamedIndividual ;
    thinkr:influencedBy tgs:Persona.WilliamStanleyJevons ;
    dct:source <https://en.wikipedia.org/wiki/Jevons_paradox>,
        <https://www.researchgate.net/publication/344271331_The_problem_of_energy_efficiency_known_as_the_Jevons_paradox>,
        <https://www.sciencedirect.com/science/article/abs/pii/S0921800905001084> ;
    dct:subject tgs:Subject.EROIAndEnergyQuality ;
    skos:definition "The observation that increases in efficiency of resource use often lead to increased total consumption of that resource rather than decreased, because efficiency lowers effective cost and expands use — a recurring theme in Hagens' skepticism toward efficiency-alone as a solution to overshoot."@en ;
    skos:prefLabel "Jevons Paradox"@en .

tgs:Concept.KleibersLaw a thinkr:Concept,
        owl:NamedIndividual ;
    thinkr:influencedBy tgs:Persona.MaxKleiber ;
    dct:source <https://en.wikipedia.org/wiki/Kleiber%27s_law> ;
    dct:subject tgs:Subject.SystemsScience ;
    skos:definition "Max Kleiber's 1932 empirical finding that an organism's basal metabolic rate scales to roughly the 3/4 power of its body mass, not the 2/3 power a simple surface-area argument would predict — one of the few genuine quantitative laws in biology, still without a fully settled theoretical explanation, and used in this graph's own source material as a real biological analogy for economic/systemic energy-scaling arguments."@en ;
    skos:prefLabel "Kleiber's Law"@en .

tgs:Concept.LandscapeOfPossibleFutures a thinkr:Concept,
        thinkr:HagensConcept,
        owl:NamedIndividual ;
    thinkr:influencedBy tgs:Persona.ConradWaddington ;
    dct:source <https://www.thegreatsimplification.com> ;
    dct:subject tgs:Subject.SystemsScience ;
    skos:definition "Hagens' own application of the landscape metaphor (valleys, ridges, switchbacks, erosion) to civilizational futures — see tgs:Monologue.Frankly_145_Part3UphillFutures for the full framework. Adapts Conrad Waddington's epigenetic landscape (originally a model of cellular differentiation) to a different domain entirely — a genuine reframing, not a direct reuse, hence HagensConcept despite the explicit external inspiration."@en ;
    skos:prefLabel "The Landscape of Possible Futures"@en .

tgs:Concept.MaximumPowerPrinciple a thinkr:Concept,
        owl:NamedIndividual ;
    thinkr:influencedBy tgs:Persona.HowardOdum ;
    dct:source <https://www.thegreatsimplification.com> ;
    dct:subject tgs:Subject.SystemsScience ;
    skos:definition "Howard T. Odum's principle (building on Alfred Lotka's earlier work) that self-organizing systems tend to develop and prevail when they maximize their intake and useful transformation of energy, not merely their efficiency — a foundational idea in ecological energetics directly connected to EROI (Charles Hall, a notable Odum student, is a central figure in that literature too)."@en ;
    skos:prefLabel "Maximum Power Principle"@en .

tgs:Concept.NarrativeAsActiveInference a thinkr:Concept,
        owl:NamedIndividual ;
    dct:source <https://www.thegreatsimplification.com> ;
    dct:subject tgs:Subject.HumanBehavior ;
    skos:definition "The idea (drawing on active inference/predictive-processing frameworks from cognitive science) that the stories people tell themselves about the world function partly as a cognitive-effort-reduction mechanism — a pre-built interpretive frame that reduces the real-time processing cost of making sense of new information, at the cost of resisting genuinely novel or disconfirming input."@en ;
    skos:prefLabel "Narrative as Active Inference"@en ;
    skos:scopeNote "Frankly_138's show notes list this as two adjacent timestamped bullets ('Narrative as active inference' / 'Narrative as reducing cognitive effort') — read here as two facets of one idea, not two separate concepts, since they describe the same mechanism from two angles rather than two distinct claims."@en .

tgs:Concept.PerpetualMulligans a thinkr:Concept,
        thinkr:HagensConcept,
        owl:NamedIndividual ;
    dct:source <https://www.thegreatsimplification.com> ;
    dct:subject tgs:Subject.EnergySystems ;
    skos:definition "Hagens' own framing for how cheap, abundant fossil energy has functioned historically as an economic 'do-over' — letting mistakes, inefficiencies, and bad decisions get absorbed and corrected via sheer energy surplus rather than genuine adaptation, a buffer that thins as energy surplus declines."@en ;
    skos:prefLabel "Perpetual Mulligans"@en .

tgs:Concept.RadicalHospitality a thinkr:Concept,
        owl:NamedIndividual ;
    dct:source <https://www.thegreatsimplification.com> ;
    dct:subject tgs:Subject.HumanBehavior ;
    skos:definition "A practice of genuine, unscripted welcome — extended both to others and to oneself — treated in this graph's source material as a necessary ingredient for real community, distinct from the transactional, role-bound interactions that ordinarily substitute for it. No single originator credited in the source material (etymological, not attributional, citations given for both words) — modeled as umbrella Concept, not thinkr:HagensConcept."@en ;
    skos:prefLabel "Radical Hospitality"@en .

tgs:Concept.Rebuildables a thinkr:Concept,
        thinkr:HagensConcept,
        owl:NamedIndividual ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
            thinkr:hasAlternateTermType tgs:AlternateTermType.CloseMatch ;
            skos:prefLabel "Renewables"@en ;
            skos:scopeNote "The mainstream/conventional term for the SAME physical technologies Hagens is discussing — CloseMatch rather than ExactMatch specifically because his own point is that the terms carry meaningfully different implications (self-sustaining vs. fossil-fuel-dependent), not that they're neutral synonyms for identical claims. Kept as an anonymous blank node (Tier 2) — not yet reused elsewhere, no independent citable history captured." ] ;
    dct:source <https://www.thegreatsimplification.com> ;
    dct:subject tgs:Subject.EnergySystems ;
    skos:definition "Hagens' own reframing of 'renewable energy' infrastructure (solar panels, wind turbines, batteries): since manufacturing, installing, and eventually replacing this infrastructure depends on fossil-fuel-powered mining, transport, and industrial processes at every stage, he argues 'rebuildable' is a more honest description than 'renewable,' which implies a self-sustaining energy source independent of the fossil fuel base it currently depends on."@en ;
    skos:prefLabel "Rebuildables"@en .

tgs:Concept.TerrorManagementTheory a thinkr:Concept,
        owl:NamedIndividual ;
    dct:source <https://www.thegreatsimplification.com> ;
    dct:subject tgs:Subject.HumanBehavior ;
    skos:definition "The theory (developed by Sheldon Solomon, Tom Pyszczynski, and Jeff Greenberg starting the early 1980s, building on Ernest Becker's work) that human awareness of mortality generates a background existential anxiety managed largely unconsciously through cultural worldviews, self-esteem, and close relationships — and that reminders of death ('mortality salience') measurably intensify attachment to one's own cultural in-group and hostility toward out-groups."@en ;
    skos:prefLabel "Terror Management Theory"@en ;
    skos:scopeNote "THIRD independent confirmation as of 2026-08-13 that this deserves real modeling: (1) surfaced during an earlier session's investigation of the TGS_199 Sheldon Solomon transcript, which found the co-founder name 'Budzinski' in that transcript is almost certainly a mishearing of Tom Pyszczynski — NOT yet independently verified, flagged here again since this stub is the natural place to resolve it; (2) Frankly_138's own show notes reference it directly with a link to 'more info' and a cross-reference to the TGS episode on it; (3) general public awareness that this is real, citable psychological theory, not a Hagens coinage. thinkr:influencedBy tgs:Persona.EmileDurkheim considered but NOT asserted — Solomon cites Durkheim's 'religion existed before gods' framing approvingly in the TGS_199 transcript, but that is Solomon's OWN citation of Durkheim within a discussion of religion's function, not a claim that Durkheim shaped Terror Management Theory's origin (which the same transcript traces to Becker, not yet modeled as a Persona in this graph)."@en .

tgs:Concept.TheSenecaEffect a thinkr:Concept,
        owl:NamedIndividual ;
    thinkr:influencedBy tgs:Persona.UgoBardi ;
    dct:source <https://www.clubofrome.org/publication/the-seneca-effect-2017/> ;
    dct:subject tgs:Subject.SystemsScience ;
    skos:definition "The observation that complex systems tend to grow slowly but collapse rapidly — named after the Roman philosopher Seneca's own observation that fortune grows slowly but ruin is swift. Developed by Ugo Bardi as a general model for why decline, once it starts, tends to be much faster than the growth that preceded it."@en ;
    skos:prefLabel "The Seneca Effect"@en .

tgs:Concept.UnicornStrategies a thinkr:Concept,
        thinkr:HagensConcept,
        owl:NamedIndividual ;
    dct:source <https://www.thegreatsimplification.com> ;
    dct:subject tgs:Subject.SystemsScience ;
    skos:definition "Hagens' own term for actions that are good moves regardless of which of the 4 composite future Scenarios (see tgs:Scenario) actually comes to pass — genuinely robust across radically different futures rather than a bet on one specific outcome. Named examples from the source episode: ocean conservation, nuclear disarmament, indigenous language preservation."@en ;
    skos:prefLabel "Unicorn Strategies"@en ;
    skos:scopeNote "Deliberately NOT formally linked to thinkr:Scenario via any property — the relationship (robust across all 4 named Scenarios) is real but this session's own 'don't over-link prematurely' discipline applies; noted here in prose instead."@en .

tgs:EarthSystemComponent.AMOC a thinkr:Concept,
        thinkr:EarthSystemComponent,
        owl:NamedIndividual ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
            thinkr:hasAlternateTermType tgs:AlternateTermType.Abbreviation,
                tgs:AlternateTermType.ExactMatch ;
            skos:prefLabel "AMOC"@en ;
            skos:scopeNote "Following the same standing convention as tgs:Concept.EnergyReturnOnInvestment: full expanded form is canonical (prefLabel + IRI), the abbreviation goes into the AlternateTerm." ] ;
    dct:subject tgs:Subject.EcologyAndEnvironment ;
    skos:definition "The major ocean current system that transports warm water northward and cold water southward through the Atlantic, regulating temperature between the Northern and Southern Hemispheres — estimated to have slowed by roughly 15% over recent decades, with real scientific concern (per the tgs:Work.GlobalTippingPointsReport2025 and multiple TGS episodes) about a potential collapse and its cascading effects on regional/global climate systems."@en ;
    skos:prefLabel "Atlantic Meridional Overturning Circulation"@en ;
    skos:scopeNote "Confirmed via real search 2026-08-13 (thegreatsimplification.com/episode/124-levke-caesar, and TGS_207's own cross-reference to both TGS_124 and TGS_105) — real thinkr:discusses link now built 2026-08-13, but via a third, different episode than either of those two: tgs:PanelDiscussion.RR_4_TitanicOceans, where physical oceanographer Antonio Turiel gives a real, detailed technical explanation of AMOC mechanics (salinity-driven sinking, wind-stress mixing) directly in the transcript — not the TGS_124/TGS_105 pairing originally anticipated here. TGS_124 and TGS_105 themselves remain real, still-deferred candidates for the same treatment once bootstrapped as Episode individuals; this note's original point stands for them, just no longer describes AMOC's only path to a real discusses link."@en .

tgs:Evidence.CircleOfTrustLocalism_ElinorOstrom a thinkr:Evidence,
        owl:NamedIndividual ;
    thinkr:confidence thinkr:ConfidenceType.Curated ;
    thinkr:evidencePolarity thinkr:PolarityType.Supports ;
    dct:description "Ostrom's Nobel-winning research on communities self-governing shared resources without top-down control or privatization provides the empirical/theoretical backbone for why small-scale local resilience can actually work, rather than just being a romantic ideal."@en .

tgs:Evidence.ComplexityCollapse_JosephTainter a thinkr:Evidence,
        owl:NamedIndividual ;
    thinkr:confidence thinkr:ConfidenceType.Curated ;
    thinkr:evidencePolarity thinkr:PolarityType.Supports ;
    dct:description "Tainter's 'The Collapse of Complex Societies' (1988) is the direct academic source for the diminishing-marginal-returns-on-complexity argument Hagens draws on when discussing societal collapse dynamics."@en ;
    prov:generatedAtTime "1988"^^xsd:gYear .

tgs:Evidence.DiscountRatesAndPresentBias_MarcusAurelius a thinkr:Evidence,
        owl:NamedIndividual ;
    thinkr:confidence thinkr:ConfidenceType.Curated ;
    thinkr:evidencePolarity thinkr:PolarityType.Supports ;
    dct:description "Stoic practice of distinguishing what is/isn't in one's control, and valuing present right action over deferred/imagined future reward, is a philosophical antecedent (not a cited influence) to the behavioral-economics critique of present bias Hagens draws on."@en .

tgs:Evidence.EnergyBlindness_ArtBerman a thinkr:Evidence,
        owl:NamedIndividual ;
    thinkr:confidence thinkr:ConfidenceType.Candidate ;
    thinkr:evidencePolarity thinkr:PolarityType.Supports ;
    dct:description "Multiple independent bio sources (artberman.com's own 'About' page among them) credit Berman with coining 'energy blindness' as a term for collective unawareness of energy's role in the economy — direct terminological match to this Concept's own name and definition. Flagged Candidate, not Curated: found via general web search 2026-07-14, not yet cross-checked against a specific TGS episode or dated publication establishing first use, and not yet human-reviewed."@en .

tgs:Evidence.EnergyBlindness_ArtBerman_TGS_220 a thinkr:Evidence,
        owl:NamedIndividual ;
    thinkr:confidence thinkr:ConfidenceType.Candidate ;
    thinkr:evidencePolarity thinkr:PolarityType.Supports ;
    dct:description "Direct primary-source citation, surfaced 2026-07-15 by the bio-intro extraction pilot: in TGS_220 (aired 2026-05-06), Berman himself says of the Iran/Strait-of-Hormuz war, 'mostly it's a blunder based on energy blindness and a failure to grasp system implications' — Berman using the exact term on Nate's own show, in his own words, not a secondhand bio credit. Still flagged Candidate rather than Curated per this project's standing rule (design decision #1, CLAUDE.md) — a strong lead, but not yet human-reviewed."@en ;
    dct:source <https://www.thegreatsimplification.com/episode/220-art-berman> ;
    prov:generatedAtTime "2026"^^xsd:gYear .

tgs:Evidence.EnergyBlindness_Buddha a thinkr:Evidence,
        owl:NamedIndividual ;
    thinkr:confidence thinkr:ConfidenceType.Candidate ;
    thinkr:evidencePolarity thinkr:PolarityType.Supports ;
    dct:description "LLM-suggested: both concern a kind of collective unawareness of the true conditions shaping suffering/behavior (avidya / ignorance vs. energy blindness). Flagged as speculative — needs review before treating as a real link; risk of forcing a surface parallel."@en .

tgs:Evidence.JevonsParadox_WilliamStanleyJevons a thinkr:Evidence,
        owl:NamedIndividual ;
    thinkr:confidence thinkr:ConfidenceType.Curated ;
    thinkr:evidencePolarity thinkr:PolarityType.Supports ;
    dct:description "Jevons first described this dynamic in 'The Coal Question' (1865), observing that more efficient coal-burning steam engines increased total coal consumption rather than reducing it — the term is named directly for him."@en ;
    prov:generatedAtTime "1865"^^xsd:gYear .

tgs:Evidence.LimitsToGrowth_DennisMeadows a thinkr:Evidence,
        owl:NamedIndividual ;
    thinkr:confidence thinkr:ConfidenceType.Curated ;
    thinkr:evidencePolarity thinkr:PolarityType.Supports ;
    dct:description "Dennis Meadows co-led the original 1972 'Limits to Growth' study alongside Donella Meadows — same direct lineage."@en ;
    prov:generatedAtTime "1972"^^xsd:gYear .

tgs:Evidence.LimitsToGrowth_DonellaMeadows a thinkr:Evidence,
        owl:NamedIndividual ;
    thinkr:confidence thinkr:ConfidenceType.Curated ;
    thinkr:evidencePolarity thinkr:PolarityType.Supports ;
    dct:description "Donella Meadows was lead author of the original 1972 'Limits to Growth' study — direct, citable lineage, not just thematic overlap."@en ;
    prov:generatedAtTime "1972"^^xsd:gYear .

tgs:Evidence.LimitsToGrowth_GayaHerrington a thinkr:Evidence,
        owl:NamedIndividual ;
    thinkr:confidence thinkr:ConfidenceType.Candidate ;
    thinkr:evidencePolarity thinkr:PolarityType.Supports ;
    dct:description "Herrington's own peer-reviewed paper, 'Update to limits to growth: Comparing the World3 model with empirical data' (Journal of Industrial Ecology, 2021, DOI 10.1111/jiec.13084 — see tgs:Work.UpdateToLimitsToGrowth2021), directly re-tests the original 1972 Limits to Growth study's World3 model against real-world 2020-era data, finding current trends track most closely with the study's own 'Business as Usual 2' and 'Comprehensive Technology' scenarios. A direct empirical continuation of the named study itself, not an inferred thematic parallel. Verified via WebSearch 2026-07-15. Flagged Candidate, not Curated: real and strong, but not yet human-reviewed per design decision #1."@en ;
    dct:source <https://doi.org/10.1111/jiec.13084> ;
    prov:generatedAtTime "2021"^^xsd:gYear .

tgs:Evidence.MartinLutherKingJr_GrowthImperative a thinkr:Evidence,
        owl:NamedIndividual ;
    thinkr:confidence thinkr:ConfidenceType.Curated ;
    thinkr:evidencePolarity thinkr:PolarityType.Supports ;
    dct:description "MLK's later writing (e.g. his critique of a society organized around 'thing-oriented' rather than 'person-oriented' values, and his turn toward economic justice/the Poor People's Campaign) is a real-world example of confronting a growth/extraction-oriented system, not primarily an ecological argument but a structurally adjacent one worth surfacing as contrast."@en .

tgs:Evidence.Metacrisis_GregoryBateson a thinkr:Evidence,
        owl:NamedIndividual ;
    thinkr:confidence thinkr:ConfidenceType.Curated ;
    thinkr:evidencePolarity thinkr:PolarityType.Supports ;
    dct:description "Bateson's systems-theoretic argument that fragmented, siloed problem-solving itself generates crises ('the pathologies of epistemology') is a direct intellectual ancestor of metacrisis framing used by Hagens and adjacent thinkers."@en .

tgs:Evidence.MoneyAsClaimOnEnergy_Aristotle a thinkr:Evidence,
        owl:NamedIndividual ;
    thinkr:confidence thinkr:ConfidenceType.Curated ;
    thinkr:evidencePolarity thinkr:PolarityType.Supports ;
    dct:description "Aristotle's distinction in Politics Book I between oikonomia (household management, wealth for use) and chrematistics (accumulation of money as an end in itself, which he considered unnatural and potentially limitless) anticipates Hagens' critique of money divorced from its real biophysical backing."@en .

tgs:Evidence.Overshoot_DoughnutEconomics a thinkr:Evidence,
        owl:NamedIndividual ;
    thinkr:aboutSource tgs:Source.CalDECCaliforniaDoughnutReport ;
    thinkr:confidence thinkr:ConfidenceType.Curated ;
    thinkr:evidencePolarity thinkr:PolarityType.Supports ;
    dct:description "CalDEC's 2025 California Doughnut Report finds California overshooting 89% of ecological indicators assessed (average overshoot 286%), using 'overshoot' as an explicit technical term for exceeding planetary-boundary-derived limits — directly paralleling Hagens' Overshoot concept despite independent development within a different framework (Doughnut Economics traces to Rockstrom et al.'s planetary boundaries work, not Hagens' energy-systems background)."@en ;
    prov:generatedAtTime "2025"^^xsd:gYear .

tgs:Evidence.Overshoot_WilliamCatton a thinkr:Evidence,
        owl:NamedIndividual ;
    thinkr:confidence thinkr:ConfidenceType.Curated ;
    thinkr:evidencePolarity thinkr:PolarityType.Supports ;
    dct:description "Catton's 1980 book 'Overshoot' coined the term Hagens uses directly; this is a citable lineage, not just a thematic echo."@en ;
    prov:generatedAtTime "1980"^^xsd:gYear .

tgs:Evidence.PeakOil_MKingHubbert a thinkr:Evidence,
        owl:NamedIndividual ;
    thinkr:confidence thinkr:ConfidenceType.Curated ;
