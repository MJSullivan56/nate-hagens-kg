# Oxigraph store (binary, local, regenerated via load_oxigraph.sh)
tgs_store/
scripts/tgs_store/
*.oxigraph/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Secrets — never commit
.env
.env.*

# DuckDB staging (local review queue — not source of truth)
extraction/staging.duckdb
extraction/entity_index.duckdb
extraction/entity_index.csv
extraction/*.duckdb

# Generated RDF from the promote workflow — decide deliberately whether
# to commit this or keep regenerating it; gitignored by default here
data/generated/

# Downloaded transcripts (large, regeneratable — keep the repo lean;
# store the fetch list/script instead, not the PDFs themselves)
extraction/transcripts_raw/
extraction/substack_summaries_raw/
extraction/cited_sources_raw/
extraction/substack_text_cache/
extraction/transcripts_text_cache/
extraction/transcripts_text_cache_pre_cleaned
extraction/intro_segments/
extraction/intro_candidates.csv
extraction/*.pdf

# Episode-shape pipeline (extraction/shape/): the scripts and the shape
# template itself ARE committed; everything derived from the copyrighted
# episode text is not. site_cache/ holds fetched episode HTML, out/ holds the
# shaped YAML/JSON records — both regenerate from the two scripts.
extraction/shape/site_cache/
extraction/shape/out/
extraction/shape/out_json/
extraction/shape/out_txt/
extraction/shape/out_txt_pilot/
extraction/shape/gaps.csv
extraction/shape/txt_resolution.csv
extraction/shape/youtube_worklist.csv

# Pre-patch snapshots of the hand-enriched .md files, taken by hand before
# running patch_md.py --apply. Same copyright reasoning as
# transcripts_text_cache/ above: these ARE the episode text.
extraction/md_backups/

# OS/editor cruft
.DS_Store
*.swp

