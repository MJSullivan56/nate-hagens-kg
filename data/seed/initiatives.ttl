    thinkr:listedInPracticeCluster tgs:PracticeCluster.CommunityGovernance, tgs:PracticeCluster.LegalStewardship ;
    dcterms:description "The deepest layer addresses the “economic code” of the place—alliances among academia, institutions, and government to move beyond GDP toward more holistic metrics that shape decisions and finance."@en ;
    dcterms:source tgs:Work.BioregioningEarthOntology ;
    .

tgs:Initiative.RegenerativeActionInThematicAreas a thinkr:Initiative, owl:NamedIndividual ;
