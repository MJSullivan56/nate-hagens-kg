          skos:scopeNote "URL and date not independently verified as of 2026-07-14."@en ] .

# --- Nate's academic relationships genuinely need MULTIPLE RelationshipType
# values at once — real, not a hypothetical stress test. Teaching Reality
# 101 is both Academic AND (per his own bio's "taught," implying a
# formal/paid role) Professional simultaneously. ---
tgs:Relationship.NateHagens_UniversityOfMinnesota a thinkr:Relationship, owl:NamedIndividual ;
    thinkr:hasSubject tgs:Persona.NateHagens ;
    thinkr:hasObject tgs:AcademicInstitution.UniversityOfMinnesota ;
    thinkr:hasRelationshipType thinkr:RelationshipType.Academic, thinkr:RelationshipType.Professional ;
    skos:prefLabel "Nate Hagens' academic and professional relationship with University of Minnesota"@en ;
    skos:scopeNote "Both Academic (teaching an honors course) AND Professional (a formal role) simultaneously — confirmed via live query this correctly returns BOTH types, not just one."@en .

#############################################
# BATCH 4 (2026-07-14, Persona-centered refactor): folding in
# persona_human_prototype-8.ttl's 3 organization/school Relationship
# individuals, not yet present in the real graph — thinkr:memberOf on
# tgs:Human.NateHagens already asserts these as flat, legal-weight
# facts (deliberately left untouched, per the confirmed precedent that
# memberOf and a structured Relationship coexist rather than compete —
# see University of Minnesota above, which already carries both). These
# three add the same structured, provenance-tracked layer for the
# remaining organizations. No thinkr:hasInteraction on any of these —
# unlike the guest relationships above, these aren't podcast
# appearances, just professional affiliations.
#############################################

tgs:Relationship.NateHagens_TheOilDrum a thinkr:Relationship, owl:NamedIndividual ;
    thinkr:hasSubject tgs:Persona.NateHagens ;
    thinkr:hasObject tgs:Organization.TheOilDrum ;
    thinkr:hasRelationshipType thinkr:RelationshipType.Professional ;
    skos:prefLabel "Nate Hagens' professional relationship with The Oil Drum"@en ;
    skos:scopeNote "End boundary is an INFERENCE, not directly confirmed for Nate specifically — Organization.TheOilDrum's own definition says the site was 'Active until 2013'; his role there necessarily ended no later than that, but no exact departure date is independently confirmed. Deliberately NOT asserting a fabricated date — the uncertainty itself is the honest fact."@en .

tgs:Relationship.NateHagens_PostCarbonInstitute a thinkr:Relationship, owl:NamedIndividual ;
    thinkr:hasSubject tgs:Persona.NateHagens ;
    thinkr:hasObject tgs:Organization.PostCarbonInstitute ;
    thinkr:hasRelationshipType thinkr:RelationshipType.Professional ;
    skos:prefLabel "Nate Hagens' professional relationship with Post Carbon Institute"@en ;
    skos:scopeNote "Currently sits on the Board — ongoing, no start date confirmed, no end (still active)."@en .

tgs:Relationship.NateHagens_PeakOilMovement a thinkr:Relationship, owl:NamedIndividual ;
    thinkr:hasSubject tgs:Persona.NateHagens ;
    thinkr:hasObject tgs:SchoolOfThought.PeakOilMovement ;
    thinkr:hasRelationshipType thinkr:RelationshipType.Intellectual ;
    skos:prefLabel "Nate Hagens' intellectual affiliation with the Peak Oil movement"@en ;
    skos:scopeNote "RETYPED 2026-07-15: was RelationshipType.Professional, corrected to the new RelationshipType.Intellectual (see tgs-core.ttl's hasIntellectualRelationship comment and enumerations.ttl's RelationshipType.Intellectual definition) — this relationship's own original scopeNote already admitted the mismatch ('not a formal joinable organization'), MJSullivan's review caught what the hedge was pointing at. No specific dates confirmed — intellectual community association via his pre-TGS career background, not formal employment or membership."@en .

#############################################
# BOOTSTRAPPED 2026-07-14 — Art Berman. See humans.ttl/episodes.ttl for
# provenance. A genuinely interesting cross-link, not overclaimed: Berman
# was "a Managing Director and frequent contributor at The Oil Drum" per
# multiple independent bio sources — the SAME organization Nate himself
# has a structured Relationship with (Relationship.NateHagens_TheOilDrum
# above). Asserting only the shared institutional fact here, NOT a claim
# that they worked together directly there — that would need separate,
# specific evidence not yet found.
#############################################

tgs:Relationship.NateHagens_ArtBerman a thinkr:Relationship, owl:NamedIndividual ;
    thinkr:hasSubject tgs:Persona.NateHagens ;
    thinkr:hasObject tgs:Persona.ArtBerman ;
    thinkr:hasRelationshipType thinkr:RelationshipType.Personal, thinkr:RelationshipType.Professional ;
    skos:prefLabel "Nate Hagens' personal and professional relationship with Art Berman"@en ;
    skos:scopeNote "4 of Art Berman's confirmed guest appearances modeled here (episodes 3, 92, 101, 220) — the transcript library shows evidence of more (an unnumbered 'ArtBermanPt2' and a 'TGS54ArtBerman3' suggesting a 3rd appearance by internal count) not yet individually researched/dated. Treat this Relationship as incomplete, not exhaustive, as of 2026-07-14. CORROBORATED 2026-07-15 via the bio-intro extraction pilot (see docs/sidecar-cleanup-handoff.md): in TGS_101's own intro (aired 2023-11-29) Nate says 'I think this is his fifth appearance on The Great Simplification' — consistent with TGS_3 + ArtBermanPt2(44) + TGS54ArtBerman3(54) + TGS_92 + TGS_101 = 5, direct primary-source support for the 'incomplete' flag above, still not itself sufficient to model episodes 44/54 as individuals (out of scope for this pilot). RelationshipType.Personal ADDED 2026-07-15 — direct evidence from Nate's own words, repeated across 3 of the 4 modeled episodes: 'Art is a friend, a colleague...' (TGS_92), 'my friend and colleague, Art Berman' (TGS_101), 'my friend Art Berman' (TGS_220). How they met, per Nate's own words in TGS_3: 'writing articles and analysis for the energy website, The Oil Drum 10 years ago, which is where we became colleagues' — corroborates the existing Relationship.ArtBerman_TheOilDrum / Nate's own TheOilDrum affiliation as the actual origin of this relationship, not just a coincidental shared affiliation."@en ;
    thinkr:hasInteraction
        [ a thinkr:PodcastAppearance ;
          thinkr:subjectRole thinkr:InteractionRole.Host ;
          thinkr:objectRole thinkr:InteractionRole.Guest ;
          thinkr:episode tgs:Interview.TGS_3_OilBestAndWorstOfFuels ;
          skos:scopeNote "No exact air date independently confirmed as of 2026-07-14."@en ],
        [ a thinkr:PodcastAppearance ;
          thinkr:subjectRole thinkr:InteractionRole.Host ;
          thinkr:objectRole thinkr:InteractionRole.Guest ;
          thinkr:episode tgs:Interview.TGS_92_BricsStrategicPetroleumReserveMetaphysics ;
          dcterms:date "2023-10-05"^^xsd:date ],
        [ a thinkr:PodcastAppearance ;
          thinkr:subjectRole thinkr:InteractionRole.Host ;
          thinkr:objectRole thinkr:InteractionRole.Guest ;
          thinkr:episode tgs:Interview.TGS_101_ShaleOilAndTheSlurpingSound ;
          dcterms:date "2023-11-29"^^xsd:date ],
        [ a thinkr:PodcastAppearance ;
          thinkr:subjectRole thinkr:InteractionRole.Host ;
          thinkr:objectRole thinkr:InteractionRole.Guest ;
          thinkr:episode tgs:Interview.TGS_220_AWorldOnThePrecipice ;
          skos:scopeNote "Air date inferred, not directly confirmed — see episodes.ttl comment on this Episode individual for the specific reasoning."@en ] .

tgs:Relationship.ArtBerman_TheOilDrum a thinkr:Relationship, owl:NamedIndividual ;
    thinkr:hasSubject tgs:Persona.ArtBerman ;
    thinkr:hasObject tgs:Organization.TheOilDrum ;
    thinkr:hasRelationshipType thinkr:RelationshipType.Professional ;
    skos:prefLabel "Art Berman's professional relationship with The Oil Drum"@en ;
    skos:scopeNote "Confirmed via multiple independent bio sources: 'Managing Director and frequent contributor.' No specific start/end dates confirmed."@en .

