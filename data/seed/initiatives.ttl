# ===== BEGIN DERIVED INVERSES (scripts/derive/compute_inverses.py; do not edit by hand) =====

# Each triple below mirrors a hand-authored one elsewhere in data/seed/.

tgs:PracticeCluster.AgroBioeconomy
    skos:narrower tgs:PracticeTerm.CommunityFoodAccess, tgs:PracticeTerm.FarmerSupport, tgs:PracticeTerm.MaterialsTransformation, tgs:PracticeTerm.RegenerativeAgriculture, tgs:PracticeTerm.RegenerativeGrazing, tgs:PracticeTerm.RegionalSourcing, tgs:PracticeTerm.ValueChainDevelopment .

tgs:PracticeCluster.AlternativeFinance
    skos:narrower tgs:PracticeTerm.LocalCurrencies, tgs:PracticeTerm.MutualCreditOrExchange, tgs:PracticeTerm.UniversalBasicIncome .

tgs:PracticeCluster.CommunityGovernance
    skos:narrower tgs:PracticeTerm.CoachesAndLeaders, tgs:PracticeTerm.CommonsGovernanceProtocols, tgs:PracticeTerm.CommunityReconciliation, tgs:PracticeTerm.CongressingAndEvents, tgs:PracticeTerm.DecisionMakingProcesses, tgs:PracticeTerm.GovernanceBodies, tgs:PracticeTerm.GovernanceDesign, tgs:PracticeTerm.NetworkWeaving, tgs:PracticeTerm.ParticipatoryStrategies, tgs:PracticeTerm.TheoryU .

tgs:PracticeCluster.EcosystemRegeneration
    skos:narrower tgs:PracticeTerm.HabitatConnectivity, tgs:PracticeTerm.InterspeciesMutualism, tgs:PracticeTerm.SeedsAndNurseries, tgs:PracticeTerm.SpeciesControl, tgs:PracticeTerm.VegetationPlanting, tgs:PracticeTerm.WaterManagement, tgs:PracticeTerm.WatershedRepair .

tgs:PracticeCluster.HubsAndCenters
