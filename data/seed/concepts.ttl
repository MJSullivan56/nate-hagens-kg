@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tgs: <http://example.org/tgs#> .
@prefix thinkr: <http://example.org/thinkr#> .

<http://example.org/tgs#> a owl:Ontology ;
    owl:imports <http://example.org/thinkr#> ;
    rdfs:comment "Imports tgs-core for Protege compatibility — editing this file alone will resolve thinkr: classes/properties via the catalog file."@en .


tgs:Concept.CarbonPulse a thinkr:Concept, thinkr:HagensConcept,
        owl:NamedIndividual ;
    dcterms:source <https://natehagens.substack.com/i/159009316/the-carbon-pulse> ;
    dcterms:subject tgs:Subject.EROIAndEnergyQuality ;
    skos:definition "The one-time, temporary burst of high-density energy available to humanity via fossil fuels, framed as a short pulse on a geological timescale rather than a permanent baseline."@en ;
    skos:prefLabel "The Carbon Pulse"@en .

tgs:Concept.CircleOfTrustLocalism a thinkr:Concept,
        owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.CommunityAndResponse ;
    skos:definition "Hagens' emphasis on rebuilding smaller-scale, face-to-face community and local resource resilience as an adaptive response to declining energy surplus and institutional fragility."@en ;
    skos:prefLabel "Local Resilience"@en ;
    thinkr:echoesIdeaOf tgs:Persona.ElinorOstrom ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
        thinkr:hasAlternateTermType tgs:AlternateTermType.ExactMatch ;
        skos:prefLabel "Circle of Trust"@en ;
        skos:scopeNote "THIRD pilot case for the alternate-term mechanism, 2026-08-13 — split out of this Concept's own former compound prefLabel (\"Local Resilience / 'Circle of Trust'\"). Kept as an anonymous blank node (Tier 2)." ] .

tgs:Concept.ComplexityCollapse a thinkr:Concept,
        owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.OvershootAndLimits ;
    skos:definition "The idea that societies invest in increasing complexity (institutions, specialization, infrastructure) to solve problems, but complexity carries rising energy/resource costs with diminishing returns — eventually making collapse (a rapid loss of complexity) a rational, if painful, adaptive response rather than an aberration."@en ;
    skos:prefLabel "Complexity and Collapse"@en ;
    thinkr:influencedBy tgs:Persona.JosephTainter .

tgs:Concept.DiscountRatesAndPresentBias a thinkr:Concept,
        owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.BehavioralEconomicsAndCognition ;
    skos:definition "The behavioral and financial tendency to heavily undervalue future costs and benefits relative to present ones, which Hagens treats as a key mechanism by which markets and individuals systematically under-price long-term ecological risk."@en ;
    skos:prefLabel "Discount Rates"@en ;
    thinkr:echoesIdeaOf tgs:Persona.MarcusAurelius ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
        thinkr:hasAlternateTermType tgs:AlternateTermType.Related ;
        skos:prefLabel "Present Bias"@en ;
        skos:scopeNote "FOURTH pilot case, 2026-08-13 — split out of this Concept's own former compound prefLabel (\"Discount Rates / Present Bias\"). Deliberately typed Related, NOT ExactMatch: 'discount rate' is the formal economic parameter, 'present bias' is the specific psychological tendency that produces excessive discounting — related, not strictly synonymous. Kept as an anonymous blank node (Tier 2)." ] .

tgs:Concept.EnergyReturnOnInvestment a thinkr:Concept,
        owl:NamedIndividual ;
    dcterms:source <https://en.wikipedia.org/wiki/Energy_return_on_investment>,
        <https://www.sciencedirect.com/topics/engineering/energy-return-on-investment>,
        <https://world-nuclear.org/information-library/energy-and-the-environment/energy-return-on-investment>,
        <https://pmc.ncbi.nlm.nih.gov/articles/PMC7320919/>,
        <https://www.gov.uk/research-for-development-outputs/eroi-of-different-fuels-and-the-implications-for-society> ;
    dcterms:subject tgs:Subject.EROIAndEnergyQuality ;
    skos:definition "The ratio of energy delivered by an energy source to the energy required to extract/produce it; central to Hagens' argument that the quality, not just quantity, of energy sources matters for what a society can sustain."@en ;
    skos:prefLabel "Energy Return on Investment"@en ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
        thinkr:hasAlternateTermType tgs:AlternateTermType.ExactMatch, tgs:AlternateTermType.Abbreviation ;
        skos:prefLabel "EROI"@en ;
        skos:scopeNote "SECOND pilot case for the alternate-term mechanism, 2026-08-13 — split out of this Concept's own former compound prefLabel ('EROI (Energy Return on Investment)'), same anti-pattern as Wetware's original compound label. BOTH types asserted deliberately: ExactMatch because this is genuinely the same meaning, Abbreviation because it's specifically a lexical-form relationship, not just a loose synonym. REVISED same day, per MJSullivan's explicit standing convention: when a term IS an Abbreviation of another, the FULL EXPANDED FORM is canonical (prefLabel + IRI local name), the abbreviation itself goes into the AlternateTerm — reversed from this pilot's own first draft, which had it backwards (IRI/prefLabel = 'EROI', full form as the AlternateTerm). See thinkr:AlternateTermType.Abbreviation's own scopeNote for the general rule." ] .

tgs:Concept.EnergyBlindness a thinkr:Concept,
        owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.EROIAndEnergyQuality ;
    skos:definition "The tendency of economics, policy, and everyday thinking to treat energy as a substitutable input abstracted into monetary terms, obscuring how dependent modern life is on cheap, concentrated, finite energy."@en ;
    skos:prefLabel "Energy Blindness"@en ;
    thinkr:contrastsWith tgs:Persona.Buddha ;
    thinkr:influencedBy tgs:Persona.ArtBerman ;
    skos:scopeNote "MJSullivan's own observation, added 2026-08-30: Energy Blindness has a fairly direct relationship to the standard economics concept of externalities — not equivalent, but externalities (costs or benefits of an economic activity borne by parties outside the transaction, left out of market prices) are a key component of how energy blindness actually operates in practice. Real, direct textual confirmation found the same day in TGS_154 (Jane Muncke): Nate's own words, asking whether short-term convenience-seeking happens 'despite the externalities,' using the term directly and unprompted in exactly this context. No dedicated Concept.Externalities individual exists in this graph — a generic economics term, not itself something any specific episode discusses as its own topic — so this relationship is captured here as prose rather than a formal link to an individual that doesn't yet exist."@en ;
    .

tgs:Concept.EnergySlaves a thinkr:Concept,
        owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.EROIAndEnergyQuality ;
    skos:definition "A framing device measuring the work output of fossil-fuel energy in equivalent human labor-hours, to make the scale of energy subsidy to modern life viscerally graspable."@en ;
    skos:prefLabel "Energy Slaves"@en .

tgs:Concept.GreatSimplification a thinkr:Concept, thinkr:HagensConcept,
        owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.SystemsFrameworks ;
    skos:definition "Hagens' term for a coming, likely non-linear reduction in the complexity, energy throughput, and material consumption of global civilization, as fossil fuel surplus energy declines relative to what the economy has grown to expect."@en ;
    skos:prefLabel "The Great Simplification"@en ;
    thinkr:contrastsWith tgs:SchoolOfThought.TechnoOptimism ;
    thinkr:relatesTo tgs:ScenarioFacet.TheGreatSimplification ;
    dcterms:references tgs:Interview.TGS_100_NateHagens ;
    skos:scopeNote "CANONICAL REFERENCE ADDED 2026-08-30: tgs:Interview.TGS_100_NateHagens designated by MJSullivan as the primary episode to link whenever a reference to this Concept as a whole is needed — the show's 100th episode, a real, comprehensive synthesis of the framework covering nearly every major concept in this graph in one sitting, made unusually direct by a genuine role reversal (Kate Raworth interviewing Nate rather than the reverse). OPEN DESIGN QUESTION, raised by MJSullivan same day, deliberately NOT resolved yet — no changes made pending further thought: this Concept may really function as an umbrella term for the whole show/framework rather than a specific, citable idea individual episodes 'discuss' the way Concept.DarkTriad or Concept.Superorganism do. If that's right, a real category mismatch may be sitting underneath the dct:references link just added — an umbrella label for an entire body of work isn't naturally 'referenced by' one episode among hundreds the way a specific concept is, even a comprehensive one. The umbrella-term reading has real value on its own (a durable, top-level label for the whole project), independent of whether episode-linkage is the right mechanism for it. Left as-is for now; revisit if this tension recurs elsewhere or a clearer resolution presents itself. contrastsWith added 2026-08-13. Real, direct evidence, not inferred from tone alone: RR-24's own official episode description centers its entire premise on critiquing techno-optimists' space-colonization ambitions as a way of 'bypassing the problems we now face on Earth' — this graph's own already-built Concept.EnergyBlindness makes the same underlying critique in general form. MJSullivan's own framing, worth preserving: this graph's discipline is about verifying real sources, not about false neutrality — Hagens' own real material already takes a clear, evidenced side here. SPLIT 2026-08-13: this individual was dual-typed as both Concept and ScenarioFacet (added, then reverted from an even earlier split attempt, then re-split here) — now holds the Concept role only, with the grid-specific ScenarioFacet role split out to its own individual, tgs:ScenarioFacet.TheGreatSimplification, linked via thinkr:relatesTo. See that individual's own scopeNote for the full reasoning and migration record."@en .

tgs:Concept.GrowthImperative a thinkr:Concept,
        owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.MonetarySystemAndGrowth ;
    skos:definition "The structural requirement of debt-based monetary systems and compound interest for continual economic growth, which Hagens argues locks in ever-increasing energy/material throughput regardless of ecological limits."@en ;
    skos:prefLabel "The Growth Imperative"@en .

tgs:Concept.HumanPredicament a thinkr:Concept, thinkr:HagensConcept,
        owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.SystemsFrameworks ;
    skos:definition "Hagens' preferred framing over 'the climate problem' or 'the energy problem' — the interlocking set of ecological overshoot, energy decline, economic dependence on growth, and human behavioral wiring, treated as a single systemic predicament rather than a checklist of separate problems with separate solutions."@en ;
    skos:prefLabel "The Human Predicament"@en .

tgs:Concept.JevonsParadox a thinkr:Concept,
        owl:NamedIndividual ;
    dcterms:source <https://en.wikipedia.org/wiki/Jevons_paradox>,
        <https://www.sciencedirect.com/science/article/abs/pii/S0921800905001084>,
        <https://www.researchgate.net/publication/344271331_The_problem_of_energy_efficiency_known_as_the_Jevons_paradox> ;
    dcterms:subject tgs:Subject.EROIAndEnergyQuality ;
    skos:definition "The observation that increases in efficiency of resource use often lead to increased total consumption of that resource rather than decreased, because efficiency lowers effective cost and expands use — a recurring theme in Hagens' skepticism toward efficiency-alone as a solution to overshoot."@en ;
    skos:prefLabel "Jevons Paradox"@en ;
    thinkr:influencedBy tgs:Persona.WilliamStanleyJevons .

tgs:Concept.LimitsToGrowth a thinkr:Concept,
        owl:NamedIndividual ;
    dcterms:source <https://www.clubofrome.org/publication/the-limits-to-growth/> ;
    dcterms:subject tgs:Subject.OvershootAndLimits ;
    skos:definition "Reference to the 1972 Club of Rome-commissioned study modeling interactions between population, industrialization, pollution, food production, and resource depletion, projecting overshoot-and-decline dynamics on multi-decade timescales — a direct intellectual predecessor to Hagens' framework."@en ;
    skos:prefLabel "Limits to Growth"@en ;
    thinkr:influencedBy tgs:Persona.DennisMeadows, tgs:Persona.DonellaMeadows ;
    thinkr:relatesTo tgs:Persona.GayaHerrington .

tgs:Concept.Metacrisis a thinkr:Concept,
        owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.SystemsFrameworks ;
    skos:definition "A term (shared with adjacent thinkers like Daniel Schmachtenberger) for the idea that today's separate crises — climate, biodiversity, inequality, political polarization, mental health — share common generative root causes rather than being independent problems."@en ;
    skos:prefLabel "Metacrisis"@en ;
    thinkr:influencedBy tgs:Persona.GregoryBateson .

tgs:Concept.MoneyAsClaimOnEnergy a thinkr:Concept, thinkr:HagensConcept,
        owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.MonetarySystemAndGrowth ;
    skos:definition "Hagens' framing of money not as wealth itself but as a social/legal claim on future energy and resources — meaning monetary growth (via debt, interest) implicitly presumes continued growth in real energy throughput, tying the Growth Imperative concept directly to biophysical limits rather than treating them as separate domains."@en ;
    skos:prefLabel "Money as a Claim on Future Energy"@en ;
    thinkr:echoesIdeaOf tgs:Persona.Aristotle .

tgs:Concept.Overshoot a thinkr:Concept,
        owl:NamedIndividual ;
    dcterms:source <https://en.wikipedia.org/wiki/Overshoot_(book)> ;
    dcterms:subject tgs:Subject.OvershootAndLimits ;
    skos:definition "The condition of a population/economy consuming renewable and non-renewable resources faster than natural systems can regenerate or absorb waste from them, borrowed from systems ecology (Catton, Meadows) and applied to the global economy."@en ;
    skos:prefLabel "Ecological Overshoot"@en ;
    thinkr:convergesWith tgs:SchoolOfThought.DoughnutEconomics ;
    thinkr:influencedBy tgs:Persona.WilliamCatton .

tgs:Concept.PeakOil a thinkr:Concept,
        owl:NamedIndividual ;
    dcterms:source <https://en.wikipedia.org/wiki/Peak_oil> ;
    dcterms:subject tgs:Subject.EROIAndEnergyQuality ;
    skos:definition "The point at which the maximum rate of petroleum extraction is reached, after which production enters terminal decline — a formative concept in Hagens' background (he worked as a peak oil analyst before founding The Great Simplification) and foundational to his energy-decline framing."@en ;
    skos:prefLabel "Peak Oil"@en ;
    thinkr:influencedBy tgs:Persona.MKingHubbert ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
        thinkr:hasAlternateTermType tgs:AlternateTermType.ExactMatch ;
        skos:prefLabel "Hubbert Peak Theory"@en ;
        skos:scopeNote "The formal academic name for this same observation, per Hubbert's own 1956 paper 'Nuclear Energy and the Fossil Fuels' (presented to the American Petroleum Institute) — real citation confirmed via https://en.wikipedia.org/wiki/Hubbert_peak_theory. ExactMatch, not just Related: same core referent as Peak Oil, just formal/academic naming versus the popularized term this graph's source material actually uses." ] .

tgs:Concept.Superorganism a thinkr:Concept,
        owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.SystemsFrameworks ;
    skos:definition "Framing human civilization as a single self-organizing, energy-and-resource-consuming entity whose collective behavior is not simply the sum of individual human intentions — echoing biological superorganism concepts (ant colonies, etc.) applied to techno-industrial society."@en ;
    skos:prefLabel "The Superorganism"@en ;
    thinkr:echoesIdeaOf tgs:Persona.JoshFarley ;
    thinkr:influencedBy tgs:Persona.EOWilson .

tgs:Concept.TheoryOfChange a thinkr:Concept,
        owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com/wp-content/uploads/2025/12/TGS-205-Nate-Hagens-Transcript.pdf> ;
    dcterms:subject tgs:Subject.CommunityAndResponse ;
    skos:definition "Hagens' stated approach to influence: rather than trying to reach and convert millions directly, cultivate a smaller network of well-informed people ('scout team') who shift the initial conditions from which broader social emergence unfolds."@en ;
    skos:prefLabel "Theory of Change"@en ;
    thinkr:hasAlternateTerm
        [ a thinkr:AlternateTerm ;
            thinkr:hasAlternateTermType tgs:AlternateTermType.Related ;
            skos:prefLabel "Emergence"@en ;
            skos:scopeNote "FIFTH pilot case, 2026-08-13, and the first with 3 terms tangled in one label rather than 2 — split out of this Concept's own former compound prefLabel (\"Theory of Change (Emergence / Initial Conditions)\") into a base concept plus TWO separate AlternateTerms rather than one. Typed Related: 'emergence' is the broader systems-science phenomenon this Theory of Change relies on, not a direct synonym for it." ],
        [ a thinkr:AlternateTerm ;
            thinkr:hasAlternateTermType tgs:AlternateTermType.Related ;
            skos:prefLabel "Initial Conditions"@en ;
            skos:scopeNote "See the sibling 'Emergence' AlternateTerm's scopeNote on this same Concept for the full split rationale. Typed Related for the same reason: the specific mechanism this Theory of Change acts through ('shift the initial conditions'), not a synonym for the Theory of Change itself." ] .

tgs:Concept.Wetware a thinkr:Concept,
        owl:NamedIndividual ;
    dcterms:source <https://en.wikipedia.org/wiki/Wetware_(brain)> ;
    dcterms:subject tgs:Subject.BehavioralEconomicsAndCognition ;
    skos:definition "The idea that human cognitive and emotional wiring evolved for small-group, resource-scarce Pleistocene environments and is poorly matched to modern abundance, abstraction, and global-scale decision-making — a recurring lens Hagens uses to explain collectively self-destructive behavior."@en ;
    skos:prefLabel "Human 'Wetware'"@en ;
    thinkr:echoesIdeaOf tgs:Persona.SigmundFreud ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
        thinkr:hasAlternateTermType tgs:AlternateTermType.ExactMatch ;
        skos:prefLabel "Evolutionary Mismatch"@en ;
        skos:scopeNote "PILOT CASE for the alternate-term mechanism, 2026-08-13 — split out of this Concept's own former compound prefLabel (\"Human 'Wetware' / Evolutionary Mismatch\"), which had jammed two real terms into one string. Kept as an anonymous blank node (Tier 2, per MJSullivan's own hasAlternateTerm pattern) rather than promoted to a named thinkr:AlternateTerm individual — not yet reused across any other Concept, no independent citable history captured yet. Promote to a named individual if/when either changes." ] .

thinkr:Concept a owl:Class ;
    rdfs:comment "A term or idea discussed within Nate Hagens' Great Simplification framework — the UMBRELLA level, deliberately broad: includes ideas he originated/reframed himself (see the narrower thinkr:HagensConcept subclass) AND real ideas/theories he adopts, synthesizes, or substantively engages with from elsewhere (e.g. Terror Management Theory, Peak Oil, the Superorganism) without having originated them. REVISED 2026-08-13, per MJSullivan's explicit direction, after auditing all 26 existing Concept individuals found the majority (19 of 26) already had documented external origination (15 via explicit thinkr:influencedBy/echoesIdeaOf/contrastsWith links to a real Persona, plus 4 more confirmed external by their own prose) — external adoption/synthesis is the NORM here, not the exception, which is why a narrower subclass for his own originated ideas specifically was worth adding rather than assumed."@en ;
    rdfs:subClassOf skos:Concept ;
    skos:scopeNote "Narrower than skos:Concept: specifically an idea discussed within Hagens' TGS framework, not a general classification term — do not confuse with thinkr:Subject, which is also a skos:Concept subclass but for topic classification, a different purpose entirely."@en ;
    skos:prefLabel "Concept"@en .

thinkr:HagensConcept a owl:Class ;
    rdfs:subClassOf thinkr:Concept ;
    rdfs:comment "The narrower subclass of thinkr:Concept specifically for ideas Nate Hagens originated, coined, or gave a genuinely distinctive reframing to himself — as opposed to the broader umbrella, which also covers real ideas/theories he substantively engages with but adopted from elsewhere. ADDED 2026-08-13, raised by MJSullivan specifically to be able to isolate Nate's own unique contributions from the broader set of ideas his show discusses. Classification requires real per-Concept judgment, not a mechanical rule — 'has no documented external lineage yet' is NOT sufficient evidence on its own (several genuinely external ideas, like Terror Management Theory and EROI, had no formal thinkr:influencedBy triple asserted despite being clearly not his own) — each of the 7 initial members was individually checked against its own existing definition/scopeNote before being classified here."@en ;
    skos:prefLabel "Hagens Concept"@en .


#############################################
# ADDED 2026-08-13 — stubbed out of Frankly_138's official show-notes topic
# list (thegreatsimplification.com/frankly-original/138-...), not from
# transcript-reading alone. See episodes.ttl's Frankly_138 record for the
# discusses links this batch supports, and docs/sidecar-cleanup-handoff.md
# for the full triage this session did before minting anything (several
# show-notes items were deliberately NOT minted — real-world current
# events, external citations better modeled as Work, or genuinely
# covered by an existing Concept already).
#############################################

tgs:Concept.TerrorManagementTheory a thinkr:Concept, owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:prefLabel "Terror Management Theory"@en ;
    skos:definition "The theory (developed by Sheldon Solomon, Tom Pyszczynski, and Jeff Greenberg starting the early 1980s, building on Ernest Becker's work) that human awareness of mortality generates a background existential anxiety managed largely unconsciously through cultural worldviews, self-esteem, and close relationships — and that reminders of death ('mortality salience') measurably intensify attachment to one's own cultural in-group and hostility toward out-groups."@en ;
    skos:scopeNote "THIRD independent confirmation as of 2026-08-13 that this deserves real modeling: (1) surfaced during an earlier session's investigation of the TGS_199 Sheldon Solomon transcript, which found the co-founder name 'Budzinski' in that transcript is almost certainly a mishearing of Tom Pyszczynski — NOT yet independently verified, flagged here again since this stub is the natural place to resolve it; (2) Frankly_138's own show notes reference it directly with a link to 'more info' and a cross-reference to the TGS episode on it; (3) general public awareness that this is real, citable psychological theory, not a Hagens coinage. thinkr:influencedBy tgs:Persona.EmileDurkheim considered but NOT asserted — Solomon cites Durkheim's 'religion existed before gods' framing approvingly in the TGS_199 transcript, but that is Solomon's OWN citation of Durkheim within a discussion of religion's function, not a claim that Durkheim shaped Terror Management Theory's origin (which the same transcript traces to Becker, not yet modeled as a Persona in this graph)."@en .

tgs:Concept.ShortfallRisk a thinkr:Concept, thinkr:HagensConcept, owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.SystemsScience ;
    skos:prefLabel "Shortfall Risk"@en ;
    skos:definition "A framing Hagens borrows from portfolio management/finance and repurposes for civilizational risk assessment: the danger that something essential (topsoil, social trust, grid stability, the nuclear-use taboo, an aquifer) drops below a threshold it cannot easily recover from — distinct from more commonly discussed AVERAGE-outcome risk, and argued to be the more important lens for genuinely existential threats specifically because average-case thinking systematically undercounts them."@en ;
    skos:scopeNote "DOUBLY CONFIRMED: independently surfaced during an earlier session's by-hand pilot read of this same episode's transcript, and again via this session's official show-notes review — Frankly_138's own team-written description states this concept explicitly functions as connective tissue across the rest of the 'How to Think About the Future' series (see tgs:Series.HowToThinkAboutTheFuture)."@en .

tgs:Concept.ScenarioThinking a thinkr:Concept, owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.SystemsScience ;
    skos:prefLabel "Scenario Thinking"@en ;
    skos:definition "Deliberately holding multiple plausible futures at once rather than committing to a single predicted storyline — the organizing methodology behind the entire 'How to Think About the Future' series (see tgs:Series.HowToThinkAboutTheFuture and tgs:Scenario) and explicitly contrasted by Hagens with forecasting."@en ;
    skos:scopeNote "Has a real, independently citable external source: Frankly_138's show notes link a specific book/resource, 'Scenario Thinking: A Historical Evolution of Strategic Foresight' — worth minting as its own tgs:Work once the exact author/publication details are verified (not yet done as of 2026-08-13, title alone insufficient to mint safely)."@en .

tgs:Concept.MoreThanHumanPredicament a thinkr:Concept, thinkr:HagensConcept, owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.EcologyAndEnvironment ;
    skos:prefLabel "More-Than-Human Predicament"@en ;
    skos:scopeNote "GENUINE OPEN QUESTION, not resolved as of 2026-08-13: may be the SAME underlying idea as the existing tgs:Concept.HumanPredicament, just reframed with explicitly non-anthropocentric ('more-than-human') language — or may be a real, deliberate broadening Hagens is making, extending the predicament framing to include non-human life rather than only humanity's own situation. Deliberately stubbed SEPARATELY rather than silently merged into HumanPredicament or silently treated as a duplicate — a later pass with more source material (this stub currently has only its show-notes timestamp label, no elaborated definition) should resolve which reading is correct, and either merge the two or keep them genuinely distinct with a real thinkr:relatesTo link explaining why."@en .

tgs:Concept.NarrativeAsActiveInference a thinkr:Concept, owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:prefLabel "Narrative as Active Inference"@en ;
    skos:definition "The idea (drawing on active inference/predictive-processing frameworks from cognitive science) that the stories people tell themselves about the world function partly as a cognitive-effort-reduction mechanism — a pre-built interpretive frame that reduces the real-time processing cost of making sense of new information, at the cost of resisting genuinely novel or disconfirming input."@en ;
    skos:scopeNote "Frankly_138's show notes list this as two adjacent timestamped bullets ('Narrative as active inference' / 'Narrative as reducing cognitive effort') — read here as two facets of one idea, not two separate concepts, since they describe the same mechanism from two angles rather than two distinct claims."@en .

tgs:Concept.Rebuildables a thinkr:Concept, thinkr:HagensConcept, owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.EnergySystems ;
    skos:prefLabel "Rebuildables"@en ;
    skos:definition "Hagens' own reframing of 'renewable energy' infrastructure (solar panels, wind turbines, batteries): since manufacturing, installing, and eventually replacing this infrastructure depends on fossil-fuel-powered mining, transport, and industrial processes at every stage, he argues 'rebuildable' is a more honest description than 'renewable,' which implies a self-sustaining energy source independent of the fossil fuel base it currently depends on."@en ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
        thinkr:hasAlternateTermType tgs:AlternateTermType.CloseMatch ;
        skos:prefLabel "Renewables"@en ;
        skos:scopeNote "The mainstream/conventional term for the SAME physical technologies Hagens is discussing — CloseMatch rather than ExactMatch specifically because his own point is that the terms carry meaningfully different implications (self-sustaining vs. fossil-fuel-dependent), not that they're neutral synonyms for identical claims. Kept as an anonymous blank node (Tier 2) — not yet reused elsewhere, no independent citable history captured." ] .

tgs:Concept.ComplexSystemsThinking a thinkr:Concept, owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.SystemsScience ;
    skos:prefLabel "Complex Systems Thinking"@en ;
    skos:definition "The general toolkit of concepts Hagens draws on for reasoning about civilizational dynamics: systems move in fits and starts rather than smoothly; ecological phase shifts exhibit path dependency (once crossed, a threshold is not easily uncrossed); non-linear causality and feedback loops mean small inputs can produce disproportionate effects; and real tipping points (ice sheets, soil systems, per the Global Tipping Points Report 2025) can be crossed well before they become visible in conventional metrics."@en ;
    skos:scopeNote "A deliberately GENERAL cluster stub, not split into 4+ separate Concepts for each named sub-idea (fits-and-starts, phase shifts, feedback loops, tipping points) — matches this session's 'don't over-model before a shape reveals itself' approach. Clearly related to the existing tgs:Concept.ComplexityCollapse and tgs:Concept.Metacrisis, but that relation is deliberately NOT formally linked yet (no thinkr:relatesTo asserted) — flagged in prose rather than prematurely formalized, pending more real content to judge the actual relationship by."@en .

#############################################
# ADDED 2026-08-13 — surfaced from the "How to Think About the Future"
# series highlights batch (Parts 2-6, MJSullivan's own manual show-notes
# transcription), same triage/verification discipline as the Frankly_138
# pass. See docs/sidecar-cleanup-handoff.md for the full session entry.
#############################################

tgs:Concept.TheSenecaEffect a thinkr:Concept, owl:NamedIndividual ;
    dcterms:source <https://www.clubofrome.org/publication/the-seneca-effect-2017/> ;
    dcterms:subject tgs:Subject.SystemsScience ;
    skos:prefLabel "The Seneca Effect"@en ;
    skos:definition "The observation that complex systems tend to grow slowly but collapse rapidly — named after the Roman philosopher Seneca's own observation that fortune grows slowly but ruin is swift. Developed by Ugo Bardi as a general model for why decline, once it starts, tends to be much faster than the growth that preceded it."@en ;
    thinkr:influencedBy tgs:Persona.UgoBardi .

tgs:Concept.LandscapeOfPossibleFutures a thinkr:Concept, thinkr:HagensConcept, owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.SystemsScience ;
    skos:prefLabel "The Landscape of Possible Futures"@en ;
    skos:definition "Hagens' own application of the landscape metaphor (valleys, ridges, switchbacks, erosion) to civilizational futures — see tgs:Monologue.Frankly_145_Part3UphillFutures for the full framework. Adapts Conrad Waddington's epigenetic landscape (originally a model of cellular differentiation) to a different domain entirely — a genuine reframing, not a direct reuse, hence HagensConcept despite the explicit external inspiration."@en ;
    thinkr:influencedBy tgs:Persona.ConradWaddington .

tgs:Concept.PerpetualMulligans a thinkr:Concept, thinkr:HagensConcept, owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.EnergySystems ;
    skos:prefLabel "Perpetual Mulligans"@en ;
    skos:definition "Hagens' own framing for how cheap, abundant fossil energy has functioned historically as an economic 'do-over' — letting mistakes, inefficiencies, and bad decisions get absorbed and corrected via sheer energy surplus rather than genuine adaptation, a buffer that thins as energy surplus declines."@en .

tgs:Concept.UnicornStrategies a thinkr:Concept, thinkr:HagensConcept, owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.SystemsScience ;
    skos:prefLabel "Unicorn Strategies"@en ;
    skos:definition "Hagens' own term for actions that are good moves regardless of which of the 4 composite future Scenarios (see tgs:Scenario) actually comes to pass — genuinely robust across radically different futures rather than a bet on one specific outcome. Named examples from the source episode: ocean conservation, nuclear disarmament, indigenous language preservation."@en ;
    skos:scopeNote "Deliberately NOT formally linked to thinkr:Scenario via any property — the relationship (robust across all 4 named Scenarios) is real but this session's own 'don't over-link prematurely' discipline applies; noted here in prose instead."@en .

#############################################
# ADDED 2026-08-13 — RR-26 "Why Community Fails" bootstrap.
#############################################

tgs:Concept.Communing a thinkr:Concept, owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:prefLabel "Communing"@en ;
    skos:definition "Nora Bateson's framing of 'communing' as the necessary precursor to 'community' — the practice of genuine mutual relating (giving before being owed, radical hospitality, tending to the whole as a way of tending to the self) that most attempts at community-building skip past by going straight to shared values, organizing, and logistics."@en ;
    thinkr:influencedBy tgs:Persona.NoraBateson .

tgs:Concept.Symmathesy a thinkr:Concept, owl:NamedIndividual ;
    dcterms:source <https://journals.isss.org/index.php/proceedings59th/article/view/2720> ;
    dcterms:subject tgs:Subject.SystemsScience ;
    skos:prefLabel "Symmathesy"@en ;
    skos:definition "Nora Bateson's 2015 coinage (Greek 'sym' + 'mathesis,' together + learning) for an entity composed through contextual mutual learning by interaction — a living system (a family, an ecosystem, a conversation) that is genuinely shaped by its own internal relationships and interdependencies, not just a collection of independently-acting parts."@en ;
    thinkr:influencedBy tgs:Persona.NoraBateson ;
    skos:scopeNote "dcterms:source UPGRADED 2026-08-13 from a generic WordPress blog post to the real ISSS (International Society for the Systems Sciences) academic conference proceedings — a strictly more authoritative citation for this same 2015 coinage, surfaced via RR-26's own real linked show notes."@en .

tgs:Concept.Schismogenesis a thinkr:Concept, owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:prefLabel "Schismogenesis"@en ;
    skos:definition "Gregory Bateson's term (from his 1930s anthropological fieldwork) for a process in which relationships escalate through cumulative interaction — either symmetrically (both parties responding to each other's same behavior with more of the same, e.g. an arms race) or complementarily (parties responding with opposite behaviors that reinforce each other, e.g. dominance and submission), each pattern intensifying over time unless deliberately interrupted."@en ;
    thinkr:influencedBy tgs:Persona.GregoryBateson .

#############################################
# ADDED 2026-08-13 — Berman 5-interview batch (TGS_101).
#############################################

tgs:Concept.MaximumPowerPrinciple a thinkr:Concept, owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.SystemsScience ;
    skos:prefLabel "Maximum Power Principle"@en ;
    skos:definition "Howard T. Odum's principle (building on Alfred Lotka's earlier work) that self-organizing systems tend to develop and prevail when they maximize their intake and useful transformation of energy, not merely their efficiency — a foundational idea in ecological energetics directly connected to EROI (Charles Hall, a notable Odum student, is a central figure in that literature too)."@en ;
    thinkr:influencedBy tgs:Persona.HowardOdum .

#############################################
# ADDED 2026-08-13 — surfaced via TGS_10's own real linked show notes.
#############################################

tgs:Concept.KleibersLaw a thinkr:Concept, owl:NamedIndividual ;
    dcterms:source <https://en.wikipedia.org/wiki/Kleiber%27s_law> ;
    dcterms:subject tgs:Subject.SystemsScience ;
    skos:prefLabel "Kleiber's Law"@en ;
    skos:definition "Max Kleiber's 1932 empirical finding that an organism's basal metabolic rate scales to roughly the 3/4 power of its body mass, not the 2/3 power a simple surface-area argument would predict — one of the few genuine quantitative laws in biology, still without a fully settled theoretical explanation, and used in this graph's own source material as a real biological analogy for economic/systemic energy-scaling arguments."@en ;
    thinkr:influencedBy tgs:Persona.MaxKleiber .

#############################################
# ADDED 2026-08-13 — RR-26 Tier 2/4 enrichment, from its own real
# linked show notes.
#############################################

tgs:Concept.RadicalHospitality a thinkr:Concept, owl:NamedIndividual ;
    dcterms:source <https://www.thegreatsimplification.com> ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:prefLabel "Radical Hospitality"@en ;
    skos:definition "A practice of genuine, unscripted welcome — extended both to others and to oneself — treated in this graph's source material as a necessary ingredient for real community, distinct from the transactional, role-bound interactions that ordinarily substitute for it. No single originator credited in the source material (etymological, not attributional, citations given for both words) — modeled as umbrella Concept, not thinkr:HagensConcept."@en .

tgs:Concept.Amonging a thinkr:Concept, owl:NamedIndividual ;
    dcterms:source <https://www.combining.life/> ;
    dcterms:subject tgs:Subject.SystemsScience ;
    skos:prefLabel "Amonging"@en ;
    skos:definition "Nora Bateson's own neologism for the edge of the self as genuinely porous and relational rather than fixed — being fundamentally constituted 'among' one's relationships and context, not separately from them. Directly connects to both her book Combining and her newer book Belly (whose own publisher description uses the phrase 'the among-ing of all life') — not confidently attributable to one specific book over the other from the sources checked."@en ;
    thinkr:influencedBy tgs:Persona.NoraBateson .

tgs:Concept.DunbarsNumber a thinkr:Concept, owl:NamedIndividual ;
    dcterms:source <https://en.wikipedia.org/wiki/Dunbar%27s_number> ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:prefLabel "Dunbar's Number"@en ;
    skos:definition "Robin Dunbar's proposed cognitive limit (roughly 150) on the number of people with whom one can maintain genuinely stable social relationships, derived from a correlation between primate brain/neocortex size and social group size — used in this graph's source material as evidence for prioritizing depth over breadth in relationships."@en ;
    thinkr:influencedBy tgs:Persona.RobinDunbar .

#############################################
# ADDED 2026-08-13 — Concept.DarkTriad, previously discussed
# substantively across RR-19, RR-20, and RR-26 but never itself
# formally minted, closing a real gap surfaced while processing
# Frankly_85. Concept.LightTriad, Nate's own explicit antonym framing
# for it, surfaced via Frankly_85 directly.
#
# ARCHITECTURAL RESOLUTION, same day: this is the first real case
# testing whether thinkr:AlternateTermType.Antonym (built 2026-08-13,
# earlier this session, flagged then as unresolved and NEVER actually
# used on any real individual since) or the already-existing
# thinkr:contrastsWith is the right mechanism for a genuine antonym.
# RESOLVED: contrastsWith wins, clearly — Light Triad and Dark Triad
# are NOT two names for the same referent (which is what AlternateTerm
# is for, e.g. EROI/"Energy Return on Investment"); they are two
# DISTINCT, separately-defined constructs that stand in opposition.
# Confirmed independently by the very paper that established this
# contrast: Kaufman et al.'s own 2019 title is literally "Contrasting
# Two Very Different Profiles of Human Nature." contrastsWith's own
# existing definition ("useful tension... does not imply influence in
# either direction") fits this case exactly. See
# thinkr:AlternateTermType.Antonym's own scopeNote for the formal
# resolution note.
#############################################

tgs:Concept.DarkTriad a thinkr:Concept, owl:NamedIndividual ;
    dcterms:source <https://www.sciencedirect.com/science/article/abs/pii/S0191886902001459> ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:prefLabel "Dark Triad"@en ;
    skos:definition "A cluster of three socially aversive personality traits — narcissism, Machiavellianism, and psychopathy — originally proposed by Delroy Paulhus and Kevin Williams (2002). A recurring analytical lens across this graph's source material for understanding how individuals with these traits gain disproportionate influence over institutions and culture, distinct from mere individual pathology."@en ;
    thinkr:contrastsWith tgs:Concept.LightTriad ;
    .

tgs:Concept.LightTriad a thinkr:Concept, owl:NamedIndividual ;
    dcterms:source <https://doaj.org/article/6a8567c65a0a46cbb579e2a93b07acd0> ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:prefLabel "Light Triad"@en ;
    skos:definition "Scott Barry Kaufman's proposed counterpart to the Dark Triad (2019, with David Bryce Yaden, Elizabeth Hyde, and Eli Tsukayama) — a cluster of three prosocial traits: Kantianism (treating people as ends in themselves, not means), humanism (belief in the inherent dignity of others), and faith in humanity (a basic trust that most people are good). Hagens' own explicit framing treats it as a real but structurally weaker force than the Dark Triad — a value-based orientation up against trait-based behavior, requiring deliberate group-level support (not just individual goodness) to hold its own."@en ;
    thinkr:influencedBy tgs:Persona.ScottBarryKaufman ;
    thinkr:contrastsWith tgs:Concept.DarkTriad ;
    .

#############################################
# ADDED 2026-08-13 — RR-2 bootstrap.
#############################################

tgs:Concept.EcologicalFootprint a thinkr:Concept, owl:NamedIndividual ;
    dcterms:source <https://en.wikipedia.org/wiki/Ecological_footprint> ;
    dcterms:subject tgs:Subject.SystemsScience ;
    skos:prefLabel "Ecological Footprint"@en ;
    skos:definition "A quantitative sustainability metric, originated and co-developed by William Rees and his then-PhD-student Mathis Wackernagel (introduced in their 1996 book 'Our Ecological Footprint'), expressing human demand on ecosystems as the amount of biologically productive land and water area required to produce what a population consumes and absorb its waste — the primary tool used to estimate the extent of humanity's ecological overshoot."@en ;
    thinkr:influencedBy tgs:Persona.WilliamRees, tgs:Persona.MathisWackernagel .

#############################################
# ADDED 2026-08-13 — the overall action framework from Frankly_132
# "What to Do as the World Falls Apart," which the episode's own
# transcript explicitly labels "a first public draft."
#############################################

tgs:Concept.FrameworkForAction a thinkr:Concept, thinkr:HagensConcept, owl:NamedIndividual ;
    skos:prefLabel "Framework for Action"@en ;
    skos:definition "Hagens' own real, explicitly-labeled 'first public draft' framework for what to actually do in response to the more-than-human predicament — introduced in Frankly_132, gestated over roughly a decade and organized under the pressure of real, live world events (the 2026 Iran war/Strait of Hormuz crisis). Structured as 4 levels: a personal foundation of inner work, 'Finding the Others' (trusted networks and shared vocabulary), 6 interdependent thinkr:InterventionFront individuals, and a thinkr:ResponsePhase timeline axis of 3 genuinely overlapping (not strictly sequential) phases that cuts across all 6 Fronts."@en ;
    dcterms:source <https://www.thegreatsimplification.com/frankly-original/132-what-to-do-as-the-world-falls-apart> ;
    thinkr:hasFront 
        tgs:InterventionFront.Infrastructure, 
        tgs:InterventionFront.PovertyAndDisplacement, 
        tgs:InterventionFront.EcologicalInterventions,
        tgs:InterventionFront.CivicResilienceAndGovernance, 
        tgs:InterventionFront.CultureAndMeaning, 
        tgs:InterventionFront.EconomicTransition ;
    thinkr:hasPhase tgs:ResponsePhase.StabilityWindow, tgs:ResponsePhase.BendNotBreak, tgs:ResponsePhase.StableAttractor ;
    skos:scopeNote "Real, direct evidence for the sequencing/parallel-construction stance, worth preserving: Hagens explicitly engages with the anti-capitalist/decolonial critique that structural transformation must precede any other intervention, states real sympathy for it, but argues explicitly for building new structures while the old ones still stand rather than waiting for a precondition that would mean 'waiting forever.'"@en .

#############################################
# ADDED 2026-08-13 — a real, cross-episode pattern MJSullivan
# identified and asked to be captured explicitly, synthesized from
# independently-recorded episodes across different guests and years —
# NOT one single named/branded framework Hagens has given one
# consistent term to himself the way Carbon Pulse or the Great
# Simplification are, so modeled as thinkr:Concept only, NOT
# thinkr:HagensConcept (that subclass requires Hagens' own genuinely
# distinctive coining, per its own class definition — this doesn't
# meet that bar honestly, however real and recurring the pattern is).
#############################################

tgs:Concept.DistributedAgency a thinkr:Concept, owl:NamedIndividual ;
    skos:prefLabel "Distributed Agency, Not Saviors"@en ;
    skos:definition "A real, recurring pattern across independently-recorded episodes: meaningful change comes from ordinary, distributed action rather than a singular hero or savior figure. Direct textual evidence spans multiple episodes, not one coined term: Frankly_58's own real closing reframe (Sam and Gollum, not Frodo, as the actual Catalysts who changed Lord of the Rings' outcome — 'you never know when your actions could shift the larger story'); Frankly_132's direct claim that reluctance to lead 'might be a good indication that you could be a good leader tomorrow,' paired with its critique that modern systems select for Dark Triad traits in those who actively seek leadership; RR-17's two guests independently converging on 'find like-minded people close to home' as their practical closing advice, rather than pointing toward a movement or a leader; and the real, structural logic of Buckminster Fuller's trim-tab principle (small, precisely-placed, unglamorous leverage redirecting something enormous), which is also the real source of Priscilla Trịnh's own 'Trintab' nickname from RR-9."@en ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:scopeNote "Identified and named as a real pattern by MJSullivan during this session, not something Hagens has explicitly unified under one term himself — worth being honest about that distinction even though the pattern itself is real and evidence-grounded across genuinely independent sources."@en ;
    .

#############################################
# added 2026-08-24 
#############################################

tgs:Concept.PersonalAgency a thinkr:Concept, owl:NamedIndividual ;
    skos:prefLabel "Personal Agency"@en ;
    skos:definition "The lived experience that some part of one's life, attention, and time is genuinely one's own to choose — distinct from tgs:Concept.DistributedAgency (a collective/systemic pattern about who drives change). Frankly_129's own organizing term, scientifically grounded via learned-helplessness/self-efficacy research (the nervous system learning whether effort produces outcomes). Frankly_142 directly ties it to dread: 'dread is the experience of being acted upon by a future you cannot influence, and agency is the opposite stance.'"@en ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:scopeNote "NOT to be confused with the existing tgs:Concept.DistributedAgency ('Distributed Agency, Not Saviors') — that concept is about collective action replacing savior-figures; this one is the individual psychological/nervous-system capacity the Staying Human series' own Part 1 is entirely about."@en ;
    .

tgs:Concept.Dread a thinkr:Concept, owl:NamedIndividual ;
    skos:prefLabel "Dread"@en ;
    skos:definition "A physiological body state, not merely a feeling — chronic anticipatory threat-response activation (amygdala/HPA-axis/cortisol) triggered by slow-moving, abstract, unresolvable risk the nervous system cannot discharge through fight-or-flight. Frankly_142's own central subject; grounded in real research on 'extreme dreaders' (~28% of subjects who preferred immediate stronger pain over waiting for milder pain) and climate psychiatrist Lise Van Susteren's 'pre-traumatic stress.'"@en ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:scopeNote "Directly cross-referenced in Frankly_143 as 'full dread... viewed from a slightly different angle' from tgs:Concept.FutureCapture — the two are presented as the same underlying phenomenon (DMN dominance with civilizational content) described from two angles, not two separate claims, matching this graph's existing 'two facets, not two concepts' pattern (see Concept.NarrativeAsActiveInference)."@en ;
    .

tgs:Concept.Presence a thinkr:Concept, owl:NamedIndividual ;
    skos:prefLabel "Presence"@en ;
    skos:definition "Frankly_143's own central subject: full attentional engagement with the present moment, framed as the destination dread transforms into 'when fully metabolized' (per Frankly_142's own closing) and as the ground from which any real response to the metacrisis must be taken."@en ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:scopeNote "Real prior art cited directly in the transcript across contemplative traditions (Thich Nhat Hanh, the Christian contemplative 'sacrament of the present moment') and neuroscience (default mode network research) — treated here as one Concept with converging support, not split by tradition."@en ;
    .

tgs:Concept.DefaultModeNetwork a thinkr:Concept, owl:NamedIndividual ;
    skos:prefLabel "Default Mode Network"@en ;
    skos:definition "The brain-region network active during self-referential processing, theory of mind, mind-wandering, and mental time travel — anti-correlated with the task-positive network (TPN), which handles direct engaged attention. Chronic DMN dominance is measurably linked to reduced hippocampal grey matter, higher anxiety/depression, and diminished sensory processing."@en ;
    dcterms:subject tgs:Subject.SystemsScience ;
    skos:scopeNote "Only the graph's second real citation of DMN research — tgs:Interview.TGS_191_TaylorGuthrie is the first, explicitly named in Frankly_143's own transcript as 'the only prior TGS coverage.' The Task Positive Network (TPN), DMN's real anti-correlated partner, is deliberately folded into this definition rather than minted separately this pass."@en ;
    .

tgs:Concept.FutureCapture a thinkr:Concept, thinkr:HagensConcept, owl:NamedIndividual ;
    skos:prefLabel "Future Capture"@en ;
    skos:definition "Nate's own coined term (Frankly_143): the state where 'the future is so loud and so vivid and so saturated with implications... that the present just can't compete with it' — the future becomes 'a place we live' rather than visit, and the present becomes 'a kind of waiting room.' Explicitly framed as the same underlying phenomenon as tgs:Concept.Dread, viewed from the angle of what it does to attention rather than what it feels like."@en ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    .

tgs:Concept.EcologicalAwakening a thinkr:Concept, owl:NamedIndividual ;
    skos:prefLabel "Ecological Awakening"@en ;
    skos:definition "Plotkin's own central term, and this episode's own title concept: a felt, experiential (not merely intellectual) shift from experiencing an 'invisible wall' between oneself and the rest of the living world to experiencing kinship with all of it — 'the earth community' — often accompanied by real grief for the years lived without that awareness. Plotkin estimates roughly 20-25% of people have had this experience. Distinct from taking a class in ecology: cognitive understanding without the felt shift doesn't count."@en ;
    dcterms:subject tgs:Subject.EcologyAndEnvironment ;
    skos:scopeNote "Direct evidence this recurs beyond one episode: Plotkin himself ties it explicitly to Joanna Macy's Great Turning (third dimension — a shift in values and consciousness) within the same conversation."@en ;
    thinkr:influencedBy tgs:Persona.BillPlotkin ;
    .

tgs:Concept.EcocentricDevelopmentalWheel a thinkr:Concept, owl:NamedIndividual ;
    skos:prefLabel "Ecocentric (Soulcentric) Developmental Wheel"@en ;
    skos:definition "Plotkin's eight-stage model of healthy human development, each stage paired with a human archetype and an earth archetype: (1) Innocent in the Nest — early childhood; (2) Explorer in the Garden — middle childhood; (3) Thespian at the Oasis — early adolescence; (4) Wanderer in the Cocoon — late adolescence, the stage of soul initiation, which 'most contemporary people never reach'; (5) Apprentice at the Wellspring — early adulthood; (6) Artisan in the Wild Orchard — late adulthood; (7) Master in the Grove of Elders — early elderhood; (8) Sage in the Mountain Cave — late elderhood. Explicitly contrasted with an 'egocentric wheel' modeling the stages most contemporary people actually go through instead, most of them stalled in an unhealthy version of stage 3."@en ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:scopeNote "Plotkin's own real prior art cited as convergent, non-Western evidence for this model: Malidoma Somé's account of Dagara initiation rites, Martín Prechtel's account of Tzutujil Maya culture, and Gregory Cajete's writing on Native American educational traditions — none of the three built as Personas this pass."@en ;
    thinkr:influencedBy tgs:Persona.BillPlotkin ;
    .

tgs:Concept.ArrestedHumanDevelopment a thinkr:Concept, owl:NamedIndividual ;
    skos:prefLabel "Arrested Human Development"@en ;
    skos:definition "Plotkin's own direct causal claim, stated as this episode's central thesis: 'the root cause [of the metacrisis] is arrested human development' — also termed 'systemic human development oppression.' Distinct from tgs:Concept.Metacrisis itself (the pattern of interconnected crises) by proposing a specific generative mechanism behind it, located in human developmental psychology rather than economic or ecological systems directly."@en ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    thinkr:relatesTo tgs:Concept.Metacrisis ;
    skos:scopeNote "A real, single-episode claim — not yet independently corroborated elsewhere in this graph. Flagged for revisiting if it recurs, matching this graph's own recurrence-based minting discipline."@en ;
    thinkr:influencedBy tgs:Persona.BillPlotkin ;
    .

tgs:Concept.GreatTurning a thinkr:Concept, owl:NamedIndividual ;
    skos:prefLabel "The Great Turning"@en ;
    skos:definition "Joanna Macy's framework, explained by Plotkin in real depth (not a passing citation): the shift from an 'Industrial Growth Society' toward a 'life-sustaining civilization,' unfolding across three simultaneous dimensions — (1) holding actions to save as much life as possible now, (2) building the structural and technical foundations for healthier systems (food, energy, governance), and (3) a shift in consciousness and values, which Plotkin explicitly connects back to tgs:Concept.EcologicalAwakening and his own developmental wheel. Macy pairs this with 'the Great Unraveling' — the ongoing collapse of existing systems — as two faces of the same real historical moment, not opposed processes."@en ;
    dcterms:subject tgs:Subject.SystemsFrameworks ;
    skos:scopeNote "Real external source, not a Hagens or Plotkin coinage — Joanna Macy is cited directly by name throughout as its originator. Macy herself not yet built as a Persona in this graph (cited here and, separately, in Frankly_142's own scopeNote as a deferred candidate)."@en ;
    thinkr:influencedBy tgs:Persona.JoannaMacy ;
    .

# added 2026-08-25

tgs:Concept.SupplyChainFragility a thinkr:Concept, owl:NamedIndividual ;
    skos:prefLabel "Supply Chain Fragility / Pinch Points"@en ;
    skos:definition "Modern global supply chains are far more concentrated, specialized, and fragile than they appear — a small number of hyper-specialized, often invisible 'pinch points' (a single factory, a single region, a single material) can be genuinely load-bearing for enormous downstream systems, disproportionate to their own small economic footprint. Real evidenced cases: the 1915 UK 'Glass Famine' (an entire domestic industry allowed to wither, then found existentially necessary within a few years, per tgs:Interview.TGS_127_EdConway); a single Birmingham factory supplying roughly half the world's automotive rearview-mirror electrodes; the 2011 Fukushima earthquake halting Ford's US truck production over a single specialized paint pigment. The mechanism Ed Conway identifies: modern comparative-advantage-driven specialization increases aggregate efficiency while increasing structural fragility — 'you have these factories which are uber-specialised... and they're pinch points. Until those pinch points explode, you don't really know about it.'"@en ;
    dcterms:subject tgs:Subject.SystemsFrameworks ;
    thinkr:influencedBy tgs:Persona.EdConway ;
    thinkr:relatesTo tgs:Concept.JevonsParadox ;
    skos:scopeNote "Real, deliberate general-purpose applicability, per MJSullivan's own stated reason for selecting this episode 2026-08-24: this concept is a candidate response/caveat to a wide range of articles about growth, consumption, or globalized production, not narrowly scoped to energy/climate topics — directly relevant to the tng-app design work's 'systemic reframing' step from this same session."@en ;
    .
tgs:Concept.EarlyAnthropoceneHypothesis a thinkr:Concept, owl:NamedIndividual ;
    dcterms:source <https://en.wikipedia.org/wiki/Early_anthropocene> ;
    skos:definition "William Ruddiman's real, own hypothesis: human-caused greenhouse gas increases began roughly 8,000 years ago through the intensive farming of early agrarian societies, not with 18th-century industrialization — and that this early human activity likely forestalled an incipient ice age already due to begin, per natural Milankovitch-cycle variation."@en ;
    skos:prefLabel "Early Anthropocene Hypothesis"@en ;
    thinkr:influencedBy tgs:Persona.WilliamRuddiman ;
    skos:scopeNote "Added 2026-08-31. Real, direct citation confirmed via Peter Brannen's own TGS_210 appearance. Given a real, dedicated own Wikipedia page (a genuine named academic hypothesis, not just a personal essay or theory), this Concept + a minimal Persona for Ruddiman (matching the same pattern already established for tgs:Persona.HowardOdum on Concept.MaximumPowerPrinciple) felt like the right, proportionate structure — unlike the other real intellectual-influence figures added the same day (Georgescu-Roegen, Kümmel, Boulding, Shepard, Jackson), who remain Human-only with no forced formal link."@en ;
    .

tgs:Concept.Ecolate a thinkr:Concept, owl:NamedIndividual ;
    dcterms:source <https://www.garretthardinsociety.org/articles/art_ecolate_view_human_predicament.html> ;
    skos:definition "Garrett Hardin's real, coined term for ecological literacy — a third literacy alongside 'numerate' (knowing numbers) and 'literate' (knowing words and grammar). Being ecolate means habitually asking 'and then what?' of any proposed action, tracing second-, third-, and nth-order consequences beyond the immediate, narrow-boundary benefit. Real, direct source for this show's own recurring 'wide-boundary thinking' vocabulary."@en ;
    skos:prefLabel "Ecolate (Ecological Literacy)"@en ;
    thinkr:influencedBy tgs:Persona.GarrettHardin ;
    .

tgs:Concept.IslandsOfCoherence a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.SystemsScience ;
    skos:definition "Ilya Prigogine's real concept, directly and repeatedly paraphrased by Nate across multiple episodes: when a complex system is far from equilibrium, small 'islands of coherence' within it have the capacity to shift the entire system to a higher order. Used throughout this show as a direct argument for the real, disproportionate potential impact of small, genuinely coherent groups or individuals during periods of systemic instability."@en ;
    skos:prefLabel "Islands of Coherence"@en ;
    thinkr:influencedBy tgs:Persona.IlyaPrigogine ;
    skos:scopeNote "Real, independently cited across at least three already-built episodes before this Concept itself existed: Frankly_65, Frankly_98, and Lisi Krall's TGS_86 — the same recurrence pattern that made David Sloan Wilson and Lisi Krall worth prioritizing as unbuilt figures earlier this session, applied here to a recurring concept rather than a recurring person."@en ;
    .

tgs:Concept.BioticPump a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.EcologyAndEnvironment ;
    skos:definition "Real theory co-developed by Anastassia Makarieva and the late Victor Gorshkov: forests actively drive atmospheric moisture transport and rainfall patterns over land, rather than being passive recipients of rain — condensation over dense forest canopy lowers air pressure, pulling moist ocean air inland. Challenges conventional climate models to treat vegetation as a dynamic driver of atmospheric processes, not a fixed background feature."@en ;
    skos:prefLabel "The Biotic Pump"@en ;
    thinkr:influencedBy tgs:Persona.AnastassiaMakarieva, tgs:Persona.VictorGorshkov ;
    skos:scopeNote "Real, previously-missing Concept, flagged explicitly as a gap in Andrew Millison's own TGS_178 scopeNote ('the mechanism is real and substantively discussed but kept as prose... no dedicated Concept.BioticPump exists yet') — resolved directly here via Makarieva's own real, first-hand TGS appearance, the theory's real originator."@en ;
    .

tgs:Concept.PlanetaryBoundaries a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.EcologyAndEnvironment ;
    skos:definition "Real, foundational scientific framework led by Johan Rockström and colleagues (originally published 2009), identifying nine distinct Earth-system processes with critical thresholds — climate change, biosphere integrity, land-system change, freshwater use, biogeochemical flows, ocean acidification, atmospheric aerosol loading, stratospheric ozone depletion, and novel entities (chemical pollution) — within which humanity and the biosphere can continue to develop safely. As of the framework's own 2023 update, six of nine boundaries have been exceeded."@en ;
    skos:prefLabel "Planetary Boundaries"@en ;
    thinkr:influencedBy tgs:Persona.JohanRockstrom ;
    skos:scopeNote "Real, genuinely surprising gap closed here — this framework is referenced constantly throughout this graph (dozens of already-built episodes cite 'planetary boundaries' directly) but had no dedicated Concept individual until Rockström's own real TGS appearance was built."@en ;
    .

tgs:Concept.RelativeFitnessSpiteFramework a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:definition "Nate's own real, structured four-quadrant behavioral framework, grounded in the evolutionary distinction between relative fitness (reproductive success measured against competitors, the real evolutionary currency) and absolute fitness (raw offspring count or physical condition alone). The four quadrants: selfishness (cost to a competitor, benefit to self), cooperation (mutual benefit), altruism (cost to self, benefit to a genetically unrelated other — rare in nature, though reciprocal altruism is common in humans), and spite (a real, direct cost to oneself, provided it imposes a greater cost on a competitor)."@en ;
    skos:prefLabel "Relative Fitness / Spite Framework"@en ;
    skos:scopeNote "Real, central framework of Frankly_11, directly extended there from individual/animal behavior to nation-state behavior (spite as a real, direct driver of nuclear war risk)."@en ;
    .

tgs:Concept.BiophysicalPyramid a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.EconomicsAndMonetary ;
    skos:definition "Nate's own real, three-layer framework for reading news and economic events: a top financial layer (prices, salaries, debt, markets — what most people interact with daily and often mistake for the entire economy), a middle biophysical layer (energy, materials, minerals, supply chains — the connective tissue turning abstract prices into real goods), and a bottom biosphere layer (soil, water, forests, climate — the largely invisible, unbilled services underpinning everything above it). A 'biophysical phase shift' occurs as financial claims increasingly outpace what the lower two layers can actually support, forcing the deeper layers into visibility."@en ;
    skos:prefLabel "The Biophysical Pyramid"@en ;
    skos:scopeNote "Real, foundational framework first laid out at length in Frankly_121, the inaugural episode of Nate's own Wide Boundary News series — later Wide Boundary News installments (e.g. Frankly_124, already built) apply this same lens without necessarily re-explaining it."@en ;
    .

tgs:Concept.BiophysicalGauntlet a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.EROIAndEnergyQuality ;
    skos:definition "Nate's own real, coined term for a structural bind facing fossil fuel extraction as resource quality declines: consumers and policymakers want low prices, but producers need increasingly higher prices to profitably extract lower-quality, more remote, or more difficult resource tranches — a real, direct tension between affordability and viable extraction that intensifies as easier reserves deplete."@en ;
    skos:prefLabel "The Biophysical Gauntlet"@en ;
    skos:scopeNote "Real, direct citation confirmed across at least two already-built episodes (Craig Tindale's TGS_207, Frankly_124) before this episode — Frankly_121 — was itself built; this episode appears to be an early, if not the first, real spoken articulation of the term in this graph's own source material."@en ;
    .

tgs:Concept.LifeEthic a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:definition "Nate's own real, direct nine-point ethical framework, first laid out in a 2021 Earth Day talk and repeated in Frankly_62: life existing is preferable to no life; more kinds of life are preferable to fewer; vibrant, complex ecosystems are preferable to fragmented, brittle ones; ecosystems with large, complex life are preferable to purely microscopic ones; ecosystems supporting conscious minds are preferable to those without; maximizing existence, happiness, love, and understanding while minimizing suffering is preferable; the future is real in the same sense the present is real, and is shaped by present causality; what fits these preferences may be considered good, what doesn't may be considered evil; and good should be maximized, evil minimized."@en ;
    skos:prefLabel "The Life Ethic"@en ;
    .

tgs:Concept.SevenDialsOfInstitutionalPsychopathy a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:definition "Nate's own real, direct framework mapping Greg Elliott's Psychopathic Selection Hypothesis onto seven distinct behavioral 'dials,' each set toward genuine cooperation in small-scale ancestral human communities but flipped toward extraction at civilizational scale: (1) repeated interaction, (2) visibility, (3) attribution, (4) delay, (5) exit costs and mutual dependence, (6) who writes the rules, and (7) symbols and proxies (money, GDP, and other measures that can decouple from the physical reality they're meant to represent). Argues all seven dials flipped simultaneously, with the sixth locked in place, together constitute the economic Superorganism — while noting the same dials often remain set the 'tribal way' at the scale of one's own street, town, or bioregion."@en ;
    skos:prefLabel "The Seven Dials of Institutional Psychopathy"@en ;
    skos:scopeNote "Real, direct follow-on framework from Frankly_157, itself a direct integration of Greg Elliott's real Psychopathic Selection Hypothesis (already built, TGS_231) with Nate's own earlier Frankly_108 (already built) distinction between individual human prosociality and aggregate institutional behavior."@en ;
    .

tgs:Concept.SupernormalStimuli a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:definition "Nate's own real, recurring teaching concept: a modern invention or artifact that hijacks ancestral, evolved brain circuitry in a deleterious, maladaptive way relative to the environment that circuitry originally evolved for — vastly exceeding, in scale or intensity, anything the ancestral environment could have produced. Nate's own real, established example is money itself, particularly the US dollar; in a real, direct extension made during a conversation with Chuck Watson, he proposes nuclear weapons as an even larger supernormal stimulus, given their real, many-orders-of-magnitude greater destructive scale relative to any weapon available in humanity's tribal past."@en ;
    skos:prefLabel "Supernormal Stimuli"@en ;
    skos:scopeNote "Real, foundational concept underlying Nate's own recurring teaching material, directly extended from money to nuclear weapons during TGS_4's real, chronologically third conversation with Chuck Watson (TGS_17)."@en ;
    .

tgs:Concept.CrudeOil a thinkr:Concept, owl:NamedIndividual, skos:Concept ;
    dcterms:subject tgs:Subject.EnergySystems ;
    skos:broader tgs:Subject.EnergySystems ;
    skos:prefLabel "Crude Oil"@en ;
    skos:definition "Real, foundational fossil energy commodity — liquid at room temperature, exceptionally energy-dense, and structurally irreplaceable at current civilizational scale."@en ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
        thinkr:hasAlternateTermType tgs:AlternateTermType.ExactMatch ;
        skos:prefLabel "The Spice"@en ;
        skos:scopeNote "Nate's own real, deliberate, recurring analogy, borrowed directly from Frank Herbert's Dune: crude oil functions for modern industrial civilization precisely as 'the spice' (melange) does for Dune's fictional universe — a singular, indispensable resource whose flow, if disrupted, threatens the stability of the entire system built on top of it. ExactMatch, not Related: in Nate's own usage the two terms refer to the identical real-world referent (crude oil itself), not a broader or mechanism-adjacent concept — he substitutes one term for the other directly, not alongside it. Real, confirmed recurring usage, not a one-off phrase: directly used in both Frankly_61 ('The Strait of Hormuz and the Spice,' already built — the analogy's own real, titular framing) and TGS_94 (Chuck Watson, already built — 'the oil, the spice flow... to use a Dune reference'), independently confirming this is Nate's own genuine, repeated rhetorical device rather than a single passing joke." ],
      [ a thinkr:AlternateTerm ;
        thinkr:hasAlternateTermType tgs:AlternateTermType.ExactMatch ;
        skos:prefLabel "Fossil Sunlight"@en ;
        skos:scopeNote "Nate's own real, recurring term for crude oil and natural gas, framing them directly as ancient solar energy captured by photosynthesis over geologic time and concentrated into an extraordinarily dense, portable form — a genuinely deeper, more literal characterization than 'fossil fuel,' emphasizing the energy's real ultimate origin rather than just its age or combustibility. ExactMatch, not Related: refers to the identical real-world referent (crude oil/gas), substituted directly for it. Real, confirmed recurring usage, not a one-off phrase: directly found in TGS_233's own real transcript (already built) — 'the whole thing is powered by fossil sunlight and non-renewable minerals' — and, per MJSullivan's own direct site search, also used in the titles/content of Frankly_39 ('Just Stop Oil Part 2 — Oil is the Economy') and Frankly_137 ('Everything is About to Change: The World After Cheap Energy'), neither yet built in this graph." ] .

tgs:Concept.SevenFundamentalDriversOfOvershoot a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.OvershootAndLimits ;
    skos:prefLabel "The Seven Fundamental Drivers of Overshoot"@en ;
    skos:definition "Nate's own real, structured seven-part framework explaining why humanity exceeds its planetary carrying capacity, first laid out in full in Frankly_68: (1) the Carbon Pulse — millions of years of stored ancient energy injected into the economic system over a geologically brief span; (2) Money Alchemy — monetary creation that draws consumption forward in time while neglecting the real, unrecorded 'third and fourth book entries' of non-renewable resource depletion and ecosystem damage; (3) Outsourced Governance to the economic Superorganism, reinforced by institutional hierarchies that systematically promote confident, optimistic individuals regardless of ecological accuracy; (4) a real, species-wide Lack of Recognition of Overshoot, stemming from widespread ecological illiteracy even among the otherwise numerate and literate; (5) the Positive Feedback of Status and Consumption, where more money and more conspicuous consumption function as culturally aspirational defaults; (6) Dopamine Superhighways, where habituated consumption and technology use bias everyday micro-decisions toward higher-energy, higher-resource choices; and (7) Cognitive Dissonance, the real, direct psychological mechanism by which people closest to a given risk often profess the least concern about it, since fully recognizing the risk would be too painful to hold alongside their own way of life."@en ;
    skos:scopeNote "SUPERSEDED 2026-09-04, per MJSullivan's own direct editorial decision for the WWNS series: this framework predates, and is treated going forward as superseded by, Nate's own later, more structured Framework for Action (tgs:Monologue.Frankly_132_FrameworkForAction, already built). WWNS content should cite the Framework for Action instead of this Concept going forward. Kept here as a real record of what Nate actually said, not deleted. Real, foundational framework, first delivered in full in Frankly_68 (already built) — Nate's own real, direct disclosure notes he recorded this Frankly with a 103°F fever the night before, calling it a 'fever-induced reflection.'"@en ;
    .

tgs:Concept.TenLensesOfInformationBifurcation a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:prefLabel "The Ten Lenses of Information Bifurcation"@en ;
    skos:definition "Nate's own real, structured set of ten dichotomies shaping how information is produced and received in modern media, first laid out in full in Frankly_57: (1) speaking vs. writing, (2) sensational vs. educational, (3) simple vs. complex, (4) the Fourth Estate vs. the Fifth Estate, (5) Fifth Estate crazy vs. Fifth Estate reasonable, (6) agenda vs. authentic, (7) socially acceptable vs. cancelable, (8) publicly-available vs. privately-sold information, (9) what is heard vs. what is said, and (10) identity vs. learning."@en ;
    skos:scopeNote "Real, foundational framework, first delivered in full in Frankly_57 (already built), prompted directly by real, documented audience reaction to Nate's own prior episode with Chuck Watson on NATO (already built, TGS_114)."@en ;
    .

tgs:Concept.GoldilocksTechnology a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.EnergySystems ;
    skos:prefLabel "Goldilocks Technology"@en ;
    skos:definition "Nate's own real, coined term for technology calibrated between two failure modes: not too 'hot' (dopaminergic, resource-intensive gadgets that deepen dependence on non-renewable inputs) and not too 'cold' (a naive retreat to stone-age tooling that ignores real human problem-solving capacity). First laid out as a preliminary checklist in Frankly_69, considering real governance incentives, true-cost pricing of externalities, material and supply-chain constraints, and a technology's actual relationship to the biosphere."@en ;
    skos:scopeNote "Real, direct extension of a concept already explored in a real, existing TGS episode on Goldilocks Technology, directly cross-referenced in this Frankly's own real show notes; that companion episode itself is not yet built in this graph."@en ;
    .

tgs:Concept.TenThingsWorthMoreThanGold a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.EconomicsAndMonetary ;
    skos:prefLabel "Ten Things Worth More Than a Pound of Gold"@en ;
    skos:definition "Nate's own real, structured countdown of things he argues hold greater real value than gold, first laid out in full in Frankly_106, moving from purely financial comparisons toward increasingly intangible ones: $50,000 in cash (worth more than a pound of gold at real, then-current prices), 100 pounds of silver, roughly half a Bitcoin, land, friends and social networks, freedom, sanity, integrity, the web of life, and — at the top — life itself."@en ;
    skos:scopeNote "Real, foundational framework, first delivered in full in Frankly_106 (already built). Nate directly distinguishes value from liquidity and resilience as three separate lenses: gold and cash are liquid but not necessarily resilient, while land, integrity, and the web of life are resilient but comparatively illiquid — arguing resilience, not liquidity, is what actually determines what carries people through real hardship."@en ;
    .

tgs:Concept.CulturalMitochondria a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:prefLabel "Cultural Mitochondria: Ten Qualities That Could Change the Future"@en ;
    skos:definition "Nate's own real, coined framework, laid out in full in Frankly_98, for ten personal traits he speculates could seed a genuinely more resilient and cooperative culture after the economic Superorganism's own eventual splintering — framed directly as 'cultural mitochondria,' small, distributed, largely invisible units of capacity, extending Marvin Harris's own real cultural-materialism pyramid (infrastructure, structure, superstructure, already built) to the real inner world of individuals the original framework left out. Nate's own real, numbered list, given deliberately 'in no particular order' despite the numbering: (0) self-care as a real neurobiological precondition, not indulgence; (1) grounding, staying tethered to body and breath; (2) a post-tragic mindset, metabolizing grief into daily rhythm rather than avoiding it; (3) being networked, decentralized and mycelial rather than hierarchical, 'finding the others'; (4) co-regulation with others via real polyvagal safety, not just individual regulation; (5) systems thinking / wide boundary thinking; (6) restraint, deliberately saying no to consumption and supernormal stimuli; (7) being status-free or status-aware rather than status-driven; (8) genuinely feeling interconnection with the web of life, not just knowing it intellectually; (9) embracing emergence over fixed outcomes, seeding present conditions rather than planning a final result; and (10) play and joy, explicitly named optional yet real and important."@en ;
    skos:scopeNote "Real, foundational framework, first delivered in full in Frankly_98 (already built). Real, honest quirk worth preserving rather than silently correcting: Nate's own numbering runs zero through ten — eleven real labeled positions — for what he calls 'ten traits,' a genuine inconsistency in his own live delivery, not a transcription error. Real, direct grounding citations confirmed: Francis Weller's own already-built TGS appearance for grief work; Mark Gafni or Zak Stein (Nate himself is uncertain which) for the pre-tragic/post-tragic framing; David Sloan Wilson and E.O. Wilson for multilevel selection theory; and Ilya Prigogine's own real 'islands of coherence' framing (already a formal Concept in this graph), directly quoted in this episode's own real closing line, though the transcript itself mis-renders his name as 'IA Priya Jean.'"@en ;
    .

tgs:Concept.TenCoreMythsOfBusinessSchools a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.EconomicsAndMonetary ;
    skos:prefLabel "The Ten Core Myths Still Taught in Business Schools"@en ;
    skos:definition "Nate's own real, structured critique, delivered in full as a countdown in Frankly_99, of ten foundational assumptions he argues mainstream economics and MBA education still teaches despite their real, direct conflict with biophysical reality — explicitly framed as values-neutral description, not preference. His own real, numbered countdown: (10) price equals value, when willingness to pay actually reflects wealth, not need or importance; (9) humans are rational utility-maximizing homo economicus, when real humans are tribal, status-seeking, and intensely social; (8) the supply curve slopes upward, when most modern production, especially digital and tech, gets cheaper at scale, concentrating power rather than sustaining competition; (7, his own real, direct 'two decades unpacking' subject) energy is a substitutable commodity like any other, omitted entirely from the real, foundational Cobb-Douglas production function despite underpinning every input to it; (6) money is lent from prior savings, when most money is actually created new at the moment a loan is issued (endogenous money creation); (5) debt is a neutral intertemporal tool, when it is actually a claim on future energy and materials that may not materialize; (4) GDP is the primary measure of national success, when it tallies transaction volume regardless of whether the underlying activity helps or harms; (3) the environment is a subset of the economy, when the economy is in fact a wholly-owned subset of the biosphere; (2) the invisible hand reliably produces the best collective outcomes, a term Adam Smith himself used only once and in a different context than it's now popularly applied; and (1) economic 'laws' are timeless and universal like physics, when they are context-bound assumptions built entirely within one narrow, roughly 150-year window of fossil-fuel abundance."@en ;
    skos:scopeNote "Real, foundational framework, first delivered in full in Frankly_99 (already built). Real, direct quantitative grounding for myth 7: one barrel of crude oil contains roughly 1,700 kilowatt-hours of real work potential — the physical equivalent of about 11 years of full-time human labor, handicapped to roughly 4-5 years once machine energy-conversion inefficiency is real, directly accounted for; at current real global consumption (~100 billion barrels of oil-equivalent annually across oil, coal, and gas), Nate directly calculates this as equivalent to adding a real 500-billion-person labor force on top of an actual global human workforce of roughly 5 billion. Real, direct named critique: Alan Blinder, real economist, former Federal Reserve Vice Chairman and textbook author, is directly named and criticized for continuing to teach upward-sloping supply curves in his own textbook despite his own published research finding barely any firms still exhibit that pattern. Real, direct forward reference: Nate closes by previewing Frankly #100 as a real, planned 'ask me anything' format, not yet built in this graph."@en ;
    .

tgs:Concept.TwentyControlKnobs a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:prefLabel "The 20 Control Knobs for a Post-Growth Future"@en ;
    skos:definition "Nate's own real, structured framework, delivered in full in Frankly_64, of twenty 'volume knobs' shaping how the future unfolds — ten real, external macro trends largely outside individual control, and ten real, internal responses within it. The ten external trends: (1) a cooler world trending warmer; (2) freedom trending toward constraints; (3) a unipolar world trending multipolar; (4) credit trending toward cash; (5) richer trending toward poorer, with a real sub-knob of equality trending toward inequality; (6) peace trending toward conflict; (7) global trending toward local; (8) unified/collective trending toward isolated/tribal; (9) future-focus trending toward present-focus, as discount rates steepen; and (10) complexity trending toward simplification. The ten internal responses: (1) isolation toward interconnection; (2) a focus on money toward a focus on real capital (health, knowledge, skills, relationships); (3) consumption toward regeneration; (4) a narrow view toward wide-boundary systems thinking; (5) baseload dependence toward deliberate intermittence; (6) technology-as-escape toward technology-as-tool, redirected toward real relationships and place; (7) critique toward awe and wonder; (8) apathy toward goodness; (9) shallow engagement toward depth; and (10) optimizing for social power and status toward optimizing for life itself."@en ;
    skos:scopeNote "Real, foundational framework, first delivered in full in Frankly_64 (already built), recorded the day before Nate left on his own real, annual fishing trip with nine male relatives. Real, direct grounding citations confirmed: Johan Rockström's own real, already-built TGS appearance (TGS-134) on planetary boundaries, directly cited for the 'complexity toward simplification' trend; the already-built Carbon Pulse framework (Frankly-44) underlying several of the external trends; David Wengrow and David Graeber's real book, The Dawn of Everything, discussed directly with real, genuine ambivalence — Nate notes anthropologists he knows have criticized it as politically motivated cherry-picking, while remaining personally agnostic."@en ;
    .

tgs:Concept.SevenPhilosophiesOnTheFuture a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:prefLabel "Seven Philosophies on the Future"@en ;
    skos:definition "Nate's own real, structured typology, delivered in full in Frankly_77, of seven distinct ways people philosophically relate to the future — offered directly as a tool for genuine empathy in conversation, since two people can share the same facts while occupying entirely different categories. (1) 'They don't': survival needs are consuming enough that the future functionally doesn't extend past today or tonight. (2) Extrapolation: too busy or distracted to have really considered it, so the future is simply assumed to continue recent trends unchanged. (3) Cosmic destiny: a genuine, near-religious belief that indefinite growth and expansion beyond Earth is a preordained human destiny, akin to natural law. (4) Degrowth: a clear-eyed understanding of ecological overshoot leading to a purposeful, voluntary choice to shrink the scale of the human enterprise. (5) Collapse/doomerism: a fatalistic, deterministic 'turbocharged' version of degrowth, rooting for or resigned to collapse rather than treating it as one point in a real probability distribution. (6) Nuanced pro-growth: genuinely understanding biophysical limits and civilizational complexity, yet concluding degrowth itself would be catastrophic — complex systems can't gracefully 'back up' — leaving continued growth and innovation as the only viable path despite real risk. (7) Nate's own real position: involuntary degrowth is coming regardless of preference, primarily via financial-system unraveling, making active preparation for a 'Bend Not Break' transition the genuine task, rather than either advocating for or dreading collapse."@en ;
    skos:scopeNote "Real, foundational framework, first delivered in full in Frankly_77 (already built), directly framed as a listening tool: knowing which of the seven categories someone else occupies changes how facts and synthesis will actually land in conversation with them. Real, direct grounding citation confirmed: Frankly_23, 'The Mordor Economy' (already built), directly cited for the financial-credit mechanics underlying category seven's own real, central claim."@en ;
    .

tgs:Concept.SevenKeyQuestionsOnNuclearConflict a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:prefLabel "Seven Key Questions on Nuclear Conflict and Sustainable Futures"@en ;
    skos:definition "Nate's own real, structured set of questions, delivered in full in Frankly_63, on how to think about the NATO-Russia conflict and nuclear risk without either sensationalizing it or ignoring it. Given deliberately starting from a real 'question zero': who is the 'we' that should even be asking these questions? Then: (1) should individuals discuss a risk they seem to have no direct agency over; (2) what would 'winning' this war actually look like, for Russia, for the West, and for the rest of the world; (3) winning for whom — whose real calculus actually governs decisions made by a small number of people who may not share the broader population's interests; (4) what is the conditional probability of any other issue someone cares about resolving well if this conflict doesn't end benignly; (5) how should the concept of war itself be reframed, rather than assumed as an immutable part of the human condition; (6) does breaking the underlying cycle require genuinely new forms of governance, national and international; and (7) how can the Overton window of possible outcomes be expanded beyond the current narrow frame of proxy war, conventional war, and nuclear war, to include cold war, cold peace, or active cooperation."@en ;
    skos:scopeNote "Real, foundational framework, first delivered in full in Frankly_63 (already built). Nate directly states his own real, explicit position before laying out the questions: 'I am not pro-Putin, I am not pro-Russia, I am pro complex life' — his own stated framing, preserved here as his words, not asserted as this graph's own view. Real, direct grounding citations confirmed: Frankly_11's own already-built evolutionary spite/relative-fitness framework (already a formal Concept), directly applied to question three; the already-built Carbon Pulse framework, directly cited for question four's own material-supply-chain concerns."@en ;
    .

tgs:Concept.EightFacesOfAI a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:prefLabel "The 8 Faces of AI"@en ;
    skos:definition "Nate's own real, structured typology, delivered in full in Frankly_96, of eight archetypal ways individual humans may relate to and be shaped by AI as it accelerates — offered directly as a sorting mechanism revealing not just what AI can do, but who people are becoming in response to it. (1) The Meek: lack access to AI, remaining unblended human psychology by circumstance rather than choice, potentially preserving cultural practices untouched by algorithmic influence. (2) The Naive, or Blissful: have access but are unaware or uninterested, making them especially vulnerable to manipulation. (3) The AI Luddites: aware of AI's real risks to embodied human cognition and actively, deliberately resist it. (4) The Pragmatists: a real subset of the Luddites, aware of the pitfalls but using AI begrudgingly to avoid falling behind professionally. (5) The Flexors: use AI performatively, for social status signaling rather than genuine productivity or enjoyment. (6) The Achievers: Nate's own real, stated 'pinnacle' category — disciplined, limiting AI use to roughly 10-15% while maintaining full, embodied human lives: family, fitness, time outdoors, meditation. (7) The Cyborgs: experience cognition as a genuine human-machine hybrid, gaining novel thought patterns while losing others to atrophy, and facing real, direct identity confusion about where human ends and AI begins. (8) The Dissolved: for those with addictive temperaments, AI becomes 'crack cocaine' — real, severe deterioration in physical and mental health, withdrawal from human relationships, and potentially many hours daily in chatbot-based relationships substituting for real human connection."@en ;
    skos:scopeNote "Real, foundational framework, first delivered in full in Frankly_96 (already built). Nate directly predicts the Achievers and the Luddites will fare best as energy and ecological constraints tighten, the Dissolved and Cyborgs worst, and speculates the Meek — 'once overlooked' — could become unexpected teachers once AI itself falters or plateaus."@en ;
    .

tgs:Concept.UltraProcessedInformation a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:prefLabel "Ultra-Processed Information"@en ;
    skos:definition "Nate's own real, direct analogy, coined in full in Frankly_128, comparing AI-generated content to industrially processed food: just as fossil-fuel-powered industrial agriculture made calories cheap and abundant while stripping out nutrient density, AI is making information cheap and abundant — fast, confident, and persuasive — while stripping out the genuinely expensive parts that tether words to reality: measurement, sourcing, expertise, and accountability. Real, direct extension of the analogy: just as food manufacturers engineer a 'bliss point' of salt, sugar, and fat for maximum palatability, AI content is becoming engineered for a real, direct attention-economy equivalent — novelty, polarization, and righteousness blended for maximum engagement, not truth."@en ;
    skos:scopeNote "Real, foundational analogy, first delivered in full in Frankly_128 (already built). Nate directly credits Robert Lustig's own real, already-referenced prior TGS appearance on processed food and addiction as the direct source of the food-system half of the analogy. Real, direct, honest personal detail: Nate states he is personally navigating a restricted diet at the time of recording, drawing the physical-discipline parallel from lived experience, not just theory."@en ;
    .

tgs:Concept.ThreeInformationFilters a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:prefLabel "The Three Information Filters: Is It True? Is It Relevant? Is It Useful?"@en ;
    skos:definition "Nate's own real, direct, practical three-question discipline, proposed in full in Frankly_128 as a genuine first-pass filter for the coming flood of AI-generated content, since no individual can fact-check the whole internet. (1) Is it true? — can the claim be traced to a real, legitimate primary source, data, or an accountable institution or person; if not, it gets a real, direct handicap as unverified rather than outright rejected. (2) Is it relevant? — even a true claim can be noise if it doesn't genuinely change one's understanding, priorities, or decisions; crediting Aza Raskin and Tristan Harris (both already built) directly for the observation that attention itself is becoming the scarce resource. (3) Is it useful? — does engaging with it actually improve judgment or capability, even at a real, small, local scale, or does it merely activate anger, polarization, or a performance of certainty without building genuine capacity."@en ;
    skos:scopeNote "Real, foundational framework, first delivered in full in Frankly_128 (already built), offered directly as a practical companion to tgs:Concept.UltraProcessedInformation — the discipline needed to navigate an information environment increasingly engineered like ultra-processed food."@en ;
    .

tgs:Concept.InServiceOfLife a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.EcologyAndEnvironment ;
    skos:prefLabel "In Service of Life (capital-L vs. lowercase-l)"@en ;
    skos:definition "Nate's own real, direct phrase, delivered in full definitional form in Frankly_92, distinguishing genuine service to Life (capital L — the full, deep-time continuity of complex life on Earth) from 'in service of life' in the lowercase sense (well-intentioned initiatives like wind farms, recycling, or the UN Sustainable Development Goals, which genuinely help but operate at a fundamentally smaller threshold). Rather than define capital-L service directly, Nate offers ten real, direct criteria for what is NOT in service of Life: (1) anything anthropocentric, caring only about human life; (2) anything reductionist, counting species without accounting for symbiosis and biocomplexity; (3) anything favoring simple life over complex life as though they were equivalent; (4) anything current-focused only, ignoring deep time (most climate models stop at 2099); (5) anything land-only-based, ignoring that oceans hold 70% of Earth's living habitat; (6) anything exoplanetary-focused (Mars colonization, immortal robot bodies, mind uploading) that writes off life on Earth itself; (7) anything causing irreversible species extinction; (8) anything allowing existential global threats (nuclear weapons) to continue; (9) interventions that fix one anthropocentric harm while worsening ecological harm overall (curing malaria without addressing the resulting pressure on rainforest habitat); and (10) growing the economic Superorganism itself, as opposed to slowing or shrinking its metabolism."@en ;
    skos:scopeNote "Real, direct origin story: the phrase itself comes from Nora Bateson (already built), relaying words her father Gregory Bateson said to young students roughly 50 years ago — with Rex Weyler (already built) reportedly present at that same real, historical moment. Real, foundational framework, first delivered in full in Frankly_92 (already built)."@en ;
    .

tgs:Concept.FiveHorsemenOf2020s a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.EconomicsAndMonetary ;
    skos:prefLabel "The Four Horsemen"@en ;
    skos:definition "Nate's own real, recurring framework, its name a real, direct allusion to the biblical Four Horsemen of the Apocalypse (Conquest/Pestilence, War, Famine, and Death), naming several simultaneous, structurally connected challenges that must be navigated even if any single one (including AI) were somehow solved. Nate's own count varies across episodes — stated as four in Frankly_83 (financial overshoot, geopolitics/war, the social contract, and complexity) and expanded to five in Frankly_92 (debt, ecological/resource overshoot, geopolitics, the zero-sum game that emerges once global economic growth stalls, and polarization/breakdown of the social contract alongside accelerating ecological breakdown)."@en ;
    skos:scopeNote "Real, recurring framework, referenced directly across multiple already-built episodes in this graph (previously flagged as worth minting in TGS_10's own scopeNote); formalized here from its real, direct enumeration in Frankly_92, with Frankly_83's own earlier four-item version (already built) linked to the same individual given no separate one exists. Real, direct etymological note: 'Four Horsemen' as a phrase for a small number of severe, converging crises is essentially always a direct allusion to the biblical apocalyptic figures (https://en.wikipedia.org/wiki/Four_Horsemen_of_the_Apocalypse), not an independent coinage — Nate's own usage borrows that apocalyptic register deliberately. Nate is direct that even full success in one domain (e.g., AI solving some problems 'in service of life') does not remove the need to navigate the others."@en ;
    .

tgs:Concept.SevenAIMacroRisks a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.EnergySystems ;
    skos:prefLabel "Seven Macro-Risks of Artificial Intelligence"@en ;
    skos:definition "Nate's own real, structured list, delivered in full in Frankly_83, of seven systemic AI risks operating at a societal, not individual, scale — counted down from least to most severe, and grounded in two underlying real, direct mechanisms: 'obligate technology' (a tribe or society that declines to adopt a competitively decisive new technology gets outcompeted regardless of its own preference) and the strong form of Jevons paradox, the backfire effect. (7) Job loss driving further wealth and income inequality, since productivity gains have overwhelmingly accrued to capital owners since the 1970s. (6) A massive new draw on energy and minerals, with a single AI query estimated at 10-100 times a standard web search's energy cost. (5) Turbocharged ecosystem impact, as AI-driven productivity gains feed back into more consumption, not less. (4/3, given as a real, direct numbering slip in the original delivery) The erosion of a shared, agreed-upon truth, as personalized AI systems increasingly reinforce each user's own pre-existing worldview, alongside a real, direct threat to academia's own economic model. (3) A genuine loss of relational humanity, as creativity, love, and attention get increasingly outsourced to machines, pulling people toward what Francis Weller (already built) calls 'secondary satisficers' (gambling, shopping, pornography) at the expense of 'primary satisficers' (real, direct ancestral bonding and shared challenge). (2) A 'Skynet' scenario in which techno-billionaires, government, surveillance, and military power gradually consolidate into the hands of a shrinking few. (1) The literal existential risk of artificial superintelligence itself, directly compared to the ending of Raiders of the Lost Ark — a species reaching for ultimate power that consumes it instead."@en ;
    skos:scopeNote "Real, foundational framework, first delivered in full in Frankly_83 (already built). Nate is real and direct that everything he lists is offered with a genuine 'grain of salt,' explicitly stating he is not an AI expert. Real, direct grounding citation confirmed: obligate technology, from Frankly's own real 'Bend Not Break' series episode two with Daniel Schmachtenberger (already built)."@en ;
    .

tgs:Concept.IdealParentCulturalEcologicalProtocols a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:prefLabel "The Ideal Parent, Cultural, and Ecological Tether Protocols"@en ;
    skos:definition "Nate's own real, direct extension, developed in full in Frankly_95, of Daniel P. Brown's (already built) real, clinical Ideal Parent Figure Protocol — a visualization of the hypothetical parents every child needs (safety, being seen, comfort, delight, and encouragement to take risks and become oneself) — outward to two further, speculative registers. The Ideal Cultural Protocol asks what a healthy culture, currently missing, might provide: belonging (grounded in place and mutual obligation), continuity (intergenerational memory and mythos), ritual and rhythm (collective practices marking life's passages), shared purpose (a coherent cultural north star), and embedded wisdom (practical, ecological, moral knowledge passed on orally, not optimized for clicks). The Ideal Ecological Tether Protocol asks what direct connection to the natural world, largely lost under modern conditions, once provided: attunement (sensory aliveness to one's own place and its seasons), kinship (treating the up to 10 million other species on Earth as relatives, not resources), stewardship (acting as guardian rather than owner or extractor), gratitude (reverent awareness of freely-given ecosystem functions), and constraint (the wisdom to recognize enough and live within one's land's real carrying capacity)."@en ;
    skos:scopeNote "Real, foundational framework, first delivered in full in Frankly_95 (already built). Nate is real and direct that he originated this extension himself while reflecting on a real, personal poem he wrote about a friend's own psychological 'pendulum' between craving validation and fiercely resisting control — explicitly speculative, 'I don't know, I've never tried it,' rather than presented as clinically validated the way Brown's own original protocol is."@en ;
    .

tgs:Concept.Intellectology a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.HumanBehavior ;
    skos:prefLabel "Intellectology"@en ;
    skos:definition "Real, formal field of study proposed by Roman Yampolskiy (already built), first named in his own 2015 paper tgs:Work.TheSpaceOfPossibleMindDesigns (already built): the deliberately human-decentered study of the full, real space of possible minds — biological, artificial, uploaded, or otherwise — treating all minds as instances of software and examining formal properties of that space (its real, proven infinitude, and the size and representational complexity individual minds can take), rather than starting from human cognition as the default reference point. Directly, explicitly named by Nate in TGS_233 (already built) during his real, direct conversation with Yampolskiy."@en ;
    skos:scopeNote "Real, independently corroborated field, not a one-off coinage: directly built upon by other researchers (Ziesche and Yampolskiy's own 2016 'Artificial Fun' paper explicitly frames itself as contributing to 'the field of intellectology'), and expanded by Yampolskiy himself in a real, later 2023 treatment, 'Taxonomies of Intelligence: A Comprehensive Guide to the Universe of Minds.' Real, direct intellectual lineage: builds explicitly on Aaron Sloman's 1984 paper 'The Structure of the Space of Possible Minds,' extending Sloman's own real, original call for an interdisciplinary description of mind-space into a formally named field with its own open problems."@en ;
    .

tgs:Concept.WhatWouldChangeMyMind a thinkr:Concept, owl:NamedIndividual ;
    dcterms:subject tgs:Subject.SystemsScience ;
    skos:prefLabel "What Would Change My Mind: The Two-Layer Falsifiability Test"@en ;
    skos:definition "Nate's own real, direct answer, developed in full in Frankly_158, to a real, direct question posed by a stranger: what would falsify his own core thesis? He distinguishes two genuinely different layers, discovered in that order but arguing the second is causally upstream of the first. Layer one, biophysical/measurable signals (real, direct examples): global fossil fuel consumption falling while GDP grows for five-plus consecutive non-recession years; energy intensity of GDP improving 3-4% annually rather than the historical ~1.2%; wide-boundary EROI (including storage, transmission, mining, recycling, not just at the source) for solar and wind clearing roughly 10:1; a large grid of 10-20 million people surviving a full winter at 80% wind/solar without fossil backup or major interconnection; energy cost per ton of refined copper falling despite ore-grade decline; critical minerals (lithium, cobalt, nickel, copper) recovered at 90% end-of-life and supplying most incremental demand, versus roughly 7.5% today; global debt-to-GDP flat or falling for a decade with no default cycle; sustained 5% annual emissions decline; retreating from seven of nine breached planetary boundaries to three or four. Layer two, cultural/behavioral signals — the real thing Nate argues would actually change his mind, since none of layer one's numbers move without this happening first, roughly a decade earlier: status shifting from consumption/display toward repair and durability; political discourse where candidates advocating consumption taxes and 'we are embedded in the web of life' framing don't lose elections; popular stories whose admired characters need less rather than either colonizing Mars or fighting zombies; personal time shifting from screens and shopping toward household maintenance, care, and volunteering; and a shift from 'who did this to us' toward 'what can we do,' evidenced by unlikely tribal-crossing collaborations (conservative farmers and environmentalists jointly protecting watersheds)."@en ;
    skos:scopeNote "Real, foundational framework, first delivered in full in Frankly_158 (already built). Nate is real and direct that the biophysical layer, though it's what he listed first, is actually the lagging indicator — 'they're what a change of heart... of a culture would look like in the physical world ten or more years after that happened.' Real, direct grounding citation confirmed: Donella Meadows' own real 'leverage points' framework (paradigm as the highest-leverage point in a system), already built, directly underlies why Nate treats the cultural layer as causally prior. Real, direct forward reference: Nate names Bill Plotkin (already built via TGS-146) directly, stating plainly 'I have to have him back on the show.'"@en ;
    .
