<http://example.org/thinkr#hasXPosition> a owl:DatatypeProperty ,
    owl:FunctionalProperty .

<http://example.org/thinkr#hasYPosition> a owl:DatatypeProperty ,
    owl:FunctionalProperty .

<http://example.org/thinkr#seriesPosition> a owl:DatatypeProperty .

<http://example.org/thinkr#verifiedOn> a owl:DatatypeProperty .

