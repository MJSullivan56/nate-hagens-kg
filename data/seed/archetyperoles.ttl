@prefix thinkr: <http://example.org/thinkr#> .
@prefix tgs: <http://example.org/tgs#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

#############################################
# ADDED 2026-10-21 -- the WWNS archetype matrix (tgs:Work.WWNSArchetypeMatrix)
# brought into the graph, at MJSullivan's request. One thinkr:ArchetypeRole
# per rated cell: which archetype, which intervention subdomain, how well it
# fits (thinkr:FitLevelType) and the role itself in one line (skos:definition),
# the call to action WWNS articles draw on. Cells rated 'No clear role' are
# left out. Strong fits are also asserted directly as
# thinkr:hasStrongFitIn on the archetype (archetypes.ttl) for simple queries.
# Roles are MJSullivan's editorial work, not Nate Hagens' statements.
#############################################

thinkr:ArchetypeRole a owl:Class ;
    rdfs:comment "The role one archetype plays in one intervention subdomain, as rated in the WWNS archetype matrix: an n-ary node carrying the archetype, the subdomain, a fit level and a one-line call to action."@en ;
    skos:prefLabel "Archetype Role"@en .

thinkr:roleOfArchetype a owl:ObjectProperty ;
    rdfs:domain thinkr:ArchetypeRole ; rdfs:range thinkr:Archetype ;
    skos:prefLabel "role of archetype"@en .

thinkr:roleInSubdomain a owl:ObjectProperty ;
    rdfs:domain thinkr:ArchetypeRole ; rdfs:range thinkr:InterventionSubdomain ;
    skos:prefLabel "role in subdomain"@en .

thinkr:hasFitLevel a owl:ObjectProperty ;
    rdfs:domain thinkr:ArchetypeRole ; rdfs:range thinkr:FitLevelType ;
    skos:prefLabel "has fit level"@en .

tgs:ArchetypeRole.Silvertongue_EnergySystems a thinkr:ArchetypeRole, owl:NamedIndividual ;
    skos:prefLabel "The Silvertongue in Energy Systems"@en ;
    thinkr:roleOfArchetype tgs:Archetype.Silvertongue ;
    thinkr:roleInSubdomain tgs:InterventionSubdomain.EnergySystems ;
    thinkr:hasFitLevel thinkr:FitLevelType.Moderate ;
    skos:definition "Translate grid realities among utilities, regulators and neighbors who distrust one another."@en ;
    dcterms:source tgs:Work.WWNSArchetypeMatrix ;
    skos:scopeNote "From the WWNS archetype matrix (cell: Silvertongue x Energy Systems)."@en .

tgs:ArchetypeRole.Alchemist_EnergySystems a thinkr:ArchetypeRole, owl:NamedIndividual ;
    skos:prefLabel "The Alchemist in Energy Systems"@en ;
    thinkr:roleOfArchetype tgs:Archetype.Alchemist ;
    thinkr:roleInSubdomain tgs:InterventionSubdomain.EnergySystems ;
    thinkr:hasFitLevel thinkr:FitLevelType.Strong ;
    skos:definition "Show the real energy behind every budget line; plan for using less, not just cleaner."@en ;
    dcterms:source tgs:Work.WWNSArchetypeMatrix ;
    skos:scopeNote "From the WWNS archetype matrix (cell: Alchemist x Energy Systems)."@en .

