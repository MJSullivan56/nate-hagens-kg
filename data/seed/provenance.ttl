@prefix tgs:   <http://example.org/tgs#> .
@prefix thinkr: <http://example.org/thinkr#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

#############################################
# provenance.ttl -- PILOT, 2026-09-12. Formalizes build/revision history
# as its own registry, per direct instruction, distinct from the
# already-existing Evidence/Source/LinkNote model (which supports
# evidentiary claims like Concept-echoesIdeaOf-Persona, not build
# history). Granularity: per-entity, per direct instruction -- one
# RevisionEvent per real episode, not one per batch.
#
# Piloted here against all 27 Reality Roundtable entities, migrating
# real, implied/explicit provenance already sitting in each entity's
# own scopeNote prose. Deliberately does NOT remove that provenance
# language from the scopeNotes themselves in this pilot pass -- this
# is an ADDITIVE structural layer for review, not a rewrite of
# episodes-rr.ttl. If this pilot is approved, a follow-up pass would
# trim the now-redundant provenance sentences out of each scopeNote,
# leaving scopeNote for genuinely evidentiary/citation content only.
#############################################

<http://example.org/thinkr#> a owl:Ontology ;
    rdfs:comment "Provenance extension to thinkr-core: real build/revision history, distinct from the Evidence/Source/LinkNote evidentiary-claim model."@en .

thinkr:RevisionEvent a owl:Class ;
    rdfs:comment "A single real, dated change to one entity's own content -- its initial build, or a later correction/enrichment/migration. One per entity per real event, not one per batch."@en .

thinkr:RevisionKindType a owl:Class ;
    rdfs:comment "Enumerated kind of a RevisionEvent."@en .

thinkr:RevisionKindType.InitialBuild a thinkr:RevisionKindType ;
    skos:prefLabel "Initial build"@en .

thinkr:RevisionKindType.Correction a thinkr:RevisionKindType ;
    skos:prefLabel "Correction"@en ;
    rdfs:comment "Fixes something that was wrong -- a stub replaced with a full build, a broken reference, a factual error."@en .

thinkr:RevisionKindType.Enrichment a thinkr:RevisionKindType ;
    skos:prefLabel "Enrichment"@en ;
    rdfs:comment "Adds real, new, correct content to an already-correct entity -- not fixing an error, extending coverage."@en .

thinkr:RevisionKindType.StructuralMigration a thinkr:RevisionKindType ;
    skos:prefLabel "Structural migration"@en ;
    rdfs:comment "Schema-level change -- a property moved domain, a file was split, a class was renamed. Not a content change."@en .

thinkr:RevisionKindType.StubCreated a thinkr:RevisionKindType ;
    skos:prefLabel "Stub created"@en ;
    rdfs:comment "A minimal placeholder entity -- real number, title, and URL confirmed from the site's own inventory, but no transcript processed and no real content built yet. Distinct from InitialBuild, which implies a full construction from real source material. Added 2026-09-12, first real need surfacing during the TGS #1-25 pilot, which mints confirmed-but-unbuilt episodes as real stubs rather than leaving them absent from the graph entirely."@en .

thinkr:affects a owl:ObjectProperty ;
    rdfs:domain thinkr:RevisionEvent ;
    rdfs:comment "The entity this event changed."@en .

thinkr:revisionDate a owl:DatatypeProperty ;
    rdfs:domain thinkr:RevisionEvent ;
    rdfs:range xsd:date .

thinkr:revisionKind a owl:ObjectProperty ;
    rdfs:domain thinkr:RevisionEvent ;
    rdfs:range thinkr:RevisionKindType .

thinkr:revisionNote a owl:DatatypeProperty ;
    rdfs:domain thinkr:RevisionEvent ;
    rdfs:range xsd:string ;
    rdfs:comment "What happened and why, in prose."@en .

thinkr:performedBy a owl:DatatypeProperty ;
    rdfs:domain thinkr:RevisionEvent ;
    rdfs:range xsd:string ;
    rdfs:comment "Which process made this change -- a session identifier, 'Claude Code batch N', a person's name directly. String for now, not an enumerated type -- becomes more structured once the automated Code pass gives this a real, consistent value to standardize around."@en .

thinkr:createdDate a owl:DatatypeProperty ;
    rdfs:domain thinkr:Episode ;
    rdfs:range xsd:date ;
    rdfs:comment "When this graph RECORD was first authored -- not the real-world episode's own recording/publish date (that's dct:created/dct:issued, already in wide use). Simple, always-present, directly on the entity -- the fast, flat answer to 'when did this entry first exist.' Distinct from and complementary to thinkr:RevisionEvent, which carries the richer WHY/WHAT-CHANGED narrative and can capture multiple real events even within a single calendar day, which a single date property cannot."@en .

thinkr:updatedDate a owl:DatatypeProperty ;
    rdfs:domain thinkr:Episode ;
    rdfs:range xsd:date ;
    rdfs:comment "When this graph record was last meaningfully changed. Equal to createdDate until a real, later revision happens. Should track the most recent thinkr:RevisionEvent's own revisionDate for this entity, where one exists with a later date than createdDate."@en .

