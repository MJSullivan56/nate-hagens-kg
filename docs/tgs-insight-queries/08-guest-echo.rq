# The guest whose conversations other episodes point back to most: TGS's most-cited guest, measured inside the show.
PREFIX thinkr: <http://example.org/thinkr#>
PREFIX tgs:    <http://example.org/tgs#>
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?g ?name (COUNT(DISTINCT ?later) AS ?citedBy) WHERE {
  ?ep thinkr:hasGuest ?g . ?later dct:references ?ep . ?later a thinkr:Episode .
  ?g rdfs:label ?n0 . BIND(REPLACE(?n0," \\(persona\\)","") AS ?name)
  FILTER(?g != tgs:Persona.NateHagens && ?later != ?ep)
} GROUP BY ?g ?name ORDER BY DESC(?citedBy) LIMIT 3
