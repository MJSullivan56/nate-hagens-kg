    thinkr:revisionKind thinkr:RevisionKindType.StubCreated ;
    thinkr:revisionNote "Real, genuine minimal stub -- number, guest name, and canonical URL confirmed via this session's own site inventory; no transcript or show notes processed. Resolves the real T10 candidate flagged via the farming-search screenshots earlier this session."@en ;
    .

tgs:RevisionEvent.TGS_230_Stub a thinkr:RevisionEvent ;
    thinkr:affects tgs:Interview.TGS_230_OlivierHamant ;
    thinkr:revisionDate "2026-09-12"^^xsd:date ;
