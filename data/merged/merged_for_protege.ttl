thinkr:RelationshipType.Intellectual a thinkr:RelationshipType,
        owl:NamedIndividual ;
    skos:prefLabel "Intellectual"@en ;
    skos:scopeNote "ADDED 2026-07-15. Subscribes to / aligns with a school of thought's ideas — distinct from Professional (implies employment or paid work) and Academic (implies formal institutional/teaching/credentialing ties). First real use: Relationship.NateHagens_PeakOilMovement, previously mistagged Professional even though its own scopeNote already admitted 'professional/intellectual community association... not a formal joinable organization' — the hedge was already visible before this type existed to resolve it."@en .

thinkr:ReliabilityType.Reputable a thinkr:ReliabilityType,
        owl:NamedIndividual ;
    skos:definition "Established journalism, credentialed-expert writing, or direct curator/maintainer reasoning that has itself been human-reviewed (thinkr:Evidence with no explicit thinkr:aboutSource defaults to this tier — see thinkr:aboutSource comment)."@en ;
    skos:prefLabel "Reputable"@en .

thinkr:ReliabilityType.Unreliable a thinkr:ReliabilityType,
        owl:NamedIndividual ;
    skos:definition "Known propaganda, misinformation, or otherwise discredited outlets. Evidence from Unreliable sources is stored (audit trail — 'we saw this, here's why it doesn't count') but EXCLUDED from calculatedConfidence entirely, regardless of polarity. A bad source doesn't make a claim less true; it just isn't signal worth counting either direction."@en ;
    skos:prefLabel "Unreliable"@en .

thinkr:ReliabilityType.Unverified a thinkr:ReliabilityType,
        owl:NamedIndividual ;
    skos:definition "Personal blogs, unreviewed Medium-style posts, anonymous sources. Can support a base Curated calculatedConfidence but can never push a LinkNote to Corroborated, regardless of volume."@en ;
    skos:prefLabel "Unverified"@en .

tgs:AcademicInstitution.UniversityOfVermont a thinkr:AcademicInstitution,
        owl:NamedIndividual ;
    thinkr:hasAcademicRelationship tgs:Relationship.JoshFarley_UniversityOfVermont ;
    skos:prefLabel "University of Vermont"@en .

tgs:AlternateTermType.Related a thinkr:AlternateTermType,
        owl:NamedIndividual ;
    skos:definition "A loose, non-hierarchical association — reusing SKOS's own skos:related semantics. The expected default/catch-all for most real-world cross-vocabulary connections."@en ;
    skos:prefLabel "Related"@en .

tgs:Concept.EnergyReturnOnInvestment a thinkr:Concept,
        owl:NamedIndividual ;
    thinkr:hasAlternateTerm [ a thinkr:AlternateTerm ;
            thinkr:hasAlternateTermType tgs:AlternateTermType.Abbreviation,
                tgs:AlternateTermType.ExactMatch ;
            skos:prefLabel "EROI"@en ;
            skos:scopeNote "SECOND pilot case for the alternate-term mechanism, 2026-08-13 — split out of this Concept's own former compound prefLabel ('EROI (Energy Return on Investment)'), same anti-pattern as Wetware's original compound label. BOTH types asserted deliberately: ExactMatch because this is genuinely the same meaning, Abbreviation because it's specifically a lexical-form relationship, not just a loose synonym. REVISED same day, per MJSullivan's explicit standing convention: when a term IS an Abbreviation of another, the FULL EXPANDED FORM is canonical (prefLabel + IRI local name), the abbreviation itself goes into the AlternateTerm — reversed from this pilot's own first draft, which had it backwards (IRI/prefLabel = 'EROI', full form as the AlternateTerm). See thinkr:AlternateTermType.Abbreviation's own scopeNote for the general rule." ] ;
    dct:source <https://en.wikipedia.org/wiki/Energy_return_on_investment>,
        <https://pmc.ncbi.nlm.nih.gov/articles/PMC7320919/>,
        <https://world-nuclear.org/information-library/energy-and-the-environment/energy-return-on-investment>,
        <https://www.gov.uk/research-for-development-outputs/eroi-of-different-fuels-and-the-implications-for-society>,
        <https://www.sciencedirect.com/topics/engineering/energy-return-on-investment> ;
    dct:subject tgs:Subject.EROIAndEnergyQuality ;
    skos:definition "The ratio of energy delivered by an energy source to the energy required to extract/produce it; central to Hagens' argument that the quality, not just quantity, of energy sources matters for what a society can sustain."@en ;
    skos:prefLabel "Energy Return on Investment"@en .

tgs:Concept.ScenarioThinking a thinkr:Concept,
        owl:NamedIndividual ;
    dct:source <https://www.thegreatsimplification.com> ;
    dct:subject tgs:Subject.SystemsScience ;
    skos:definition "Deliberately holding multiple plausible futures at once rather than committing to a single predicted storyline — the organizing methodology behind the entire 'How to Think About the Future' series (see tgs:Series.HowToThinkAboutTheFuture and tgs:Scenario) and explicitly contrasted by Hagens with forecasting."@en ;
    skos:prefLabel "Scenario Thinking"@en ;
    skos:scopeNote "Has a real, independently citable external source: Frankly_138's show notes link a specific book/resource, 'Scenario Thinking: A Historical Evolution of Strategic Foresight' — worth minting as its own tgs:Work once the exact author/publication details are verified (not yet done as of 2026-08-13, title alone insufficient to mint safely)."@en .

tgs:Concept.Schismogenesis a thinkr:Concept,
        owl:NamedIndividual ;
    thinkr:influencedBy tgs:Persona.GregoryBateson ;
    dct:source <https://www.thegreatsimplification.com> ;
    dct:subject tgs:Subject.HumanBehavior ;
    skos:definition "Gregory Bateson's term (from his 1930s anthropological fieldwork) for a process in which relationships escalate through cumulative interaction — either symmetrically (both parties responding to each other's same behavior with more of the same, e.g. an arms race) or complementarily (parties responding with opposite behaviors that reinforce each other, e.g. dominance and submission), each pattern intensifying over time unless deliberately interrupted."@en ;
    skos:prefLabel "Schismogenesis"@en .

tgs:Concept.ShortfallRisk a thinkr:Concept,
        thinkr:HagensConcept,
        owl:NamedIndividual ;
    dct:source <https://www.thegreatsimplification.com> ;
    dct:subject tgs:Subject.SystemsScience ;
    skos:definition "A framing Hagens borrows from portfolio management/finance and repurposes for civilizational risk assessment: the danger that something essential (topsoil, social trust, grid stability, the nuclear-use taboo, an aquifer) drops below a threshold it cannot easily recover from — distinct from more commonly discussed AVERAGE-outcome risk, and argued to be the more important lens for genuinely existential threats specifically because average-case thinking systematically undercounts them."@en ;
    skos:prefLabel "Shortfall Risk"@en ;
    skos:scopeNote "DOUBLY CONFIRMED: independently surfaced during an earlier session's by-hand pilot read of this same episode's transcript, and again via this session's official show-notes review — Frankly_138's own team-written description states this concept explicitly functions as connective tissue across the rest of the 'How to Think About the Future' series (see tgs:Series.HowToThinkAboutTheFuture)."@en .

tgs:Human.DJWhite a thinkr:Human,
        owl:NamedIndividual ;
    rdfs:comment "Co-founder of Greenpeace International and founder of EarthTrust; drove an international dolphin-safe tuna certification and helped stop a national dolphin drive kill. Co-author with Nate Hagens of Reality Blind (2021). Has his own real TGS guest episode (#51) — real, confirmed via search, deliberately NOT built as an Episode individual in this pass to keep scope bounded, flagged for a future pass."@en ;
    skos:prefLabel "DJ White"@en .

tgs:Human.GayaHerrington a thinkr:Human,
        owl:NamedIndividual ;
    thinkr:memberOf tgs:AcademicInstitution.HarvardUniversity,
        tgs:Organization.ClubOfRome,
        tgs:Organization.PostCarbonInstitute,
        tgs:Organization.SchneiderElectric,
        tgs:Organization.StopStraatintimidatie ;
    rdfs:comment "Née Branderhorst (born 1981) — publicly known as 'Gaya Branderhorst' as recently as 2015-2016 (per contemporaneous coverage of Stop Straatintimidatie's founding), 'Gaya Herrington' in all TGS-era and current professional material; the Branderhorst-to-Herrington transition itself was not independently dated, flagged as a real, minor gap rather than guessed. Sustainability researcher and former financial risk consultant. Education: MSc Econometrics, Vrije Universiteit Amsterdam; MSc Sustainability Studies, Harvard University (the degree itself stays prose-only, not modeled as an AcademicInstitution Relationship — same 'current-affiliation-gets-structured, degree-history-stays-prose' precedent as tgs:Human.JoshFarley; her CURRENT Harvard teaching role is separately modeled, see tgs:Relationship.GayaHerrington_HarvardUniversity). Career history: De Nederlandsche Bank (the Netherlands' central bank, past role) and KPMG US (past, Director of Sustainability Services) — both kept as prose only, not modeled as Organization individuals, since neither is central to her current public Persona and both predate her most TGS-relevant work; Schneider Electric (Vice-President of Sustainability Research, 12 years advising multinationals — modeled, see tgs:Relationship.GayaHerrington_SchneiderElectric) was originally recorded here as current but CORRECTED 2026-07-15 via a direct WebFetch of her own bio site (gayaherrington.com/about): this is now a PAST role. As of 2026 she works as an independent advisor; also Bioregional Finance co-Director of 'Cascadia' (org not independently verified/modeled — likely 'Regenerate Cascadia' per a LinkedIn hit, not confirmed against a primary source, deliberately left unmodeled rather than guessed) and Research Collaborator with York University's Ecological Footprint Initiative (also not independently verified further, prose-only). Current Board member, Post Carbon Institute (tgs:Relationship.GayaHerrington_PostCarbonInstitute — notably, an ALREADY-MODELED Organization in this graph that Nate Hagens also sits on the Board of, a real cross-connection between two bootstrapped guests) and R3.0 (not independently verified/modeled, prose-only). Current Adjunct Professor, Harvard University, teaching 'Economic transformation for post-growth flourishing' (tgs:Relationship.GayaHerrington_HarvardUniversity); also teaches an MBA class in post-growth economics/collapse resilience at Dutch college De Veranderschool and guest-lectures at Berkeley, Cambridge, UCLA, and Shizenkan University (all prose-only, incidental rather than central). Confirmed member, Club of Rome (tgs:Relationship.GayaHerrington_ClubOfRome) — the organization that originally commissioned the 1972 Limits to Growth study she later empirically re-tested, the single most thematically on-point affiliation surfaced in this bootstrap. Best known for 'Update to limits to growth: Comparing the World3 model with empirical data' (Journal of Industrial Ecology, 2021, DOI 10.1111/jiec.13084) — a direct empirical re-test of the original 1972 Limits to Growth study's World3 model against 2020-era real-world data, finding current trends track most closely with the 'Business as Usual 2' and 'Comprehensive Technology' scenarios (see tgs:Work.UpdateToLimitsToGrowth2021 and tgs:LinkNote.LimitsToGrowth_GayaHerrington). Also authored the book 'Five Insights for Avoiding Global Collapse' (tgs:Work.FiveInsightsForAvoidingGlobalCollapse) and has delivered a TED talk (not independently verified/linked). Founder (2014) of Stop Straatintimidatie, a Dutch anti-street-harassment advocacy organization that became a formal nonprofit foundation in 2016 (see tgs:Organization.StopStraatintimidatie and tgs:Relationship.GayaHerrington_StopStraatintimidatie) — central to her current public Persona as a women's-rights activist, not merely an incidental past fact, hence structured rather than left as prose. Real Wikipedia page, Wikidata entry (Q110607845), AND DBpedia page all confirmed via WebSearch/WebFetch 2026-07-15 — see tgs:CrosswalkNote.GayaHerrington_Wikidata and tgs:CrosswalkNote.GayaHerrington_DBpedia. A one-year-old daughter is mentioned in the TGS_57 transcript itself but deliberately excluded here as a privacy-sensitive personal detail not central to her public Persona, consistent with this project's scope (publications/credentials/public role, not general biography) — a judgment call, not a strict rule, flagged in case a future session weighs it differently."@en ;
    skos:prefLabel "Gaya Herrington"@en .

tgs:Human.IainMcGilchrist a thinkr:Human,
        owl:NamedIndividual ;
    rdfs:comment "FRSA, born 1953. British psychiatrist, philosopher, and neuroscientist. Fellow of the Royal College of Psychiatrists; Quondam Fellow of All Souls College, Oxford; former associate fellow of Green Templeton College, Oxford; emeritus consultant at the Maudsley and Bethlem Royal hospitals, London; former research fellow in Neuroimaging at Johns Hopkins University. Chancellor of Ralston College since October 2025 (succeeding Jordan Peterson). Confirmed via direct transcript excerpt as a repeat TGS guest: Episode 85 'Wisdom, Nature and the Brain' (2023) and Episode 217 'Wisdom in a World in Crisis' (April 2026, Nate explicitly says 'rejoined by,' confirming the second appearance). NOTE the correct spelling is IAIN, not the 'Ian' the NER pipeline extracted — confirmed via Wikipedia/Wikidata/his own official site (channelmcgilchrist.com)."@en ;
    owl:sameAs <http://dbpedia.org/resource/Iain_McGilchrist>,
        <http://www.wikidata.org/entity/Q16732304> ;
    skos:prefLabel "Iain McGilchrist"@en .

tgs:Human.VanessaAndreotti a thinkr:Human,
        owl:NamedIndividual ;
    rdfs:comment "Brazilian-born educator; Dean of the Faculty of Education, University of Victoria (at time of RR-10). Former Canada Research Chair in Race, Inequalities and Global Change; former David Lam Chair in Critical Multicultural Education. Co-founder of the Gesturing Towards Decolonial Futures Arts/Research Collective. Author of 'Hospicing Modernity: Facing Humanity's Wrongs and the Implications for Social Activism' and (2025) 'Outgrowing Modernity.' Real prior solo TGS appearance confirmed: episode #125, 'Hospicing Modernity and Rehabilitating Humanity' — real URL confirmed, not yet built as an Episode individual in this pass. No independent Wikipedia/DBpedia page found — confirmed real via her own UVic faculty profile, ResearchGate, and multiple independent podcast/publisher listings."@en ;
    skos:prefLabel "Vanessa Andreotti"@en .

tgs:Interview.TGS_10_NoraBateson a thinkr:Episode,
        owl:NamedIndividual ;
    thinkr:discusses tgs:Concept.KleibersLaw,
        tgs:Concept.Schismogenesis,
        tgs:Concept.Superorganism,
        tgs:Concept.Symmathesy,
        tgs:SchoolOfThought.WarmData ;
    thinkr:hasCanonicalSource <https://www.thegreatsimplification.com/episode/10-nora-bateson> ;
    thinkr:hasDiscussionSummary "hasDiscussionSummary ADDED 2026-08-13 from MJSullivan's own uploaded transcript — this entity had been otherwise fully built without one. Nora's real, foundational thesis is stated directly in the opening minutes: culture is highly skilled at naming and measuring 'the parts' of any system, but far less able to perceive the relationships between them — a real, pointed distinction she illustrates with a family, which can't function like a machine where a malfunctioning 'part' gets simply swapped out. Her explanation of symmathesy is offered as a real etymological construction, not a borrowed term — sym (together) plus the Greek mathisi (learning) — coined specifically because she felt systems thinking lacked a word for transcontextual mutual learning across an ecosystem's members. The conversation's most vivid moment is Nora's own real 'dog shit hill' metaphor: two paths up a hill, one direct but covered in waste, one longer but clean — offered as a direct challenge to the presumption that the 'efficient' linear path is actually efficient once its full real cost is counted. Her real explanation of schismogenesis distinguishes two of her father Gregory's original types (complementary, where an escalating dominance/submission gap eventually erases the relationship itself; symmetrical, where escalating competition between equals can remain creative even as it consumes everything else in the relationship) plus a third, real type she attributes to a Finnish research group rather than her father: 'systems holdback,' where each party withholds from a relationship in direct proportion to what they perceive the other withholding. A real, genuinely vulnerable disclosure closes the conversation's personal register: Nora describes deliberately raising her own children with systems-thinking and complexity skills, only realizing afterward that she hadn't anticipated their peers lacking the same tools — leaving her kids cast into real, unwanted roles as 'the helper, the healer, the rock' for people around them who were themselves struggling. The episode's real closing image, offered in response to Nate's question about energy redundancy, reframes infrastructure itself as a relationship problem: Nora's own anecdote about a friend who builds laundromats specifically because that's where isolated people are forced to talk to each other, extended by Nate into a real, direct principle both land on together — 'every single one of our basic needs should have a community around it.'"@en ;
    thinkr:hasEpisodeSegment tgs:EpisodeSegment.MainShow ;
    thinkr:hasEpisodeType thinkr:EpisodeType.Interview ;
    thinkr:hasGuest tgs:Persona.NoraBateson ;
    thinkr:hasHost tgs:Persona.NateHagens ;
    thinkr:hasTranscript <https://www.thegreatsimplification.com/wp-content/uploads/2022/03/TGS10NoraBatesonTranscript.docx.pdf> ;
    dct:created "2022-02-11"^^xsd:date ;
    dct:issued "2022-03-16"^^xsd:date ;
    dct:references tgs:Organization.InternationalBatesonInstitute,
        tgs:Work.RealityBlind ;
    dct:subject tgs:Subject.EconomicsAndMonetary,
        tgs:Subject.HumanBehavior ;
    skos:definition "Nora's first TGS appearance, bringing systems/complexity thinking to bear on the show's usual physical-science framing — how ecosystems (and human systems) develop through mutual learning (symmathesy), how relationships escalate through cumulative interaction (schismogenesis), and what her own concept of Warm Data offers as a way of perceiving the relational context conventional data strips away."@en ;
    skos:prefLabel "Nora Bateson: \"Complexity Between the Lines\""@en ;
    skos:scopeNote "2026-08-13: fully fleshed out from a direct real fetch of the episode's own page (MJSullivan's own request), confirming every one of his manually-transcribed timestamp labels against the page's real embedded links. Real, further citable material found but NOT built into this graph in this pass: William Bateson (Nora's grandfather, a real historical geneticist, distinct from her father Gregory already in this graph), Warm Data's own dedicated site (warmdatalab.net, distinct from International Bateson Institute's own site already used elsewhere), and 'People Need People' (peopleneedpeople.online) — real but unclear enough in nature (organization vs. informal initiative) from this one citation alone to model confidently. The Superorganism citation here is notably a DIFFERENT, real external ScienceDirect paper, not Nate's own writing — consistent with (and further corroborating) this graph's own earlier classification of Concept.Superorganism as external-origination, not thinkr:HagensConcept."@en .

